package sections

templ Steps(theme string) {
	<!-- Structural section: Process / How It Works (1-2-3-4 Steps) -->
	<section id="steps" class="py-16 px-4 bg-surface-muted/50 border-t border-b border-content/10">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-12" data-reveal>
				<div class="section-badge">Этапы работы</div>
				<h2 class="section-title">Как мы работаем</h2>
				<p class="section-subtitle">Прозрачный и понятный процесс от первого обращения до готового результата</p>
			</div>

			if theme == "auto" {
				<div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
					<div data-reveal data-reveal-delay="100" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">01</div>
						<h3 class="card-title text-base mb-1">Приём и осмотр</h3>
						<p class="card-desc text-xs">Принимаем автомобиль, фиксируем пробег и жалобы автовладельца в заказ-наряде.</p>
					</div>
					<div data-reveal data-reveal-delay="200" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">02</div>
						<h3 class="card-title text-base mb-1">Диагностика</h3>
						<p class="card-desc text-xs">Сканируем электронные блоки и осматриваем узлы на подъемнике, находим точную причину.</p>
					</div>
					<div data-reveal data-reveal-delay="300" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">03</div>
						<h3 class="card-title text-base mb-1">Согласование сметы</h3>
						<p class="card-desc text-xs">Утверждаем с вами финальную стоимость работ и запчастей до начала ремонта. Никаких сюрпризов.</p>
					</div>
					<div data-reveal data-reveal-delay="400" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">04</div>
						<h3 class="card-title text-base mb-1">Ремонт и выдача</h3>
						<p class="card-desc text-xs">Выполняем ремонт, проводим тест качества и выдаем авто с актом и гарантией 1 год.</p>
					</div>
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
					<div data-reveal data-reveal-delay="100" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">01</div>
						<h3 class="card-title text-base mb-1">Запись на сайте</h3>
						<p class="card-desc text-xs">Выберите подходящую дату и удобное время в интерактивном календаре онлайн.</p>
					</div>
					<div data-reveal data-reveal-delay="200" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">02</div>
						<h3 class="card-title text-base mb-1">Подтверждение</h3>
						<p class="card-desc text-xs">Мы связываемся с вами и уточняем список необходимых для визита документов.</p>
					</div>
					<div data-reveal data-reveal-delay="300" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">03</div>
						<h3 class="card-title text-base mb-1">Визит без очередей</h3>
						<p class="card-desc text-xs">Приходите к назначенному времени — специалист примет вас строго по расписанию.</p>
					</div>
					<div data-reveal data-reveal-delay="400" class="card-base relative">
						<div class="w-10 h-10 rounded-xl bg-accent text-surface font-bold flex items-center justify-center text-sm mb-4 shadow">04</div>
						<h3 class="card-title text-base mb-1">Готовый результат</h3>
						<p class="card-desc text-xs">Получите заверенные документы, протокол обследования или выполненную услугу.</p>
					</div>
				</div>
			}
		</div>
	</section>
}
