package sections

import (
	icons "sitecraft/ui/components/icons"
)

templ Steps(theme string) {
	<!-- Hallmark Architectural Process Steps (Strict Aesthetic Mode) -->
	<section
		id="steps"
		data-component="hallmark-steps"
		data-source="ui/sections/steps.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-6xl mx-auto border-b border-content/10"
	>
		<!-- Заголовок секции (Floor 54: без плашек) -->
		<div class="mb-12 text-left" data-reveal>
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
				Порядок и регламент приёма
			</h2>
			<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
				Чёткая последовательность действий от предварительной правовой экспертизы до выдачи заверенных актов.
			</p>
		</div>

		if theme == "auto" {
			<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
				<div data-reveal data-reveal-delay="100" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">01</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.Car(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Приём и осмотр
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">Фиксация обращений и первичное оформление заказ-наряда.</p>
				</div>
				<div data-reveal data-reveal-delay="200" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">02</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.Wrench(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Диагностика
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">Аппаратное сканирование узлов и определение точной причины.</p>
				</div>
				<div data-reveal data-reveal-delay="300" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">03</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.FileText(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Согласование сметы
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">Утверждение окончательной калькуляции до начала работ.</p>
				</div>
				<div data-reveal data-reveal-delay="400" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">04</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.CheckCircle2(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Выдача автомобиля
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">Контрольный осмотр и предоставление акта с гарантией.</p>
				</div>
			</div>
		} else {
			<!-- Default / Legal / Swiss -->
			<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
				<div data-reveal data-reveal-delay="100" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">01</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.Calendar(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Запись на приём
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">
						Выбор подходящей даты и точного времени в электронной сетке расписания.
					</p>
				</div>

				<div data-reveal data-reveal-delay="200" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">02</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.FileText(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Правовая экспертиза
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">
						Предварительная проверка предоставленных документов и согласование проекта договора.
					</p>
				</div>

				<div data-reveal data-reveal-delay="300" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">03</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.ShieldCheck(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Визит и удостоверение
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">
						Личное подписание документов в кабинете нотариуса строго в назначенное время.
					</p>
				</div>

				<div data-reveal data-reveal-delay="400" class="pt-4 border-t-2 border-content/10 hover:border-accent transition-colors space-y-3">
					<div class="text-xs font-mono text-content-muted">04</div>
					<h3 class="font-bold text-base text-content flex items-center gap-2">
						@icons.CheckCircle2(templ.Attributes{"class": "w-4 h-4 text-accent"})
						Регистрация в реестрах
					</h3>
					<p class="text-xs text-content-muted leading-relaxed">
						Внесение акта в ЕИС нотариата и отправка сведений в ведомственные реестры (ФНС, Росреестр).
					</p>
				</div>
			</div>
		}
	</section>
}
