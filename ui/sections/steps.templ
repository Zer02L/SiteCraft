package sections

templ Steps(theme string) {
	<!-- Structural section: Process / How It Works (1-2-3-4 Steps) -->
	<section id="steps" class="py-16 px-4 bg-stone-50 border-t border-b border-stone-200">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-12" data-reveal>
				<div class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-semibold rounded-full border border-primary/20 uppercase tracking-wider mb-2">Этапы работы</div>
				<h2 class="font-serif-title text-3xl font-bold text-stone-900">Как мы работаем</h2>
				<p class="text-stone-500 mt-2 max-w-xl mx-auto text-sm">Прозрачный и понятный процесс от первого обращения до готового результата</p>
			</div>

			if theme == "auto" {
				<div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
					<div data-reveal data-reveal-delay="100" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">01</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Приём и осмотр</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Принимаем автомобиль, фиксируем пробег и жалобы автовладельца в заказ-наряде.</p>
					</div>
					<div data-reveal data-reveal-delay="200" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">02</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Диагностика</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Сканируем электронные блоки и осматриваем узлы на подъемнике, находим точную причину.</p>
					</div>
					<div data-reveal data-reveal-delay="300" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">03</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Согласование сметы</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Утверждаем с вами финальную стоимость работ и запчастей до начала ремонта. Никаких сюрпризов.</p>
					</div>
					<div data-reveal data-reveal-delay="400" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">04</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Ремонт и выдача</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Выполняем ремонт, проводим тест качества и выдаем авто с актом и гарантией 1 год.</p>
					</div>
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
					<div data-reveal data-reveal-delay="100" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">01</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Запись на сайте</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Выберите подходящую дату и удобное время в интерактивном календаре онлайн.</p>
					</div>
					<div data-reveal data-reveal-delay="200" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">02</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Подтверждение</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Мы связываемся с вами и уточняем список необходимых для визита документов.</p>
					</div>
					<div data-reveal data-reveal-delay="300" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">03</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Визит без очередей</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Приходите к назначенному времени — специалист примет вас строго по расписанию.</p>
					</div>
					<div data-reveal data-reveal-delay="400" class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm relative">
						<div class="w-10 h-10 rounded-xl bg-primary text-white font-bold flex items-center justify-center text-sm mb-4 shadow">04</div>
						<h3 class="font-bold text-stone-900 text-base mb-1">Готовый результат</h3>
						<p class="text-stone-600 text-xs leading-relaxed">Получите заверенные документы, протокол обследования или выполненную услугу.</p>
					</div>
				</div>
			}
		</div>
	</section>
}
