package hero

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"
	"sitecraft/ui/components/cinematic"
)

templ LegalHero(content models.SiteContent, settings models.SiteSettings) {
	<!-- Hallmark Architectural Hero (Strict Aesthetic Mode) -->
	<section
		data-component="hallmark-legal-hero"
		data-source="ui/sections/hero/legal_hero.templ"
		class="relative bg-surface text-content min-h-[85vh] flex flex-col justify-between pt-10 pb-8 px-6 sm:px-10 lg:px-14 overflow-hidden border-b border-content/10 select-none"
	>
		<!-- Верхняя архитектоническая строка статуса (Floor 54 / Floor 67: без плашек и капслока) -->
		<div class="relative z-10 flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-content/10">
			<div class="flex items-center gap-3">
				<span class="w-1.5 h-1.5 bg-accent"></span>
				<span class="text-xs text-content-muted tracking-normal">
					if content.HeroBadge != "" {
						<span data-field="content.HeroBadge">{ content.HeroBadge }</span>
					} else {
						<span>Официальная юридическая и нотариальная практика</span>
					}
				</span>
			</div>

			<div class="flex items-center gap-4 text-xs">
				if content.Phone1 != "" {
					<a href={ templ.SafeURL("tel:" + content.Phone1) } class="text-content font-semibold hover:text-accent transition-colors">
						{ content.Phone1 }
					</a>
				}
				<span class="hidden md:inline-block text-content/20">•</span>
				<span class="hidden md:inline-block text-content-muted">Приём по предварительной записи</span>
			</div>
		</div>

		<!-- Центральный блок: Типографический манифест и архитектурный формуляр -->
		<div class="relative z-10 my-auto py-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
			<div class="lg:col-span-8 flex flex-col items-start space-y-6">
				<div>
					<h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-content leading-[1.06] mb-4">
						if content.HeroTitle != "" {
							<span data-field="content.HeroTitle">{ content.HeroTitle }</span>
						} else {
							<span>Правовая защита и нотариат</span>
						}
					</h1>

					<!-- Минималистичный текстовый фокус -->
					<div class="pt-1 text-content-muted text-base sm:text-lg">
						@cinematic.Typewriter("Специализация: ", []string{
							"защита корпоративных прав",
							"удостоверение сделок с долями ООО",
							"наследственное производство",
							"депозитные расчёты и эскроу",
						}, "")
					</div>
				</div>

				<p data-field="content.HeroSubtitle" class="text-base sm:text-lg text-content-muted max-w-2xl leading-relaxed font-normal">
					if content.HeroSubtitle != "" {
						{ content.HeroSubtitle }
					} else {
						Комплексное ведение нотариальных действий, сопровождение сделок и защита прав граждан и бизнеса в строгом соответствии с законодательством Российской Федерации.
					}
				</p>

				<!-- Кнопки действий (Floor 63: чистые глаголы без стрелочек) -->
				<div class="flex flex-wrap items-center gap-4 pt-2">
					@base.Button(base.ButtonProps{
						Variant: base.BtnAccent,
						Size:    base.BtnSizeLg,
						Href:    "#booking",
						Class:   "font-medium",
					}) {
						Записаться на консультацию
					}
					@base.Button(base.ButtonProps{
						Variant: base.BtnOutline,
						Size:    base.BtnSizeLg,
						Href:    "#services",
						Class:   "font-medium",
					}) {
						Реестр нотариальных действий
					}
				</div>
			</div>

			<!-- Правая колонка: Архитектурный формуляр доверия (Floor 11: плоский реестр с hairlines) -->
			<div class="lg:col-span-4 flex flex-col items-stretch max-w-sm w-full mx-auto lg:mx-0">
				<div class="p-6 bg-surface-muted border border-content/10 space-y-4">
					<div class="border-b border-content/10 pb-3">
						<div class="text-xs text-content-muted">Персональная ответственность</div>
						<div class="text-base font-bold text-content mt-1">
							if content.OwnerName != "" {
								<span data-field="content.OwnerName">{ content.OwnerName }</span>
							} else {
								<span>Нотариус города Москвы</span>
							}
						</div>
						if content.OwnerTitle != "" {
							<div class="text-xs text-content-muted mt-0.5" data-field="content.OwnerTitle">{ content.OwnerTitle }</div>
						}
					</div>

					<div class="space-y-2.5 text-xs text-content-muted leading-relaxed">
						<div class="flex items-start gap-2">
							<span class="text-accent">•</span>
							<span>Приказ Министерства юстиции РФ и статус нотариуса</span>
						</div>
						<div class="flex items-start gap-2">
							<span class="text-accent">•</span>
							<span>Прямое электронное взаимодействие с Росреестром и ФНС</span>
						</div>
						<div class="flex items-start gap-2">
							<span class="text-accent">•</span>
							<span>Полная нотариальная тайна и имущественная ответственность</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Нижняя бегущая строка направлений практики (Floor 67: sentence-case, без капслока) -->
		<div class="relative z-10 pt-4 -mx-6 sm:-mx-10 lg:-mx-14 border-t border-content/10">
			@cinematic.KineticMarquee([]string{
				"Сделки с недвижимостью",
				"Корпоративные решения и доли ООО",
				"Удостоверение доверенностей",
				"Наследственные дела",
				"Депозит нотариуса",
				"Электронная регистрация в Росреестре",
				"Обеспечение доказательств в сети Интернет",
				"Брачные договоры и соглашения",
			}, 28, false)
		</div>
	</section>
}
