package hero

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

templ SplitHero(content models.SiteContent, settings models.SiteSettings) {
	<!-- Hallmark Split Hero (Strict Aesthetic Mode) -->
	<section
		data-component="hallmark-split-hero"
		data-source="ui/sections/hero/split_hero.templ"
		class="relative bg-surface text-content py-16 md:py-24 px-6 sm:px-10 border-b border-content/10"
	>
		<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
			<!-- Левая колонка: Основной оффер и регламент -->
			<div class="lg:col-span-7 space-y-6 text-left" data-reveal="left">
				if content.HeroBadge != "" {
					<div class="flex items-center gap-2 text-xs text-content-muted">
						<span class="w-1.5 h-1.5 bg-accent"></span>
						<span data-field="content.HeroBadge">{ content.HeroBadge }</span>
					</div>
				}

				<h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-content leading-tight">
					<span data-field="content.HeroTitle">{ content.HeroTitle }</span>
					if content.OwnerName != "" {
						<br/>
						<span data-field="content.OwnerName" class="text-accent font-serif font-normal">{ content.OwnerName }</span>
					}
				</h1>

				<p data-field="content.HeroSubtitle" class="text-base sm:text-lg text-content-muted max-w-xl font-normal leading-relaxed">
					{ content.HeroSubtitle }
				</p>

				<!-- Архитектурные принципы работы (Floor 67: без капслока) -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-left max-w-lg text-xs sm:text-sm text-content-muted">
					<div class="flex items-center space-x-2 py-1.5 border-b border-content/10">
						<span class="text-accent font-bold">—</span>
						<span>Быстрая запись по графику без очередей</span>
					</div>
					<div class="flex items-center space-x-2 py-1.5 border-b border-content/10">
						<span class="text-accent font-bold">—</span>
						<span>Официальный статус и законная защита</span>
					</div>
					<div class="flex items-center space-x-2 py-1.5 border-b border-content/10">
						<span class="text-accent font-bold">—</span>
						<span>Стандарты нотариального регламента</span>
					</div>
					<div class="flex items-center space-x-2 py-1.5 border-b border-content/10">
						<span class="text-accent font-bold">—</span>
						<span>Предварительная экспертиза документов</span>
					</div>
				</div>

				<!-- Кнопки действий (Floor 63: чистые глаголы) -->
				<div class="pt-4 flex flex-wrap gap-4 items-center">
					@base.Button(base.ButtonProps{
						Variant: base.BtnAccent,
						Size:    base.BtnSizeLg,
						Href:    "#booking",
						Class:   "font-medium",
					}) {
						@icons.Calendar(templ.Attributes{"class": "w-4 h-4 mr-2"})
						Записаться на приём
					}
					if content.Phone1 != "" {
						@base.Button(base.ButtonProps{
							Variant: base.BtnOutline,
							Size:    base.BtnSizeLg,
							Href:    "tel:" + content.Phone1,
							Class:   "font-medium",
						}) {
							@icons.Phone(templ.Attributes{"class": "w-4 h-4 text-accent mr-2"})
							{ content.Phone1 }
						}
					}
				</div>
			</div>

			<!-- Правая колонка: Формуляр регламента и графика (Floor 11: плоский реестр с divide-y) -->
			<div class="lg:col-span-5 flex justify-center lg:justify-end" data-reveal="scale" data-reveal-delay="200">
				<div class="w-full max-w-sm bg-surface-muted border border-content/10 p-6 sm:p-7">
					<div class="border-b border-content/10 pb-4 mb-4">
						<h3 class="font-bold text-base text-content">Приём и регламент</h3>
						<p class="text-xs text-content-muted mt-0.5">Официальная приёмная нотариуса</p>
					</div>

					<div class="divide-y divide-content/10 text-xs">
						if content.WorkHours != "" {
							<div class="py-3 flex items-start space-x-3">
								<div class="font-medium text-content-muted w-24 shrink-0">График:</div>
								<div class="text-content">
									<div>{ content.WorkHours }</div>
									if content.LunchBreak != "" {
										<div class="text-content-muted mt-0.5">Обед: { content.LunchBreak }</div>
									}
								</div>
							</div>
						}

						if content.Address != "" {
							<div class="py-3 flex items-start space-x-3">
								<div class="font-medium text-content-muted w-24 shrink-0">Адрес:</div>
								<div class="text-content">
									<div>{ content.Address }</div>
									if content.AddressSub != "" {
										<div class="text-content-muted mt-0.5">{ content.AddressSub }</div>
									}
								</div>
							</div>
						}

						if content.Phone1 != "" {
							<div class="py-3 flex items-start space-x-3">
								<div class="font-medium text-content-muted w-24 shrink-0">Телефон:</div>
								<div>
									<a href={ templ.URL("tel:" + content.Phone1) } class="text-content font-bold hover:text-accent transition">
										{ content.Phone1 }
									</a>
								</div>
							</div>
						}
					</div>

					<div class="mt-6 pt-4 border-t border-content/10">
						@base.Button(base.ButtonProps{
							Variant: base.BtnPrimary,
							Size:    base.BtnSizeDefault,
							Href:    "#booking",
							Class:   "w-full font-medium justify-center",
						}) {
							Выбрать свободное время
						}
					</div>
				</div>
			</div>
		</div>
	</section>
}
