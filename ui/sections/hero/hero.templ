package hero

import (
	"sitecraft/internal/models"

	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ Hero(content models.SiteContent) {
	<!-- Hero Section -->
	<section class="relative bg-gradient-to-b from-primary-dark via-primary to-primary-dark text-white py-16 md:py-20 px-4 overflow-hidden border-b-4 border-accent">
		<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
			<div class="lg:col-span-7 space-y-5 text-center lg:text-left" data-reveal="left">
				@badge.Badge(badge.Props{
					Variant: badge.VariantSecondary,
					Class:   "bg-surface/15 text-accent border-accent/40 font-semibold uppercase tracking-wider text-xs px-3.5 py-1.5 shadow-sm animate-pulse-glow",
				}) {
					<span class="w-2 h-2 rounded-full bg-emerald-400 mr-2 animate-pulse"></span>
					{ content.HeroBadge }
				}

				<h1 class="font-serif-title text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight animate-fade-in-up">
					{ content.HeroTitle } <br/>
					<span class="text-accent">{ content.OwnerName }</span>
				</h1>

				<p class="text-stone-200 text-base sm:text-lg max-w-xl mx-auto lg:mx-0 font-normal">
					{ content.HeroSubtitle }
				</p>

				<!-- Контакты и быстрые кнопки -->
				<div class="pt-2 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Size:    button.SizeLg,
						Href:    "#booking",
						Class:   "bg-accent hover:bg-accent-hover text-primary-dark font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition duration-200",
					}) {
						@icons.Calendar(templ.Attributes{"class": "w-5 h-5 mr-2"})
						Записаться онлайн
					}
					if content.Phone1 != "" {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Size:    button.SizeLg,
							Href:    "tel:" + content.Phone1,
							Class:   "bg-surface/10 hover:bg-surface/20 text-white font-medium border-white/20 hover:-translate-y-0.5 transition duration-200",
						}) {
							@icons.Phone(templ.Attributes{"class": "w-5 h-5 text-accent mr-2"})
							{ content.Phone1 }
						}
					}
				</div>
			</div>


			<!-- Фото / Вывеска -->
			<div id="about" class="lg:col-span-5 flex justify-center" data-reveal="scale" data-reveal-delay="200">
				<div class="relative group max-w-xs sm:max-w-sm">
					<div class="absolute -inset-1.5 bg-accent/40 rounded-2xl blur-sm group-hover:bg-accent/60 transition duration-300"></div>
					<div class="relative bg-primary-dark p-3 rounded-2xl border-2 border-accent shadow-2xl overflow-hidden">
						<img
							src={ content.HeroPhoto }
							alt={ content.HeroTitle + ": " + content.OwnerName }
							class="w-full h-auto rounded-xl object-cover shadow-inner hover:scale-[1.02] transition duration-300"
						/>
						<div class="mt-3 px-2 py-1 text-center">
							<div class="text-xs uppercase tracking-widest text-accent font-semibold">Официальная вывеска</div>
							<div class="text-[11px] text-stone-300 mt-0.5">{ content.OwnerTitle }</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
