package hero

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

templ Hero(content models.SiteContent) {
	<!-- Hallmark Classical Architectural Hero (Strict Aesthetic Mode) -->
	<section
		data-component="hallmark-hero"
		data-source="ui/sections/hero/hero.templ"
		class="relative bg-surface text-content py-16 md:py-24 px-6 sm:px-10 border-b border-content/10"
	>
		<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
			<div class="lg:col-span-7 space-y-6 text-left" data-reveal="left">
				if content.HeroBadge != "" {
					<div class="flex items-center gap-2 text-xs text-content-muted">
						<span class="w-1.5 h-1.5 bg-accent"></span>
						<span data-field="content.HeroBadge">{ content.HeroBadge }</span>
					</div>
				}

				<h1 data-field="content.HeroTitle" class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-content leading-tight">
					{ content.HeroTitle }
					if content.OwnerName != "" {
						<br/>
						<span data-field="content.OwnerName" class="text-accent font-serif font-normal">{ content.OwnerName }</span>
					}
				</h1>

				<p data-field="content.HeroSubtitle" class="text-base sm:text-lg text-content-muted max-w-xl font-normal leading-relaxed">
					{ content.HeroSubtitle }
				</p>

				<!-- Контакты и кнопки действий (Floor 63: чистые глаголы без стрелок) -->
				<div class="pt-2 flex flex-wrap gap-4 items-center">
					@base.Button(base.ButtonProps{
						Variant: base.BtnAccent,
						Size:    base.BtnSizeLg,
						Href:    "#booking",
						Class:   "font-medium",
					}) {
						@icons.Calendar(templ.Attributes{"class": "w-4 h-4 mr-2"})
						Записаться на приём
					}
					if content.Phone1 != "" {
						@base.Button(base.ButtonProps{
							Variant: base.BtnOutline,
							Size:    base.BtnSizeLg,
							Href:    "tel:" + content.Phone1,
							Class:   "font-medium",
						}) {
							@icons.Phone(templ.Attributes{"class": "w-4 h-4 text-accent mr-2"})
							{ content.Phone1 }
						}
					}
				</div>
			</div>

			<!-- Фото / Вывеска (Архитектурный фрейм с hairlines) -->
			<div id="about" class="lg:col-span-5 flex justify-center lg:justify-end" data-reveal="scale" data-reveal-delay="200">
				<div class="max-w-sm w-full bg-surface-muted border border-content/10 p-3">
					<img
						src={ content.HeroPhoto }
						alt={ content.HeroTitle + ": " + content.OwnerName }
						class="w-full h-auto object-cover grayscale hover:grayscale-0 transition duration-500"
					/>
					<div class="mt-3 pt-2 border-t border-content/10 text-left">
						<div class="text-xs font-semibold text-content">Официальный приём</div>
						<div class="text-xs text-content-muted mt-0.5">{ content.OwnerTitle }</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
