package sections

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ Team(theme string, content models.SiteContent) {
	<!-- Structural section: Specialists / Team Members -->
	<section id="team" class="py-16 px-4 max-w-6xl mx-auto">
		<div class="text-center mb-12" data-reveal>
			@base.Badge(base.BadgeProps{
				Variant: base.BadgeAccent,
				Class:   "mb-2 uppercase tracking-wider",
			}) {
				Наши специалисты
			}
			<h2 class="section-title">Команда профессионалов</h2>
			<p class="section-subtitle">Опытные специалисты с профильным образованием и непрерывной практикой</p>
		</div>


		if theme == "medical" {
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div data-reveal data-reveal-delay="100" class="card-base text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-4xl mb-4 shadow-inner">👨‍⚕️</div>
					<h3 class="card-title">{ "Дмитрий Николаевич Орлов" }</h3>
					<p class="text-accent font-semibold text-xs mt-1">Главный врач, кардиолог</p>
					<p class="card-desc text-xs mt-3">Кандидат медицинских наук, стаж 18 лет. Эксперт по функциональной диагностике сердца и сосудов.</p>
				</div>
				<div data-reveal data-reveal-delay="200" class="card-base text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-4xl mb-4 shadow-inner">👩‍⚕️</div>
					<h3 class="card-title">{ "Анна Сергеевна Воронова" }</h3>
					<p class="text-accent font-semibold text-xs mt-1">Врач УЗД экспертного класса</p>
					<p class="card-desc text-xs mt-3">Врач высшей квалификационной категории, стаж 14 лет. Более 20 000 проведенных протоколов УЗИ.</p>
				</div>
				<div data-reveal data-reveal-delay="300" class="card-base text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-4xl mb-4 shadow-inner">👨‍⚕️</div>
					<h3 class="card-title">{ "Михаил Романович Лебедев" }</h3>
					<p class="text-accent font-semibold text-xs mt-1">Терапевт, гастроэнтеролог</p>
					<p class="card-desc text-xs mt-3">Стаж 11 лет. Комплексный превентивный подход к здоровью, разработка персональных программ питания.</p>
				</div>
			</div>
		} else if theme == "beauty" {
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div data-reveal data-reveal-delay="100" class="card-base text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-4xl mb-4 shadow-inner">💇‍♀️</div>
					<h3 class="card-title">{ "Виктория Самойлова" }</h3>
					<p class="text-accent font-semibold text-xs mt-1">Арт-директор, топ-колорист</p>
					<p class="card-desc text-xs mt-3">Диплом Академии Vidal Sassoon. Создатель авторских методик безаммиачного тонирования волос.</p>
				</div>
				<div data-reveal data-reveal-delay="200" class="card-base text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-4xl mb-4 shadow-inner">💅</div>
					<h3 class="card-title">{ "Алина Морозова" }</h3>
					<p class="text-accent font-semibold text-xs mt-1">Ведущий мастер нейл-арта</p>
					<p class="card-desc text-xs mt-3">Победитель чемпионата по аппаратному маникюру. Специалист по аппаратному педикюру Smart.</p>
				</div>
				<div data-reveal data-reveal-delay="300" class="card-base text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-4xl mb-4 shadow-inner">✨</div>
					<h3 class="card-title">{ "Полина Калинина" }</h3>
					<p class="text-accent font-semibold text-xs mt-1">Визажист & Стилист по прическам</p>
					<p class="card-desc text-xs mt-3">Работа на показах Fashion Week. Вечерние и свадебные образы, подчеркивающие индивидуальность.</p>
				</div>
			</div>
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
				<div data-reveal data-reveal-delay="100" class="card-base text-center hover:-translate-y-1 hover:shadow-lg transition duration-300">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-accent mb-4 shadow-inner">
						@icons.Scale(templ.Attributes{"class": "w-10 h-10"})
					</div>
					<h3 class="card-title">{ content.OwnerName }</h3>
					<p class="text-accent font-semibold text-xs mt-1">{ content.OwnerTitle }</p>
					<p class="card-desc text-xs mt-3">Назначен на должность нотариуса приказом Управления Минюста РФ. Лицензия на право нотариальной деятельности.</p>
				</div>
				<div data-reveal data-reveal-delay="200" class="card-base text-center hover:-translate-y-1 hover:shadow-lg transition duration-300">
					<div class="w-24 h-24 mx-auto rounded-full bg-accent/15 border-2 border-accent flex items-center justify-center text-accent mb-4 shadow-inner">
						@icons.Users(templ.Attributes{"class": "w-10 h-10"})
					</div>
					<h3 class="card-title">Помощники и консультанты</h3>
					<p class="text-accent font-semibold text-xs mt-1">Юридический отдел конторы</p>
					<p class="card-desc text-xs mt-3">Квалифицированные юристы обеспечивают предварительную правовую экспертизу документов без задержек.</p>
				</div>
			</div>
		}
	</section>
}

