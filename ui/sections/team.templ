package sections

import (
	"sitecraft/internal/models"

	icons "sitecraft/ui/components/icons"
)

templ Team(theme string, content models.SiteContent) {
	<!-- Hallmark Architectural Dossier / Team (Strict Aesthetic Mode) -->
	<section
		id="team"
		data-component="hallmark-team"
		data-source="ui/sections/team.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-6xl mx-auto border-b border-content/10"
	>
		<!-- Заголовок секции (Floor 54: без плашек) -->
		<div class="mb-12 text-left" data-reveal>
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
				Нотариальный состав и специалисты
			</h2>
			<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
				Квалифицированные юристы и нотариусы с многолетней практикой и профильной государственной аккредитацией.
			</p>
		</div>

		if theme == "medical" {
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div data-reveal data-reveal-delay="100" class="p-6 bg-surface border border-content/10 flex flex-col justify-between">
					<div>
						<div class="w-12 h-12 bg-surface-muted border border-content/10 flex items-center justify-center text-2xl mb-4">🩺</div>
						<h3 class="font-bold text-base text-content">Дмитрий Николаевич Орлов</h3>
						<p class="text-accent font-medium text-xs mt-0.5">Главный врач, кардиолог</p>
						<p class="text-xs text-content-muted mt-3 leading-relaxed">Кандидат медицинских наук, стаж 18 лет. Эксперт по функциональной диагностике сердца и сосудов.</p>
					</div>
				</div>
				<div data-reveal data-reveal-delay="200" class="p-6 bg-surface border border-content/10 flex flex-col justify-between">
					<div>
						<div class="w-12 h-12 bg-surface-muted border border-content/10 flex items-center justify-center text-2xl mb-4">🔬</div>
						<h3 class="font-bold text-base text-content">Анна Сергеевна Воронова</h3>
						<p class="text-accent font-medium text-xs mt-0.5">Врач УЗД экспертного класса</p>
						<p class="text-xs text-content-muted mt-3 leading-relaxed">Врач высшей квалификационной категории, стаж 14 лет. Более 20 000 проведённых протоколов УЗИ.</p>
					</div>
				</div>
				<div data-reveal data-reveal-delay="300" class="p-6 bg-surface border border-content/10 flex flex-col justify-between">
					<div>
						<div class="w-12 h-12 bg-surface-muted border border-content/10 flex items-center justify-center text-2xl mb-4">🩺</div>
						<h3 class="font-bold text-base text-content">Михаил Романович Лебедев</h3>
						<p class="text-accent font-medium text-xs mt-0.5">Терапевт, гастроэнтеролог</p>
						<p class="text-xs text-content-muted mt-3 leading-relaxed">Стаж 11 лет. Комплексный превентивный подход к здоровью, разработка персональных программ питания.</p>
					</div>
				</div>
			</div>
		} else {
			<!-- Default / Legal / Swiss Dossier -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl">
				<div data-reveal data-reveal-delay="100" class="p-8 bg-surface border border-content/10 flex flex-col justify-between">
					<div class="space-y-4">
						<div class="w-12 h-12 bg-surface-muted border border-content/10 flex items-center justify-center text-accent">
							@icons.Scale(templ.Attributes{"class": "w-6 h-6"})
						</div>
						<div>
							<h3 class="font-bold text-lg text-content">{ content.OwnerName }</h3>
							<p class="text-accent font-medium text-xs mt-0.5">{ content.OwnerTitle }</p>
						</div>
						<p class="text-xs text-content-muted leading-relaxed">
							Назначен на должность нотариуса приказом Главного управления Министерства юстиции РФ. Лицензия на право нотариальной деятельности и стаж более 15 лет.
						</p>
					</div>
				</div>

				<div data-reveal data-reveal-delay="200" class="p-8 bg-surface border border-content/10 flex flex-col justify-between">
					<div class="space-y-4">
						<div class="w-12 h-12 bg-surface-muted border border-content/10 flex items-center justify-center text-accent">
							@icons.Users(templ.Attributes{"class": "w-6 h-6"})
						</div>
						<div>
							<h3 class="font-bold text-lg text-content">Помощники и консультанты</h3>
							<p class="text-accent font-medium text-xs mt-0.5">Юридический отдел конторы</p>
						</div>
						<p class="text-xs text-content-muted leading-relaxed">
							Квалифицированные юристы со стажем обеспечивают предварительную правовую экспертизу документов, подготовку договоров и оперативный приём без задержек.
						</p>
					</div>
				</div>
			</div>
		}
	</section>
}
