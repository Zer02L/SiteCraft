package sections

import (
	"sitecraft/internal/models"
)

templ Team(theme string, content models.SiteContent) {
	<!-- Structural section: Specialists / Team Members -->
	<section id="team" class="py-16 px-4 max-w-6xl mx-auto">
		<div class="text-center mb-12" data-reveal>
			<div class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-semibold rounded-full border border-primary/20 uppercase tracking-wider mb-2">Наши специалисты</div>
			<h2 class="font-serif-title text-3xl font-bold text-stone-900">Команда профессионалов</h2>
			<p class="text-stone-500 mt-2 max-w-xl mx-auto text-sm">Опытные специалисты с профильным образованием и непрерывной практикой</p>
		</div>

		if theme == "medical" {
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div data-reveal data-reveal-delay="100" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-teal-50 border-2 border-primary flex items-center justify-center text-4xl mb-4 shadow-inner">👨‍⚕️</div>
					<h3 class="font-bold text-stone-900 text-lg">Дмитрий Николаевич Орлов</h3>
					<p class="text-primary font-semibold text-xs mt-1">Главный врач, кардиолог</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Кандидат медицинских наук, стаж 18 лет. Эксперт по функциональной диагностике сердца и сосудов.</p>
				</div>
				<div data-reveal data-reveal-delay="200" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-teal-50 border-2 border-primary flex items-center justify-center text-4xl mb-4 shadow-inner">👩‍⚕️</div>
					<h3 class="font-bold text-stone-900 text-lg">Анна Сергеевна Воронова</h3>
					<p class="text-primary font-semibold text-xs mt-1">Врач УЗД экспертного класса</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Врач высшей квалификационной категории, стаж 14 лет. Более 20 000 проведенных протоколов УЗИ.</p>
				</div>
				<div data-reveal data-reveal-delay="300" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-teal-50 border-2 border-primary flex items-center justify-center text-4xl mb-4 shadow-inner">👨‍⚕️</div>
					<h3 class="font-bold text-stone-900 text-lg">Михаил Романович Лебедев</h3>
					<p class="text-primary font-semibold text-xs mt-1">Терапевт, гастроэнтеролог</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Стаж 11 лет. Комплексный превентивный подход к здоровью, разработка персональных программ питания.</p>
				</div>
			</div>
		} else if theme == "beauty" {
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div data-reveal data-reveal-delay="100" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-pink-50 border-2 border-primary flex items-center justify-center text-4xl mb-4 shadow-inner">💇‍♀️</div>
					<h3 class="font-bold text-stone-900 text-lg">Виктория Самойлова</h3>
					<p class="text-primary font-semibold text-xs mt-1">Арт-директор, топ-колорист</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Диплом Академии Vidal Sassoon. Создатель авторских методик безаммиачного тонирования волос.</p>
				</div>
				<div data-reveal data-reveal-delay="200" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-pink-50 border-2 border-primary flex items-center justify-center text-4xl mb-4 shadow-inner">💅</div>
					<h3 class="font-bold text-stone-900 text-lg">Алина Морозова</h3>
					<p class="text-primary font-semibold text-xs mt-1">Ведущий мастер нейл-арта</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Победитель чемпионата по аппаратному маникюру. Специалист по аппаратному педикюру Smart.</p>
				</div>
				<div data-reveal data-reveal-delay="300" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-pink-50 border-2 border-primary flex items-center justify-center text-4xl mb-4 shadow-inner">✨</div>
					<h3 class="font-bold text-stone-900 text-lg">Полина Калинина</h3>
					<p class="text-primary font-semibold text-xs mt-1">Визажист & Стилист по прическам</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Работа на показах Fashion Week. Вечерние и свадебные образы, подчеркивающие индивидуальность.</p>
				</div>
			</div>
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
				<div data-reveal data-reveal-delay="100" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-amber-50 border-2 border-primary flex items-center justify-center text-4xl mb-4 shadow-inner">⚖️</div>
					<h3 class="font-bold text-stone-900 text-lg">{ content.OwnerName }</h3>
					<p class="text-primary font-semibold text-xs mt-1">{ content.OwnerTitle }</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Назначен на должность нотариуса приказом Управления Минюста РФ. Лицензия на право нотариальной деятельности.</p>
				</div>
				<div data-reveal data-reveal-delay="200" class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-sm text-center">
					<div class="w-24 h-24 mx-auto rounded-full bg-stone-50 border-2 border-stone-300 flex items-center justify-center text-4xl mb-4 shadow-inner">🏛️</div>
					<h3 class="font-bold text-stone-900 text-lg">Помощники и консультанты</h3>
					<p class="text-stone-600 font-semibold text-xs mt-1">Юридический отдел конторы</p>
					<p class="text-stone-500 text-xs mt-3 leading-relaxed">Квалифицированные юристы обеспечивают предварительную правовую экспертизу документов без задержек.</p>
				</div>
			</div>
		}
	</section>
}
