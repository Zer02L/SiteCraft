package sections

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ MapSection(content models.SiteContent, settings models.SiteSettings, branches []models.BranchItem) {
	<!-- Interactive Location & Multi-Branch Map Section (Блок 4: Сеть филиалов) -->
	<section
		id="map"
		class="py-16 px-4 max-w-6xl mx-auto"
		if len(branches) > 0 {
			x-data="{
				activeCity: 'all',
				activeBranchId: 0,
				branches: [],
			}"
		}
	>
		<div class="text-center mb-8" data-reveal>
			@base.Badge(base.BadgeProps{
				Variant: base.BadgeAccent,
				Class:   "mb-2 uppercase tracking-wider",
			}) {
				if len(branches) > 1 {
					Сеть филиалов
				} else {
					Локация
				}
			}
			<h2 class="font-serif-title text-3xl font-bold text-content">
				if len(branches) > 1 {
					Наши филиалы и как нас найти
				} else {
					Как нас найти
				}
			</h2>
			<p class="text-content-muted mt-2 text-sm max-w-xl mx-auto">
				Удобный подъезд и собственная парковка для клиентов. Выберите удобный филиал для обслуживания.
			</p>
		</div>

		if len(branches) > 1 {
			<!-- Фильтр по городам (Zero-lag Alpine.js) -->
			<div class="flex items-center justify-center gap-2 mb-6 flex-wrap" data-reveal>
				<button
					type="button"
					@click="activeCity = 'all'"
					:class="activeCity === 'all' ? 'bg-primary text-white shadow-md' : 'bg-surface text-content-muted hover:text-content border border-content/15'"
					class="px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer"
				>
					Все отделения ({ fmt.Sprintf("%d", len(branches)) })
				</button>
				<!-- Выбираем уникальные города -->
				for _, city := range getUniqueCities(branches) {
					<button
						type="button"
						@click={ fmt.Sprintf("activeCity = '%s'", city) }
						:class={ fmt.Sprintf("activeCity === '%s' ? 'bg-primary text-white shadow-md' : 'bg-surface text-content-muted hover:text-content border border-content/15'", city) }
						class="px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer"
					>
						{ city }
					</button>
				}
			</div>

			<!-- Карточки отделений -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8" data-reveal>
				for idx, b := range branches {
					<div
						x-show={ fmt.Sprintf("activeCity === 'all' || activeCity === '%s'", b.City) }
						@click={ fmt.Sprintf("activeBranchId = %d", idx) }
						:class={ fmt.Sprintf("activeBranchId === %d ? 'ring-2 ring-primary border-primary bg-surface shadow-md' : 'border-content/10 bg-surface/70 hover:bg-surface'", idx) }
						class="p-5 rounded-2xl border transition-all cursor-pointer flex flex-col justify-between"
					>
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="font-bold text-sm text-content">{ b.Name }</span>
								if b.IsMain {
									<span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-accent/20 text-primary-dark">
										Флагман
									</span>
								}
							</div>
							<p class="text-xs text-content/80 font-medium mb-1 flex items-start gap-1">
								@icons.MapPin(templ.Attributes{"class": "w-3.5 h-3.5 text-primary flex-shrink-0 mt-0.5"})
								<span>{ b.Address }</span>
							</p>
							if b.Metro != "" {
								<p class="text-[11px] text-content-muted pl-4">м. { b.Metro }</p>
							}
						</div>

						<div class="mt-4 pt-3 border-t border-content/10 flex items-center justify-between text-xs">
							<a
								href={ templ.URL("tel:" + b.Phone) }
								class="font-bold text-primary hover:underline"
								onclick="event.stopPropagation()"
							>
								{ b.Phone }
							</a>
							<a
								href={ templ.URL(fmt.Sprintf("https://yandex.ru/maps/?rtext=~%f,%f", b.Lat, b.Lng)) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-[11px] text-accent hover:underline flex items-center gap-0.5 font-semibold"
								onclick="event.stopPropagation()"
							>
								<span>Маршрут</span>
								@icons.ExternalLink(templ.Attributes{"class": "w-3 h-3"})
							</a>
						</div>
					</div>
				}
			</div>
		}

		<div class="bg-surface rounded-2xl shadow-sm border border-content/10 overflow-hidden grid grid-cols-1 lg:grid-cols-12" data-reveal>
			<!-- Адрес и контакты рядом с картой -->
			<div class="lg:col-span-4 p-6 sm:p-8 bg-surface-muted border-b lg:border-b-0 lg:border-r border-content/10 flex flex-col justify-between">
				<div class="space-y-6">
					<div>
						<span class="text-xs font-semibold uppercase tracking-wider text-primary flex items-center gap-1.5">
							@icons.MapPin(templ.Attributes{"class": "w-3.5 h-3.5 text-primary"})
							Фактический адрес
						</span>
						<p class="mt-1.5 text-base font-bold text-content leading-snug">
							{ content.Address }
						</p>
						<p class="text-xs text-content-muted mt-1">{ content.AddressSub }</p>
					</div>

					<div class="border-t border-content/10 pt-4">
						<span class="text-xs font-semibold uppercase tracking-wider text-content-muted flex items-center gap-1.5">
							@icons.Phone(templ.Attributes{"class": "w-3.5 h-3.5 text-content-muted"})
							Прямые телефоны:
						</span>
						<div class="mt-2 space-y-1">
							if content.Phone1 != "" {
								<a href={ templ.URL("tel:" + content.Phone1) } class="block text-base font-bold text-primary hover:underline">{ content.Phone1 }</a>
							}
							if content.Phone2 != "" {
								<a href={ templ.URL("tel:" + content.Phone2) } class="block text-sm font-semibold text-content hover:underline">{ content.Phone2 }</a>
							}
						</div>
					</div>

					<div class="border-t border-content/10 pt-4">
						<span class="text-xs font-semibold uppercase tracking-wider text-content-muted flex items-center gap-1.5">
							@icons.Clock(templ.Attributes{"class": "w-3.5 h-3.5 text-content-muted"})
							График:
						</span>
						<p class="text-xs text-content/80 mt-1">{ content.WorkHours } (Обед { content.LunchBreak })</p>
						<p class="text-xs text-content-muted">{ content.DaysOff }</p>
					</div>
				</div>

				<div class="mt-8 pt-4 border-t border-content/10 space-y-2">
					@base.Button(base.ButtonProps{
						Variant: base.BtnAccent,
						Size:    base.BtnSizeSm,
						Href:    "#booking",
						Class:   "w-full text-primary-dark font-bold shadow-sm hover:shadow transition",
					}) {
						@icons.Calendar(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
						Забронировать время онлайн
					}
				</div>
			</div>

			<!-- Карта с поддержкой Lazy-loading через HTMX (Zero-JS / 100 PageSpeed) -->
			<div class="lg:col-span-8 min-h-[420px] relative bg-surface-muted flex items-center justify-center">
				if settings.MapMode == "lazy" {
					<div
						hx-get="/api/map-frame"
						hx-trigger="revealed"
						hx-swap="outerHTML"
						class="w-full h-full min-h-[420px] flex flex-col items-center justify-center text-content-muted gap-2 p-6"
					>
						@icons.Loader2(templ.Attributes{"class": "animate-spin w-8 h-8 text-primary"})
						<span class="text-xs font-medium">Загрузка интерактивной карты...</span>
					</div>
				} else {
					<iframe
						src={ content.MapIframe }
						width="100%"
						height="100%"
						frameborder="0"
						allowfullscreen="true"
						class="w-full h-full min-h-[420px] border-0"
						title={ "Интерактивная карта — " + content.HeroTitle + " " + content.OwnerName }
					></iframe>
				}
			</div>
		</div>
	</section>
}

func getUniqueCities(branches []models.BranchItem) []string {
	seen := make(map[string]bool)
	var cities []string
	for _, b := range branches {
		if b.City != "" && !seen[b.City] {
			seen[b.City] = true
			cities = append(cities, b.City)
		}
	}
	return cities
}

templ MapFrame(iframeURL string, title string) {
	<iframe
		src={ iframeURL }
		width="100%"
		height="100%"
		frameborder="0"
		allowfullscreen="true"
		class="w-full h-full min-h-[420px] border-0"
		title={ title }
	></iframe>
}
