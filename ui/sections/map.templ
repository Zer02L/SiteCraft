package sections

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

templ MapSection(content models.SiteContent, settings models.SiteSettings, branches []models.BranchItem) {
	<!-- Hallmark Architectural Location & Map Section (Strict Aesthetic Mode) -->
	<section
		id="map"
		data-component="hallmark-map"
		data-source="ui/sections/map.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-6xl mx-auto border-b border-content/10"
		if len(branches) > 0 {
			x-data="{
				activeCity: 'all',
				activeBranchId: 0,
				branches: [],
			}"
		}
	>
		<!-- Заголовок секции (Floor 54: без плашек) -->
		<div class="mb-12 text-left" data-reveal>
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
				if len(branches) > 1 {
					Адреса отделений и схема проезда
				} else {
					Местонахождение и приёмная
				}
			</h2>
			<p class="text-sm sm:text-base text-content-muted mt-2 max-w-xl leading-relaxed">
				Центральный деловой район, охраняемая парковка для доверителей и доступность от метро.
			</p>
		</div>

		if len(branches) > 1 {
			<!-- Фильтр по городам (Floor 67: sentence-case) -->
			<div class="flex items-center gap-2 mb-6 flex-wrap" data-reveal>
				<button
					type="button"
					@click="activeCity = 'all'"
					:class="activeCity === 'all' ? 'bg-primary text-white border-primary' : 'bg-surface text-content border-content/15 hover:border-content/30'"
					class="px-4 py-2 border text-xs font-medium transition cursor-pointer"
				>
					Все отделения ({ fmt.Sprintf("%d", len(branches)) })
				</button>
				for _, city := range getUniqueCities(branches) {
					<button
						type="button"
						@click={ fmt.Sprintf("activeCity = '%s'", city) }
						:class={ fmt.Sprintf("activeCity === '%s' ? 'bg-primary text-white border-primary' : 'bg-surface text-content border-content/15 hover:border-content/30'", city) }
						class="px-4 py-2 border text-xs font-medium transition cursor-pointer"
					>
						{ city }
					</button>
				}
			</div>

			<!-- Реестр отделений (Floor 11: flat hairlines) -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8" data-reveal>
				for idx, b := range branches {
					<div
						x-show={ fmt.Sprintf("activeCity === 'all' || activeCity === '%s'", b.City) }
						@click={ fmt.Sprintf("activeBranchId = %d", idx) }
						:class={ fmt.Sprintf("activeBranchId === %d ? 'border-accent bg-surface-muted/50' : 'border-content/10 bg-surface hover:border-content/30'", idx) }
						class="p-5 border transition cursor-pointer flex flex-col justify-between"
					>
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="font-bold text-sm text-content">{ b.Name }</span>
								if b.IsMain {
									<span class="text-[11px] text-content-muted">Центральное</span>
								}
							</div>
							<p class="text-xs text-content/80 font-medium mb-1 flex items-start gap-1.5">
								@icons.MapPin(templ.Attributes{"class": "w-3.5 h-3.5 text-accent flex-shrink-0 mt-0.5"})
								<span>{ b.Address }</span>
							</p>
							if b.Metro != "" {
								<p class="text-[11px] text-content-muted pl-5">м. { b.Metro }</p>
							}
						</div>

						<div class="mt-4 pt-3 border-t border-content/10 flex items-center justify-between text-xs">
							<a
								href={ templ.URL("tel:" + b.Phone) }
								class="font-semibold text-content hover:text-accent"
								onclick="event.stopPropagation()"
							>
								{ b.Phone }
							</a>
							<a
								href={ templ.URL(fmt.Sprintf("https://yandex.ru/maps/?rtext=~%f,%f", b.Lat, b.Lng)) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-[11px] text-accent hover:underline flex items-center gap-1 font-medium"
								onclick="event.stopPropagation()"
							>
								<span>Маршрут</span>
								@icons.ExternalLink(templ.Attributes{"class": "w-3 h-3"})
							</a>
						</div>
					</div>
				}
			</div>
		}

		<!-- Архитектурный сплит: Контакты + Интерактивная карта (Floor 11: divide-x с тонкими hairlines) -->
		<div class="bg-surface border border-content/10 overflow-hidden grid grid-cols-1 lg:grid-cols-12" data-reveal>
			<div class="lg:col-span-4 p-6 sm:p-8 bg-surface-muted/30 border-b lg:border-b-0 lg:border-r border-content/10 flex flex-col justify-between space-y-6">
				<div class="space-y-6">
					<div>
						<span class="text-xs font-semibold text-content-muted flex items-center gap-1.5">
							@icons.MapPin(templ.Attributes{"class": "w-3.5 h-3.5 text-accent"})
							Фактический адрес приёма
						</span>
						<p class="mt-1.5 text-base font-bold text-content leading-snug">
							{ content.Address }
						</p>
						if content.AddressSub != "" {
							<p class="text-xs text-content-muted mt-1">{ content.AddressSub }</p>
						}
					</div>

					<div class="border-t border-content/10 pt-4">
						<span class="text-xs font-semibold text-content-muted flex items-center gap-1.5">
							@icons.Phone(templ.Attributes{"class": "w-3.5 h-3.5 text-accent"})
							Телефоны для записи:
						</span>
						<div class="mt-2 space-y-1">
							if content.Phone1 != "" {
								<a href={ templ.URL("tel:" + content.Phone1) } class="block text-sm font-bold text-content hover:text-accent transition-colors">{ content.Phone1 }</a>
							}
							if content.Phone2 != "" {
								<a href={ templ.URL("tel:" + content.Phone2) } class="block text-xs font-medium text-content-muted hover:text-content transition-colors">{ content.Phone2 }</a>
							}
						</div>
					</div>

					<div class="border-t border-content/10 pt-4">
						<span class="text-xs font-semibold text-content-muted flex items-center gap-1.5">
							@icons.Clock(templ.Attributes{"class": "w-3.5 h-3.5 text-accent"})
							Режим работы:
						</span>
						<p class="text-xs text-content mt-1">{ content.WorkHours } (Обед: { content.LunchBreak })</p>
						if content.DaysOff != "" {
							<p class="text-xs text-content-muted mt-0.5">{ content.DaysOff }</p>
						}
					</div>
				</div>

				<div class="pt-4 border-t border-content/10">
					@base.Button(base.ButtonProps{
						Variant: base.BtnAccent,
						Size:    base.BtnSizeSm,
						Href:    "#booking",
						Class:   "w-full font-medium justify-center",
					}) {
						@icons.Calendar(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
						Забронировать время онлайн
					}
				</div>
			</div>

			<!-- Карта (Lazy-loading через HTMX) -->
			<div class="lg:col-span-8 min-h-[420px] relative bg-surface-muted flex items-center justify-center">
				if settings.MapMode == "lazy" {
					<div
						hx-get="/api/map-frame"
						hx-trigger="revealed"
						hx-swap="outerHTML"
						class="w-full h-full min-h-[420px] flex flex-col items-center justify-center text-content-muted gap-2 p-6"
					>
						@icons.Loader2(templ.Attributes{"class": "animate-spin w-8 h-8 text-accent"})
						<span class="text-xs font-medium">Загрузка интерактивной схемы проезда...</span>
					</div>
				} else {
					<iframe
						src={ content.MapIframe }
						width="100%"
						height="100%"
						frameborder="0"
						allowfullscreen="true"
						class="w-full h-full min-h-[420px] border-0"
						title={ "Интерактивная карта — " + content.HeroTitle + " " + content.OwnerName }
					></iframe>
				}
			</div>
		</div>
	</section>
}

func getUniqueCities(branches []models.BranchItem) []string {
	seen := make(map[string]bool)
	var cities []string
	for _, b := range branches {
		if b.City != "" && !seen[b.City] {
			seen[b.City] = true
			cities = append(cities, b.City)
		}
	}
	return cities
}

templ MapFrame(iframeURL string, title string) {
	<iframe
		src={ iframeURL }
		width="100%"
		height="100%"
		frameborder="0"
		allowfullscreen="true"
		class="w-full h-full min-h-[420px] border-0"
		title={ title }
	></iframe>
}
