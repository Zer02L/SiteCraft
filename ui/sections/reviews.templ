package sections

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"
)

templ Reviews(theme string, customReviews ...[]models.ReviewItem) {
	{{
		var revList []models.ReviewItem
		if len(customReviews) > 0 && len(customReviews[0]) > 0 {
			revList = customReviews[0]
		}
		var agg models.ReviewAggregate
		if len(revList) > 0 {
			sum := 0
			for _, r := range revList {
				sum += r.Rating
			}
			agg = models.ReviewAggregate{
				TotalReviews: len(revList),
				AverageScore: float64(sum) / float64(len(revList)),
				BestRating:   5,
				WorstRating:  1,
			}
		}
	}}
	<!-- Structural section: Customer Reviews / Testimonials with Schema.org UGC -->
	<section
		id="reviews"
		class="py-16 px-4 bg-surface-muted border-t border-b border-content/10"
		itemscope
		itemtype="https://schema.org/LocalBusiness"
	>
		<meta itemprop="name" content="SiteCraft Business"/>
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-10" data-reveal>
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeAccent,
					Class:   "mb-2 uppercase tracking-wider",
				}) {
					Отзывы клиентов
				}
				<h2 class="section-title">Что говорят наши клиенты</h2>
				<p class="section-subtitle">Реальные отзывы доверителей и посетителей с независимой верификацией</p>

				<!-- Schema.org AggregateRating микроразметка -->
				if len(revList) > 0 {
					<div
						itemprop="aggregateRating"
						itemscope
						itemtype="https://schema.org/AggregateRating"
						class="mt-3 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-xs text-amber-500 font-bold"
					>
						<span class="text-amber-400">★★★★★</span>
						<span itemprop="ratingValue" class="text-content font-bold">{ fmt.Sprintf("%.1f", agg.AverageScore) }</span>
						<span class="text-content-muted font-normal">из <span itemprop="bestRating">5</span> (<span itemprop="reviewCount">{ fmt.Sprintf("%d", agg.TotalReviews) }</span> отзывов)</span>
					</div>
				}
			</div>

			if len(revList) > 0 {
				<!-- Динамические проверенные отзывы из базы (Verified UGC) -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					for _, rev := range revList {
						<div
							data-reveal
							itemprop="review"
							itemscope
							itemtype="https://schema.org/Review"
							class="card-base flex flex-col justify-between"
						>
							<div>
								<div class="flex items-center justify-between mb-3">
									<div class="text-amber-500 text-sm" itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
										<meta itemprop="ratingValue" content={ fmt.Sprintf("%d", rev.Rating) }/>
										<meta itemprop="bestRating" content="5"/>
										for i := 0; i < rev.Rating; i++ {
											<span>★</span>
										}
										for i := rev.Rating; i < 5; i++ {
											<span class="text-stone-300 dark:text-stone-700">★</span>
										}
									</div>
									if rev.OrderID != "" {
										<span class="inline-flex items-center gap-1 text-[10px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 rounded-full border border-emerald-500/20">
											<svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
											<span>Проверенный заказ</span>
										</span>
									}
								</div>
								<p class="text-content/80 text-sm italic leading-relaxed" itemprop="reviewBody">
									«{ rev.Comment }»
								</p>
							</div>
							<div class="mt-4 pt-4 border-t border-content/10 flex items-center justify-between">
								<div class="flex items-center gap-3">
									<div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs">
										{ string([]rune(rev.AuthorName)[0]) }
									</div>
									<div>
										<div class="text-xs font-bold text-content" itemprop="author" itemscope itemtype="https://schema.org/Person">
											<span itemprop="name">{ rev.AuthorName }</span>
										</div>
										if rev.OrderID != "" {
											<div class="text-[10px] text-content-muted font-mono">{ rev.OrderID }</div>
										}
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			} else if theme == "medical" {
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div data-reveal data-reveal-delay="100" class="card-base flex flex-col justify-between">
						<div>
							<div class="text-amber-500 text-sm mb-3">★★★★★</div>
							<p class="text-content/80 text-sm italic leading-relaxed">«Прекрасная клиника! Проходила УЗИ и сдавала анализы. Никаких очередей, всё точно по времени. Врач подробно объяснил каждый показатель и успокоил.»</p>
						</div>
						<div class="mt-4 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs">ЕМ</div>
							<div>
								<div class="text-xs font-bold text-content">Елена Михайлова</div>
								<div class="text-[11px] text-content-muted">Пациент отделения УЗИ</div>
							</div>
						</div>
					</div>
					<div data-reveal data-reveal-delay="200" class="card-base flex flex-col justify-between">
						<div>
							<div class="text-amber-500 text-sm mb-3">★★★★★</div>
							<p class="text-content/80 text-sm italic leading-relaxed">«Терапевт очень внимательно изучил все симптомы, назначил только нужные анализы без навязывания лишних услуг. Результаты пришли на почту в тот же вечер!»</p>
						</div>
						<div class="mt-4 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs">АС</div>
							<div>
								<div class="text-xs font-bold text-content">Алексей Смирнов</div>
								<div class="text-[11px] text-content-muted">Первичный приём</div>
							</div>
						</div>
					</div>
					<div data-reveal data-reveal-delay="300" class="card-base flex flex-col justify-between">
						<div>
							<div class="text-amber-500 text-sm mb-3">★★★★★</div>
							<p class="text-content/80 text-sm italic leading-relaxed">«Современное оборудование, чистота и вежливый персонал. Записалась через сайт за минуту, сразу перезвонили и подтвердили запись. Очень рекомендую!»</p>
						</div>
						<div class="mt-4 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs">ОВ</div>
							<div>
								<div class="text-xs font-bold text-content">Ольга Васильева</div>
								<div class="text-[11px] text-content-muted">Регулярный чекап</div>
							</div>
						</div>
					</div>
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div data-reveal data-reveal-delay="100" class="card-base flex flex-col justify-between">
						<div>
							<div class="text-amber-500 text-sm mb-3">★★★★★</div>
							<p class="text-content/80 text-sm italic leading-relaxed">«Оформляли сделку купли-продажи квартиры. Всё прошло спокойно, чётко и строго по закону. Нотариус подробно разъяснил каждый пункт договора.»</p>
						</div>
						<div class="mt-4 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs">ВГ</div>
							<div>
								<div class="text-xs font-bold text-content">Виктор Григорьев</div>
								<div class="text-[11px] text-content-muted">Удостоверение сделки</div>
							</div>
						</div>
					</div>
					<div data-reveal data-reveal-delay="200" class="card-base flex flex-col justify-between">
						<div>
							<div class="text-amber-500 text-sm mb-3">★★★★★</div>
							<p class="text-content/80 text-sm italic leading-relaxed">«Быстро заверили генеральную доверенность для юридического лица. Записались заранее онлайн, приняли ровно в назначенное время без ожидания.»</p>
						</div>
						<div class="mt-4 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs">НМ</div>
							<div>
								<div class="text-xs font-bold text-content">Наталья Мельникова</div>
								<div class="text-[11px] text-content-muted">Оформление доверенности</div>
							</div>
						</div>
					</div>
					<div data-reveal data-reveal-delay="300" class="card-base flex flex-col justify-between">
						<div>
							<div class="text-amber-500 text-sm mb-3">★★★★★</div>
							<p class="text-content/80 text-sm italic leading-relaxed">«Ведение наследственного дела прошло без стресса. Помогли оперативно запросить архивные справки и оформить свидетельство о праве на наследство.»</p>
						</div>
						<div class="mt-4 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs">АР</div>
							<div>
								<div class="text-xs font-bold text-content">Андрей Романов</div>
								<div class="text-[11px] text-content-muted">Наследственное дело</div>
							</div>
						</div>
					</div>
				</div>
			}

			<!-- Кнопка и интерактивная форма отправки отзыва (UGC) -->
			<div class="mt-12 text-center" x-data="{ openForm: false, rating: 5 }">
				<button
					type="button"
					@click="openForm = !openForm"
					class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-primary/30 text-primary hover:bg-primary/5 text-xs font-bold transition-all shadow-xs cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
					<span x-text="openForm ? 'Скрыть форму отзыва' : 'Оставить отзыв о сотрудничестве'"></span>
				</button>

				<!-- Разворачиваемая форма отзыва -->
				<div
					x-show="openForm"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 -translate-y-2"
					x-transition:enter-end="opacity-100 translate-y-0"
					class="max-w-lg mx-auto mt-6 card-base p-6 text-left"
				>
					<h3 class="text-sm font-bold text-content mb-1">Поделитесь вашим впечатлением</h3>
					<p class="text-xs text-content-muted mb-4">Ваш отзыв будет проверен и поможет нам стать лучше.</p>

					<form
						hx-post="/api/reviews"
						hx-target="#review-submit-response"
						hx-swap="innerHTML"
						@htmx:after-request="if ($event.detail.successful) { $el.reset(); }"
						class="space-y-4"
					>
						<!-- Honeypot -->
						<div class="hidden" aria-hidden="true">
							<input type="text" name="website_company_url" tabindex="-1" autocomplete="off"/>
						</div>

						<!-- Выбор звезд (1-5) -->
						<div>
							<label class="form-label">Ваша оценка *</label>
							<div class="flex items-center gap-1.5 mt-1">
								<input type="hidden" name="rating" :value="rating"/>
								<template x-for="star in [1, 2, 3, 4, 5]" :key="star">
									<button
										type="button"
										@click="rating = star"
										class="text-xl transition-transform hover:scale-110 focus:outline-none cursor-pointer"
										:class="star <= rating ? 'text-amber-400' : 'text-stone-300 dark:text-stone-600'"
									>
										★
									</button>
								</template>
								<span class="text-xs text-content-muted ml-2 font-medium" x-text="rating + ' из 5'"></span>
							</div>
						</div>

						<div>
							<label class="form-label">Ваше имя *</label>
							<input
								type="text"
								name="author_name"
								required
								minlength="2"
								placeholder="Иван Петров"
								class="form-input"
							/>
						</div>

						<div>
							<label class="form-label">Номер заказа / договора (для проверенного бейджа)</label>
							<input
								type="text"
								name="order_id"
								placeholder="Например: SRV-4182 или номер договора"
								class="form-input font-mono uppercase"
							/>
						</div>

						<div>
							<label class="form-label">Ваш отзыв *</label>
							<textarea
								name="comment"
								required
								minlength="5"
								rows="3"
								placeholder="Опишите, что вам понравилось в работе специалистов..."
								class="form-input"
							></textarea>
						</div>

						@base.Button(base.ButtonProps{
							Type:    "submit",
							Variant: base.BtnPrimary,
							Size:    base.BtnSizeSm,
							Class:   "w-full font-bold shadow-xs",
						}) {
							<span>Отправить отзыв на модерацию</span>
						}
					</form>
					<div id="review-submit-response" class="mt-4"></div>
				</div>
			</div>
		</div>
	</section>
}
