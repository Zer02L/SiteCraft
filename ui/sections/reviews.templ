package sections

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"
)

templ Reviews(theme string, customReviews ...[]models.ReviewItem) {
	{{
		var revList []models.ReviewItem
		if len(customReviews) > 0 && len(customReviews[0]) > 0 {
			revList = customReviews[0]
		}
		var agg models.ReviewAggregate
		if len(revList) > 0 {
			sum := 0
			for _, r := range revList {
				sum += r.Rating
			}
			agg = models.ReviewAggregate{
				TotalReviews: len(revList),
				AverageScore: float64(sum) / float64(len(revList)),
				BestRating:   5,
				WorstRating:  1,
			}
		}
	}}
	<!-- Hallmark Editorial Testimonials (Strict Aesthetic Mode) -->
	<section
		id="reviews"
		data-component="hallmark-reviews"
		data-source="ui/sections/reviews.templ"
		class="py-16 md:py-20 px-6 sm:px-10 bg-surface-muted/40 border-b border-content/10"
		itemscope
		itemtype="https://schema.org/LocalBusiness"
	>
		<meta itemprop="name" content="SiteCraft Business"/>
		<div class="max-w-6xl mx-auto">
			<!-- Заголовок секции (Floor 54: без плашек) -->
			<div class="mb-12 text-left" data-reveal>
				<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
					Отзывы и практика взаимодействия
				</h2>
				<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
					Верифицированные отзывы доверителей по результатам совершённых нотариальных действий и правовых консультаций.
				</p>

				<!-- Schema.org AggregateRating (минималистичный сводный показатель) -->
				if len(revList) > 0 {
					<div
						itemprop="aggregateRating"
						itemscope
						itemtype="https://schema.org/AggregateRating"
						class="mt-4 flex items-center gap-3 text-xs text-content-muted"
					>
						<span class="text-accent text-sm">★★★★★</span>
						<span class="text-content font-bold"><span itemprop="ratingValue">{ fmt.Sprintf("%.1f", agg.AverageScore) }</span> из <span itemprop="bestRating">5</span></span>
						<span class="text-content-muted">• (<span itemprop="reviewCount">{ fmt.Sprintf("%d", agg.TotalReviews) }</span> подтверждённых отзывов)</span>
					</div>
				}
			</div>

			if len(revList) > 0 {
				<!-- Динамические отзывы (Floor 11: архитектурная сетка с тонкими hairlines) -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					for _, rev := range revList {
						<div
							data-reveal
							itemprop="review"
							itemscope
							itemtype="https://schema.org/Review"
							class="p-6 bg-surface border border-content/10 flex flex-col justify-between"
						>
							<div class="space-y-3">
								<div class="flex items-center justify-between text-xs">
									<div class="text-accent text-xs" itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
										<meta itemprop="ratingValue" content={ fmt.Sprintf("%d", rev.Rating) }/>
										<meta itemprop="bestRating" content="5"/>
										for i := 0; i < rev.Rating; i++ {
											<span>★</span>
										}
										for i := rev.Rating; i < 5; i++ {
											<span class="text-content/20">★</span>
										}
									</div>
									if rev.OrderID != "" {
										<span class="text-[11px] text-content-muted font-mono">{ rev.OrderID }</span>
									}
								</div>
								<p class="text-content text-xs sm:text-sm leading-relaxed" itemprop="reviewBody">
									«{ rev.Comment }»
								</p>
							</div>

							<div class="mt-6 pt-4 border-t border-content/10 flex items-center gap-3">
								<div class="w-8 h-8 bg-surface-muted border border-content/10 text-content font-bold flex items-center justify-center text-xs shrink-0">
									{ string([]rune(rev.AuthorName)[0]) }
								</div>
								<div class="text-xs">
									<div class="font-bold text-content" itemprop="author" itemscope itemtype="https://schema.org/Person">
										<span itemprop="name">{ rev.AuthorName }</span>
									</div>
									<div class="text-content-muted text-[11px]">Удостоверенное действие</div>
								</div>
							</div>
						</div>
					}
				</div>
			} else {
				<!-- Fallback отзывы (Default / Legal / Swiss) -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div data-reveal data-reveal-delay="100" class="p-6 bg-surface border border-content/10 flex flex-col justify-between">
						<div class="space-y-3">
							<div class="text-accent text-xs">★★★★★</div>
							<p class="text-content text-xs sm:text-sm leading-relaxed">
								«Оформляли сделку купли-продажи коммерческой недвижимости. Всё прошло спокойно, чётко и строго по регламенту. Нотариус подробно разъяснил каждый пункт договора.»
							</p>
						</div>
						<div class="mt-6 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-8 h-8 bg-surface-muted border border-content/10 text-content font-bold flex items-center justify-center text-xs">ВГ</div>
							<div class="text-xs">
								<div class="font-bold text-content">Виктор Григорьев</div>
								<div class="text-content-muted text-[11px]">Удостоверение сделки</div>
							</div>
						</div>
					</div>
					<div data-reveal data-reveal-delay="200" class="p-6 bg-surface border border-content/10 flex flex-col justify-between">
						<div class="space-y-3">
							<div class="text-accent text-xs">★★★★★</div>
							<p class="text-content text-xs sm:text-sm leading-relaxed">
								«Быстро заверили генеральную доверенность для юридического лица. Записались заранее онлайн, приняли ровно в назначенное время без малейшего ожидания.»
							</p>
						</div>
						<div class="mt-6 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-8 h-8 bg-surface-muted border border-content/10 text-content font-bold flex items-center justify-center text-xs">НМ</div>
							<div class="text-xs">
								<div class="font-bold text-content">Наталья Мельникова</div>
								<div class="text-content-muted text-[11px]">Оформление полномочий</div>
							</div>
						</div>
					</div>
					<div data-reveal data-reveal-delay="300" class="p-6 bg-surface border border-content/10 flex flex-col justify-between">
						<div class="space-y-3">
							<div class="text-accent text-xs">★★★★★</div>
							<p class="text-content text-xs sm:text-sm leading-relaxed">
								«Ведение наследственного дела прошло организованно. Помогли оперативно запросить архивные справки и выдать свидетельство о праве на наследство.»
							</p>
						</div>
						<div class="mt-6 pt-4 border-t border-content/10 flex items-center gap-3">
							<div class="w-8 h-8 bg-surface-muted border border-content/10 text-content font-bold flex items-center justify-center text-xs">АР</div>
							<div class="text-xs">
								<div class="font-bold text-content">Андрей Романов</div>
								<div class="text-content-muted text-[11px]">Наследственное дело</div>
							</div>
						</div>
					</div>
				</div>
			}

			<!-- Форма отправки отзыва (UGC) сдержанного архитектурного стиля -->
			<div class="mt-12 text-center" x-data="{ openForm: false, rating: 5 }">
				<button
					type="button"
					@click="openForm = !openForm"
					class="px-5 py-2.5 border border-content/20 text-content hover:bg-surface text-xs font-medium transition cursor-pointer"
				>
					<span x-text="openForm ? 'Скрыть форму отзыва' : 'Оставить отзыв о приёме'"></span>
				</button>

				<div
					x-show="openForm"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 -translate-y-2"
					x-transition:enter-end="opacity-100 translate-y-0"
					class="max-w-lg mx-auto mt-6 bg-surface p-6 text-left border border-content/10"
				>
					<h3 class="text-sm font-bold text-content mb-1">Ваш отзыв о сотрудничестве</h3>
					<p class="text-xs text-content-muted mb-4">Отзыв будет опубликован после верификации нотариального действия.</p>

					<form
						hx-post="/api/reviews"
						hx-target="#review-submit-response"
						hx-swap="innerHTML"
						@htmx:after-request="if ($event.detail.successful) { $el.reset(); }"
						class="space-y-4"
					>
						<div class="hidden" aria-hidden="true">
							<input type="text" name="website_company_url" tabindex="-1" autocomplete="off"/>
						</div>

						<div>
							<label class="form-label text-xs font-medium text-content">Оценка взаимодействия *</label>
							<div class="flex items-center gap-1.5 mt-1">
								<input type="hidden" name="rating" :value="rating"/>
								<template x-for="star in [1, 2, 3, 4, 5]" :key="star">
									<button
										type="button"
										@click="rating = star"
										class="text-lg transition focus:outline-none cursor-pointer"
										:class="star <= rating ? 'text-accent' : 'text-content/20'"
									>
										★
									</button>
								</template>
								<span class="text-xs text-content-muted ml-2 font-medium" x-text="rating + ' из 5'"></span>
							</div>
						</div>

						<div>
							<label class="form-label text-xs font-medium text-content">Ваше имя *</label>
							<input
								type="text"
								name="author_name"
								required
								minlength="2"
								placeholder="Иван Петров"
								class="form-input text-xs"
							/>
						</div>

						<div>
							<label class="form-label text-xs font-medium text-content">Номер реестровой записи или договора</label>
							<input
								type="text"
								name="order_id"
								placeholder="Например: 77/14-н/77-2026"
								class="form-input text-xs font-mono"
							/>
						</div>

						<div>
							<label class="form-label text-xs font-medium text-content">Текст отзыва *</label>
							<textarea
								name="comment"
								required
								minlength="5"
								rows="3"
								placeholder="Опишите ваши впечатления от качества и регламента приёма..."
								class="form-input text-xs"
							></textarea>
						</div>

						@base.Button(base.ButtonProps{
							Type:    "submit",
							Variant: base.BtnPrimary,
							Size:    base.BtnSizeSm,
							Class:   "w-full font-medium",
						}) {
							<span>Отправить отзыв</span>
						}
					</form>
					<div id="review-submit-response" class="mt-4 text-xs"></div>
				</div>
			</div>
		</div>
	</section>
}
