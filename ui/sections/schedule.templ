package sections

import (
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"

	icons "sitecraft/ui/components/icons"
)

templ ScheduleBar(content models.SiteContent) {
	<!-- Hallmark Architectural Schedule Band (Strict Aesthetic Mode) -->
	<section
		id="schedule"
		data-component="hallmark-schedule"
		data-source="ui/sections/schedule.templ"
		class="bg-surface border-b border-content/10 py-10 px-6 sm:px-10"
	>
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-content/10">
			<!-- Часы приёма -->
			<div data-reveal data-reveal-delay="100" class="py-4 md:py-0 md:px-8 first:md:pl-0 flex items-start gap-4">
				<div class="p-2.5 bg-surface-muted text-content shrink-0 border border-content/10">
					@icons.Clock(templ.Attributes{"class": "w-5 h-5 text-accent"})
				</div>
				<div class="space-y-1">
					<h4 class="font-bold text-content text-sm">{ i18n.T(ctx, "schedule.hours_title") }</h4>
					<p class="text-xs text-content-muted leading-relaxed">{ content.WorkHours }</p>
					if content.LunchBreak != "" {
						<p class="text-xs text-content-muted">
							{ i18n.T(ctx, "schedule.lunch_title") } <span class="font-medium text-content">{ content.LunchBreak }</span>
						</p>
					}
					if content.DaysOff != "" {
						<p class="text-xs text-content-muted">{ content.DaysOff }</p>
					}
				</div>
			</div>

			<!-- Телефоны -->
			<div data-reveal data-reveal-delay="200" class="py-4 md:py-0 md:px-8 flex items-start gap-4">
				<div class="p-2.5 bg-surface-muted text-content shrink-0 border border-content/10">
					@icons.PhoneCall(templ.Attributes{"class": "w-5 h-5 text-accent"})
				</div>
				<div class="space-y-1">
					<h4 class="font-bold text-content text-sm">{ i18n.T(ctx, "schedule.phones_title") }</h4>
					<div class="space-y-0.5">
						if content.Phone1 != "" {
							<a href={ templ.URL("tel:" + content.Phone1) } class="block text-sm font-semibold text-content hover:text-accent transition-colors">
								{ content.Phone1 }
							</a>
						}
						if content.Phone2 != "" {
							<a href={ templ.URL("tel:" + content.Phone2) } class="block text-xs text-content-muted hover:text-content transition-colors">
								{ content.Phone2 }
							</a>
						}
					</div>
					<p class="text-xs text-content-muted">{ i18n.T(ctx, "schedule.phones_sub") }</p>
				</div>
			</div>

			<!-- Порядок приёма -->
			<div data-reveal data-reveal-delay="300" class="py-4 md:py-0 md:px-8 last:md:pr-0 flex items-start gap-4">
				<div class="p-2.5 bg-surface-muted text-content shrink-0 border border-content/10">
					@icons.ShieldCheck(templ.Attributes{"class": "w-5 h-5 text-accent"})
				</div>
				<div class="space-y-1">
					<h4 class="font-bold text-content text-sm">{ i18n.T(ctx, "schedule.admission_title") }</h4>
					<p class="text-xs text-content-muted leading-relaxed">{ i18n.T(ctx, "schedule.admission_desc") }</p>
					<a href="#booking" class="text-xs font-semibold text-accent hover:underline inline-block pt-1">
						{ i18n.T(ctx, "schedule.choose_time") }
					</a>
				</div>
			</div>
		</div>
	</section>
}
