package sections

import (
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ ScheduleBar(content models.SiteContent) {
	<!-- Info Bar (График работы) -->
	<section id="schedule" class="bg-surface border-b border-content/10 py-8 px-4 shadow-sm">
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
			<!-- Часы работы -->
			<div data-reveal data-reveal-delay="100" class="flex items-start gap-4 p-4 rounded-xl bg-surface-muted border border-content/10 hover:border-accent/40 hover:-translate-y-0.5 hover:shadow-md transition duration-300">
				<div class="p-3 bg-primary/10 text-primary rounded-lg shrink-0">
					@icons.Clock(templ.Attributes{"class": "w-6 h-6"})
				</div>
				<div>
					<h4 class="font-bold text-content text-sm">{ i18n.T(ctx, "schedule.hours_title") }</h4>
					<p class="text-xs text-content-muted mt-1 font-medium">{ content.WorkHours }</p>
					<p class="text-xs text-content-muted">{ i18n.T(ctx, "schedule.lunch_title") } <span class="font-semibold text-amber-700">{ content.LunchBreak }</span></p>
					<p class="text-xs text-content-muted mt-0.5">{ content.DaysOff }</p>
				</div>
			</div>

			<!-- Телефоны -->
			<div data-reveal data-reveal-delay="200" class="flex items-start gap-4 p-4 rounded-xl bg-surface-muted border border-content/10 hover:border-accent/40 hover:-translate-y-0.5 hover:shadow-md transition duration-300">
				<div class="p-3 bg-primary/10 text-primary rounded-lg shrink-0">
					@icons.PhoneCall(templ.Attributes{"class": "w-6 h-6"})
				</div>
				<div>
					<h4 class="font-bold text-content text-sm">{ i18n.T(ctx, "schedule.phones_title") }</h4>
					<div class="mt-1 space-y-0.5">
						if content.Phone1 != "" {
							<a href={ templ.URL("tel:" + content.Phone1) } class="block text-sm font-bold text-primary hover:underline">{ content.Phone1 }</a>
						}
						if content.Phone2 != "" {
							<a href={ templ.URL("tel:" + content.Phone2) } class="block text-sm font-semibold text-content/80 hover:underline">{ content.Phone2 }</a>
						}
					</div>
					<p class="text-xs text-content-muted mt-0.5">{ i18n.T(ctx, "schedule.phones_sub") }</p>
				</div>
			</div>

			<!-- Порядок приёма -->
			<div data-reveal data-reveal-delay="300" class="flex items-start gap-4 p-4 rounded-xl bg-surface-muted border border-content/10 hover:border-accent/40 hover:-translate-y-0.5 hover:shadow-md transition duration-300">
				<div class="p-3 bg-primary/10 text-primary rounded-lg shrink-0">
					@icons.ShieldCheck(templ.Attributes{"class": "w-6 h-6"})
				</div>
				<div>
					<h4 class="font-bold text-content text-sm">{ i18n.T(ctx, "schedule.admission_title") }</h4>
					<p class="text-xs text-content-muted mt-1">{ i18n.T(ctx, "schedule.admission_desc") }</p>
					<a href="#booking" class="text-xs font-semibold text-primary hover:underline inline-block mt-1">{ i18n.T(ctx, "schedule.choose_time") }</a>
				</div>
			</div>

		</div>
	</section>
}
