package sections

import (
	"fmt"
	"sitecraft/internal/models"

	icons "sitecraft/ui/components/icons"
)

templ Faq(theme string, payload *models.FAQPayload) {
	<!-- Hallmark Architectural Hairline Accordion / FAQ (Strict Aesthetic Mode) -->
	<section
		id="faq"
		data-component="hallmark-faq"
		data-source="ui/sections/faq.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-4xl mx-auto border-b border-content/10"
	>
		if payload != nil && len(payload.Items) > 0 {
			<!-- Режим 1: Data-Driven из JSON Payload (Floor 54: без плашек над заголовком) -->
			<div class="mb-12 text-left" data-reveal>
				<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
					if payload.Title != "" {
						{ payload.Title }
					} else {
						Вопросы и регламент взаимодействия
					}
				</h2>
				if payload.Subtitle != "" {
					<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">{ payload.Subtitle }</p>
				}
			</div>

			<!-- Flat Hairline Accordion (Floor 11: divide-y вместо вложенных карточек) -->
			<div class="divide-y divide-content/10 border-t border-b border-content/10">
				for idx, item := range payload.Items {
					<details data-reveal data-reveal-delay={ fmt.Sprintf("%d", (idx%4)*80) } class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>{ item.Question }</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							{ item.Answer }
						</p>
					</details>
				}
			</div>
		} else {
			<!-- Режим 2: Встроенный архитектурный fallback (Floor 54 / Floor 67: без плашек и капслока) -->
			<div class="mb-12 text-left" data-reveal>
				<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
					Вопросы и регламент взаимодействия
				</h2>
				<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
					Разъяснения нотариального регламента, перечня документов и порядка совершения действий.
				</p>
			</div>

			if theme == "medical" {
				<div class="divide-y divide-content/10 border-t border-b border-content/10">
					<details data-reveal class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Нужно ли готовиться к сдаче анализов крови?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Большинство биохимических анализов сдаются строго натощак (8–12 часов после приёма пищи). Разрешается пить чистую негазированную воду.
						</p>
					</details>
					<details data-reveal data-reveal-delay="100" class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Как быстро приходят результаты УЗИ и обследований?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Протокол ультразвукового исследования и снимки экспертного класса выдаются врачом сразу же после завершения процедуры в течение 10–15 минут.
						</p>
					</details>
					<details data-reveal data-reveal-delay="200" class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Принимают ли врачи по полису ОМС или ДМС?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Мы сотрудничаем с большинством страховых компаний по программам ДМС. Для согласования визита обратитесь к куратору вашей страховой компании.
						</p>
					</details>
				</div>
			} else if theme == "auto" {
				<div class="divide-y divide-content/10 border-t border-b border-content/10">
					<details data-reveal class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Сколько времени занимает комплексная диагностика?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Полная компьютерная диагностика сканером и осмотр ходовой части на подъёмнике занимают от 40 до 60 минут с выдачей подробного диагностического листа.
						</p>
					</details>
					<details data-reveal data-reveal-delay="100" class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Можно ли привезти свои запчасти и моторное масло?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Да, вы можете привезти собственные расходные материалы. Письменная гарантия сервиса в таком случае распространяется на качество проведённых монтажных работ.
						</p>
					</details>
					<details data-reveal data-reveal-delay="200" class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Предоставляется ли письменная гарантия на ремонт?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Да, мы предоставляем официальную гарантию 12 месяцев (или 20 000 км пробега) на слесарные работы и сертифицированные комплектующие.
						</p>
					</details>
				</div>
			} else {
				<!-- Default / Legal / Swiss -->
				<div class="divide-y divide-content/10 border-t border-b border-content/10">
					<details data-reveal class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Какие документы необходимы для оформления доверенности?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Оригинал паспорта гражданина РФ доверителя и полные паспортные данные поверенного лица. При удостоверении полномочий на транспортное средство — ПТС или СТС.
						</p>
					</details>
					<details data-reveal data-reveal-delay="100" class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Какой срок установлен для открытия наследственного дела?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Заявление о принятии наследства подаётся нотариусу в течение 6 месяцев со дня открытия наследства (дня смерти наследодателя).
						</p>
					</details>
					<details data-reveal data-reveal-delay="200" class="group py-5 text-content">
						<summary class="flex justify-between items-center font-bold text-content text-sm sm:text-base cursor-pointer list-none select-none">
							<span>Можно ли направить проекты документов предварительно онлайн?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4"})
						</summary>
						<p class="mt-3 text-xs sm:text-sm text-content-muted leading-relaxed max-w-3xl">
							Да, сканы и проекты документов можно заблаговременно отправить по защищённому каналу связи для предварительной правовой экспертизы до личного визита.
						</p>
					</details>
				</div>
			}
		}
	</section>
}
