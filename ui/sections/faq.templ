package sections

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

templ Faq(theme string, payload *models.FAQPayload) {
	<!-- Structural section: FAQ / Accordion Section (Zero-JS using native <details>, Data-driven or fallback) -->
	<section id="faq" class="py-16 px-4 max-w-4xl mx-auto">
		if payload != nil && len(payload.Items) > 0 {
			<!-- Режим 1: Полностью Data-Driven из JSON Payload -->
			<div class="text-center mb-12" data-reveal>
				if payload.Badge != "" {
					<div class="inline-flex justify-center mb-3">
						@base.Badge(base.BadgeProps{
							Variant: base.BadgeAccent,
							Class:   "text-xs font-bold uppercase tracking-wider py-1 px-3",
						}) {
							{ payload.Badge }
						}
					</div>
				}
				<h2 class="section-title">
					if payload.Title != "" {
						{ payload.Title }
					} else {
						Часто задаваемые вопросы
					}
				</h2>
				if payload.Subtitle != "" {
					<p class="section-subtitle">{ payload.Subtitle }</p>
				}
			</div>

			<div class="space-y-4">
				for idx, item := range payload.Items {
					<details data-reveal data-reveal-delay={ fmt.Sprintf("%d", (idx%4)*100) } class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>{ item.Question }</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							{ item.Answer }
						</p>
					</details>
				}
			</div>
		} else {
			<!-- Режим 2: Встроенный fallback по темам -->
			<div class="text-center mb-12" data-reveal>
				<div class="section-badge">Вопрос — Ответ</div>
				<h2 class="section-title">Часто задаваемые вопросы</h2>
				<p class="section-subtitle">Собрали ответы на самые популярные вопросы наших клиентов</p>
			</div>

			if theme == "medical" {
				<div class="space-y-4">
					<details data-reveal class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Нужно ли готовиться к сдаче анализов крови?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Большинство биохимических анализов и исследований крови сдаются строго натощак (8-12 часов после приема пищи). Разрешается пить чистую негазированную воду. За сутки исключите жирную пищу и алкоголь.
						</p>
					</details>
					<details data-reveal data-reveal-delay="100" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Как быстро приходят результаты УЗИ и обследований?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Протокол ультразвукового исследования и снимки экспертного класса выдаются врачом сразу же после завершения процедуры (в течение 10–15 минут).
						</p>
					</details>
					<details data-reveal data-reveal-delay="200" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Принимают ли врачи по полису ОМС или ДМС?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Мы сотрудничаем с большинством страховых компаний по программам ДМС. Для согласования визита по ДМС обратитесь к куратору вашей страховой компании перед приёмом.
						</p>
					</details>
				</div>
			} else if theme == "auto" {
				<div class="space-y-4">
					<details data-reveal class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Сколько времени занимает комплексная диагностика?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Полная компьютерная диагностика сканером и осмотр ходовой части на подъемнике занимают от 40 до 60 минут. Вы получите подробный диагностический лист с рекомендациями.
						</p>
					</details>
					<details data-reveal data-reveal-delay="100" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Можно ли привезти свои запчасти и моторное масло?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Да, вы можете привезти собственные расходные материалы. При этом гарантия автосервиса будет распространяться на качество выполненных монтажных работ.
						</p>
					</details>
					<details data-reveal data-reveal-delay="200" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Есть ли гарантия на выполненный ремонт?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Да, мы предоставляем письменную гарантию 12 месяцев (или 20 000 км пробега) на слесарные работы и установленные оригинальные комплектующие.
						</p>
					</details>
				</div>
			} else if theme == "beauty" {
				<div class="space-y-4">
					<details data-reveal class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>За сколько дней необходимо записываться к топ-стилистам?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							К ведущим мастерам рекомендуем записываться за 3–5 дней. Однако мы всегда оставляем горячие «окна» день-в-день — уточняйте у администратора.
						</p>
					</details>
					<details data-reveal data-reveal-delay="100" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Как проводится стерилизация инструментов?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							В 4 этапа: ультразвуковая дезинфекция, предстерилизационная очистка, сушка и стерилизация в сухожаровом шкафу ГП-20. Индивидуальный крафт-пакет вскрывается строго при вас.
						</p>
					</details>
					<details data-reveal data-reveal-delay="200" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Какую косметику и красители вы используете?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Мы работаем только на оригинальной премиальной продукции L'Oreal Professionnel, Davines (Италия) и Lebel (Япония) с сертификатами подлинности.
						</p>
					</details>
				</div>
			} else {
				<div class="space-y-4">
					<details data-reveal class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Какие документы необходимы для оформления доверенности?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Оригинал паспорта гражданина РФ доверителя, полные паспортные данные поверенного лица (копия или четкое фото паспорта). При автодоверенности — ПТС или СТС.
						</p>
					</details>
					<details data-reveal data-reveal-delay="100" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Какой срок для открытия наследственного дела?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Заявление о принятии наследства должно быть подано нотариусу в течение 6 месяцев со дня открытия наследства (дня смерти наследодателя).
						</p>
					</details>
					<details data-reveal data-reveal-delay="200" class="group bg-surface rounded-card-sm border border-content/10 text-content p-5 open:shadow-md transition">
						<summary class="flex justify-between items-center font-bold text-content text-sm cursor-pointer list-none select-none">
							<span>Можно ли подать документы удаленно или направить представителя?</span>
							@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4 text-accent group-open:rotate-180 transition-transform duration-200 shrink-0"})
						</summary>
						<p class="mt-3 text-xs text-content-muted leading-relaxed pt-2 border-t border-content/10">
							Проекты документов можно выслать предварительно на электронную почту для проверки. Непосредственное удостоверение требует личного присутствия либо совершения действия через единую систему удаленных действий.
						</p>
					</details>
				</div>
			}
		}
	</section>
}
