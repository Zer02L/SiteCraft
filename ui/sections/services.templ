package sections

import (
	"fmt"
	"sitecraft/internal/models"

	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ Services(services []models.ServiceItem, settings models.SiteSettings) {
	<!-- Services Section -->
	<section id="services" class="py-16 px-4 max-w-6xl mx-auto">
		<div class="text-center mb-12" data-reveal>
			@badge.Badge(badge.Props{
				Variant: badge.VariantSecondary,
				Class:   "section-badge mb-3",
			}) {
				Направления
			}
			<h2 class="section-title">Услуги и стоимость</h2>
			<p class="section-subtitle">Профессиональный подход, прозрачные цены и фиксированные сроки выполнения работ</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			for idx, s := range services {
				<div
					data-reveal
					data-reveal-delay={ fmt.Sprintf("%d", ((idx % 3) + 1) * 100) }
					class="card-interactive flex flex-col justify-between hover:scale-[1.01]"
				>
					<div>
						<div class="w-8 h-8 rounded-lg bg-accent/15 text-accent flex items-center justify-center mb-3">
							@icons.Sparkles(templ.Attributes{"class": "w-4 h-4"})
						</div>
						<h3 class="card-title mb-2">{ s.Title }</h3>
						<p class="card-desc mb-4">{ s.Description }</p>
					</div>
					<div class="pt-4 border-t border-content/10 flex items-center justify-between">
						<div>
							<span class="text-xs text-content-muted block">Стоимость:</span>
							<span class="font-bold text-accent text-sm">{ s.Price }</span>
						</div>
						if settings.EnablePayment {
							@button.Button(button.Props{
								Variant: button.VariantSecondary,
								Size:    button.SizeSm,
								Attributes: templ.Attributes{
									"hx-get":    "/api/payment/modal?service_id" + "=" + s.ID,
									"hx-target": "#payment-modal-container",
									"hx-swap":   "innerHTML transition:true",
								},
								Class: "text-primary hover:bg-primary hover:text-white transition gap-1 font-semibold",
							}) {
								@icons.CreditCard(templ.Attributes{"class": "w-3.5 h-3.5 mr-1"})
								Оплатить онлайн
							}
						}
					</div>
				</div>
			}
		</div>
		<div id="payment-modal-container"></div>
	</section>
}

