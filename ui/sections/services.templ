package sections

import (
	"fmt"
	"strconv"
	"strings"
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

func parsePriceNumber(raw string) float64 {
	digits := strings.Map(func(r rune) rune {
		if r >= '0' && r <= '9' {
			return r
		}
		return -1
	}, raw)
	val, err := strconv.ParseFloat(digits, 64)
	if err != nil {
		return 0
	}
	return val
}

templ Services(services []models.ServiceItem, settings models.SiteSettings) {
	<!-- Services Section -->
	<section id="services" class="py-16 px-4 max-w-6xl mx-auto">
		<div class="text-center mb-12" data-reveal>
			@base.Badge(base.BadgeProps{
				Variant: base.BadgeAccent,
				Class:   "mb-3 uppercase tracking-wider text-xs px-3 py-1",
			}) {
				{ i18n.T(ctx, "services.badge") }
			}
			<h2 class="section-title">{ i18n.T(ctx, "services.title") }</h2>
			<p class="section-subtitle">{ i18n.T(ctx, "services.subtitle") }</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			for idx, s := range services {
				@base.Card(base.CardProps{
					Variant: base.CardInteractive,
					Class:   "flex flex-col justify-between hover:scale-[1.01]",
					Attrs: templ.Attributes{
						"data-reveal":       "",
						"data-reveal-delay": fmt.Sprintf("%d", ((idx % 3) + 1) * 100),
					},
				}) {
					<div>
						<div class="flex items-center justify-between mb-3">
							<div class="w-8 h-8 rounded-lg bg-accent/15 text-accent flex items-center justify-center">
								@icons.Sparkles(templ.Attributes{"class": "w-4 h-4"})
							</div>
							if s.StockCount == 0 || s.IsPreorder {
								<span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-500/10 text-amber-500 border border-amber-500/20 font-bold">Под заказ</span>
							} else if s.StockCount > 0 && s.StockCount <= 5 {
								<span class="px-2 py-0.5 rounded-full text-[10px] bg-rose-500/10 text-rose-500 border border-rose-500/20 font-bold">Осталось { fmt.Sprintf("%d", s.StockCount) } шт</span>
							}
						</div>
						@base.CardTitle("mb-2") {
							{ s.Title }
						}
						@base.CardDescription("mb-4") {
							{ s.Description }
						}
					</div>
					<div class="pt-4 border-t border-content/10 flex items-center justify-between">
						<div>
							<span class="text-xs text-content-muted block">{ i18n.T(ctx, "services.cost_label") }</span>
							<span class="font-bold text-accent text-sm">{ s.Price }</span>
						</div>
						<div class="flex items-center gap-2">
							if settings.EnableCart {
								@base.Button(base.ButtonProps{
									Variant: base.BtnAccent,
									Size:    base.BtnSizeSm,
									Class:   "gap-1 font-bold",
									Attrs: templ.Attributes{
										"type":        "button",
										"x-on:click":  fmt.Sprintf("$store.cart.add({ id: '%s', title: '%s', price: %f, price_str: '%s' })", s.ID, s.Title, parsePriceNumber(s.Price), s.Price),
										"title":       "Добавить в корзину",
									},
								}) {
									@icons.Plus(templ.Attributes{"class": "w-3.5 h-3.5"})
									if s.StockCount == 0 || s.IsPreorder {
										<span>Предзаказ</span>
									} else {
										<span>В корзину</span>
									}
								}
							}
							if settings.EnablePayment {
								@base.Button(base.ButtonProps{
									Variant: base.BtnSecondary,
									Size:    base.BtnSizeSm,
									Class:   "gap-1 font-semibold",
									Attrs: templ.Attributes{
										"hx-get":    "/api/payment/modal?service_id=" + s.ID,
										"hx-target": "#payment-modal-container",
										"hx-swap":   "innerHTML transition:true",
									},
								}) {
									@icons.CreditCard(templ.Attributes{"class": "w-3.5 h-3.5 mr-1"})
									{ i18n.T(ctx, "services.pay_online") }
								}
							}
						</div>
					</div>
				}
			}
		</div>
		<div id="payment-modal-container"></div>
	</section>
}

