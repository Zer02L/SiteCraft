package sections

import (
	"fmt"
	"strconv"
	"strings"
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

func parsePriceNumber(raw string) float64 {
	digits := strings.Map(func(r rune) rune {
		if r >= '0' && r <= '9' {
			return r
		}
		return -1
	}, raw)
	val, err := strconv.ParseFloat(digits, 64)
	if err != nil {
		return 0
	}
	return val
}

templ Services(services []models.ServiceItem, settings models.SiteSettings) {
	<!-- Hallmark Architectural Services Registry (Strict Aesthetic Mode) -->
	<section
		id="services"
		data-component="hallmark-services"
		data-source="ui/sections/services.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-6xl mx-auto border-b border-content/10"
	>
		<!-- Заголовок секции (Floor 54: без плашек) -->
		<div class="mb-12 text-left" data-reveal>
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
				{ i18n.T(ctx, "services.title") }
			</h2>
			<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
				{ i18n.T(ctx, "services.subtitle") }
			</p>
		</div>

		<!-- Архитектурный реестр услуг (Hallmark 05-rows: divide-y с тонкими hairlines) -->
		<div class="divide-y divide-content/10 border-t border-b border-content/10">
			for idx, s := range services {
				<div
					data-reveal
					data-reveal-delay={ fmt.Sprintf("%d", ((idx % 3) + 1) * 80) }
					class="py-6 sm:py-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6 hover:bg-surface-muted/40 transition-colors px-2 -mx-2"
				>
					<div class="space-y-2 lg:max-w-2xl">
						<div class="flex items-center gap-3">
							<span class="text-xs font-mono text-content-muted">{ fmt.Sprintf("%02d", idx+1) }</span>
							<h3 class="text-base sm:text-lg font-bold text-content">{ s.Title }</h3>
						</div>
						if s.Description != "" {
							<p class="text-xs sm:text-sm text-content-muted leading-relaxed pl-7">{ s.Description }</p>
						}
					</div>

					<div class="flex items-center justify-between lg:justify-end gap-6 pl-7 lg:pl-0 shrink-0">
						<div class="text-left lg:text-right">
							<span class="text-[11px] text-content-muted block">{ i18n.T(ctx, "services.cost_label") }</span>
							<span class="text-sm sm:text-base font-bold text-content">{ s.Price }</span>
						</div>

						<div class="flex items-center gap-3">
							if settings.EnableCart {
								@base.Button(base.ButtonProps{
									Variant: base.BtnAccent,
									Size:    base.BtnSizeSm,
									Class:   "font-medium gap-1.5",
									Attrs: templ.Attributes{
										"type":        "button",
										"x-on:click":  fmt.Sprintf("$store.cart.add({ id: '%s', title: '%s', price: %f, price_str: '%s' })", s.ID, s.Title, parsePriceNumber(s.Price), s.Price),
										"title":       "Выбрать услугу",
									},
								}) {
									@icons.Plus(templ.Attributes{"class": "w-3.5 h-3.5"})
									<span>Выбрать</span>
								}
							}
							if settings.EnablePayment {
								@base.Button(base.ButtonProps{
									Variant: base.BtnOutline,
									Size:    base.BtnSizeSm,
									Class:   "font-medium",
									Attrs: templ.Attributes{
										"hx-get":    "/api/payment/modal?service_id=" + s.ID,
										"hx-target": "#payment-modal-container",
										"hx-swap":   "innerHTML transition:true",
									},
								}) {
									@icons.CreditCard(templ.Attributes{"class": "w-3.5 h-3.5 mr-1"})
									<span>Оплатить</span>
								}
							}
						</div>
					</div>
				</div>
			}
		</div>
		<div id="payment-modal-container"></div>
	</section>
}
