package sections

import (
	"fmt"
	"sitecraft/internal/models"

	icons "sitecraft/ui/components/icons"
)

templ BeforeAfter(payload models.BeforeAfterPayload, settings models.SiteSettings) {
	<!-- Hallmark Architectural Case Studies & Comparison (Strict Aesthetic Mode) -->
	<section
		id="before-after"
		data-component="hallmark-before-after"
		data-source="ui/sections/before_after.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-5xl mx-auto border-b border-content/10"
		data-reveal
	>
		<!-- Заголовок секции (Floor 54: без плашек) -->
		<div class="mb-12 text-left">
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
				if payload.Title != "" {
					{ payload.Title }
				} else {
					Практические кейсы и результаты
				}
			</h2>
			<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
				if payload.Subtitle != "" {
					{ payload.Subtitle }
				} else {
					Сопоставление исходного состояния объекта и итогового результата с официальной сметой и документальным подтверждением.
				}
			</p>
		</div>

		if len(payload.Items) > 0 {
			<div
				x-data="{
					activeIdx: 0,
					sliderPos: 50,
					isDragging: false,
					setPosFromEvent(e, el) {
						let container = el || this.$refs.sliderContainer;
						if (!container) return;
						let rect = container.getBoundingClientRect();
						let clientX = e.touches ? e.touches[0].clientX : e.clientX;
						let pos = ((clientX - rect.left) / rect.width) * 100;
						this.sliderPos = Math.min(100, Math.max(0, pos));
					}
				}"
				@window:mouseup="isDragging = false"
				@window:touchend="isDragging = false"
				class="space-y-6"
			>
				<!-- Переключатель кейсов (Floor 67: sentence-case) -->
				if len(payload.Items) > 1 {
					<div class="flex items-center gap-2 flex-wrap">
						for idx, item := range payload.Items {
							<button
								type="button"
								x-on:click={ fmt.Sprintf("activeIdx = %d; sliderPos = 50", idx) }
								:class={ fmt.Sprintf("activeIdx === %d ? 'bg-primary text-white border-primary' : 'bg-surface border-content/15 text-content-muted hover:text-content'", idx) }
								class="px-4 py-2 border text-xs sm:text-sm font-medium transition cursor-pointer"
							>
								{ item.Title }
							</button>
						}
					</div>
				}

				for idx, item := range payload.Items {
					<div
						x-show={ fmt.Sprintf("activeIdx === %d", idx) }
						x-transition:enter="transition ease-out duration-200"
						x-transition:enter-start="opacity-0"
						x-transition:enter-end="opacity-100"
						class="space-y-6"
					>
						<!-- Контейнер слайдера с hairlines -->
						<div
							x-ref="sliderContainer"
							x-on:mousedown="isDragging = true; setPosFromEvent($event, $el)"
							x-on:mousemove="if (isDragging) setPosFromEvent($event, $el)"
							x-on:mouseup="isDragging = false"
							x-on:mouseleave="isDragging = false"
							x-on:touchstart="isDragging = true; setPosFromEvent($event, $el)"
							x-on:touchmove="if (isDragging) setPosFromEvent($event, $el)"
							x-on:touchend="isDragging = false"
							class="relative w-full aspect-[16/10] sm:aspect-[16/9] overflow-hidden border border-content/10 select-none cursor-ew-resize bg-surface-muted"
						>
							<img
								src={ item.AfterImage }
								alt={ item.Title + " — После" }
								class="absolute inset-0 w-full h-full object-cover pointer-events-none"
								loading="lazy"
							/>

							<div
								class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-10"
								:style="'clip-path: inset(0 0 0 ' + sliderPos + '%); -webkit-clip-path: inset(0 0 0 ' + sliderPos + '%);'"
							>
								<div class="absolute top-4 right-4 px-3 py-1 bg-surface/90 text-content text-xs font-medium border border-content/20 pointer-events-none select-none">
									if item.AfterLabel != "" {
										{ item.AfterLabel }
									} else {
										После
									}
								</div>
							</div>

							<div
								class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-10"
								:style="'clip-path: inset(0 ' + (100 - sliderPos) + '% 0 0); -webkit-clip-path: inset(0 ' + (100 - sliderPos) + '% 0 0);'"
							>
								<img
									src={ item.BeforeImage }
									alt={ item.Title + " — До" }
									class="absolute inset-0 w-full h-full object-cover pointer-events-none"
									loading="lazy"
								/>
								<div class="absolute top-4 left-4 px-3 py-1 bg-surface/90 text-content text-xs font-medium border border-content/20 pointer-events-none select-none">
									if item.BeforeLabel != "" {
										{ item.BeforeLabel }
									} else {
										До
									}
								</div>
							</div>

							<!-- Вертикальный разделитель -->
							<div
								class="absolute top-0 bottom-0 z-20 w-px bg-white shadow-md pointer-events-none"
								:style="'left: ' + sliderPos + '%'"
							>
								<div
									role="slider"
									tabindex="0"
									aria-label="Сравнение До и После"
									:aria-valuenow="Math.round(sliderPos)"
									aria-valuemin="0"
									aria-valuemax="100"
									class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-8 h-8 bg-surface text-content border border-content/20 flex items-center justify-center text-xs pointer-events-auto cursor-ew-resize"
								>
									@icons.ChevronsLeftRight(templ.Attributes{"class": "w-4 h-4 text-accent"})
								</div>
							</div>
						</div>

						<!-- Описание кейса -->
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 bg-surface border border-content/10">
							<div>
								<h3 class="font-bold text-content text-base sm:text-lg">{ item.Title }</h3>
								if item.Description != "" {
									<p class="text-xs sm:text-sm text-content-muted mt-1 leading-relaxed">{ item.Description }</p>
								}
							</div>
							<div class="text-xs text-content-muted flex items-center gap-1.5 self-end sm:self-center shrink-0">
								@icons.MousePointerClick(templ.Attributes{"class": "w-4 h-4 text-accent"})
								<span>Потяните влево-вправо</span>
							</div>
						</div>

						<!-- Паспорт кейса и смета (Floor 11: flat hairlines) -->
						if item.Cost != "" || item.Duration != "" || len(item.Stages) > 0 {
							<div class="grid grid-cols-1 md:grid-cols-12 gap-6 p-6 bg-surface-muted/30 border border-content/10">
								<div class="md:col-span-5 space-y-3">
									<div class="text-xs font-bold text-content">
										Паспорт кейса
									</div>

									if item.Duration != "" {
										<div class="flex items-center justify-between text-xs py-2 border-b border-content/10">
											<span class="text-content-muted">Срок выполнения:</span>
											<span class="font-bold text-content">{ item.Duration }</span>
										</div>
									}

									if item.Cost != "" {
										<div class="py-2 border-b border-content/10 space-y-1">
											<div class="flex items-center justify-between text-xs">
												<span class="text-content-muted">Итоговая смета:</span>
												<span class="font-bold text-content">{ item.Cost }</span>
											</div>
											if item.MaterialsCost != "" || item.WorksCost != "" {
												<div class="text-[11px] text-content-muted flex justify-between pt-1">
													if item.MaterialsCost != "" {
														<span>Материалы: { item.MaterialsCost }</span>
													}
													if item.WorksCost != "" {
														<span>Работы: { item.WorksCost }</span>
													}
												</div>
											}
										</div>
									}
								</div>

								if len(item.Stages) > 0 {
									<div class="md:col-span-7 space-y-2">
										<div class="text-xs font-bold text-content mb-2">
											Выполненные этапы
										</div>
										<div class="divide-y divide-content/10">
											for _, stage := range item.Stages {
												<div class="py-2 flex items-center gap-2 text-xs text-content">
													<span class="text-accent">•</span>
													<span>{ stage }</span>
												</div>
											}
										</div>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		}
	</section>
}
