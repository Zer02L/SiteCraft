package sections

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

templ BeforeAfter(payload models.BeforeAfterPayload, settings models.SiteSettings) {
	<!-- Case Studies & Before/After Portfolio Section (Блок 4: Кейсы со сметой) -->
	<section id="before-after" class="py-16 px-4 max-w-5xl mx-auto" data-reveal>
		<div class="text-center mb-10">
			@base.Badge(base.BadgeProps{
				Variant: base.BadgeAccent,
				Class:   "mb-3 uppercase tracking-wider",
			}) {
				if payload.Badge != "" {
					{ payload.Badge }
				} else {
					"Результаты работы"
				}
			}
			<h2 class="section-title">
				if payload.Title != "" {
					{ payload.Title }
				} else {
					"Наглядные результаты: До и После"
				}
			</h2>
			<p class="section-subtitle">
				if payload.Subtitle != "" {
					{ payload.Subtitle }
				} else {
					"Потяните за разделитель, чтобы в деталях оценить качество выполненной работы и прозрачную смету"
				}
			</p>
		</div>

		if len(payload.Items) > 0 {
			<div
				x-data="{
					activeIdx: 0,
					sliderPos: 50,
					isDragging: false,
					setPosFromEvent(e, el) {
						let container = el || this.$refs.sliderContainer;
						if (!container) return;
						let rect = container.getBoundingClientRect();
						let clientX = e.touches ? e.touches[0].clientX : e.clientX;
						let pos = ((clientX - rect.left) / rect.width) * 100;
						this.sliderPos = Math.min(100, Math.max(0, pos));
					}
				}"
				@window:mouseup="isDragging = false"
				@window:touchend="isDragging = false"
				class="space-y-6"
			>
				<!-- Переключатель кейсов (если их больше одного) -->
				if len(payload.Items) > 1 {
					<div class="flex items-center justify-center gap-2 flex-wrap">
						for idx, item := range payload.Items {
							<button
								type="button"
								x-on:click={ fmt.Sprintf("activeIdx = %d; sliderPos = 50", idx) }
								:class={ fmt.Sprintf("activeIdx === %d ? 'bg-accent text-primary-dark font-bold shadow-md' : 'bg-surface border border-content/15 text-content-muted hover:text-content'", idx) }
								class="px-4 py-2 rounded-btn text-xs sm:text-sm transition cursor-pointer"
							>
								{ item.Title }
							</button>
						}
					</div>
				}

				for idx, item := range payload.Items {
					<div
						x-show={ fmt.Sprintf("activeIdx === %d", idx) }
						x-transition:enter="transition ease-out duration-200"
						x-transition:enter-start="opacity-0 scale-98"
						x-transition:enter-end="opacity-100 scale-100"
						class="space-y-4"
					>
						<!-- Контейнер интерактивного слайдера -->
						<div
							x-ref="sliderContainer"
							x-on:mousedown="isDragging = true; setPosFromEvent($event, $el)"
							x-on:mousemove="if (isDragging) setPosFromEvent($event, $el)"
							x-on:mouseup="isDragging = false"
							x-on:mouseleave="isDragging = false"
							x-on:touchstart="isDragging = true; setPosFromEvent($event, $el)"
							x-on:touchmove="if (isDragging) setPosFromEvent($event, $el)"
							x-on:touchend="isDragging = false"
							class="relative w-full aspect-[16/10] sm:aspect-[16/9] rounded-card overflow-hidden shadow-2xl border border-content/10 select-none cursor-ew-resize bg-surface-muted"
						>
							<!-- Слой 'ПОСЛЕ' (Фоновое базовое изображение) -->
							<img
								src={ item.AfterImage }
								alt={ item.Title + " — После" }
								class="absolute inset-0 w-full h-full object-cover pointer-events-none"
								loading="lazy"
							/>

							<!-- Слой 'ПОСЛЕ' (Шильдик, перекрываемый шторкой при движении вправо через clip-path) -->
							<div
								class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-10"
								:style="'clip-path: inset(0 0 0 ' + sliderPos + '%); -webkit-clip-path: inset(0 0 0 ' + sliderPos + '%);'"
							>
								<div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider border border-white/20 whitespace-nowrap pointer-events-none select-none">
									if item.AfterLabel != "" {
										{ item.AfterLabel }
									} else {
										"После"
									}
								</div>
							</div>

							<!-- Слой 'ДО' (Обрезаемый слой слева через clip-path без сжатия содержимого) -->
							<div
								class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-10"
								:style="'clip-path: inset(0 ' + (100 - sliderPos) + '% 0 0); -webkit-clip-path: inset(0 ' + (100 - sliderPos) + '% 0 0);'"
							>
								<img
									src={ item.BeforeImage }
									alt={ item.Title + " — До" }
									class="absolute inset-0 w-full h-full object-cover pointer-events-none"
									loading="lazy"
								/>
								<div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider border border-white/20 whitespace-nowrap pointer-events-none select-none">
									if item.BeforeLabel != "" {
										{ item.BeforeLabel }
									} else {
										"До"
									}
								</div>
							</div>

							<!-- Вертикальный разделитель и бегунок -->
							<div
								class="absolute top-0 bottom-0 z-20 w-0.5 bg-white shadow-2xl pointer-events-none"
								:style="'left: ' + sliderPos + '%'"
							>
								<div
									role="slider"
									tabindex="0"
									aria-label="Сравнение До и После"
									:aria-valuenow="Math.round(sliderPos)"
									aria-valuemin="0"
									aria-valuemax="100"
									x-on:keydown.left.prevent="sliderPos = Math.max(0, sliderPos - 5)"
									x-on:keydown.right.prevent="sliderPos = Math.min(100, sliderPos + 5)"
									class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-white text-slate-800 shadow-xl border-2 border-accent flex items-center justify-center font-bold text-xs pointer-events-auto cursor-ew-resize focus:outline-none focus:ring-2 focus:ring-accent"
								>
									<div class="flex items-center gap-0.5 text-primary">
										@icons.ChevronsLeftRight(templ.Attributes{"class": "w-5 h-5"})
									</div>
								</div>
							</div>
						</div>

						<!-- Описание кейса и подсказка -->
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-card-sm bg-surface border border-content/10">
							<div>
								<h3 class="font-bold text-content text-base sm:text-lg">{ item.Title }</h3>
								if item.Description != "" {
									<p class="text-xs sm:text-sm text-content-muted mt-0.5 leading-relaxed">{ item.Description }</p>
								}
							</div>
							<div class="text-xs text-content-muted flex items-center gap-1.5 self-end sm:self-center flex-shrink-0">
								@icons.MousePointerClick(templ.Attributes{"class": "w-4 h-4 text-accent"})
								<span>Потяните влево-вправо</span>
							</div>
						</div>

						<!-- Развернутая B2B-смета и таймлайн этапов работ (Модуль #17: Case Studies) -->
						if item.Cost != "" || item.Duration != "" || len(item.Stages) > 0 {
							<div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-5 rounded-2xl bg-surface-muted border border-content/10">
								<!-- Смета и срок -->
								<div class="md:col-span-5 space-y-3">
									<div class="flex items-center gap-2 text-xs font-bold text-primary uppercase tracking-wider">
										@icons.Receipt(templ.Attributes{"class": "w-4 h-4 text-primary"})
										<span>Паспорт кейса и смета</span>
									</div>

									if item.Duration != "" {
										<div class="flex items-center justify-between text-xs bg-surface p-2.5 rounded-xl border border-content/10">
											<span class="text-content-muted flex items-center gap-1.5">
												@icons.Clock(templ.Attributes{"class": "w-3.5 h-3.5 text-content-muted"})
												Срок выполнения:
											</span>
											<span class="font-bold text-content">{ item.Duration }</span>
										</div>
									}

									if item.Cost != "" {
										<div class="bg-surface p-3 rounded-xl border border-content/10 space-y-1.5">
											<div class="flex items-center justify-between text-xs">
												<span class="font-semibold text-content-muted">Итоговая смета:</span>
												<span class="font-bold text-sm text-primary">{ item.Cost }</span>
											</div>
											if item.MaterialsCost != "" || item.WorksCost != "" {
												<div class="pt-1.5 border-t border-content/10 text-[11px] text-content-muted flex justify-between">
													if item.MaterialsCost != "" {
														<span>Запчасти: { item.MaterialsCost }</span>
													}
													if item.WorksCost != "" {
														<span>Работы: { item.WorksCost }</span>
													}
												</div>
											}
										</div>
									}
								</div>

								<!-- Этапы выполнения проекта -->
								if len(item.Stages) > 0 {
									<div class="md:col-span-7 space-y-2">
										<div class="flex items-center gap-2 text-xs font-bold text-content-muted uppercase tracking-wider mb-2">
											@icons.ListChecks(templ.Attributes{"class": "w-4 h-4 text-emerald-600"})
											<span>Выполненные этапы</span>
										</div>
										<div class="space-y-1.5">
											for _, stage := range item.Stages {
												<div class="flex items-center gap-2 text-xs text-content/90 bg-surface px-3 py-2 rounded-xl border border-content/10">
													@icons.CheckCircle2(templ.Attributes{"class": "w-4 h-4 text-emerald-500 flex-shrink-0"})
													<span>{ stage }</span>
												</div>
											}
										</div>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		}
	</section>
}
