package sections

import (
	"fmt"
	"sitecraft/internal/models"

	icons "sitecraft/ui/components/icons"
)

templ CareersSection(vacancies []models.VacancyItem, settings models.SiteSettings) {
	<!-- Hallmark Architectural Careers & Registry (Strict Aesthetic Mode) -->
	<section
		id="careers"
		data-component="hallmark-careers"
		data-source="ui/sections/careers.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-5xl mx-auto border-b border-content/10"
		data-reveal
	>
		<!-- Заголовок секции (Floor 54: без плашек) -->
		<div class="mb-12 text-left">
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
				Вакансии и карьера в конторе
			</h2>
			<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
				Приглашаем юристов, консультантов и помощников нотариуса с фундаментальным профильным образованием.
			</p>
		</div>

		if len(vacancies) == 0 {
			<div class="p-8 text-left bg-surface border border-content/10 text-xs sm:text-sm text-content-muted leading-relaxed">
				<p>В настоящее время открытых конкурсных вакансий нет. Вы можете направить резюме для включения в кадровый резерв на электронную почту конторы.</p>
			</div>
		} else {
			<div class="divide-y divide-content/10 border-t border-b border-content/10" x-data="{ openVacancyId: null }">
				for _, v := range vacancies {
					<div class="py-5">
						<div
							@click={ fmt.Sprintf("openVacancyId = (openVacancyId === '%s' ? null : '%s')", v.ID, v.ID) }
							class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 cursor-pointer select-none"
						>
							<div class="space-y-1">
								<div class="flex items-center gap-3">
									<h3 class="font-bold text-base text-content">{ v.Title }</h3>
									if v.Department != "" {
										<span class="text-xs text-content-muted">({ v.Department })</span>
									}
								</div>
								<div class="flex items-center gap-3 text-xs text-content-muted">
									if v.Experience != "" {
										<span>Опыт: { v.Experience }</span>
									}
									if v.Schedule != "" {
										<span>• График: { v.Schedule }</span>
									}
								</div>
							</div>

							<div class="flex items-center justify-between sm:justify-end gap-6 shrink-0">
								if v.Salary != "" {
									<span class="text-sm font-semibold text-content">{ v.Salary }</span>
								}
								<button
									type="button"
									class="w-8 h-8 flex items-center justify-center text-content-muted transition-transform"
									:class={ fmt.Sprintf("openVacancyId === '%s' ? 'rotate-180 text-accent' : ''", v.ID) }
								>
									@icons.ChevronDown(templ.Attributes{"class": "w-4 h-4"})
								</button>
							</div>
						</div>

						<div
							x-show={ fmt.Sprintf("openVacancyId === '%s'", v.ID) }
							x-collapse
							class="pt-5 mt-4 border-t border-content/10 space-y-6"
						>
							<div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-content/80">
								if len(v.Responsibilities) > 0 {
									<div class="space-y-2">
										<span class="font-bold text-content text-xs block">Обязанности:</span>
										<ul class="space-y-1 list-disc pl-4 text-content-muted leading-relaxed">
											for _, r := range v.Responsibilities {
												<li>{ r }</li>
											}
										</ul>
									</div>
								}

								if len(v.Requirements) > 0 {
									<div class="space-y-2">
										<span class="font-bold text-content text-xs block">Требования:</span>
										<ul class="space-y-1 list-disc pl-4 text-content-muted leading-relaxed">
											for _, req := range v.Requirements {
												<li>{ req }</li>
											}
										</ul>
									</div>
								}

								if len(v.Benefits) > 0 {
									<div class="space-y-2">
										<span class="font-bold text-content text-xs block">Условия:</span>
										<ul class="space-y-1 list-disc pl-4 text-content-muted leading-relaxed">
											for _, b := range v.Benefits {
												<li>{ b }</li>
											}
										</ul>
									</div>
								}
							</div>

							<div id={ "vacancy-form-" + v.ID } class="p-5 bg-surface-muted/30 border border-content/10">
								<h4 class="font-bold text-xs text-content mb-3 flex items-center gap-1.5">
									@icons.Send(templ.Attributes{"class": "w-3.5 h-3.5 text-accent"})
									<span>Откликнуться на позицию</span>
								</h4>

								<form
									hx-post="/api/careers/apply"
									hx-target={ "#vacancy-form-" + v.ID }
									hx-swap="innerHTML"
									class="grid grid-cols-1 sm:grid-cols-3 gap-3"
								>
									<input type="hidden" name="vacancy_title" value={ v.Title }/>
									<input type="text" name="company_website_url" class="hidden" tabindex="-1" autocomplete="off"/>

									<div>
										<input
											type="text"
											name="name"
											required
											placeholder="Ваше имя"
											class="form-input text-xs"
										/>
									</div>
									<div>
										<input
											type="tel"
											name="phone"
											required
											placeholder="+7 (___) ___-__-__"
											class="form-input text-xs font-mono"
										/>
									</div>
									<div>
										<input
											type="text"
											name="resume_link"
											placeholder="Ссылка на резюме (hh.ru)"
											class="form-input text-xs"
										/>
									</div>

									<div class="sm:col-span-3 flex items-center justify-between gap-4 pt-1">
										<span class="text-[11px] text-content-muted">
											Нажимая кнопку, вы подтверждаете согласие на обработку персональных данных.
										</span>
										<button
											type="submit"
											class="px-5 py-2 bg-primary text-white text-xs font-medium hover:bg-primary-dark transition cursor-pointer shrink-0"
										>
											Отправить отклик
										</button>
									</div>
								</form>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</section>
}

templ VacancyApplicationSuccess(name string, vacancyTitle string) {
	<div class="p-4 bg-surface border border-content/10 text-left text-xs">
		<div class="font-bold text-sm text-content mb-1">Отклик успешно зарегистрирован</div>
		<p class="text-content-muted">Спасибо, { name }! Ваша анкета передана руководству конторы по вакансии «{ vacancyTitle }».</p>
	</div>
}
