package sections

import (
	"encoding/json"
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

func quizPayloadJSON(p models.QuizPayload) string {
	b, err := json.Marshal(p)
	if err != nil {
		return "{}"
	}
	return string(b)
}

templ Quiz(payload models.QuizPayload, settings models.SiteSettings) {
	<!-- Hallmark Architectural Calculator / Quiz (Strict Aesthetic Mode) -->
	<section
		id="quiz"
		data-component="hallmark-quiz"
		data-source="ui/sections/quiz.templ"
		class="py-16 md:py-20 px-6 sm:px-10 max-w-4xl mx-auto border-b border-content/10"
		data-reveal
	>
		<!-- Заголовок секции (Floor 54: без плашек) -->
		<div class="mb-10 text-left">
			<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
				if payload.Title != "" {
					{ payload.Title }
				} else {
					Расчёт нотариального тарифа и сопутствующих услуг
				}
			</h2>
			<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
				if payload.Subtitle != "" {
					{ payload.Subtitle }
				} else {
					Выберите параметры нотариального действия для расчёта предварительного размера государственной пошлины и правовой работы.
				}
			</p>
		</div>

		<div
			id="quiz-form-container"
			class="bg-surface border border-content/10 p-6 sm:p-10 relative overflow-hidden"
			x-data={ fmt.Sprintf(`{
				step: 0,
				totalSteps: %d,
				basePrice: %f,
				currency: '%s',
				selectedOptions: {},
				totalPrice: %f,
				preferredContact: 'phone',
				calcPrice() {
					let p = this.basePrice;
					for (let s in this.selectedOptions) {
						let opt = this.selectedOptions[s];
						if (Array.isArray(opt)) {
							opt.forEach(o => p += (o.price || 0));
						} else if (opt && opt.price) {
							p += opt.price;
						}
					}
					this.totalPrice = Math.max(0, p);
				},
				selectRadio(stepIdx, optId, title, price) {
					this.selectedOptions[stepIdx] = { id: optId, title: title, price: price };
					this.calcPrice();
				},
				isRadioSelected(stepIdx, optId) {
					return this.selectedOptions[stepIdx] && this.selectedOptions[stepIdx].id === optId;
				},
				canProceed(stepIdx) {
					return !!this.selectedOptions[stepIdx];
				},
				getSummaryPayload() {
					let summary = {
						estimated_price: this.totalPrice,
						preferred_contact: this.preferredContact,
						steps: []
					};
					for (let s in this.selectedOptions) {
						let val = this.selectedOptions[s];
						summary.steps.push({
							step: parseInt(s) + 1,
							choice: val ? val.title : ''
						});
					}
					return JSON.stringify(summary);
				}
			}`, len(payload.Steps), payload.BasePrice, payload.Currency, payload.BasePrice) }
		>
			<!-- Индикатор шагов и суммы (Floor 67: sentence-case) -->
			<div class="mb-8 pb-6 border-b border-content/10 flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center gap-3">
					<div class="flex items-center gap-1.5">
						<template x-for="i in totalSteps + 1" :key="i">
							<div
								class="h-1.5 transition-all duration-300"
								:class="i - 1 <= step ? 'w-8 bg-accent' : 'w-2 bg-content/15'"
							></div>
						</template>
					</div>
					<span class="text-xs text-content-muted" x-text="'Шаг ' + (step + 1) + ' из ' + (totalSteps + 1)"></span>
				</div>

				<div class="flex items-center gap-2 py-1 px-3 border border-content/15 bg-surface-muted">
					<span class="text-xs text-content-muted">Предварительно:</span>
					<span class="text-sm font-bold text-content" x-text="totalPrice.toLocaleString('ru-RU') + ' ' + currency"></span>
				</div>
			</div>

			<!-- Шаги квиза -->
			for stepIdx, s := range payload.Steps {
				<div
					x-show={ fmt.Sprintf("step === %d", stepIdx) }
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					class="space-y-6"
				>
					<div>
						<h3 class="text-lg sm:text-xl font-bold text-content mb-1">{ s.Question }</h3>
						if s.Subtitle != "" {
							<p class="text-xs sm:text-sm text-content-muted">{ s.Subtitle }</p>
						}
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						for _, opt := range s.Options {
							<button
								type="button"
								x-on:click={ fmt.Sprintf("selectRadio(%d, '%s', '%s', %f)", stepIdx, opt.ID, opt.Title, opt.PriceModifier) }
								:class={ fmt.Sprintf("isRadioSelected(%d, '%s') ? 'border-accent bg-surface-muted text-content font-bold' : 'border-content/15 bg-surface text-content hover:border-content/30'", stepIdx, opt.ID) }
								class="text-left p-4 border transition flex items-start gap-3 cursor-pointer"
							>
								<div
									:class={ fmt.Sprintf("isRadioSelected(%d, '%s') ? 'border-accent bg-accent' : 'border-content/30'", stepIdx, opt.ID) }
									class="w-4 h-4 border flex items-center justify-center shrink-0 mt-0.5"
								>
									<span class="w-1.5 h-1.5 bg-white"></span>
								</div>
								<div class="flex-1">
									<div class="text-xs sm:text-sm font-semibold flex items-center justify-between">
										<span>{ opt.Title }</span>
										if opt.PriceModifier > 0 {
											<span class="text-xs font-mono text-accent ml-2">+{ fmt.Sprintf("%.0f", opt.PriceModifier) } { payload.Currency }</span>
										}
									</div>
									if opt.Description != "" {
										<p class="text-xs text-content-muted mt-1 leading-relaxed">{ opt.Description }</p>
									}
								</div>
							</button>
						}
					</div>

					<!-- Навигация (Floor 63: чистые глаголы без стрелок) -->
					<div class="pt-6 flex items-center justify-between border-t border-content/10">
						<div>
							if stepIdx > 0 {
								<button
									type="button"
									x-on:click="step--"
									class="px-4 py-2 border border-content/15 text-content-muted hover:text-content text-xs font-medium transition cursor-pointer"
								>
									Назад
								</button>
							}
						</div>
						<button
							type="button"
							x-on:click={ fmt.Sprintf("if (canProceed(%d)) { step++; }", stepIdx) }
							:disabled={ fmt.Sprintf("!canProceed(%d)", stepIdx) }
							:class={ fmt.Sprintf("canProceed(%d) ? 'bg-primary text-white hover:bg-primary-dark cursor-pointer' : 'bg-content/10 text-content-muted cursor-not-allowed'", stepIdx) }
							class="px-5 py-2 text-xs font-medium transition"
						>
							Далее
						</button>
					</div>
				</div>
			}

			<!-- Финальный шаг: Контактные данные -->
			<div
				x-show={ fmt.Sprintf("step === %d", len(payload.Steps)) }
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
			>
				<form
					hx-post="/api/leads"
					hx-target="#quiz-form-container"
					hx-swap="innerHTML transition:true"
					class="space-y-6"
				>
					<div>
						<h3 class="text-xl font-bold text-content">Получение расчёта тарифа</h3>
						<p class="text-xs text-content-muted mt-1">
							if payload.BonusText != "" {
								{ payload.BonusText }
							} else {
								Укажите телефон для отправки предварительной сметы и резервирования времени приёма.
							}
						</p>
					</div>

					<div class="p-4 bg-surface-muted border border-content/10 flex items-center justify-between text-xs">
						<span class="text-content-muted">Расчётный тариф нотариального действия:</span>
						<span class="text-base font-bold text-content" x-text="totalPrice.toLocaleString('ru-RU') + ' ' + currency"></span>
					</div>

					<input type="hidden" name="source" value="quiz_calculator"/>
					<input type="hidden" name="action_type" value="Расчёт стоимости из онлайн-калькулятора"/>
					<input type="hidden" name="comment" :value="'Предварительный расчёт: ' + totalPrice + ' ' + currency"/>
					<input type="hidden" name="company_website_url" value=""/>
					<input type="hidden" name="consent" value="on"/>
					<input type="hidden" name="quiz_payload" :value="getSummaryPayload()"/>

					<div>
						<label class="form-label text-xs font-medium text-content mb-2">Способ связи</label>
						<div class="grid grid-cols-3 gap-3">
							<button
								type="button"
								x-on:click="preferredContact = 'whatsapp'"
								:class="preferredContact === 'whatsapp' ? 'border-accent bg-surface-muted font-bold text-content' : 'border-content/10 text-content-muted'"
								class="py-2.5 px-3 border text-xs flex items-center justify-center gap-1.5 transition cursor-pointer"
							>
								@icons.MessageSquare(templ.Attributes{"class": "w-4 h-4 text-accent"})
								<span>WhatsApp</span>
							</button>
							<button
								type="button"
								x-on:click="preferredContact = 'telegram'"
								:class="preferredContact === 'telegram' ? 'border-accent bg-surface-muted font-bold text-content' : 'border-content/10 text-content-muted'"
								class="py-2.5 px-3 border text-xs flex items-center justify-center gap-1.5 transition cursor-pointer"
							>
								@icons.Send(templ.Attributes{"class": "w-4 h-4 text-accent"})
								<span>Telegram</span>
							</button>
							<button
								type="button"
								x-on:click="preferredContact = 'phone'"
								:class="preferredContact === 'phone' ? 'border-accent bg-surface-muted font-bold text-content' : 'border-content/10 text-content-muted'"
								class="py-2.5 px-3 border text-xs flex items-center justify-center gap-1.5 transition cursor-pointer"
							>
								@icons.Phone(templ.Attributes{"class": "w-4 h-4 text-accent"})
								<span>Звонок</span>
							</button>
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						@base.Input(base.InputProps{
							Label:       "Ваше имя",
							Name:        "name",
							Required:    true,
							Placeholder: "Иван Петров",
						})
						@base.Input(base.InputProps{
							Label:       "Телефон для связи",
							Name:        "phone",
							Type:        "tel",
							Required:    true,
							Placeholder: "+7 (___) ___-__-__",
							Class:       "font-mono",
						})
					</div>

					<div class="pt-4 flex items-center justify-between gap-4 border-t border-content/10">
						@base.Button(base.ButtonProps{
							Variant: base.BtnOutline,
							Size:    base.BtnSizeSm,
							Type:    "button",
							Attrs:   templ.Attributes{"x-on:click": "step--"},
						}) {
							<span>Назад</span>
						}
						@base.Button(base.ButtonProps{
							Variant: base.BtnAccent,
							Size:    base.BtnSizeDefault,
							Type:    "submit",
							Class:   "font-medium",
						}) {
							<span>Получить предварительный расчёт</span>
						}
					</div>
				</form>
			</div>
		</div>
	</section>
}
