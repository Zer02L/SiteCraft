package sections

import (
	"github.com/axadrn/shadcn-templ/v2/components/badge"
)

templ Gallery(theme string) {
	<!-- Structural section: Visual Portfolio / Photo Gallery -->
	<section id="gallery" class="py-16 px-4 max-w-6xl mx-auto">
		<div class="text-center mb-12" data-reveal>
			@badge.Badge(badge.Props{
				Variant: badge.VariantSecondary,
				Class:   "section-badge mb-2",
			}) {
				Галерея
			}
			<h2 class="section-title">Портфолио и атмосфера</h2>
			<p class="section-subtitle">Взгляните на результаты нашей работы и комфортное пространство студии</p>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
			<div data-reveal data-reveal-delay="100" class="group relative overflow-hidden rounded-card bg-surface-muted aspect-square border border-content/10">
				<div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-tr from-pink-100 via-rose-50 to-amber-50 p-6 text-center group-hover:scale-105 transition duration-300">
					<span class="text-4xl mb-2">💇‍♀️</span>
					<span class="font-bold text-xs text-content">Airtouch & Укладка</span>
					<span class="text-[10px] text-content-muted mt-1">Холодный блонд</span>
				</div>
			</div>
			<div data-reveal data-reveal-delay="200" class="group relative overflow-hidden rounded-card bg-surface-muted aspect-square border border-content/10">
				<div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-tr from-rose-100 via-pink-50 to-purple-50 p-6 text-center group-hover:scale-105 transition duration-300">
					<span class="text-4xl mb-2">💅</span>
					<span class="font-bold text-xs text-content">Smart-педикюр</span>
					<span class="text-[10px] text-content-muted mt-1">Стойкий глянец</span>
				</div>
			</div>
			<div data-reveal data-reveal-delay="300" class="group relative overflow-hidden rounded-card bg-surface-muted aspect-square border border-content/10">
				<div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-tr from-amber-100 via-orange-50 to-rose-50 p-6 text-center group-hover:scale-105 transition duration-300">
					<span class="text-4xl mb-2">✨</span>
					<span class="font-bold text-xs text-content">Макияж & Образ</span>
					<span class="text-[10px] text-content-muted mt-1">Вечерний стиль</span>
				</div>
			</div>
			<div data-reveal data-reveal-delay="400" class="group relative overflow-hidden rounded-card bg-surface-muted aspect-square border border-content/10">
				<div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-tr from-teal-50 via-pink-50 to-amber-100 p-6 text-center group-hover:scale-105 transition duration-300">
					<span class="text-4xl mb-2">🌸</span>
					<span class="font-bold text-xs text-content">SPA для волос</span>
					<span class="text-[10px] text-content-muted mt-1">Глубокое питание</span>
				</div>
			</div>
		</div>
	</section>
}
