package sections

import (
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"
)

templ Booking(content models.SiteContent, bookedSlots map[string][]string, settings models.SiteSettings, resources ...[]models.ResourceItem) {
	{{
		var resList []models.ResourceItem
		if len(resources) > 0 {
			resList = resources[0]
		}
	}}
	<!-- Hallmark Architectural Booking (Strict Aesthetic Mode) -->
	<section
		id="booking"
		data-component="hallmark-booking"
		data-source="ui/sections/booking.templ"
		class="py-16 md:py-20 px-6 sm:px-10 bg-surface-muted/40 border-b border-content/10"
	>
		<div class="max-w-6xl mx-auto" data-reveal>
			<!-- Заголовок секции (Floor 54: без плашек) -->
			<div class="mb-12 text-left">
				<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-content">
					if settings.BookingMode == "simple" {
						{ i18n.T(ctx, "booking.simple_title") }
					} else {
						{ i18n.T(ctx, "booking.slots_title") }
					}
				</h2>
				<p class="text-sm sm:text-base text-content-muted mt-2 max-w-2xl leading-relaxed">
					if settings.BookingMode == "simple" {
						{ i18n.T(ctx, "booking.simple_desc") }
					} else {
						{ i18n.T(ctx, "booking.slots_desc") }
					}
				</p>
			</div>

			if settings.BookingMode == "simple" {
				@BookingSimple(content, settings)
			} else {
				@BookingSlots(content, bookedSlots, settings, resList)
			}
		</div>
	</section>
}
