package sections

import (
	"fmt"
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ Booking(content models.SiteContent, bookedSlots map[string][]string, settings models.SiteSettings, resources ...[]models.ResourceItem) {
	{{
		var resList []models.ResourceItem
		if len(resources) > 0 {
			resList = resources[0]
		}
	}}
	<!-- Booking Section (Simple or Interactive Slots) -->
	<section id="booking" class="py-16 px-4 bg-surface-muted border-t border-content/10">
		<div class="max-w-6xl mx-auto" data-reveal>
			<div class="text-center mb-10">
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeAccent,
					Class:   "mb-2 uppercase tracking-wider",
				}) {
					{ i18n.T(ctx, "booking.badge") }
				}
				<h2 class="section-title">
					if settings.BookingMode == "simple" {
						{ i18n.T(ctx, "booking.simple_title") }
					} else {
						{ i18n.T(ctx, "booking.slots_title") }
					}
				</h2>
				<p class="section-subtitle">
					if settings.BookingMode == "simple" {
						{ i18n.T(ctx, "booking.simple_desc") }
					} else {
						{ i18n.T(ctx, "booking.slots_desc") }
					}
				</p>
			</div>

			if settings.BookingMode == "simple" {
				<!-- Режим 1: Простая лидген-форма -->
				<div
					x-data="{
						phone: '',
						formatPhone(val) {
							let digits = (val || '').replace(/\D/g, '');
							if (!digits) return '';
							if (digits.startsWith('7') || digits.startsWith('8')) digits = digits.substring(1);
							let res = '+7';
							if (digits.length > 0) res += ' (' + digits.substring(0, 3);
							if (digits.length >= 4) res += ') ' + digits.substring(3, 6);
							if (digits.length >= 7) res += '-' + digits.substring(6, 8);
							if (digits.length >= 9) res += '-' + digits.substring(8, 10);
							return res;
						},
						onPhoneInput(e) {
							this.phone = this.formatPhone(e.target.value);
						}
					}"
					class="max-w-xl mx-auto card-base p-6 sm:p-8"
				>
					<form
						hx-post="/api/leads"
						hx-target="#booking-response"
						hx-swap="innerHTML transition:true"
						@htmx:after-request="if ($event.detail.successful) { $el.reset(); phone = ''; }"
						class="space-y-4"
					>
						<!-- Honeypot антиспам-ловушка (скрыта от людей) -->
						<div class="hidden" aria-hidden="true">
							<label>URL: <input type="text" name="company_website_url" tabindex="-1" autocomplete="off"/></label>
						</div>

						<div>
							<label class="form-label">{ i18n.T(ctx, "booking.name_label") }</label>
							<input
								type="text"
								name="name"
								required
								minlength="2"
								maxlength="100"
								autocomplete="name"
								placeholder={ i18n.T(ctx, "booking.name_placeholder") }
								class="form-input"
							/>
						</div>

						<div>
							<label class="form-label">{ i18n.T(ctx, "booking.phone_label") }</label>
							<input
								type="tel"
								name="phone"
								x-model="phone"
								@input="onPhoneInput($event)"
								required
								autocomplete="tel"
								placeholder={ i18n.T(ctx, "booking.phone_placeholder") }
								class="form-input"
							/>
						</div>

						<div>
							<label class="form-label">{ i18n.T(ctx, "booking.comment_label") }</label>
							<textarea
								name="comment"
								rows="3"
								maxlength="1000"
								placeholder={ i18n.T(ctx, "booking.comment_placeholder") }
								class="form-input"
							></textarea>
						</div>

						<div class="pt-1">
							<label class="flex items-start gap-2.5 cursor-pointer select-none">
								<input
									type="checkbox"
									name="consent"
									value="on"
									checked
									required
									class="mt-0.5 rounded border-content/20 text-primary focus:ring-accent"
								/>
								<span class="text-xs text-content-muted leading-snug">
									{ i18n.T(ctx, "booking.consent_text") } *
								</span>
							</label>
						</div>

						@base.Button(base.ButtonProps{
							Variant: base.BtnPrimary,
							Size:    base.BtnSizeLg,
							Type:    "submit",
							Class:   "w-full font-bold shadow gap-2",
						}) {
							<span class="htmx-indicator">
								@icons.Loader2(templ.Attributes{"class": "animate-spin w-4 h-4 mr-2"})
							</span>
							@icons.Send(templ.Attributes{"class": "w-4 h-4 mr-1"})
							<span>{ i18n.T(ctx, "booking.submit_simple") }</span>
						}
					</form>
					<div id="booking-response" class="mt-4"></div>
				</div>
			} else {
				<!-- Режим 2: Интерактивная сетка бронирования времени -->
				<div
					x-data="{
						selectedResource: '',
						selectedDate: '2026-10-07',
						selectedTime: '',
						name: '',
						phone: '',
						comment: '',
						agreeConsent: true,
						bookedMap: {},
						errors: { name: '', phone: '', time: '', consent: '' },
						touched: { name: false, phone: false },
						dates: [
							{ label: 'Ср, 7 окт', date: '2026-10-07', slots: [
								{ time: '09:30', defaultFree: true },
								{ time: '10:15', defaultFree: true },
								{ time: '11:00', defaultFree: false },
								{ time: '12:00', defaultFree: true },
								{ time: '14:30', defaultFree: true },
								{ time: '15:30', defaultFree: false },
								{ time: '16:30', defaultFree: true }
							]},
							{ label: 'Чт, 8 окт', date: '2026-10-08', slots: [
								{ time: '09:30', defaultFree: false },
								{ time: '10:30', defaultFree: true },
								{ time: '11:30', defaultFree: true },
								{ time: '12:15', defaultFree: false },
								{ time: '14:30', defaultFree: true },
								{ time: '15:15', defaultFree: true },
								{ time: '16:00', defaultFree: false }
							]},
							{ label: 'Пт, 9 окт', date: '2026-10-09', slots: [
								{ time: '09:30', defaultFree: true },
								{ time: '10:00', defaultFree: true },
								{ time: '11:00', defaultFree: false },
								{ time: '12:00', defaultFree: false },
								{ time: '14:30', defaultFree: true },
								{ time: '15:30', defaultFree: true },
								{ time: '16:15', defaultFree: true }
							]},
							{ label: 'Пн, 12 окт', date: '2026-10-12', slots: [
								{ time: '09:30', defaultFree: true },
								{ time: '10:30', defaultFree: true },
								{ time: '11:30', defaultFree: true },
								{ time: '12:00', defaultFree: true },
								{ time: '14:30', defaultFree: false },
								{ time: '15:30', defaultFree: true },
								{ time: '16:30', defaultFree: true }
							]},
							{ label: 'Вт, 13 окт', date: '2026-10-13', slots: [
								{ time: '09:30', defaultFree: false },
								{ time: '10:30', defaultFree: false },
								{ time: '11:30', defaultFree: true },
								{ time: '12:00', defaultFree: true },
								{ time: '14:30', defaultFree: true },
								{ time: '15:30', defaultFree: true },
								{ time: '16:30', defaultFree: false }
							]}
						],
						init() {
							const el = document.getElementById('booked-data-json');
							if (el) {
								try {
									this.bookedMap = JSON.parse(el.textContent) || {};
								} catch (e) {}
							}
						},
						isSlotFree(time) {
							const booked = this.bookedMap[this.selectedDate] || [];
							if (booked.includes(time)) return false;
							const day = this.dates.find(d => d.date === this.selectedDate);
							if (!day) return true;
							const slot = day.slots.find(s => s.time === time);
							return slot ? slot.defaultFree : true;
						},
						currentSlots() {
							const day = this.dates.find(d => d.date === this.selectedDate);
							if (!day) return [];
							return day.slots.map(s => ({ time: s.time, free: this.isSlotFree(s.time) }));
						},
						selectSlot(time, isFree) {
							if (isFree) {
								this.selectedTime = time;
								this.errors.time = '';
							}
						},
						selectResource(id) {
							this.selectedResource = id;
							this.selectedTime = '';
							fetch('/api/slots?resource_id=' + encodeURIComponent(id))
								.then(r => r.ok ? r.json() : {})
								.then(data => {
									this.bookedMap = data || {};
								})
								.catch(() => {});
						},
						formatPhone(val) {
							let digits = (val || '').replace(/\D/g, '');
							if (!digits) return '';
							if (digits.startsWith('7') || digits.startsWith('8')) digits = digits.substring(1);
							let res = '+7';
							if (digits.length > 0) res += ' (' + digits.substring(0, 3);
							if (digits.length >= 4) res += ') ' + digits.substring(3, 6);
							if (digits.length >= 7) res += '-' + digits.substring(6, 8);
							if (digits.length >= 9) res += '-' + digits.substring(8, 10);
							return res;
						},
						onPhoneInput(e) {
							this.phone = this.formatPhone(e.target.value);
							if (this.touched.phone) this.validatePhone();
						},
						validateName() {
							const val = (this.name || '').trim();
							if (!val) { this.errors.name = 'Укажите ФИО заявителя'; return false; }
							if (val.length < 2) { this.errors.name = 'ФИО должно содержать не менее 2 символов'; return false; }
							this.errors.name = '';
							return true;
						},
						validatePhone() {
							const digits = (this.phone || '').replace(/\D/g, '');
							if (!digits) { this.errors.phone = 'Укажите контактный номер телефона'; return false; }
							if (digits.length < 11) { this.errors.phone = 'Укажите номер полностью (10 цифр номера)'; return false; }
							this.errors.phone = '';
							return true;
						},
						validateTime() {
							if (!this.selectedTime) { this.errors.time = 'Пожалуйста, выберите свободное время'; return false; }
							this.errors.time = '';
							return true;
						},
						validateConsent() {
							if (!this.agreeConsent) { this.errors.consent = 'Необходимо согласие на обработку данных'; return false; }
							this.errors.consent = '';
							return true;
						},
						validateAll() {
							this.touched.name = true;
							this.touched.phone = true;
							return this.validateTime() && this.validateName() && this.validatePhone() && this.validateConsent();
						},
						handleSubmit(e) {
							if (!this.validateAll()) {
								e.preventDefault();
								e.stopPropagation();
								return false;
							}
						},
						handleSuccess() {
							if (this.selectedDate && this.selectedTime) {
								if (!this.bookedMap[this.selectedDate]) this.bookedMap[this.selectedDate] = [];
								this.bookedMap[this.selectedDate].push(this.selectedTime);
							}
							this.name = ''; this.phone = ''; this.comment = ''; this.selectedTime = '';
							this.touched.name = false; this.touched.phone = false;
							this.errors = { name: '', phone: '', time: '', consent: '' };
						}
					}"
					class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
				>
					@templ.JSONScript("booked-data-json", bookedSlots)
					<!-- Календарь и сетка времени (левая колонка) -->
					<div class="lg:col-span-7 card-base sm:p-8">
						if len(resList) > 0 {
							<!-- Шаг 1: Выбор специалиста / мастера / поста (Resource Booking) -->
							<div class="mb-6 pb-4 border-b border-content/10">
								<h3 class="font-bold text-content text-base flex items-center gap-2 mb-3">
									<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
									1. Выберите специалиста или кабинет
								</h3>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
									<button
										type="button"
										@click="selectResource('')"
										:class="selectedResource === ''
											? 'border-primary bg-primary/10 text-primary font-bold shadow-xs'
											: 'border-content/10 bg-surface-muted text-content/70 hover:border-content/30'"
										class="p-3 rounded-xl border text-left flex items-center gap-3 transition-all cursor-pointer"
									>
										<span class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-sm font-bold flex-shrink-0">✨</span>
										<div class="min-w-0">
											<div class="text-xs font-semibold leading-tight">Любой специалист</div>
											<div class="text-[10px] text-content-muted mt-0.5">Ближайшее доступное время</div>
										</div>
									</button>
									for _, r := range resList {
										<button
											type="button"
											@click={ fmt.Sprintf("selectResource('%s')", r.ID) }
											:class={ fmt.Sprintf("selectedResource === '%s' ? 'border-primary bg-primary/10 text-primary font-bold shadow-xs' : 'border-content/10 bg-surface-muted text-content/70 hover:border-content/30'", r.ID) }
											class="p-3 rounded-xl border text-left flex items-center gap-3 transition-all cursor-pointer"
										>
											<span class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-sm font-bold flex-shrink-0">{ r.Avatar }</span>
											<div class="min-w-0">
												<div class="text-xs font-semibold leading-tight truncate">{ r.Name }</div>
												<div class="text-[10px] text-content-muted mt-0.5 truncate">{ r.Role }</div>
											</div>
										</button>
									}
								</div>
							</div>
						}

						<div class="flex items-center justify-between mb-4 pb-3 border-b border-content/10">
							<h3 class="font-bold text-content text-base flex items-center gap-2">
								<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
								if len(resList) > 0 {
									2. { i18n.T(ctx, "booking.date_label") }
								} else {
									1. { i18n.T(ctx, "booking.date_label") }
								}
							</h3>
							<div class="flex items-center gap-3 text-xs">
								<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> { i18n.T(ctx, "booking.legend_free") }</span>
								<span class="flex items-center gap-1.5 text-content-muted"><span class="w-2.5 h-2.5 rounded-full bg-stone-300"></span> { i18n.T(ctx, "booking.legend_busy") }</span>
							</div>
						</div>

						<!-- Выбор дней недели -->
						<div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-6">
							<template x-for="day in dates" :key="day.date">
								<button
									type="button"
									@click="selectedDate = day.date; selectedTime = ''"
									:class="selectedDate === day.date
										? 'bg-primary text-white border-primary shadow-sm'
										: 'bg-surface-muted text-content/80 border-content/10 hover:bg-surface-muted'"
									class="p-2.5 rounded-card-sm border text-center transition flex flex-col items-center justify-center cursor-pointer"
								>
									<span class="text-xs font-semibold" x-text="day.label"></span>
								</button>
							</template>
						</div>

						<!-- Сетка слотов времени -->
						<div class="mb-4">
							<h4 class="font-semibold text-content text-sm mb-3">2. { i18n.T(ctx, "booking.time_label") }</h4>
							<div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
								<template x-for="slot in currentSlots()" :key="slot.time">
									<button
										type="button"
										:disabled="!slot.free"
										@click="selectSlot(slot.time, slot.free)"
										:class="!slot.free
											? 'bg-surface-muted text-content-muted border-content/10 cursor-not-allowed line-through'
											: (selectedTime === slot.time
												? 'bg-emerald-600 text-white border-emerald-700 shadow-md ring-2 ring-emerald-300'
												: 'bg-emerald-50/80 text-emerald-800 border-emerald-200 hover:bg-emerald-100 hover:border-emerald-300 cursor-pointer font-medium')"
										class="py-2.5 px-3 rounded-btn border text-sm transition flex items-center justify-center gap-1.5"
									>
										<span x-text="slot.time"></span>
									</button>
								</template>
							</div>
						</div>

						<div class="p-3 bg-amber-50/80 rounded-card-sm border border-amber-200/80 text-xs text-amber-800 flex items-center gap-2">
							<svg class="w-4 h-4 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span>{ i18n.T(ctx, "footer.lunch") } { content.LunchBreak }.</span>
						</div>
					</div>

					<!-- Форма подтверждения (правая колонка) -->
					<div class="lg:col-span-5 card-base sm:p-8">
						<h3 class="font-serif-title text-xl font-bold text-content mb-1">{ i18n.T(ctx, "booking.slots_title") }</h3>
						<p class="text-xs text-content-muted mb-5">{ i18n.T(ctx, "booking.slots_desc") }</p>

						<!-- Индикатор выбранного времени -->
						<div
							:class="errors.time ? 'border-rose-300 bg-rose-50/50' : (selectedTime ? 'border-emerald-300 bg-emerald-50/30' : 'border-content/10 bg-surface-muted')"
							class="mb-4 p-3 rounded-card-sm border text-xs flex items-center justify-between transition"
						>
							<span class="text-content-muted">{ i18n.T(ctx, "booking.time_label") }:</span>
							<span
								:class="selectedTime ? 'text-emerald-700' : 'text-content-muted'"
								class="font-bold"
								x-text="selectedTime ? (selectedDate + ' ' + selectedTime) : '—'"
							></span>
						</div>

						<form
							hx-post="/api/leads"
							hx-target="#booking-response"
							hx-swap="innerHTML transition:true"
							@submit="handleSubmit($event)"
							@htmx:after:request="if ($event.detail.successful) handleSuccess()"
							@htmx:after-request="if ($event.detail.successful) handleSuccess()"
							class="space-y-4"
							novalidate
						>
							<!-- Honeypot -->
							<div class="hidden" aria-hidden="true">
								<label>URL: <input type="text" name="company_website_url" tabindex="-1" autocomplete="off"/></label>
							</div>

							<input type="hidden" name="booking_date" :value="selectedDate"/>
							<input type="hidden" name="booking_time" :value="selectedTime"/>
							<input type="hidden" name="resource_id" :value="selectedResource"/>

							<div>
								<label class="form-label">{ i18n.T(ctx, "booking.name_label") }</label>
								<input
									type="text"
									name="name"
									x-model="name"
									@input="if (touched.name) validateName()"
									@blur="touched.name = true; validateName()"
									placeholder={ i18n.T(ctx, "booking.name_placeholder") }
									class="form-input"
								/>
								<template x-if="errors.name">
									<p class="text-xs text-rose-600 mt-1" x-text="errors.name"></p>
								</template>
							</div>

							<div>
								<label class="form-label">{ i18n.T(ctx, "booking.phone_label") }</label>
								<input
									type="tel"
									name="phone"
									x-model="phone"
									@input="onPhoneInput($event)"
									@blur="touched.phone = true; validatePhone()"
									placeholder={ i18n.T(ctx, "booking.phone_placeholder") }
									class="form-input"
								/>
								<template x-if="errors.phone">
									<p class="text-xs text-rose-600 mt-1" x-text="errors.phone"></p>
								</template>
							</div>

							<div>
								<label class="form-label">{ i18n.T(ctx, "booking.comment_label") }</label>
								<textarea
									name="comment"
									x-model="comment"
									rows="2"
									placeholder={ i18n.T(ctx, "booking.comment_placeholder") }
									class="form-input"
								></textarea>
							</div>

							<div class="pt-1">
								<label class="flex items-start gap-2.5 cursor-pointer select-none">
									<input
										type="checkbox"
										name="consent"
										x-model="agreeConsent"
										class="mt-0.5 rounded border-content/20 text-primary focus:ring-accent"
									/>
									<span class="text-xs text-content-muted leading-snug">
										{ i18n.T(ctx, "booking.consent_text") } *
									</span>
								</label>
								<template x-if="errors.consent">
									<p class="text-xs text-rose-600 mt-1" x-text="errors.consent"></p>
								</template>
							</div>

							@base.Button(base.ButtonProps{
								Variant: base.BtnPrimary,
								Size:    base.BtnSizeLg,
								Type:    "submit",
								Class:   "w-full font-bold shadow gap-2",
							}) {
								<span class="htmx-indicator">
									@icons.Loader2(templ.Attributes{"class": "animate-spin w-4 h-4 mr-2"})
								</span>
								@icons.CalendarCheck(templ.Attributes{"class": "w-4 h-4 mr-1"})
								<span>{ i18n.T(ctx, "booking.submit_slots") }</span>
							}
						</form>

						<div id="booking-response" class="mt-4"></div>
					</div>
				</div>
			}
		</div>
	</section>
}
