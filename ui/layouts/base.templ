package layouts

import (
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"
)

templ Base(title string, description string, settings models.SiteSettings, seoOpt ...models.SEOData) {
	{{ seo := resolveSEO(title, description, settings, seoOpt...) }}
	<!DOCTYPE html>
	<html
		lang={ i18n.GetLocale(ctx) }
		class="scroll-smooth"
		data-theme={ settings.Theme }
		data-flavor={ settings.GetDesignFlavor() }
		data-font={ settings.GetFontPair() }
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ seo.Title }</title>
			<meta name="description" content={ seo.Description }/>
			<link rel="alternate" hreflang="ru" href="?lang=ru"/>
			<link rel="alternate" hreflang="en" href="?lang=en"/>
			<meta property="og:locale" content={ i18n.OGLocale(ctx) }/>
			if seo.NoIndex {
				<meta name="robots" content="noindex, nofollow"/>
			}
			if seo.CanonicalURL != "" {
				<link rel="canonical" href={ seo.CanonicalURL }/>
			}

			<!-- Open Graph / SEO -->
			<meta property="og:title" content={ seo.Title }/>
			<meta property="og:description" content={ seo.Description }/>
			<meta property="og:type" content={ seo.OGType }/>
			if seo.CanonicalURL != "" {
				<meta property="og:url" content={ seo.CanonicalURL }/>
			}
			if seo.OGImage != "" {
				<meta property="og:image" content={ seo.OGImage }/>
			}

			<!-- Twitter Cards -->
			if seo.TwitterCard != "" {
				<meta name="twitter:card" content={ seo.TwitterCard }/>
				<meta name="twitter:title" content={ seo.Title }/>
				<meta name="twitter:description" content={ seo.Description }/>
				if seo.OGImage != "" {
					<meta name="twitter:image" content={ seo.OGImage }/>
				}
			}

			<!-- Schema.org JSON-LD Structured Data -->
			for _, jsonld := range seo.JSONLDScripts() {
				@RenderJSONLD(jsonld)
			}

			<!-- Динамические токены темы и цвета -->
			@RenderCustomTokens(settings)

			<!-- Google Fonts: Merriweather + Inter + Bebas Neue -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/>
			
			<!-- HTMX (Zero-JS foundation for AJAX requests) - Local Standalone -->
			<script src="/assets/js/htmx.min.js"></script>
			<!-- HTMX 4 + Alpine.js official compatibility extension - Local Standalone -->
			<script src="/assets/js/hx-alpine-compat.js"></script>

			<!-- Quill 2.0 WYSIWYG Editor - Local Standalone -->
			<link href="/assets/css/quill.snow.css" rel="stylesheet"/>
			<script src="/assets/js/quill.min.js"></script>

			<!-- Telegram WebApp SDK (автоматическая адаптация для TMA) -->
			<script src="https://telegram.org/js/telegram-web-app.js"></script>
			<script>
				(function() {
					if (window.Telegram && window.Telegram.WebApp) {
						try {
							var tg = window.Telegram.WebApp;
							tg.ready();
							tg.expand();
							document.addEventListener('htmx:configRequest', function(evt) {
								if (tg.initData) {
									evt.detail.headers['X-Telegram-Init-Data'] = tg.initData;
								}
							});
						} catch(e) {}
					}
				})();
			</script>

			<!-- Alpine.js + Mask Plugin for light client-side state - Local Standalone -->
			<script defer src="/assets/js/alpine-mask.min.js"></script>
			<script defer src="/assets/js/alpine.min.js"></script>

			<!-- Cloudflare Turnstile (если включен) -->
			if settings.EnableTurnstile && settings.TurnstileSiteKey != "" {
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			}

			<!-- Яндекс Метрика (если указан ID) -->
			if settings.YandexMetrikaID != "" {
				<script type="text/javascript">
					(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
					m[i].l=1*new Date();
					for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
					k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
					(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
					ym({ settings.YandexMetrikaID }, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
				</script>
			}

			<!-- Скомпилированные стили Tailwind с семантическими токенами -->
			<link rel="stylesheet" href="/assets/styles.css?v=preview_live_v2"/>
			<!-- No-JS Progressive Enhancement: если JavaScript выключен или недоступен, контент отображается сразу -->
			<noscript>
				<style>
					[data-reveal] {
						opacity: 1 !important;
						transform: none !important;
						transition: none !important;
					}
				</style>
			</noscript>
			<style>
				.font-serif-title { font-family: 'Merriweather', Georgia, serif; }
			</style>

			<!-- Микро-скрипт Доступности и Темы на чистом Vanilla JS (< 1.5 КБ, без зависимостей) -->
			<script>
				(function() {
					const root = document.documentElement;
					
					// Тема сайта (сохраняется в localStorage)
					const savedTheme = localStorage.getItem('sitecraft_theme') || root.getAttribute('data-theme') || 'coral';
					root.setAttribute('data-theme', savedTheme);

					// API Доступности (a11y)
					window.A11Y = {
						active: localStorage.getItem('a11y_active') === 'true',
						fontSize: localStorage.getItem('a11y_font') || 'normal',
						spacing: localStorage.getItem('a11y_spacing') || 'normal',
						theme: localStorage.getItem('a11y_theme') || 'black-on-white',
						images: localStorage.getItem('a11y_images') || 'on',

						apply: function() {
							const toolbar = document.getElementById('a11y-toolbar');
							if (this.active) {
								root.classList.add('a11y-mode');
								root.setAttribute('data-a11y-font', this.fontSize);
								root.setAttribute('data-a11y-spacing', this.spacing);
								root.setAttribute('data-a11y-theme', this.theme);
								root.setAttribute('data-a11y-images', this.images);
								if (toolbar) toolbar.classList.remove('hidden');
							} else {
								root.classList.remove('a11y-mode');
								root.removeAttribute('data-a11y-font');
								root.removeAttribute('data-a11y-spacing');
								root.removeAttribute('data-a11y-theme');
								root.removeAttribute('data-a11y-images');
								if (toolbar) toolbar.classList.add('hidden');
							}
							this.updateUI();
						},

						toggle: function() {
							this.active = !this.active;
							localStorage.setItem('a11y_active', this.active);
							this.apply();
						},

						setFont: function(size) {
							this.fontSize = size;
							localStorage.setItem('a11y_font', size);
							root.setAttribute('data-a11y-font', size);
							this.updateUI();
						},

						setColorScheme: function(scheme) {
							this.theme = scheme;
							localStorage.setItem('a11y_theme', scheme);
							root.setAttribute('data-a11y-theme', scheme);
							this.updateUI();
						},

						toggleSpacing: function() {
							this.spacing = (this.spacing === 'normal') ? 'wide' : 'normal';
							localStorage.setItem('a11y_spacing', this.spacing);
							root.setAttribute('data-a11y-spacing', this.spacing);
							this.updateUI();
						},

						toggleImages: function() {
							this.images = (this.images === 'on') ? 'off' : 'on';
							localStorage.setItem('a11y_images', this.images);
							root.setAttribute('data-a11y-images', this.images);
							this.updateUI();
						},

						updateUI: function() {
							const sBtn = document.getElementById('a11y-spacing-btn');
							if (sBtn) sBtn.textContent = this.spacing === 'wide' ? 'Интервал: Широкий' : 'Интервал: Обычный';
							const iBtn = document.getElementById('a11y-images-btn');
							if (iBtn) iBtn.textContent = this.images === 'off' ? 'Изображения: Выкл' : 'Изображения: Вкл';
						}
					};

					// Переключение тем сайта (Основная + Сезоны + Гармоническая + День/Ночь)
					window.getThemeState = function() {
						const current = root.getAttribute('data-theme') || 'main';
						const isNight = current.endsWith('-night') || current === 'dark';
						let base = current.replace('-night', '').replace('-day', '');
						if (base === 'dark' || base === 'default') base = 'main';
						return { base: base, isNight: isNight };
					};

					window.setSiteTheme = function(seasonName) {
						const state = window.getThemeState();
						const season = seasonName || state.base;
						const newTheme = state.isNight ? (season + '-night') : season;
						root.setAttribute('data-theme', newTheme);
						localStorage.setItem('sitecraft_theme', newTheme);
						window.dispatchEvent(new CustomEvent('themechanged', { detail: { theme: newTheme, season: season, isNight: state.isNight } }));
					};

					window.toggleNightMode = function() {
						const state = window.getThemeState();
						const newTheme = state.isNight ? state.base : (state.base + '-night');
						root.setAttribute('data-theme', newTheme);
						localStorage.setItem('sitecraft_theme', newTheme);
						window.dispatchEvent(new CustomEvent('themechanged', { detail: { theme: newTheme, season: state.base, isNight: !state.isNight } }));
					};

					// ----------------------------------------------------
					// 🎨 Единый кэширующий JS-мост к дизайн-токенам (Zero-Reflow)
					// ----------------------------------------------------
					const _tokenCache = new Map();
					window.SiteTokens = {
						read: function(name) {
							if (_tokenCache.has(name)) return _tokenCache.get(name);
							const v = getComputedStyle(root).getPropertyValue(name).trim();
							_tokenCache.set(name, v);
							return v;
						},
						readMs: function(name) { return parseFloat(this.read(name)) || 0; },
						readSec: function(name) { return (parseFloat(this.read(name)) || 0) / 1000; },
						parseSpring: function(name) {
							const raw = this.read(name).replace(/"/g, '');
							const res = {};
							raw.split(';').filter(Boolean).forEach(function(p) {
								const kv = p.split(':');
								if (kv.length === 2) res[kv[0].trim()] = parseFloat(kv[1].trim());
							});
							return res;
						},
						motionEnabled: function() {
							return !root.classList.contains('a11y-mode') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						},
						clearCache: function() {
							_tokenCache.clear();
						}
					};
					window.addEventListener('themechanged', function() { window.SiteTokens.clearCache(); });

					// Visual Editor Live Bridge (Zero-Reload preview)
					window.addEventListener('message', function(e) {
						if (!e.data) return;
						if (e.data.type === 'SITE_TOKEN_UPDATE' && e.data.key && e.data.value) {
							root.style.setProperty(e.data.key, e.data.value);
							if (e.data.key === '--color-primary') {
								root.style.setProperty('--color-content', e.data.value);
								root.style.setProperty('--color-content-muted', 'color-mix(in srgb, ' + e.data.value + ' 65%, transparent)');
								root.style.setProperty('--color-primary-dark', 'color-mix(in srgb, ' + e.data.value + ', black 30%)');
								root.style.setProperty('--color-primary-light', 'color-mix(in srgb, ' + e.data.value + ', white 25%)');
								var phex = e.data.value.replace('#', '');
								if (phex.length === 3) phex = phex[0]+phex[0]+phex[1]+phex[1]+phex[2]+phex[2];
								if (phex.length === 6) {
									var pr = parseInt(phex.substring(0, 2), 16);
									var pg = parseInt(phex.substring(2, 4), 16);
									var pb = parseInt(phex.substring(4, 6), 16);
									var plum = (0.2126 * pr + 0.7152 * pg + 0.0722 * pb) / 255.0;
									root.style.setProperty('--color-on-primary', plum > 0.22 ? '#0f172a' : '#ffffff');
								}
							}
							if (e.data.key === '--color-surface') {
								root.style.setProperty('--color-surface-muted', 'color-mix(in srgb, var(--color-primary, #000) 4%, ' + e.data.value + ')');
							}
							if (e.data.key === '--color-accent') {
								var hex = e.data.value.replace('#', '');
								if (hex.length === 3) hex = hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
								if (hex.length === 6) {
									var r = parseInt(hex.substring(0, 2), 16);
									var g = parseInt(hex.substring(2, 4), 16);
									var b = parseInt(hex.substring(4, 6), 16);
									var lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
									root.style.setProperty('--color-on-accent', lum > 0.22 ? '#0f172a' : '#ffffff');
								}
								root.style.setProperty('--color-accent-hover', 'color-mix(in srgb, ' + e.data.value + ', black 15%)');
								root.style.setProperty('--color-accent-light', 'color-mix(in srgb, ' + e.data.value + ' 12%, white)');
							}
							window.SiteTokens.clearCache();
						}
						if (e.data.type === 'SITE_GRAYSCALE_UPDATE') {
							if (e.data.enabled) {
								root.style.filter = 'grayscale(100%) contrast(108%)';
							} else {
								root.style.filter = '';
							}
						}
						if (e.data.type === 'SITE_THEME_UPDATE' && e.data.theme) {
							root.setAttribute('data-theme', e.data.theme);
							window.SiteTokens.clearCache();
						}
						if (e.data.type === 'SITE_FLAVOR_UPDATE' && e.data.flavor) {
							root.setAttribute('data-flavor', e.data.flavor);
							window.SiteTokens.clearCache();
						}
						if (e.data.type === 'SITE_FONT_UPDATE' && e.data.font) {
							root.setAttribute('data-font', e.data.font);
							window.SiteTokens.clearCache();
						}
						if (e.data.type === 'SITE_CHECK_OVERFLOW') {
							checkHorizontalOverflow();
						}
						if (e.data.type === 'SITE_SCROLL_TO_BLOCK') {
							var target = null;
							if (e.data.blockId) {
								target = document.getElementById(e.data.blockId) ||
									document.querySelector('[data-block-id="' + e.data.blockId + '"]');
							}
							if (!target && e.data.blockType) {
								target = document.querySelector('[data-block="' + e.data.blockType + '"]') ||
									document.querySelector('section[data-component="' + e.data.blockType + '"]') ||
									document.querySelector('[data-block*="' + e.data.blockType.toLowerCase() + '"]');
							}
							if (target) {
								target.scrollIntoView({ behavior: 'smooth', block: 'center' });
								target.style.outline = '3px solid #2563eb';
								target.style.outlineOffset = '4px';
								target.style.boxShadow = '0 0 25px rgba(37,99,235,0.35)';
								target.style.transition = 'outline 0.2s, box-shadow 0.2s';
								setTimeout(function() {
									target.style.outline = '';
									target.style.outlineOffset = '';
									target.style.boxShadow = '';
								}, 2200);
							}
						}
					});

					// ----------------------------------------------------
					// 🛰️ Responsive Radar: Детектор горизонтального переполнения верстки
					// ----------------------------------------------------
					function checkHorizontalOverflow() {
						if (window.parent === window) return;
						var doc = document.documentElement;
						var winWidth = window.innerWidth;
						var scrollWidth = doc.scrollWidth;
						var hasOverflow = scrollWidth > (winWidth + 1);
						var culprits = [];

						if (hasOverflow) {
							var elements = document.querySelectorAll('body *');
							for (var i = 0; i < elements.length; i++) {
								var el = elements[i];
								var rect = el.getBoundingClientRect();
								if (rect.right > (winWidth + 1) || el.scrollWidth > (winWidth + 1)) {
									var bTag = el.tagName.toLowerCase();
									var bClass = (el.className && typeof el.className === 'string') ? el.className.split(' ').slice(0, 3).join(' ') : '';
									var blockName = el.getAttribute('data-block') || el.getAttribute('data-component') || (bTag + (el.id ? ('#' + el.id) : ('.' + bClass)));
									culprits.push({
										name: blockName,
										overflow: Math.round(Math.max(rect.right - winWidth, el.scrollWidth - winWidth))
									});
									if (culprits.length >= 3) break;
								}
							}
						}

						window.parent.postMessage({
							type: 'SITE_OVERFLOW_REPORT',
							hasOverflow: hasOverflow,
							scrollWidth: scrollWidth,
							winWidth: winWidth,
							diff: hasOverflow ? (scrollWidth - winWidth) : 0,
							culprits: culprits
						}, '*');
					}

					if (window.location.search.indexOf('preview=true') !== -1 && window.parent !== window) {
						window.addEventListener('load', function() { setTimeout(checkHorizontalOverflow, 400); });
						window.addEventListener('resize', function() { setTimeout(checkHorizontalOverflow, 200); });

						document.addEventListener('click', function(e) {
							var blockEl = e.target.closest('[data-block], section, [data-component]');
							if (blockEl) {
								var bType = blockEl.getAttribute('data-block') || blockEl.getAttribute('data-component') || '';
								var bId = blockEl.getAttribute('data-block-id') || blockEl.id || '';
								window.parent.postMessage({
									type: 'PREVIEW_BLOCK_CLICKED',
									blockType: bType,
									blockId: bId
								}, '*');
							}
						}, true);
					}

					// ----------------------------------------------------
					// ⚡ Микро-движок Scroll Reveal (IntersectionObserver < 0.5 КБ)
					// ----------------------------------------------------
					function initScrollReveal(scope) {
						if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
						if (root.classList.contains('a11y-mode')) return;

						const rootElement = scope || document;
						const elements = rootElement.querySelectorAll('[data-reveal]:not(.is-revealed)');
						if (!elements.length) return;

						if (!('IntersectionObserver' in window)) {
							elements.forEach(function(el) { el.classList.add('is-revealed'); });
							return;
						}

						const observer = new IntersectionObserver(function(entries) {
							entries.forEach(function(entry) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-revealed');
									observer.unobserve(entry.target);
								}
							});
						}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

						elements.forEach(function(el) { observer.observe(el); });
					}

					// Первичная синхронизация после загрузки DOM
					document.addEventListener('DOMContentLoaded', function() {
						if (window.htmx && window.htmx.findExtension) {
							var ext = window.htmx.findExtension('alpine-compat');
							if (ext && !window.htmx.findExtension('hx-alpine-compat')) {
								window.htmx.registerExtension('hx-alpine-compat', ext);
							}
						}
						window.A11Y.apply();
						initScrollReveal();
					});

					// Бесшовный перезапуск при HTMX Swap (фрагментарные обновления)
					document.addEventListener('htmx:afterSwap', function(evt) {
						if (window.Alpine && evt.detail && evt.detail.target) {
							window.Alpine.initTree(evt.detail.target);
						}
						initScrollReveal(evt.detail.target);
					});
				})();
			</script>
		</head>
		<body class="bg-surface text-content antialiased flex flex-col min-h-screen" hx-ext="alpine-compat, hx-alpine-compat">
			{ children... }
		</body>

	</html>
}
