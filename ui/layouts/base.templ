package layouts

import (
	"sitecraft/internal/models"
)

templ Base(title string, description string, settings models.SiteSettings) {
	<!DOCTYPE html>
	<html lang="ru" class="scroll-smooth" data-theme={ settings.Theme }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<meta name="description" content={ description }/>
			<!-- Open Graph / SEO -->
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:type" content="website"/>
			<!-- Google Fonts: Merriweather + Inter + Bebas Neue -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/>
			
			<!-- HTMX (Zero-JS foundation for AJAX requests) -->
			<script src="https://unpkg.com/htmx.org@4.0.0/dist/htmx.min.js"></script>

			<!-- Telegram WebApp SDK (автоматическая адаптация для TMA) -->
			<script src="https://telegram.org/js/telegram-web-app.js"></script>
			<script>
				(function() {
					if (window.Telegram && window.Telegram.WebApp) {
						try {
							var tg = window.Telegram.WebApp;
							tg.ready();
							tg.expand();
							document.addEventListener('htmx:configRequest', function(evt) {
								if (tg.initData) {
									evt.detail.headers['X-Telegram-Init-Data'] = tg.initData;
								}
							});
						} catch(e) {}
					}
				})();
			</script>

			<!-- Alpine.js + Mask Plugin for light client-side state (modals, mobile menu, phone masks) -->
			<script defer src="https://unpkg.com/@alpinejs/mask@3.x.x/dist/cdn.min.js"></script>
			<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

			<!-- Cloudflare Turnstile (если включен) -->
			if settings.EnableTurnstile && settings.TurnstileSiteKey != "" {
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			}

			<!-- Яндекс Метрика (если указан ID) -->
			if settings.YandexMetrikaID != "" {
				<script type="text/javascript">
					(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
					m[i].l=1*new Date();
					for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
					k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
					(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
					ym({ settings.YandexMetrikaID }, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
				</script>
			}

			<!-- Скомпилированные стили Tailwind с семантическими токенами -->
			<link rel="stylesheet" href="/assets/styles.css"/>
			<style>
				.font-serif-title { font-family: 'Merriweather', Georgia, serif; }
			</style>

			<!-- Динамическая инъекция темы из PocketBase (Theming Engine) -->
			if settings.PrimaryColor != "" || settings.AccentColor != "" || settings.BackgroundColor != "" || settings.FontFamily != "" {
				<style>
					:root {
						if settings.PrimaryColor != "" {
							--color-primary: { settings.PrimaryColor };
							--color-primary-dark: { settings.PrimaryColor };
							--color-primary-light: { settings.PrimaryColor };
						}
						if settings.AccentColor != "" {
							--color-accent: { settings.AccentColor };
							--color-accent-hover: { settings.AccentColor };
						}
						if settings.BackgroundColor != "" {
							--color-surface: { settings.BackgroundColor };
						}
						if settings.FontFamily != "" {
							--font-custom: { settings.FontFamily }, sans-serif;
							font-family: var(--font-custom);
						}
					}
				</style>
			}

			<!-- Микро-скрипт Доступности и Темы на чистом Vanilla JS (< 1.5 КБ, без зависимостей) -->
			<script>
				(function() {
					const root = document.documentElement;
					
					// Тема сайта (сохраняется в localStorage)
					const savedTheme = localStorage.getItem('sitecraft_theme') || root.getAttribute('data-theme') || 'main';
					root.setAttribute('data-theme', savedTheme);

					// API Доступности (a11y)
					window.A11Y = {
						active: localStorage.getItem('a11y_active') === 'true',
						fontSize: localStorage.getItem('a11y_font') || 'normal',
						spacing: localStorage.getItem('a11y_spacing') || 'normal',
						theme: localStorage.getItem('a11y_theme') || 'black-on-white',
						images: localStorage.getItem('a11y_images') || 'on',

						apply: function() {
							const toolbar = document.getElementById('a11y-toolbar');
							if (this.active) {
								root.classList.add('a11y-mode');
								root.setAttribute('data-a11y-font', this.fontSize);
								root.setAttribute('data-a11y-spacing', this.spacing);
								root.setAttribute('data-a11y-theme', this.theme);
								root.setAttribute('data-a11y-images', this.images);
								if (toolbar) toolbar.classList.remove('hidden');
							} else {
								root.classList.remove('a11y-mode');
								root.removeAttribute('data-a11y-font');
								root.removeAttribute('data-a11y-spacing');
								root.removeAttribute('data-a11y-theme');
								root.removeAttribute('data-a11y-images');
								if (toolbar) toolbar.classList.add('hidden');
							}
							this.updateUI();
						},

						toggle: function() {
							this.active = !this.active;
							localStorage.setItem('a11y_active', this.active);
							this.apply();
						},

						setFont: function(size) {
							this.fontSize = size;
							localStorage.setItem('a11y_font', size);
							root.setAttribute('data-a11y-font', size);
							this.updateUI();
						},

						setColorScheme: function(scheme) {
							this.theme = scheme;
							localStorage.setItem('a11y_theme', scheme);
							root.setAttribute('data-a11y-theme', scheme);
							this.updateUI();
						},

						toggleSpacing: function() {
							this.spacing = (this.spacing === 'normal') ? 'wide' : 'normal';
							localStorage.setItem('a11y_spacing', this.spacing);
							root.setAttribute('data-a11y-spacing', this.spacing);
							this.updateUI();
						},

						toggleImages: function() {
							this.images = (this.images === 'on') ? 'off' : 'on';
							localStorage.setItem('a11y_images', this.images);
							root.setAttribute('data-a11y-images', this.images);
							this.updateUI();
						},

						updateUI: function() {
							const sBtn = document.getElementById('a11y-spacing-btn');
							if (sBtn) sBtn.textContent = this.spacing === 'wide' ? 'Интервал: Широкий' : 'Интервал: Обычный';
							const iBtn = document.getElementById('a11y-images-btn');
							if (iBtn) iBtn.textContent = this.images === 'off' ? 'Изображения: Выкл' : 'Изображения: Вкл';
						}
					};

					// Переключение тем сайта (Основная + Времена года + День/Ночь)
					window.getThemeState = function() {
						const current = root.getAttribute('data-theme') || 'main';
						const isNight = current.endsWith('-night') || current === 'dark';
						let base = current.replace('-night', '').replace('-day', '');
						if (base === 'dark' || base === 'default' || base === 'legal') base = 'main';
						return { base: base, isNight: isNight };
					};

					window.setSiteTheme = function(seasonName) {
						const state = window.getThemeState();
						const season = seasonName || state.base;
						const newTheme = state.isNight ? (season + '-night') : season;
						root.setAttribute('data-theme', newTheme);
						localStorage.setItem('sitecraft_theme', newTheme);
						window.dispatchEvent(new CustomEvent('themechanged', { detail: { theme: newTheme, season: season, isNight: state.isNight } }));
					};

					window.toggleNightMode = function() {
						const state = window.getThemeState();
						const newTheme = state.isNight ? state.base : (state.base + '-night');
						root.setAttribute('data-theme', newTheme);
						localStorage.setItem('sitecraft_theme', newTheme);
						window.dispatchEvent(new CustomEvent('themechanged', { detail: { theme: newTheme, season: state.base, isNight: !state.isNight } }));
					};

					// ----------------------------------------------------
					// ⚡ Микро-движок Scroll Reveal (IntersectionObserver < 0.5 КБ)
					// ----------------------------------------------------
					function initScrollReveal(scope) {
						if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
						if (root.classList.contains('a11y-mode')) return;

						const rootElement = scope || document;
						const elements = rootElement.querySelectorAll('[data-reveal]:not(.is-revealed)');
						if (!elements.length) return;

						if (!('IntersectionObserver' in window)) {
							elements.forEach(function(el) { el.classList.add('is-revealed'); });
							return;
						}

						const observer = new IntersectionObserver(function(entries) {
							entries.forEach(function(entry) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-revealed');
									observer.unobserve(entry.target);
								}
							});
						}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

						elements.forEach(function(el) { observer.observe(el); });
					}

					// Первичная синхронизация после загрузки DOM
					document.addEventListener('DOMContentLoaded', function() {
						window.A11Y.apply();
						initScrollReveal();
					});

					// Бесшовный перезапуск при HTMX Swap (фрагментарные обновления)
					document.addEventListener('htmx:after:swap', function(evt) {
						initScrollReveal(evt.detail.target);
					});
					document.addEventListener('htmx:afterSwap', function(evt) {
						initScrollReveal(evt.detail.target);
					});
				})();
			</script>
		</head>
		<body class="bg-surface text-content antialiased flex flex-col min-h-screen">
			{ children... }
		</body>
	</html>
}
