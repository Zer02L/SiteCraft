package pages

import (
	"sitecraft/internal/models"
)

templ ClientContactsTab(content models.SiteContent, settings models.SiteSettings) {
	<div class="max-w-5xl space-y-6">
		<div class="pb-4 border-b border-admin-border">
			<h2 class="text-lg font-semibold text-admin-content tracking-tight">Контакты и реквизиты</h2>
			<p class="text-xs text-admin-content-muted mt-0.5">Управление телефонами, мессенджерами, адресом и рабочим графиком на сайте</p>
		</div>

		<form
			x-data="{ dirty: false }"
			@input="dirty = true"
			@change="dirty = true"
			hx-post="/client/contacts"
			hx-target="#contacts-save-status"
			hx-swap="innerHTML"
			@htmx:after-request="if ($event.detail.successful) { dirty = false; $dispatch('admin-toast', { message: 'Контакты сохранены', tone: 'success' }); }"
			class="space-y-6"
		>
			<!-- Секция 1: Компания и каналы связи -->
			<div class="bg-admin-surface border border-admin-border rounded-xl p-5 sm:p-6">
				<div class="grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] gap-6">
					<div>
						<h3 class="text-sm font-semibold text-admin-content">Компания и мессенджеры</h3>
						<p class="text-xs text-admin-content-muted mt-1 leading-relaxed">Отображается в шапке сайта, карточках контактов и кнопках быстрой связи.</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">
								Название компании / Сайта <span class="text-admin-accent">*</span>
							</label>
							<input
								type="text"
								name="site_name"
								value={ settings.SiteName }
								required
								minlength="2"
								maxlength="100"
								pattern=".*\S+.*"
								title="Название сайта должно содержать от 2 до 100 символов"
								placeholder="Моя Компания"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Обязательное поле (от 2 до 100 символов)</p>
						</div>

						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Слоган / Деятельность</label>
							<input
								type="text"
								name="tagline"
								value={ settings.Tagline }
								maxlength="150"
								placeholder="Например: Надежная защита ваших интересов"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Краткое описание деятельности (до 150 символов)</p>
						</div>

						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">
								Основной телефон <span class="text-admin-accent">*</span>
							</label>
							<input
								type="tel"
								name="phone1"
								value={ formatPhoneMask(content.Phone1) }
								required
								x-data
								x-mask="+7 (999) 999-99-99"
								placeholder="+7 (999) 000-00-00"
								pattern="^\+7 \(\d{3}\) \d{3}-\d{2}-\d{2}$"
								title="Формат номера: +7 (999) 999-99-99"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono tabular-nums placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Формат: +7 (XXX) XXX-XX-XX</p>
						</div>

						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Дополнительный телефон</label>
							<input
								type="tel"
								name="phone2"
								value={ formatPhoneMask(content.Phone2) }
								x-data
								x-mask="+7 (999) 999-99-99"
								placeholder="+7 (999) 000-00-00"
								pattern="^(\+7 \(\d{3}\) \d{3}-\d{2}-\d{2})?$"
								title="Формат номера: +7 (999) 999-99-99 или оставьте пустым"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono tabular-nums placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Необязательно, формат +7 (XXX) XXX-XX-XX</p>
						</div>

						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">WhatsApp (номер для чата)</label>
							<input
								type="tel"
								name="whatsapp_phone"
								value={ formatPhoneMask(settings.WhatsappPhone) }
								x-data
								x-mask="+7 (999) 999-99-99"
								placeholder="+7 (999) 000-00-00"
								pattern="^(\+7 \(\d{3}\) \d{3}-\d{2}-\d{2})?$"
								title="Формат номера WhatsApp: +7 (999) 999-99-99 или оставьте пустым"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono tabular-nums placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Для прямой ссылки wa.me</p>
						</div>

						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Telegram (юзернейм или ссылка)</label>
							<input
								type="text"
								name="telegram_contact"
								value={ settings.TelegramContact }
								placeholder="@my_channel или t.me/my_channel"
								maxlength="60"
								pattern="^(@[a-zA-Z0-9_]{3,32}|(https?:\/\/)?t\.me\/[a-zA-Z0-9_]{3,32}|[a-zA-Z0-9_]{3,32})?$"
								title="Юзернейм Telegram (@username или t.me/username)"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Формат: &#64;username или t.me/username</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Секция 2: Адрес и режим работы -->
			<div class="bg-admin-surface border border-admin-border rounded-xl p-5 sm:p-6">
				<div class="grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] gap-6">
					<div>
						<h3 class="text-sm font-semibold text-admin-content">Адрес и график работы</h3>
						<p class="text-xs text-admin-content-muted mt-1 leading-relaxed">Используется в подвале, разделе контактов и микроразметке для поисковых систем.</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div class="sm:col-span-2">
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">
								Адрес офиса / филиала <span class="text-admin-accent">*</span>
							</label>
							<input
								type="text"
								name="address"
								value={ content.Address }
								required
								minlength="5"
								maxlength="200"
								pattern=".*\S+.*"
								title="Фактический адрес (от 5 до 200 символов)"
								placeholder="г. Москва, ул. Ленина, д. 10"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Обязательное поле для отображения на сайте и картах</p>
						</div>

						<div class="sm:col-span-2">
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Уточнение адреса (этаж, ориентир, город)</label>
							<input
								type="text"
								name="address_sub"
								value={ content.AddressSub }
								maxlength="100"
								placeholder="Офис 302, 3 этаж, БЦ Плаза"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Дополнительные ориентиры для клиентов</p>
						</div>

						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">График работы</label>
							<input
								type="text"
								name="work_hours"
								value={ content.WorkHours }
								maxlength="60"
								placeholder="Пн-Пт: 09:00 - 18:00"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Рабочие часы в будние дни</p>
						</div>

						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Выходные дни</label>
							<input
								type="text"
								name="days_off"
								value={ content.DaysOff }
								maxlength="60"
								placeholder="Сб, Вс"
								class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm placeholder:text-admin-content-subtle transition-colors"
							/>
							<p class="text-[11px] text-admin-content-subtle mt-1">Дни отдыха или праздники</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Sticky Save Bar -->
			<div class="sticky bottom-4 z-10 flex flex-wrap items-center justify-between gap-3 px-4 py-3 rounded-xl border border-admin-border bg-admin-surface-elevated">
				<div class="flex items-center gap-3 min-h-6">
					<span x-show="dirty" x-cloak class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning-border">
						Есть несохранённые изменения
					</span>
					<div id="contacts-save-status"></div>
				</div>
				<button
					type="submit"
					class="px-4 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-xs transition active:scale-[0.99] flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>Сохранить изменения</span>
				</button>
			</div>
		</form>
	</div>
}

templ ClientSecurityTab(msg string, errMsg string) {
	<div class="max-w-2xl space-y-6">
		<div class="pb-4 border-b border-admin-border">
			<h2 class="text-lg font-semibold text-admin-content tracking-tight">Безопасность и доступ</h2>
			<p class="text-xs text-admin-content-muted mt-0.5">Управление паролем доступа к панели управления сайтом</p>
		</div>

		<div class="bg-admin-surface border border-admin-border rounded-xl p-5 sm:p-6">
			<div id="security-feedback">
				if msg != "" {
					<div class="mb-5 p-3 rounded-lg bg-admin-success-muted border border-admin-success-border text-admin-success text-xs flex items-center gap-2">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
						<span>{ msg }</span>
					</div>
				}
				if errMsg != "" {
					<div class="mb-5 p-3 rounded-lg bg-admin-danger-muted border border-admin-danger-border text-admin-danger text-xs flex items-center gap-2">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}
			</div>

			<form
				hx-post="/client/security/password"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class="space-y-4"
			>
				<div>
					<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Текущий пароль</label>
					<input
						type="password"
						name="current_password"
						required
						placeholder="Введите текущий пароль..."
						class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle transition-colors text-sm"
					/>
				</div>

				<div>
					<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Новый пароль</label>
					<input
						type="password"
						name="new_password"
						required
						minlength="8"
						placeholder="Минимум 8 символов..."
						class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle transition-colors text-sm"
					/>
					<p class="mt-1 text-[11px] text-admin-content-subtle">Пароль должен содержать не менее 8 знаков</p>
				</div>

				<div>
					<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Подтверждение нового пароля</label>
					<input
						type="password"
						name="confirm_password"
						required
						minlength="8"
						placeholder="Повторите новый пароль..."
						class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle transition-colors text-sm"
					/>
				</div>

				<div class="pt-2">
					<button
						type="submit"
						class="px-4 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-xs transition active:scale-[0.99] flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
						<span>Обновить пароль</span>
					</button>
				</div>
			</form>
		</div>
	</div>
}
