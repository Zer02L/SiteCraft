package pages

import (
	"fmt"
	"sitecraft/internal/checker"
)

func getPercentTextColor(pct int) string {
	if pct == 100 {
		return "text-admin-success"
	} else if pct >= 70 {
		return "text-admin-accent"
	}
	return "text-admin-warning"
}

func getProgressBarBg(pct int) string {
	if pct == 100 {
		return "bg-admin-success"
	} else if pct >= 70 {
		return "bg-admin-accent"
	}
	return "bg-admin-warning"
}

func getStatusDotBg(pct int) string {
	if pct == 100 {
		return "bg-admin-success"
	} else if pct >= 70 {
		return "bg-admin-accent"
	}
	return "bg-admin-warning"
}

func getItemCardClasses(item checker.ChecklistItem) string {
	if item.IsCompleted {
		return "bg-admin-surface-muted/40 border-admin-border-subtle"
	}
	if item.IsCritical {
		return "bg-admin-surface border-admin-warning-border hover:border-admin-warning"
	}
	return "bg-admin-surface border-admin-border hover:border-admin-accent-border"
}

func getItemTitleClasses(item checker.ChecklistItem) string {
	if item.IsCompleted {
		return "text-admin-content-muted line-through decoration-admin-content-muted/40"
	}
	return "text-admin-content"
}

templ SetupChecklistWidget(result checker.ChecklistResult) {
	<div
		id="admin-setup-checklist"
		hx-get="/admin/api/checklist"
		hx-trigger="refreshChecklist from:body"
		hx-swap="outerHTML"
		class="relative inline-flex items-center"
	>
		<!-- Компактная пилюля готовности в верхней панели -->
		<button
			type="button"
			onclick="document.getElementById('admin-checklist-dialog').showModal()"
			class="px-2.5 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs text-admin-content transition-colors flex items-center gap-2 font-medium cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
			title="Чеклист готовности к запуску"
			aria-label="Открыть чеклист готовности к запуску"
		>
			<span class={ "w-2 h-2 rounded-full shrink-0 " + getStatusDotBg(result.Percentage) }></span>
			<span class="hidden sm:inline text-admin-content-muted">Готовность</span>
			<span class={ "font-mono tabular-nums font-semibold " + getPercentTextColor(result.Percentage) }>
				{ fmt.Sprintf("%d%%", result.Percentage) }
			</span>
		</button>

		<!-- Нативный <dialog> чеклиста готовности -->
		<dialog
			id="admin-checklist-dialog"
			onclick="if (event.target === this) this.close()"
			class="admin-dialog fixed inset-0 m-auto bg-admin-surface-elevated border border-admin-border rounded-xl p-0 text-admin-content max-w-2xl w-[calc(100%-2rem)] shadow-xl z-50 h-fit overflow-hidden"
		>
			<!-- Шапка -->
			<div class="p-5 border-b border-admin-border flex items-start justify-between gap-4">
				<div class="flex items-start gap-3 min-w-0">
					<div class="w-9 h-9 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-accent flex items-center justify-center shrink-0">
						<svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
					<div class="min-w-0">
						<div class="flex items-center gap-2 flex-wrap">
							<h3 class="font-semibold text-base text-admin-content tracking-tight">
								Чеклист готовности к запуску
							</h3>
							if result.IsReady {
								<span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-admin-success-muted text-admin-success border border-admin-success-border">
									Готов к запуску
								</span>
							} else {
								<span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning-border">
									Требуется настройка
								</span>
							}
						</div>
						<p class="text-xs text-admin-content-muted mt-0.5 tabular-nums">
							{ fmt.Sprintf("Выполнено %d из %d пунктов (%d%%)", result.CompletedCount, result.TotalCount, result.Percentage) }
							if result.CriticalPendingCount() > 0 {
								<span class="text-admin-warning font-medium">
									{ fmt.Sprintf(" · %d обязательных", result.CriticalPendingCount()) }
								</span>
							}
						</p>
					</div>
				</div>

				<button
					type="button"
					onclick="document.getElementById('admin-checklist-dialog').close()"
					class="p-1.5 rounded-lg text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					title="Закрыть"
					aria-label="Закрыть чеклист готовности"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>

			<!-- Прогресс-бар -->
			<div class="px-5 pt-4">
				<div class="h-1.5 w-full bg-admin-surface-muted rounded-full overflow-hidden">
					<div
						class={ "h-full rounded-full " + getProgressBarBg(result.Percentage) }
						style={ fmt.Sprintf("width: %d%%", result.Percentage) }
					></div>
				</div>

				if result.Percentage == 100 {
					<div class="mt-4 p-3 rounded-lg bg-admin-success-muted border border-admin-success-border text-admin-success text-xs flex items-center gap-2">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>Все основные шаги выполнены. Сайт полностью сконфигурирован и готов к запуску.</span>
					</div>
				}
			</div>

			<!-- Сетка шагов чеклиста -->
			<div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[60vh] overflow-y-auto">
				if len(result.Items) == 0 {
					<div class="sm:col-span-2 p-6 text-center rounded-lg border border-dashed border-admin-border text-xs text-admin-content-muted">
						Список проверок пока пустой
					</div>
				} else {
					for _, item := range result.Items {
					<div class={ "p-3.5 rounded-lg border flex flex-col justify-between transition-colors " + getItemCardClasses(item) }>
						<div class="flex items-start gap-2.5">
							if item.IsCompleted {
								<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-admin-success-muted text-admin-success border border-admin-success-border shrink-0 mt-0.5">
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
									</svg>
								</span>
							} else if item.IsCritical {
								<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-admin-warning-muted text-admin-warning border border-admin-warning-border shrink-0 text-[11px] font-mono font-bold mt-0.5">
									!
								</span>
							} else {
								<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-admin-surface-muted text-admin-content-subtle border border-admin-border shrink-0 mt-0.5">
									<span class="w-1.5 h-1.5 rounded-full bg-admin-content-subtle"></span>
								</span>
							}
							<div class="min-w-0 flex-1">
								<div class="flex items-center gap-1.5 flex-wrap">
									<span class={ "text-xs font-semibold tracking-tight " + getItemTitleClasses(item) }>
										{ item.Title }
									</span>
									if item.IsCritical && !item.IsCompleted {
										<span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning-border">
											Важно
										</span>
									}
								</div>
								<p class="text-[11px] text-admin-content-muted mt-0.5 leading-snug">
									{ item.Description }
								</p>
							</div>
						</div>

						<div class="mt-3 flex items-center justify-end">
							if !item.IsCompleted {
								<button
									type="button"
									@click={ fmt.Sprintf("document.getElementById('admin-checklist-dialog').close(); openTab('%s', '%s')", item.TabID, item.ActionRoute()) }
									class="px-2.5 py-1 rounded-md text-xs font-medium bg-admin-accent-muted hover:bg-admin-accent/20 text-admin-accent border border-admin-accent-border transition-colors flex items-center gap-1 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
								>
									<span>{ item.ActionLabel }</span>
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
									</svg>
								</button>
							} else {
								<span class="text-[11px] font-medium text-admin-success flex items-center gap-1">
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
									Готово
								</span>
							}
						</div>
					</div>
					}
				}
			</div>
		</dialog>
	</div>
}
