package pages

import (
	"fmt"
	"sitecraft/internal/checker"
)

func getPercentTextColor(pct int) string {
	if pct == 100 {
		return "text-emerald-500"
	} else if pct >= 70 {
		return "text-admin-accent"
	}
	return "text-amber-500"
}

func getProgressBarBg(pct int) string {
	if pct == 100 {
		return "bg-emerald-500"
	} else if pct >= 70 {
		return "bg-admin-accent"
	}
	return "bg-amber-500"
}

func getItemCardClasses(item checker.ChecklistItem) string {
	if item.IsCompleted {
		return "bg-admin-surface-muted/30 border-admin-border/50"
	}
	if item.IsCritical {
		return "bg-admin-surface border-amber-500/30 hover:border-amber-500/60"
	}
	return "bg-admin-surface border-admin-border hover:border-admin-accent/40"
}

func getItemTitleClasses(item checker.ChecklistItem) string {
	if item.IsCompleted {
		return "text-admin-content-muted line-through decoration-admin-content-muted/40"
	}
	return "text-admin-content"
}

templ SetupChecklistWidget(result checker.ChecklistResult) {
	<div
		id="admin-setup-checklist"
		hx-get="/admin/api/checklist"
		hx-trigger="refreshChecklist from:body"
		hx-swap="outerHTML"
		x-data={ fmt.Sprintf("{ open: %t }", result.Percentage < 100) }
		class="bg-admin-surface border border-admin-border rounded-2xl p-5 sm:p-6 shadow-xs transition-all duration-200"
	>
		<!-- Заголовок и процентная шкала -->
		<div class="flex items-center justify-between gap-4">
			<div class="flex items-center gap-3.5 min-w-0">
				if result.Percentage == 100 {
					<div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 flex items-center justify-center shrink-0 font-bold text-base">
						🚀
					</div>
				} else if result.Percentage >= 70 {
					<div class="w-10 h-10 rounded-xl bg-admin-accent-muted border border-admin-accent-border text-admin-accent flex items-center justify-center shrink-0 font-bold text-base">
						⚡
					</div>
				} else {
					<div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-500 flex items-center justify-center shrink-0 font-bold text-base">
						📋
					</div>
				}
				<div class="min-w-0">
					<div class="flex items-center gap-2 flex-wrap">
						<h3 class="font-bold text-sm sm:text-base text-admin-content tracking-tight">
							Чеклист готовности к запуску
						</h3>
						if result.IsReady {
							<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/25">
								Готов к запуску
							</span>
						} else {
							<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-500 border border-amber-500/25">
								Требуется настройка
							</span>
						}
					</div>
					<p class="text-xs text-admin-content-muted mt-0.5 truncate">
						{ fmt.Sprintf("Выполнено %d из %d пунктов (%d%%)", result.CompletedCount, result.TotalCount, result.Percentage) }
						if result.CriticalPendingCount() > 0 {
							<span class="text-amber-500 font-medium">
								{ fmt.Sprintf(" • %d обязательных", result.CriticalPendingCount()) }
							</span>
						}
					</p>
				</div>
			</div>

			<div class="flex items-center gap-3 shrink-0">
				<span class={ "text-base sm:text-lg font-bold font-mono " + getPercentTextColor(result.Percentage) }>
					{ fmt.Sprintf("%d%%", result.Percentage) }
				</span>
				<button
					type="button"
					@click="open = !open"
					class="p-2 rounded-xl border border-admin-border hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content transition-colors cursor-pointer"
					:title="open ? 'Свернуть чеклист' : 'Развернуть чеклист'"
					aria-label="Свернуть или развернуть чеклист"
				>
					<svg
						class="w-4 h-4 transition-transform duration-200"
						:class="{ 'rotate-180': open }"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Прогресс-бар -->
		<div class="mt-4 h-2 w-full bg-admin-surface-muted rounded-full overflow-hidden border border-admin-border/40">
			<div
				class={ "h-full rounded-full transition-all duration-500 " + getProgressBarBg(result.Percentage) }
				style={ fmt.Sprintf("width: %d%%", result.Percentage) }
			></div>
		</div>

		if result.Percentage == 100 {
			<div x-show="open" class="mt-4 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs flex items-center gap-2.5">
				<svg class="w-4 h-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
				<span>Поздравляем! Все основные шаги выполнены. Сайт полностью сконфигурирован и готов к запуску.</span>
			</div>
		}

		<!-- Сетка шагов чеклиста -->
		<div x-show="open" class="mt-5 pt-5 border-t border-admin-border grid grid-cols-1 md:grid-cols-2 gap-3">
			for _, item := range result.Items {
				<div class={ "p-3.5 rounded-xl border flex flex-col justify-between transition-colors " + getItemCardClasses(item) }>
					<div class="flex items-start gap-2.5">
						if item.IsCompleted {
							<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-500 border border-emerald-500/30 shrink-0 mt-0.5">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
								</svg>
							</span>
						} else if item.IsCritical {
							<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-500/15 text-amber-500 border border-amber-500/30 shrink-0 text-xs font-bold font-mono mt-0.5">
								!
							</span>
						} else {
							<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-admin-surface-muted text-admin-content-subtle border border-admin-border shrink-0 text-xs font-bold font-mono mt-0.5">
								•
							</span>
						}
						<div class="min-w-0 flex-1">
							<div class="flex items-center gap-1.5 flex-wrap">
								<span class={ "text-xs font-semibold tracking-tight " + getItemTitleClasses(item) }>
									{ item.Title }
								</span>
								if item.IsCritical && !item.IsCompleted {
									<span class="px-1.5 py-0.2 rounded text-[9px] font-semibold uppercase tracking-wider bg-amber-500/15 text-amber-500 border border-amber-500/25">
										Важно
									</span>
								}
							</div>
							<p class="text-[11px] text-admin-content-muted mt-0.5 leading-snug">
								{ item.Description }
							</p>
						</div>
					</div>

					<div class="mt-3 flex items-center justify-end">
						if !item.IsCompleted {
							<button
								type="button"
								@click={ fmt.Sprintf("currentTab = '%s'; htmx.ajax('GET', '%s', {target: '#admin-tab-content', swap: 'innerHTML'}); history.pushState(null, '', '%s')", item.TabID, item.ActionRoute(), item.ActionURL) }
								class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-admin-accent-muted hover:bg-admin-accent/20 text-admin-accent border border-admin-accent-border transition-colors flex items-center gap-1 cursor-pointer"
							>
								<span>{ item.ActionLabel }</span>
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
								</svg>
							</button>
						} else {
							<span class="text-[10px] font-mono text-emerald-500 flex items-center gap-1">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
								</svg>
								Готово
							</span>
						}
					</div>
				</div>
			}
		</div>
	</div>
}
