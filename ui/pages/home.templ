package pages

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components"
	"sitecraft/ui/layouts"
	"sitecraft/ui/registry"
	"sitecraft/ui/sections"
	"sitecraft/ui/sections/hero"
)

templ Home(data HomePageData) {
	@layouts.Base(data.Settings.SiteName+" — "+data.Content.HeroTitle, data.Content.HeroSubtitle, data.Settings, models.NewHomeSEO(data.Settings, data.Content, "")) {
		if data.Settings.EnableA11y {
			@components.A11yBar()
		}
		@components.Header(data.Content, data.Settings)

		<!-- Динамический модульный рендеринг секций через BlockRegistry (Factory Pattern) -->
		if len(data.Blocks) > 0 {
			for _, b := range data.Blocks {
				@registry.RenderBlock(b, data.RenderContext())
			}
		} else {
			<!-- Дефолтный порядок, если блоки еще не настроены -->
			if data.Settings.Theme == "cyber" {
				@hero.CyberHero(data.Content, data.Settings)
			} else if data.Settings.Theme == "legal" {
				@hero.LegalHero(data.Content, data.Settings)
			} else {
				@hero.Hero(data.Content)
			}
			@sections.ScheduleBar(data.Content)
			@sections.Features(data.Settings.Theme, nil)
			@sections.Services(data.Services, data.Settings)
			@sections.Reviews(data.Settings.Theme, data.Reviews)
			@sections.Booking(data.Content, data.BookedSlots, data.Settings, data.Resources)
			@sections.Faq(data.Settings.Theme, nil)
			@sections.MapSection(data.Content, data.Settings, data.Branches)
		}

		@components.Footer(data.Content, data.Settings)

		if data.Settings.EnableFloatingContact {
			@components.FloatingContact(data.Content, data.Settings)
		}
		if data.Settings.EnableCart {
			@components.CartDrawer(data.Settings)
		}
		if data.Settings.EnableLiveChat {
			@components.ChatWidget(data.Settings)
		}
		if data.Settings.EnableRecentActivity {
			@components.RecentActivity(data.Settings)
		}
		@components.ExitIntent(data.Settings)
		if data.Settings.EnableCookieConsent {
			@components.CookieConsent(data.Settings)
		}
	}
}
