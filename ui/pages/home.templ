package pages

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components"
	"sitecraft/ui/layouts"
	"sitecraft/ui/registry"
	"sitecraft/ui/sections"
	"sitecraft/ui/sections/hero"
)

templ Home(settings models.SiteSettings, content models.SiteContent, services []models.ServiceItem, bookedSlots map[string][]string, blocks []models.PageBlock, resources []models.ResourceItem, reviews []models.ReviewItem, branches []models.BranchItem, vacancies []models.VacancyItem) {
	@layouts.Base(settings.SiteName+" — "+content.HeroTitle, content.HeroSubtitle, settings, models.NewHomeSEO(settings, content, "")) {
		if settings.EnableA11y {
			@components.A11yBar()
		}
		@components.Header(content, settings)

		<!-- Динамический модульный рендеринг секций через BlockRegistry (Factory Pattern) -->
		if len(blocks) > 0 {
			for _, b := range blocks {
				@registry.RenderBlock(b, registry.RenderContext{
					Settings:    settings,
					Content:     content,
					Services:    services,
					BookedSlots: bookedSlots,
					Resources:   resources,
					Reviews:     reviews,
					Branches:    branches,
					Vacancies:   vacancies,
				})
			}
		} else {
			<!-- Дефолтный порядок, если блоки еще не настроены -->
			if settings.Theme == "cyber" {
				@hero.CyberHero(content, settings)
			} else if settings.Theme == "legal" {
				@hero.LegalHero(content, settings)
			} else {
				@hero.Hero(content)
			}
			@sections.ScheduleBar(content)
			@sections.Features(settings.Theme, nil)
			@sections.Services(services, settings)
			@sections.Reviews(settings.Theme, reviews)
			@sections.Booking(content, bookedSlots, settings, resources)
			@sections.Faq(settings.Theme, nil)
			@sections.MapSection(content, settings, branches)
		}

		@components.Footer(content, settings)

		if settings.EnableFloatingContact {
			@components.FloatingContact(content, settings)
		}
		if settings.EnableCart {
			@components.CartDrawer(settings)
		}
		if settings.EnableLiveChat {
			@components.ChatWidget(settings)
		}
		if settings.EnableRecentActivity {
			@components.RecentActivity(settings)
		}
		@components.ExitIntent(settings)
		if settings.EnableCookieConsent {
			@components.CookieConsent(settings)
		}
	}
}
