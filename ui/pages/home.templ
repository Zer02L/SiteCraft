package pages

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components"
	"sitecraft/ui/layouts"
	"sitecraft/ui/sections"
	"sitecraft/ui/sections/hero"
)

templ Home(settings models.SiteSettings, content models.SiteContent, services []models.ServiceItem, bookedSlots map[string][]string, blocks []models.PageBlock) {
	@layouts.Base(settings.SiteName+" — "+content.HeroTitle, content.HeroSubtitle, settings, models.NewHomeSEO(settings, content, "")) {
		if settings.EnableA11y {
			@components.A11yBar()
		}
		@components.Header(content, settings)

		<!-- Динамический модульный рендеринг секций через BlockRegistry (Factory Pattern) -->
		if len(blocks) > 0 {
			for _, b := range blocks {
				@RenderBlock(b, RenderContext{
					Settings:    settings,
					Content:     content,
					Services:    services,
					BookedSlots: bookedSlots,
				})
			}
		} else {
			<!-- Дефолтный порядок, если блоки еще не настроены -->
			if settings.Theme == "cyber" {
				@hero.CyberHero(content, settings)
			} else {
				@hero.Hero(content)
			}
			@sections.ScheduleBar(content)
			@sections.Features(settings.Theme, nil)
			@sections.Services(services, settings)
			@sections.Reviews(settings.Theme)
			@sections.Booking(content, bookedSlots, settings)
			@sections.Faq(settings.Theme, nil)
			@sections.MapSection(content, settings)
		}

		@components.Footer(content, settings)
	}
}
