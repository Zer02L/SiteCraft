package pages

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components"
	"sitecraft/ui/layouts"
)

templ Home(settings models.SiteSettings, content models.SiteContent, services []models.ServiceItem, bookedSlots map[string][]string, blocks []models.PageBlock) {
	@layouts.Base(settings.SiteName+" — "+content.HeroTitle, content.HeroSubtitle, settings) {
		if settings.EnableA11y {
			@components.A11yBar()
		}
		@components.Header(content, settings)

		<!-- Динамический модульный рендеринг секций по порядку (Block Reordering) -->
		if len(blocks) > 0 {
			for _, b := range blocks {
				switch b.Type {
					case "hero":
						@components.Hero(content)
					case "schedule":
						@components.ScheduleBar(content)
					case "services":
						@components.Services(services, settings)
					case "booking":
						@components.Booking(content, bookedSlots, settings)
					case "map":
						@components.MapSection(content, settings)
					case "rich_text", "html":
						@components.DynamicBlock(b)
				}
			}
		} else {
			<!-- Дефолтный порядок, если блоки еще не настроены -->
			@components.Hero(content)
			@components.ScheduleBar(content)
			@components.Services(services, settings)
			@components.Booking(content, bookedSlots, settings)
			@components.MapSection(content, settings)
		}

		@components.Footer(content)
	}
}
