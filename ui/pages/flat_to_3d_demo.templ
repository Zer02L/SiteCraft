package pages

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components/cinematic"
	"sitecraft/ui/layouts"
)

templ FlatTo3DDemo(settings models.SiteSettings) {
	@layouts.Base("NORDIC TIMBER — Архитектурное бюро & Префаб технологии", "Инновационное проектирование загородных вилл с интерактивной 3D-экспликацией чертежей Flat-to-3D на WebGL", settings) {
		<div class="min-h-screen bg-surface text-content font-sans">
			<!-- Плавающий навигационный хедер в архитектурном стиле -->
			<header class="fixed top-0 left-0 right-0 z-40 bg-surface/80 backdrop-blur-md border-b border-content/10 px-4 sm:px-8 py-3.5 flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<div class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center text-white font-bold font-mono text-sm shadow-md">
						NT
					</div>
					<div>
						<span class="font-bold tracking-tight text-sm uppercase">Nordic Timber</span>
						<span class="hidden sm:inline-block ml-2 text-xs font-mono text-content/50">| ARCHITECTURAL LAB</span>
					</div>
				</div>

				<nav class="hidden md:flex items-center space-x-6 text-xs font-mono tracking-wider text-content/75">
					<a href="#hero-3d" class="hover:text-accent transition-colors">01. 3D-ЧЕРТЕЖ</a>
					<a href="#technology" class="hover:text-accent transition-colors">02. ТЕХНОЛОГИЯ</a>
					<a href="#models" class="hover:text-accent transition-colors">03. ПРОЕКТЫ</a>
					<a href="#calculator" class="hover:text-accent transition-colors">04. КАЛЬКУЛЯТОР</a>
				</nav>

				<div class="flex items-center space-x-3">
					<a
						href="#calculator"
						class="px-4 py-2 rounded-lg bg-accent text-white text-xs font-mono font-semibold tracking-wider hover:bg-accent/90 transition-all shadow-sm"
					>
						РАССЧИТАТЬ СМЕТУ
					</a>
				</div>
			</header>

			<!-- 1. Главная Hero-секция с 3D-скроллингом Flat-to-3D (OGL) -->
			<div id="hero-3d">
				@cinematic.FlatTo3D(cinematic.FlatTo3DProps{
					ID:           "nordic-villa-3d",
					ProjectName:  "Nordic Villa 140",
					Subtitle:     "CLT-Префаб Архитектура",
					Layers:       cinematic.DefaultNordicHouseLayers(),
					ScrollHeight: "h-[360vh]",
				})
			</div>

			<!-- 2. Секция «Архитектурная экосистема и слои» -->
			<section id="technology" class="py-24 px-4 sm:px-8 max-w-7xl mx-auto border-t border-content/10">
				<div class="max-w-3xl mb-16">
					<span class="font-mono text-xs uppercase font-bold text-accent tracking-widest">Инженерная философия</span>
					<h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-content mt-2">
						Префаб-строительство с точностью до 0.5 миллиметра
					</h2>
					<p class="mt-4 text-base sm:text-lg text-content/70 leading-relaxed">
						Каждый модуль проектируется как законченная параметрическая система. На стройплощадку доставляются готовые панели с завода в Ленинградской области со скрытой разводкой инженерных сетей и чистовой отделкой.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="p-8 rounded-2xl border border-content/10 bg-surface/50 backdrop-blur-sm space-y-4 hover:border-accent/40 transition-colors">
						<div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center font-mono font-bold text-accent text-lg">
							A+
						</div>
						<h3 class="text-xl font-bold text-content">Энергоэффективность</h3>
						<p class="text-sm text-content/70 leading-relaxed">
							Коэффициент сопротивления теплопередаче стен R₀ = 5.2 м²·°C/Вт. Затраты на отопление зимой сопоставимы с оплатой однокомнатной квартиры.
						</p>
						<div class="pt-4 border-t border-content/10 font-mono text-xs text-content/60">
							Пассивный дом &middot; Paroc Extra 250 мм
						</div>
					</div>

					<div class="p-8 rounded-2xl border border-content/10 bg-surface/50 backdrop-blur-sm space-y-4 hover:border-accent/40 transition-colors">
						<div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center font-mono font-bold text-accent text-lg">
							21
						</div>
						<h3 class="text-xl font-bold text-content">Срок монтажа — 21 день</h3>
						<p class="text-sm text-content/70 leading-relaxed">
							Полная сборка теплого контура на готовый фундамент занимает менее месяца. Заводской контроль влажности древесины исключает усадку и трещины.
						</p>
						<div class="pt-4 border-t border-content/10 font-mono text-xs text-content/60">
							Сушка до 12% &middot; CNC-зарезка Hundegger
						</div>
					</div>

					<div class="p-8 rounded-2xl border border-content/10 bg-surface/50 backdrop-blur-sm space-y-4 hover:border-accent/40 transition-colors">
						<div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center font-mono font-bold text-accent text-lg">
							50
						</div>
						<h3 class="text-xl font-bold text-content">Гарантия 50 лет</h3>
						<p class="text-sm text-content/70 leading-relaxed">
							Конструкционная прочность сертифицирована по ГОСТ 20850-2014. Использование лиственницы и глубокой биозащиты гарантирует вековой срок службы.
						</p>
						<div class="pt-4 border-t border-content/10 font-mono text-xs text-content/60">
							ГОСТ 20850-2014 &middot; FSC Wood
						</div>
					</div>
				</div>
			</section>

			<!-- 3. Каталог типовых архитектурных серий -->
			<section id="models" class="py-24 px-4 sm:px-8 max-w-7xl mx-auto border-t border-content/10">
				<div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
					<div>
						<span class="font-mono text-xs uppercase font-bold text-accent tracking-widest">Каталог проектов</span>
						<h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-content mt-2">
							Архитектурные линейки Nordic
						</h2>
					</div>
					<p class="text-sm text-content/60 font-mono max-w-md">
						Все проекты адаптированы под технологию послойной заводской сборки и доступны в 3 комплектациях.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Вилла 1 -->
					<div class="rounded-2xl border border-content/15 overflow-hidden bg-surface/60 flex flex-col group hover:shadow-2xl transition-all">
						<div class="h-56 bg-content/5 relative p-6 flex flex-col justify-between border-b border-content/10">
							<span class="font-mono text-xs font-bold text-accent bg-surface/90 px-3 py-1 rounded-full w-max shadow-sm">КОМПАКТ</span>
							<div>
								<div class="text-xs font-mono text-content/50 uppercase">Площадь</div>
								<div class="text-2xl font-bold text-content font-mono">65 м&sup2;</div>
							</div>
						</div>
						<div class="p-6 flex-1 flex flex-col justify-between space-y-4">
							<div>
								<h3 class="text-xl font-bold text-content">Nordic Compact 65</h3>
								<p class="text-xs text-content/70 mt-1 leading-relaxed">
									Идеальное решение для загородного отдыха или гостевого дома: мастер-спальня, кухня-гостиная со вторым светом и панорамная сауна.
								</p>
								<div class="mt-4 flex flex-wrap gap-2 text-[11px] font-mono text-content/60">
									<span class="px-2.5 py-1 rounded-md bg-content/5">2 спальни</span>
									<span class="px-2.5 py-1 rounded-md bg-content/5">1 санузел</span>
									<span class="px-2.5 py-1 rounded-md bg-content/5">Терраса 24 м&sup2;</span>
								</div>
							</div>
							<div class="pt-4 border-t border-content/10 flex items-center justify-between">
								<div class="font-bold text-base font-mono">от 6.8 млн ₽</div>
								<a href="#calculator" class="text-xs font-mono text-accent hover:underline font-semibold">КОНФИГУРИРОВАТЬ &rarr;</a>
							</div>
						</div>
					</div>

					<!-- Вилла 2 (Акцентная) -->
					<div class="rounded-2xl border-2 border-accent overflow-hidden bg-surface flex flex-col relative shadow-xl group">
						<div class="h-56 bg-accent/5 relative p-6 flex flex-col justify-between border-b border-accent/20">
							<div class="flex items-center justify-between">
								<span class="font-mono text-xs font-bold text-white bg-accent px-3 py-1 rounded-full shadow-sm">ХИТ ПРОДАЖ</span>
								<span class="text-[11px] font-mono text-accent font-semibold">FLAT-TO-3D ДЕМО</span>
							</div>
							<div>
								<div class="text-xs font-mono text-content/50 uppercase">Площадь</div>
								<div class="text-2xl font-bold text-content font-mono">140 м&sup2;</div>
							</div>
						</div>
						<div class="p-6 flex-1 flex flex-col justify-between space-y-4">
							<div>
								<h3 class="text-xl font-bold text-content">Nordic Panorama 140</h3>
								<p class="text-xs text-content/70 mt-1 leading-relaxed">
									Флагманская семейная вилла: просторная гостиная с камином, 3 спальни, кабинет на антресоли и крытая лаунж-терраса.
								</p>
								<div class="mt-4 flex flex-wrap gap-2 text-[11px] font-mono text-content/60">
									<span class="px-2.5 py-1 rounded-md bg-accent/10 text-accent font-semibold">3 спальни</span>
									<span class="px-2.5 py-1 rounded-md bg-content/5">2 санузла</span>
									<span class="px-2.5 py-1 rounded-md bg-content/5">Терраса 45 м&sup2;</span>
								</div>
							</div>
							<div class="pt-4 border-t border-content/10 flex items-center justify-between">
								<div class="font-bold text-base font-mono text-accent">от 12.4 млн ₽</div>
								<a href="#calculator" class="text-xs font-mono text-accent hover:underline font-semibold">КОНФИГУРИРОВАТЬ &rarr;</a>
							</div>
						</div>
					</div>

					<!-- Вилла 3 -->
					<div class="rounded-2xl border border-content/15 overflow-hidden bg-surface/60 flex flex-col group hover:shadow-2xl transition-all">
						<div class="h-56 bg-content/5 relative p-6 flex flex-col justify-between border-b border-content/10">
							<span class="font-mono text-xs font-bold text-content/70 bg-surface/90 px-3 py-1 rounded-full w-max shadow-sm">РЕЗИДЕНЦИЯ</span>
							<div>
								<div class="text-xs font-mono text-content/50 uppercase">Площадь</div>
								<div class="text-2xl font-bold text-content font-mono">210 м&sup2;</div>
							</div>
						</div>
						<div class="p-6 flex-1 flex flex-col justify-between space-y-4">
							<div>
								<h3 class="text-xl font-bold text-content">Nordic Grand Estate 210</h3>
								<p class="text-xs text-content/70 mt-1 leading-relaxed">
									Двухуровневая резиденция с мастер-блоком, спа-зоной, отдельным блоком для персонала и гаражом на 2 автомобиля.
								</p>
								<div class="mt-4 flex flex-wrap gap-2 text-[11px] font-mono text-content/60">
									<span class="px-2.5 py-1 rounded-md bg-content/5">4 спальни</span>
									<span class="px-2.5 py-1 rounded-md bg-content/5">3 санузла</span>
									<span class="px-2.5 py-1 rounded-md bg-content/5">Гараж 42 м&sup2;</span>
								</div>
							</div>
							<div class="pt-4 border-t border-content/10 flex items-center justify-between">
								<div class="font-bold text-base font-mono">от 19.8 млн ₽</div>
								<a href="#calculator" class="text-xs font-mono text-accent hover:underline font-semibold">КОНФИГУРИРОВАТЬ &rarr;</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 4. Интерактивный калькулятор конфигурации и форма заявки на HTMX -->
			<section id="calculator" class="py-24 px-4 sm:px-8 max-w-5xl mx-auto border-t border-content/10">
				<div class="p-8 sm:p-12 rounded-3xl border border-content/15 bg-surface shadow-2xl relative" x-data="{ area: 140, foundation: 1, finish: 2, get totalCost() { return Math.round(this.area * 78000 + (this.foundation === 2 ? 650000 : 350000) + (this.finish === 2 ? 850000 : 0)); } }">
					<div class="max-w-2xl mb-10">
						<span class="font-mono text-xs uppercase font-bold text-accent tracking-widest">Онлайн-конфигуратор</span>
						<h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-content mt-1">
							Рассчитайте стоимость виллы под ключ
						</h2>
						<p class="text-xs sm:text-sm text-content/70 mt-2">
							Выберите параметры проекта для предварительной калькуляции сметы с точностью до 95%.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-10">
						<!-- Левая колонка: ползунки и опции -->
						<div class="space-y-6">
							<div>
								<div class="flex justify-between items-center mb-2 font-mono text-xs">
									<span class="text-content/80 font-semibold">ЖИЛАЯ ПЛОЩАДЬ:</span>
									<span class="text-accent font-bold text-sm" x-text="area + ' м²'"></span>
								</div>
								<input
									type="range"
									min="60"
									max="240"
									step="10"
									x-model.number="area"
									class="w-full accent-accent cursor-pointer"
								/>
								<div class="flex justify-between text-[10px] font-mono text-content/40 mt-1">
									<span>60 м²</span>
									<span>140 м²</span>
									<span>240 м²</span>
								</div>
							</div>

							<div>
								<label class="block font-mono text-xs font-semibold text-content/80 mb-2">ТИП ОСНОВАНИЯ:</label>
								<div class="grid grid-cols-2 gap-3">
									<button
										type="button"
										@click="foundation = 1"
										:class="foundation === 1 ? 'border-accent bg-accent/10 text-accent font-bold' : 'border-content/15 text-content/70'"
										class="p-3 border rounded-xl text-xs font-mono text-left transition-all"
									>
										Свайно-ростверковый
									</button>
									<button
										type="button"
										@click="foundation = 2"
										:class="foundation === 2 ? 'border-accent bg-accent/10 text-accent font-bold' : 'border-content/15 text-content/70'"
										class="p-3 border rounded-xl text-xs font-mono text-left transition-all"
									>
										УШП плита с подогревом
									</button>
								</div>
							</div>

							<div>
								<label class="block font-mono text-xs font-semibold text-content/80 mb-2">ОТДЕЛКА ФАСАДА:</label>
								<div class="grid grid-cols-2 gap-3">
									<button
										type="button"
										@click="finish = 1"
										:class="finish === 1 ? 'border-accent bg-accent/10 text-accent font-bold' : 'border-content/15 text-content/70'"
										class="p-3 border rounded-xl text-xs font-mono text-left transition-all"
									>
										Хвойный планкен AB
									</button>
									<button
										type="button"
										@click="finish = 2"
										:class="finish === 2 ? 'border-accent bg-accent/10 text-accent font-bold' : 'border-content/15 text-content/70'"
										class="p-3 border rounded-xl text-xs font-mono text-left transition-all"
									>
										Премиум лиственница + сланец
									</button>
								</div>
							</div>

							<div class="p-4 rounded-xl bg-content/5 border border-content/10 font-mono text-xs flex justify-between items-center">
								<span class="text-content/70">Ориентировочная смета:</span>
								<span class="text-lg font-bold text-accent" x-text="totalCost.toLocaleString('ru-RU') + ' ₽'"></span>
							</div>
						</div>

						<!-- Правая колонка: форма заявки на HTMX -->
						<div class="bg-surface/50 p-6 rounded-2xl border border-content/10 flex flex-col justify-between">
							<div>
								<h3 class="text-base font-bold text-content mb-1">Получить детальный архитектурный альбом</h3>
								<p class="text-xs text-content/60 mb-6">
									Мы вышлем комплект чертежей выбранной виллы, спецификацию материалов и график возведения на ваш WhatsApp или Telegram.
								</p>

								<form
									hx-post="/api/leads"
									hx-swap="outerHTML"
									class="space-y-4"
								>
									<!-- Скрытые поля с данными калькулятора -->
									<input type="hidden" name="source" value="flat_to_3d_showcase"/>
									<input type="hidden" name="service" value="Архитектурное проектирование и префаб"/>

									<div>
										<label class="block text-xs font-mono text-content/70 mb-1">Ваше имя:</label>
										<input
											type="text"
											name="name"
											required
											placeholder="Александр"
											class="w-full px-3.5 py-2.5 rounded-xl border border-content/20 bg-surface text-content text-xs focus:border-accent focus:outline-none transition-colors"
										/>
									</div>

									<div>
										<label class="block text-xs font-mono text-content/70 mb-1">Телефон / Мессенджер:</label>
										<input
											type="tel"
											name="phone"
											required
											placeholder="+7 (999) 000-00-00"
											class="w-full px-3.5 py-2.5 rounded-xl border border-content/20 bg-surface text-content text-xs focus:border-accent focus:outline-none transition-colors"
										/>
									</div>

									<button
										type="submit"
										class="w-full py-3 rounded-xl bg-accent text-white font-mono font-bold text-xs tracking-wider uppercase hover:bg-accent/90 transition-all shadow-md mt-2"
									>
										Получить проект и смету
									</button>
								</form>
							</div>

							<div class="mt-4 text-[10px] text-content/40 font-mono text-center">
								Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности. Без спама.
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Футер сайта -->
			<footer class="py-12 px-4 sm:px-8 border-t border-content/10 text-center font-mono text-xs text-content/50 space-y-2">
				<div>NORDIC TIMBER ARCHITECTURE &middot; SITE-CRAFT FLAT-TO-3D ENGINE</div>
				<div class="text-[11px] text-content/40">Разработано на Go + Templ + Tailwind CSS v4 + Alpine.js + OGL WebGL</div>
			</footer>
		</div>
	}
}
