package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientServiceForm(service models.ServiceItem, isNew bool) {
	<div class="max-w-2xl mx-auto">
		<div class="flex items-center justify-between mb-6 pb-4 border-b border-admin-border">
			<div>
				<h2 class="text-xl font-bold text-admin-content tracking-tight">
					if isNew {
						Добавить услугу или товар
					} else {
						Редактирование: { service.Title }
					}
				</h2>
				<p class="text-xs text-admin-content-muted mt-1">Заполните данные для отображения в блоке услуг и каталоге сайта</p>
			</div>
			<button
				type="button"
				hx-get="/client/tab/services"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class="text-xs text-admin-content-muted hover:text-admin-content px-3 py-1.5 rounded-lg border border-admin-border bg-admin-surface-muted hover:bg-admin-surface-hover transition-colors cursor-pointer flex items-center gap-1.5"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
				</svg>
				<span>Назад к списку</span>
			</button>
		</div>

		<form
			hx-post="/client/services/save"
			hx-target="#admin-tab-content"
			hx-swap="innerHTML"
			class="space-y-5 bg-admin-surface border border-admin-border rounded-2xl p-6 sm:p-8 shadow-sm"
		>
			<input type="hidden" name="id" value={ service.ID } />

			<!-- Название услуги -->
			<div>
				<label class="block text-xs font-semibold uppercase tracking-wider text-admin-content-muted mb-2">
					Название услуги или товара <span class="text-admin-accent">*</span>
				</label>
				<input
					type="text"
					name="title"
					value={ service.Title }
					required
					placeholder="Например: Замена масла и фильтров, Экспресс-консультация..."
					class="w-full px-4 py-3 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder-admin-content-subtle focus:outline-none focus:ring-1 focus:ring-admin-border-focus focus:border-admin-border-focus transition-all text-sm"
				/>
			</div>

			<!-- Стоимость и Порядок сортировки в 2 колонки -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-admin-content-muted mb-2">
						Стоимость / Тариф
					</label>
					<input
						type="text"
						name="price"
						value={ service.Price }
						placeholder="от 2 500 ₽, 1 900 ₽/мес, Бесплатно..."
						class="w-full px-4 py-3 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder-admin-content-subtle focus:outline-none focus:ring-1 focus:ring-admin-border-focus focus:border-admin-border-focus transition-all text-sm"
					/>
					<p class="text-[11px] text-admin-content-subtle mt-1">Произвольный текстовый формат или точная сумма с валютой</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-admin-content-muted mb-2">
						Порядок вывода (сортировка)
					</label>
					<input
						type="number"
						name="order"
						value={ fmt.Sprintf("%d", service.Order) }
						min="0"
						step="1"
						placeholder="1"
						class="w-full px-4 py-3 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder-admin-content-subtle focus:outline-none focus:ring-1 focus:ring-admin-border-focus focus:border-admin-border-focus transition-all text-sm"
					/>
					<p class="text-[11px] text-admin-content-subtle mt-1">Меньшее число выводится выше в списке</p>
				</div>
			</div>

			<!-- Складской учет и доступность -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-admin-content-muted mb-2">
						Остаток на складе (шт.)
					</label>
					<input
						type="number"
						name="stock_count"
						value={ fmt.Sprintf("%d", service.StockCount) }
						placeholder="-1"
						class="w-full px-4 py-3 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder-admin-content-subtle focus:outline-none focus:ring-1 focus:ring-admin-border-focus focus:border-admin-border-focus transition-all text-sm"
					/>
					<p class="text-[11px] text-admin-content-subtle mt-1">-1 для неограниченного запаса, 0 при отсутствии</p>
				</div>

				<div class="flex flex-col justify-end space-y-3 pb-1">
					<label class="flex items-center gap-2.5 cursor-pointer">
						<input
							type="checkbox"
							name="is_preorder"
							value="true"
							checked?={ service.IsPreorder }
							class="w-4 h-4 rounded bg-admin-surface-muted border-admin-border text-admin-accent focus:ring-admin-accent"
						/>
						<span class="text-xs text-admin-content-muted font-medium">Доступно под заказ (Preorder)</span>
					</label>

					<label class="flex items-center gap-2.5 cursor-pointer">
						<input
							type="checkbox"
							name="active"
							value="true"
							checked?={ service.Active }
							class="w-4 h-4 rounded bg-admin-surface-muted border-admin-border text-admin-success focus:ring-admin-success"
						/>
						<span class="text-xs text-admin-content-muted font-medium">Активна (показывать на витрине сайта)</span>
					</label>
				</div>
			</div>

			<!-- Подробное описание -->
			<div>
				<label class="block text-xs font-semibold uppercase tracking-wider text-admin-content-muted mb-2">
					Краткое описание / Особенности
				</label>
				<textarea
					name="description"
					rows="3"
					placeholder="Укажите, что входит в услугу, сроки исполнения, гарантию..."
					class="w-full px-4 py-3 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder-admin-content-subtle focus:outline-none focus:ring-1 focus:ring-admin-border-focus focus:border-admin-border-focus transition-all text-sm resize-none"
				>{ service.Description }</textarea>
			</div>

			<div class="pt-4 border-t border-admin-border flex items-center justify-end gap-3">
				<button
					type="button"
					hx-get="/client/tab/services"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-4 py-2.5 rounded-xl border border-admin-border text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted text-xs font-medium transition-colors cursor-pointer"
				>
					Отмена
				</button>
				<button
					type="submit"
					class="px-6 py-2.5 rounded-xl bg-admin-accent hover:bg-admin-accent-hover text-admin-bg font-bold text-xs transition-all shadow-md active:scale-[0.99] flex items-center gap-2 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>Сохранить позицию</span>
				</button>
			</div>
		</form>
	</div>
}
