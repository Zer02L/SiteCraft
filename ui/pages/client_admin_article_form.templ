package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/pages/admin_articles"
)

templ ClientArticleForm(article models.ArticleItem, isNew bool) {
	<!-- Quill 2.0 WYSIWYG Editor - Local Standalone (Lazy loaded specifically for article editing) -->
	<link href="/assets/css/quill.snow.css" rel="stylesheet"/>
	<script src="/assets/js/quill.min.js"></script>
	<!-- Article Editor Controller (Transliteration, DnD, Quill Init) -->
	<script src="/assets/js/admin-article-editor.js"></script>

	<div class="w-full" :class="focusMode ? 'max-w-3xl mx-auto' : ''">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 pb-4 border-b border-admin-border">
			<div>
				if isNew {
					<h2 class="text-xl font-bold text-admin-content tracking-tight">Новая статья</h2>
				} else {
					<h2 class="text-xl font-bold text-admin-content tracking-tight">Редактирование статьи</h2>
				}
				<p class="text-xs text-admin-content-muted mt-0.5">Редактор публикаций с автогенерацией URL, обложкой и тегами</p>
			</div>
			<div class="flex items-center gap-2 shrink-0 flex-wrap">
				<button
					type="button"
					onclick="document.getElementById('article-seo-preview-dialog').showModal()"
					title="Предпросмотр сниппета в Google и соцсетях"
					class="px-3 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs font-medium text-admin-content transition-colors flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					<svg class="w-3.5 h-3.5 text-admin-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<span>SEO Превью</span>
				</button>

				<!-- Focus Mode Toggle (Фича 5: UX-фокус UltimaPress) -->
				<button
					type="button"
					@click="$dispatch('toggle-focus-mode')"
					title="Переключить режим Focus Mode (Esc для выхода)"
					class="px-3 py-1.5 rounded-lg border text-xs font-medium transition-colors flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					:class="focusMode ? 'bg-admin-accent text-admin-on-accent border-admin-accent' : 'bg-admin-surface hover:bg-admin-surface-muted border-admin-border text-admin-content'"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-show="!focusMode">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
					</svg>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-show="focusMode" x-cloak>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9L4 4m0 0l5 5M4 4h5M4 4v5m11 7l5 5m0 0l-5-5m5 5h-5m5 0v-5"></path>
					</svg>
					<span x-text="focusMode ? 'Выйти из фокуса' : 'Focus Mode'"></span>
				</button>

				<button
					type="button"
					hx-get="/client/tab/articles"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					@click="$dispatch('exit-focus-mode')"
					class="px-3 py-1.5 rounded-lg bg-admin-surface hover:bg-admin-surface-muted border border-admin-border text-xs font-medium text-admin-content-muted hover:text-admin-content transition-colors cursor-pointer"
				>
					Назад к списку
				</button>
			</div>
		</div>

		<form
			hx-post="/client/articles/save"
			hx-target="#admin-tab-content"
			hx-swap="innerHTML"
			@htmx:after-request="$dispatch('exit-focus-mode')"
			hx-encoding="multipart/form-data"
			enctype="multipart/form-data"
			x-data={ fmt.Sprintf("articleEditor({ initialTitle: %s, initialSlug: %s, initialTags: %s, initialCover: %s, isNew: %t })",
				escapeJSONString(article.Title),
				escapeJSONString(article.Slug),
				tagsToJSON(article.Tags),
				escapeJSONString(article.CoverImage),
				isNew,
			) }
			x-init="init()"
			class="grid gap-6 items-start"
			:class="focusMode ? 'grid-cols-1' : 'grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px]'"
		>
			<input type="hidden" name="id" value={ article.ID }/>
			<input type="hidden" name="tags" :value="tags.join(',')"/>
			<input type="hidden" name="remove_cover" :value="removeCover ? 'true' : 'false'"/>

			<!-- Левая колонка: Полотно редактора -->
			<div class="bg-admin-surface border border-admin-border rounded-xl p-5 sm:p-6 space-y-5">
				<!-- Заголовок статьи с транслитерацией -->
				<div>
					<div class="flex items-center justify-between mb-1.5">
						<label for="article-title-input" class="block text-xs font-medium text-admin-content-muted">
							Заголовок статьи <span class="text-admin-accent">*</span>
						</label>
						<span class="text-[11px] text-admin-content-subtle">Автоматически формирует URL</span>
					</div>
					<input
						id="article-title-input"
						type="text"
						name="title"
						x-model="title"
						x-on:input="onTitleInput()"
						required
						placeholder="Например: Как подготовить документы для сделки..."
						class="admin-input w-full px-3.5 py-2.5 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-base font-semibold placeholder:font-normal placeholder:text-admin-content-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					/>
				</div>

				<!-- В режиме Focus Mode: аккордеон параметров публикации -->
				<div x-show="focusMode" x-cloak>
					<button
						type="button"
						@click="showExtraSettings = !showExtraSettings"
						class="w-full py-2 px-3 rounded-lg bg-admin-surface-muted/60 hover:bg-admin-surface-muted text-xs text-admin-content-muted flex items-center justify-between transition-colors border border-admin-border cursor-pointer"
					>
						<span class="flex items-center gap-2 font-medium text-admin-content">
							<svg class="w-3.5 h-3.5 text-admin-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							</svg>
							<span>Параметры публикации (обложка, теги, URL, дата)</span>
						</span>
						<span class="text-xs text-admin-accent font-medium" x-text="showExtraSettings ? 'Свернуть' : 'Настроить'"></span>
					</button>
				</div>

				<!-- Визуальный редактор текста статьи (Quill.js) -->
				<div class="space-y-1.5">
					<div class="flex items-center justify-between">
						<span class="block text-xs font-medium text-admin-content-muted">Текст статьи</span>
						<span x-show="focusMode" x-cloak class="text-[11px] font-mono text-admin-content-subtle">Режим фокуса</span>
					</div>

					<textarea
						name="content"
						x-ref="contentInput"
						class="hidden"
					>{ article.Content }</textarea>

					<div
						class="quill-dark-wrapper rounded-lg overflow-hidden border border-admin-border bg-admin-surface"
						:class="{ 'ring-2 ring-admin-accent/30': focusMode }"
					>
						<div
							x-ref="quillEditor"
							class="text-admin-content"
							:class="focusMode ? 'min-h-[520px] text-base leading-relaxed' : 'min-h-[420px]'"
						></div>
					</div>
				</div>

				<!-- Сохранение (внизу левой колонки для быстрого доступа в Focus Mode и на мобильных) -->
				<div class="pt-4 border-t border-admin-border flex items-center justify-end gap-3">
					<button
						type="submit"
						class="px-5 py-2.5 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-xs transition-colors flex items-center gap-2 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
						<span>Сохранить публикацию</span>
					</button>
				</div>
			</div>

			<!-- Правая sticky-колонка метаданных и публикации -->
			<div x-show="!focusMode || showExtraSettings" class="space-y-4 lg:sticky lg:top-18">
				<!-- Блок 1: Публикация и расписание -->
				<div class="bg-admin-surface border border-admin-border rounded-xl p-4 space-y-4">
					<div class="text-xs font-semibold text-admin-content">Публикация</div>

					<label class="flex items-start gap-2.5 cursor-pointer">
						<input
							type="checkbox"
							id="is_published"
							name="is_published"
							value="true"
							checked?={ article.IsPublished }
							class="mt-0.5 w-4 h-4 rounded text-admin-accent bg-admin-surface-muted border-admin-border focus-visible:ring-admin-border-focus cursor-pointer"
						/>
						<span class="text-xs text-admin-content leading-snug">
							Опубликовать на сайте
							<span class="block text-[11px] text-admin-content-muted mt-0.5">При дате в будущем запланирует выход</span>
						</span>
					</label>

					<div>
						<label for="published_at_input" class="block text-xs font-medium text-admin-content-muted mb-1.5">
							Дата и время
						</label>
						<input
							type="datetime-local"
							name="published_at"
							id="published_at_input"
							value={ article.PublishedAtInput() }
							class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-xs font-mono focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						/>
						<div class="flex flex-wrap gap-1.5 mt-2">
							<button
								type="button"
								onclick="const now = new Date(); const offset = now.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(now - offset).toISOString().slice(0, 16);"
								class="px-2 py-1 rounded-md bg-admin-surface-muted hover:bg-admin-surface-hover text-[11px] text-admin-content border border-admin-border transition-colors cursor-pointer"
							>
								Сейчас
							</button>
							<button
								type="button"
								onclick="const d = new Date(); d.setDate(d.getDate() + 1); d.setHours(9, 0, 0, 0); const offset = d.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(d - offset).toISOString().slice(0, 16);"
								class="px-2 py-1 rounded-md bg-admin-surface-muted hover:bg-admin-surface-hover text-[11px] text-admin-accent border border-admin-border transition-colors cursor-pointer"
							>
								Завтра 09:00
							</button>
							<button
								type="button"
								onclick="const d = new Date(); d.setDate(d.getDate() + 3); d.setHours(10, 0, 0, 0); const offset = d.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(d - offset).toISOString().slice(0, 16);"
								class="px-2 py-1 rounded-md bg-admin-surface-muted hover:bg-admin-surface-hover text-[11px] text-admin-accent border border-admin-border transition-colors cursor-pointer"
							>
								+3 дня
							</button>
							<button
								type="button"
								onclick="const d = new Date(); d.setDate(d.getDate() + 7); d.setHours(12, 0, 0, 0); const offset = d.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(d - offset).toISOString().slice(0, 16);"
								class="px-2 py-1 rounded-md bg-admin-surface-muted hover:bg-admin-surface-hover text-[11px] text-admin-accent border border-admin-border transition-colors cursor-pointer"
							>
								+7 дней
							</button>
						</div>
					</div>
				</div>

				<!-- Блок 2: URL и Автор -->
				<div class="bg-admin-surface border border-admin-border rounded-xl p-4 space-y-3.5">
					<div>
						<div class="flex items-center justify-between mb-1.5">
							<label for="article-slug-input" class="block text-xs font-medium text-admin-content-muted">
								URL-адрес (Slug) <span class="text-admin-accent">*</span>
							</label>
							<button
								type="button"
								x-on:click="regenerateSlug()"
								title="Обновить ссылку по названию"
								class="text-[11px] text-admin-accent hover:underline flex items-center gap-1 cursor-pointer"
							>
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
								</svg>
								<span>Обновить</span>
							</button>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-xs text-admin-content-subtle font-mono select-none">
								/blog/
							</span>
							<input
								id="article-slug-input"
								type="text"
								name="slug"
								x-model="slug"
								x-on:input="onSlugInput()"
								required
								placeholder="kak-podgotovit-dokumenty"
								class="admin-input w-full pl-14 pr-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-accent font-mono text-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
							/>
						</div>
					</div>

					<div>
						<label for="article-author-input" class="block text-xs font-medium text-admin-content-muted mb-1.5">
							Автор публикации
						</label>
						<input
							id="article-author-input"
							type="text"
							name="author_name"
							value={ article.AuthorName }
							placeholder="Имя автора"
							class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						/>
					</div>

					<div>
						<label for="article-excerpt-input" class="block text-xs font-medium text-admin-content-muted mb-1.5">
							Краткий анонс
						</label>
						<textarea
							id="article-excerpt-input"
							name="excerpt"
							rows="2"
							placeholder="Описание для карточки в каталоге..."
							class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						>{ article.Excerpt }</textarea>
					</div>
				</div>

				<!-- Блок 3: Обложка -->
				<div class="bg-admin-surface border border-admin-border rounded-xl p-4 space-y-2.5">
					<span class="block text-xs font-semibold text-admin-content">Обложка статьи</span>

					<input
						type="file"
						name="cover_image"
						x-ref="coverFileInput"
						accept="image/png,image/jpeg,image/webp,image/gif"
						class="hidden"
						x-on:change="handleFileSelect($event)"
					/>

					<div x-show="coverPreview" class="relative group rounded-lg overflow-hidden border border-admin-border bg-admin-bg">
						<img decoding="async" loading="lazy"
							:src="coverPreview"
							alt="Обложка статьи"
							class="w-full h-40 object-cover"
						/>
						<div class="absolute inset-0 bg-admin-bg/75 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
							<button
								type="button"
								x-on:click="$refs.coverFileInput.click()"
								class="px-2.5 py-1.5 rounded-md bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-medium text-xs cursor-pointer transition-colors"
							>
								Заменить
							</button>
							<button
								type="button"
								x-on:click="clearCover()"
								class="px-2.5 py-1.5 rounded-md bg-admin-danger-muted hover:bg-admin-danger/25 text-admin-danger border border-admin-danger-border font-medium text-xs cursor-pointer transition-colors"
							>
								Удалить
							</button>
						</div>
					</div>

					<div
						x-show="!coverPreview"
						x-on:click="$refs.coverFileInput.click()"
						x-on:dragover.prevent="isDragging = true"
						x-on:dragleave.prevent="isDragging = false"
						x-on:drop.prevent="handleDrop($event)"
						:class="isDragging ? 'border-admin-accent bg-admin-accent-muted' : 'border-admin-border hover:border-admin-border-focus bg-admin-surface-muted/40'"
						class="border border-dashed rounded-lg p-5 text-center cursor-pointer transition-colors"
					>
						<svg class="w-6 h-6 mx-auto text-admin-content-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
						</svg>
						<p class="text-xs font-medium text-admin-content">Выбрать или перетащить фото</p>
						<p class="text-[11px] text-admin-content-subtle mt-0.5">WebP, PNG, JPG до 5 МБ (16:9)</p>
					</div>
				</div>

				<!-- Блок 4: Теги -->
				<div class="bg-admin-surface border border-admin-border rounded-xl p-4 space-y-2.5">
					<span class="block text-xs font-semibold text-admin-content">Теги и рубрики</span>

					<div class="p-2 rounded-lg bg-admin-surface-muted border border-admin-border min-h-[42px] flex flex-wrap items-center gap-1.5">
						<template x-for="(tag, idx) in tags" :key="idx">
							<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-accent-muted text-admin-accent border border-admin-accent-border">
								<span x-text="'#' + tag"></span>
								<button
									type="button"
									x-on:click="removeTag(idx)"
									title="Удалить тег"
									aria-label="Удалить тег"
									class="hover:text-admin-danger text-admin-accent/80 transition-colors cursor-pointer"
								>
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
								</button>
							</span>
						</template>

						<input
							type="text"
							x-model="newTag"
							x-on:keydown.enter.prevent="addTag()"
							x-on:keydown.comma.prevent="addTag()"
							placeholder="+ Тег и Enter..."
							aria-label="Добавить тег"
							class="flex-1 min-w-[110px] bg-transparent text-admin-content text-xs placeholder-admin-content-subtle focus:outline-none py-0.5 focus-visible:ring-2 focus-visible:ring-admin-border-focus rounded"
						/>
					</div>

					<div class="flex items-center gap-1.5 flex-wrap">
						for _, suggested := range []string{"Полезное", "Инструкция", "Советы", "Законодательство", "Кейс", "Новости"} {
							<button
								type="button"
								x-on:click={ fmt.Sprintf("suggestTag('%s')", suggested) }
								class="px-2 py-0.5 rounded-md bg-admin-surface-muted hover:bg-admin-surface-hover text-admin-content-muted hover:text-admin-accent text-[11px] transition-colors cursor-pointer border border-admin-border"
							>
								{ "+" + suggested }
							</button>
						}
					</div>
				</div>
			</div>
		</form>

		<!-- Стили темы Workbench для Quill Editor -->
		<style>
			.quill-dark-wrapper .ql-toolbar.ql-snow {
				background-color: var(--admin-surface-muted);
				border-color: var(--admin-border);
				border-top-left-radius: 0.5rem;
				border-top-right-radius: 0.5rem;
				border-bottom: 1px solid var(--admin-border);
				padding: 0.625rem 0.75rem;
			}
			.quill-dark-wrapper .ql-container.ql-snow {
				background-color: var(--admin-surface);
				border-color: var(--admin-border);
				border-bottom-left-radius: 0.5rem;
				border-bottom-right-radius: 0.5rem;
				font-size: 0.95rem;
				font-family: inherit;
				color: var(--admin-content);
			}
			.quill-dark-wrapper .ql-editor {
				min-height: 360px;
				line-height: 1.7;
				padding: 1rem 1.25rem;
			}
			.quill-dark-wrapper .ql-editor.ql-blank::before {
				color: var(--admin-content-subtle);
				font-style: normal;
			}
			.quill-dark-wrapper .ql-snow .ql-stroke {
				stroke: var(--admin-content-muted);
			}
			.quill-dark-wrapper .ql-snow .ql-fill {
				fill: var(--admin-content-muted);
			}
			.quill-dark-wrapper .ql-snow .ql-picker {
				color: var(--admin-content-muted);
			}
			.quill-dark-wrapper .ql-snow .ql-picker-options {
				background-color: var(--admin-surface-elevated);
				border: 1px solid var(--admin-border);
				border-radius: 0.5rem;
			}
			.quill-dark-wrapper .ql-snow .ql-picker-item:hover,
			.quill-dark-wrapper .ql-snow .ql-picker-item.ql-selected {
				color: var(--admin-accent);
			}
			.quill-dark-wrapper .ql-snow button:hover .ql-stroke,
			.quill-dark-wrapper .ql-snow button.ql-active .ql-stroke,
			.quill-dark-wrapper .ql-snow .ql-picker-label:hover .ql-stroke {
				stroke: var(--admin-accent) !important;
			}
			.quill-dark-wrapper .ql-snow button:hover .ql-fill,
			.quill-dark-wrapper .ql-snow button.ql-active .ql-fill {
				fill: var(--admin-accent) !important;
			}
			.quill-dark-wrapper .ql-snow .ql-picker-label:hover {
				color: var(--admin-accent) !important;
			}
			.quill-dark-wrapper .ql-editor h2 {
				font-size: 1.35rem;
				font-weight: 700;
				color: var(--admin-content);
				margin-top: 1rem;
				margin-bottom: 0.5rem;
			}
			.quill-dark-wrapper .ql-editor h3 {
				font-size: 1.15rem;
				font-weight: 600;
				color: var(--admin-content);
				margin-top: 0.75rem;
				margin-bottom: 0.5rem;
			}
			.quill-dark-wrapper .ql-editor blockquote {
				border-left: 3px solid var(--admin-accent);
				padding-left: 0.85rem;
				color: var(--admin-content-muted);
				font-style: italic;
				margin: 0.75rem 0;
			}
			.quill-dark-wrapper .ql-editor a {
				color: var(--admin-accent);
				text-decoration: underline;
			}
			.quill-dark-wrapper .ql-editor img {
				border-radius: 0.5rem;
				max-width: 100%;
				margin: 0.75rem 0;
			}
			.admin-focus-mode .quill-dark-wrapper .ql-editor {
				min-height: 520px;
				font-size: 1.05rem;
				line-height: 1.8;
				padding: 1.5rem 1.75rem;
			}
		</style>

		<!-- Модальное окно предпросмотра сниппета SEO в поиске -->
		@admin_articles.SEOPreviewModal(article)
	</div>
}
