package admin_articles

import (
	"sitecraft/internal/models"
)

templ SEOPreviewModal(article models.ArticleItem) {
	<!-- Модальное окно предпросмотра SEO и сниппетов в поиске -->
	<dialog id="article-seo-preview-dialog" style="margin: auto;" class="fixed inset-0 m-auto bg-admin-surface border border-admin-border rounded-2xl p-6 text-admin-content backdrop:bg-black/60 max-w-2xl w-full shadow-2xl z-50 h-fit">
		<div class="flex items-center justify-between pb-4 border-b border-admin-border">
			<div class="flex items-center gap-2.5">
				<div class="w-8 h-8 rounded-xl bg-admin-accent-muted border border-admin-accent-border text-admin-accent flex items-center justify-center text-sm font-bold">
					🔍
				</div>
				<div>
					<h3 class="text-base font-bold text-admin-content">Предпросмотр в поиске и соцсетях</h3>
					<p class="text-xs text-admin-content-muted">Отображение статьи в Google, Яндекс и мессенджерах</p>
				</div>
			</div>
			<button
				type="button"
				onclick="document.getElementById('article-seo-preview-dialog').close()"
				class="text-admin-content-muted hover:text-admin-content cursor-pointer p-1.5 rounded-lg hover:bg-admin-surface-muted transition-colors"
				aria-label="Закрыть"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		<div class="space-y-6 mt-5 text-xs">
			<!-- 1. Google / Яндекс Поисковый сниппет -->
			<div class="space-y-2">
				<div class="text-[11px] font-mono uppercase tracking-wider text-admin-content-muted font-semibold flex items-center justify-between">
					<span>Сниппет в поисковой выдаче (SERP)</span>
					<span class="text-admin-accent font-normal text-[10px]">Google & Яндекс</span>
				</div>
				<div class="p-4 rounded-xl bg-white text-slate-900 border border-slate-200 shadow-xs space-y-1 font-sans">
					<!-- Хлебные крошки и домен -->
					<div class="flex items-center gap-1.5 text-xs text-slate-600">
						<span class="w-4 h-4 rounded-full bg-slate-100 flex items-center justify-center text-[10px]">🌐</span>
						<span class="truncate">sitecraft.local › blog › <span class="font-mono text-slate-800" x-text="slug || 'statya'"></span></span>
					</div>
					<!-- Заголовок страницы -->
					<div class="text-base sm:text-lg font-semibold text-blue-700 hover:underline cursor-pointer leading-snug break-words">
						<span x-text="title || 'Заголовок публикации'"></span>
					</div>
					<!-- Описание и превью -->
					<div class="flex items-start gap-3 pt-1">
						<p class="text-xs text-slate-600 leading-relaxed flex-1">
							<span class="text-slate-400 font-mono text-[11px] mr-1">Дата публикации —</span>
							<span>Статья и экспертный материал в корпоративном блоге. Пошаговые инструкции, рекомендации и аналитика.</span>
						</p>
						<template x-if="coverPreview">
							<img :src="coverPreview" alt="Обложка" class="w-16 h-16 rounded-lg object-cover shrink-0 border border-slate-200"/>
						</template>
					</div>
				</div>
			</div>

			<!-- 2. Социальный шейринг (Open Graph) -->
			<div class="space-y-2">
				<div class="text-[11px] font-mono uppercase tracking-wider text-admin-content-muted font-semibold flex items-center justify-between">
					<span>Карточка в Telegram / VK / WhatsApp</span>
					<span class="text-admin-accent font-normal text-[10px]">Open Graph (1200×630)</span>
				</div>
				<div class="rounded-xl border border-admin-border bg-admin-surface-muted overflow-hidden max-w-md shadow-xs">
					<template x-if="coverPreview">
						<img :src="coverPreview" alt="OG Cover" class="w-full h-36 object-cover bg-admin-bg"/>
					</template>
					<template x-if="!coverPreview">
						<div class="w-full h-24 bg-admin-bg flex items-center justify-center text-admin-content-subtle text-xs">
							Обложка не загружена (будет использован дефолтный логотип сайта)
						</div>
					</template>
					<div class="p-3.5 space-y-1">
						<div class="text-[10px] font-mono text-admin-content-subtle uppercase">sitecraft.local</div>
						<div class="text-sm font-bold text-admin-content leading-snug break-words" x-text="title || 'Заголовок публикации'"></div>
						<div class="text-xs text-admin-content-muted line-clamp-2">Экспертные материалы и полезные публикации.</div>
					</div>
				</div>
			</div>

			<!-- 3. Экспресс-аудит SEO -->
			<div class="p-3.5 rounded-xl bg-admin-surface-muted border border-admin-border space-y-2">
				<div class="text-[11px] font-mono font-semibold text-admin-content uppercase">Чек-лист поисковой оптимизации</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
					<div class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full" :class="title && title.length >= 20 && title.length <= 70 ? 'bg-emerald-400' : 'bg-amber-400'"></span>
						<span>Заголовок: <strong x-text="(title ? title.length : 0) + ' знаков'"></strong> (норма 40–65)</span>
					</div>
					<div class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full" :class="slug ? 'bg-emerald-400' : 'bg-rose-400'"></span>
						<span>ЧПУ Slug: <strong x-text="slug ? 'Сформирован' : 'Отсутствует'"></strong></span>
					</div>
					<div class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full" :class="coverPreview ? 'bg-emerald-400' : 'bg-amber-400'"></span>
						<span>Обложка: <strong x-text="coverPreview ? 'Загружена' : 'Рекомендуется'"></strong></span>
					</div>
					<div class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full" :class="tags.length > 0 ? 'bg-emerald-400' : 'bg-amber-400'"></span>
						<span>Рубрикатор: <strong x-text="tags.length + ' тегов'"></strong></span>
					</div>
				</div>
			</div>
		</div>

		<div class="flex items-center justify-end pt-4 border-t border-admin-border mt-5">
			<button
				type="button"
				onclick="document.getElementById('article-seo-preview-dialog').close()"
				class="px-4 py-2 rounded-xl bg-admin-surface hover:bg-admin-surface-muted text-admin-content border border-admin-border text-xs font-semibold cursor-pointer transition-colors"
			>
				Закрыть
			</button>
		</div>
	</dialog>
}
