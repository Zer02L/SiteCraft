package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientReviewsTab(reviews []models.ReviewItem) {
	{{
		publishedCount := 0
		pendingCount := 0
		totalScore := 0
		for _, r := range reviews {
			if r.IsPublished {
				publishedCount++
			} else {
				pendingCount++
			}
			totalScore += r.Rating
		}
		avgScore := 0.0
		if len(reviews) > 0 {
			avgScore = float64(totalScore) / float64(len(reviews))
		}
	}}
	<div
		x-data="{
			filter: 'all',
			replyModalOpen: false,
			currentReview: null,
			replyText: ''
		}"
		class="space-y-6"
	>
		<!-- Заголовок страницы (Высокий контраст) -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h2 class="text-xl sm:text-2xl font-bold text-admin-content tracking-tight">
					Модерация отзывов
				</h2>
				<p class="text-xs sm:text-sm text-admin-content-muted mt-1">
					Управление клиентскими отзывами, подтверждение модерации и публикация на витрине
				</p>
			</div>
		</div>

		<!-- Верхняя сводка KPI -->
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
			<div class="p-4 rounded-2xl bg-admin-surface border border-admin-border shadow-2xs">
				<div class="text-[11px] font-mono font-semibold uppercase tracking-wider text-admin-content-muted">
					Всего отзывов
				</div>
				<div class="text-2xl sm:text-3xl font-bold text-admin-content mt-1 font-mono">
					{ fmt.Sprintf("%d", len(reviews)) }
				</div>
			</div>

			<div class="p-4 rounded-2xl bg-admin-surface border border-admin-border shadow-2xs">
				<div class="flex items-center gap-1.5 text-[11px] font-mono font-semibold uppercase tracking-wider text-emerald-500">
					<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
					Опубликовано
				</div>
				<div class="text-2xl sm:text-3xl font-bold text-admin-content mt-1 font-mono">
					{ fmt.Sprintf("%d", publishedCount) }
				</div>
			</div>

			<div class="p-4 rounded-2xl bg-admin-surface border border-admin-border shadow-2xs">
				<div class="flex items-center gap-1.5 text-[11px] font-mono font-semibold uppercase tracking-wider text-amber-500">
					<span class="w-2 h-2 rounded-full bg-amber-500"></span>
					На проверке
				</div>
				<div class="text-2xl sm:text-3xl font-bold text-admin-content mt-1 font-mono">
					{ fmt.Sprintf("%d", pendingCount) }
				</div>
			</div>

			<div class="p-4 rounded-2xl bg-admin-surface border border-admin-border shadow-2xs">
				<div class="text-[11px] font-mono font-semibold uppercase tracking-wider text-admin-content-muted">
					Средняя оценка
				</div>
				<div class="text-2xl sm:text-3xl font-bold text-admin-content mt-1 font-mono flex items-center gap-1.5">
					<span class="text-amber-400">★</span>
					<span>{ fmt.Sprintf("%.1f", avgScore) }</span>
					<span class="text-xs text-admin-content-subtle font-normal font-sans">/ 5.0</span>
				</div>
			</div>
		</div>

		if len(reviews) == 0 {
			<!-- Empty state -->
			<div class="bg-admin-surface border border-admin-border rounded-2xl p-12 text-center shadow-xs">
				<div class="w-14 h-14 rounded-2xl bg-admin-surface-muted text-admin-content-subtle flex items-center justify-center mx-auto mb-4 text-2xl">
					★
				</div>
				<h3 class="text-admin-content font-bold text-lg mb-1.5">Отзывов пока нет</h3>
				<p class="text-xs sm:text-sm text-admin-content-muted max-w-md mx-auto leading-relaxed">
					Клиенты могут оставлять отзывы в трекере заказов или через виджет на сайте. Все новые обращения будут автоматически поступать сюда на проверку.
				</p>
			</div>
		} else {
			<!-- Фильтры по статусу (Действия модерации) -->
			<div class="flex items-center justify-between gap-3 flex-wrap">
				<div class="inline-flex items-center p-1 rounded-xl bg-admin-surface-muted border border-admin-border text-xs font-medium">
					<button
						type="button"
						@click="filter = 'all'"
						:class="filter === 'all' ? 'bg-admin-surface text-admin-content font-semibold shadow-2xs' : 'text-admin-content-muted hover:text-admin-content'"
						class="px-3.5 py-1.5 rounded-lg transition cursor-pointer"
					>
						Все ({ fmt.Sprintf("%d", len(reviews)) })
					</button>
					<button
						type="button"
						@click="filter = 'published'"
						:class="filter === 'published' ? 'bg-admin-surface text-admin-content font-semibold shadow-2xs' : 'text-admin-content-muted hover:text-admin-content'"
						class="px-3.5 py-1.5 rounded-lg transition cursor-pointer flex items-center gap-1.5"
					>
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
						Опубликованные ({ fmt.Sprintf("%d", publishedCount) })
					</button>
					<button
						type="button"
						@click="filter = 'pending'"
						:class="filter === 'pending' ? 'bg-admin-surface text-admin-content font-semibold shadow-2xs' : 'text-admin-content-muted hover:text-admin-content'"
						class="px-3.5 py-1.5 rounded-lg transition cursor-pointer flex items-center gap-1.5"
					>
						<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
						На проверке ({ fmt.Sprintf("%d", pendingCount) })
					</button>
				</div>

				<div class="text-xs text-admin-content-muted">
					Показано строк: <span class="font-mono font-semibold text-admin-content">{ fmt.Sprintf("%d", len(reviews)) }</span>
				</div>
			</div>

			<!-- Таблица модерации -->
			<div class="bg-admin-surface border border-admin-border rounded-2xl overflow-hidden shadow-xs">
				<div class="overflow-x-auto">
					<table class="tabular-nums w-full text-left text-sm border-collapse">
						<thead class="bg-admin-surface-muted/90 text-admin-content-muted uppercase tracking-wider font-semibold border-b border-admin-border font-mono text-xs">
							<tr>
								<th class="py-3.5 px-4 font-semibold">Автор & Дата</th>
								<th class="py-3.5 px-4 font-semibold whitespace-nowrap">Оценка</th>
								<th class="py-3.5 px-4 font-semibold">Услуга / Заказ</th>
								<th class="py-3.5 px-4 font-semibold">Отзыв</th>
								<th class="py-3.5 px-4 font-semibold whitespace-nowrap">Статус</th>
								<th class="py-3.5 px-4 font-semibold text-right whitespace-nowrap">Действия</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-admin-border text-admin-content">
							for _, rev := range reviews {
								<tr
									x-show={ fmt.Sprintf("filter === 'all' || (filter === 'published' && %t) || (filter === 'pending' && !%t)", rev.IsPublished, rev.IsPublished) }
									x-data="{ expanded: false }"
									class="hover:bg-admin-surface-muted/60 transition-colors group"
									id={ "review-row-" + rev.ID }
								>
									<!-- Автор и дата: высокий контраст, дата не сливается -->
									<td class="py-4 px-4 align-top">
										<div class="font-semibold text-admin-content text-sm leading-snug">
											{ rev.AuthorName }
										</div>
										<div class="text-xs text-admin-content-muted font-normal mt-1 flex items-center gap-1.5">
											if rev.City != "" {
												<span>{ rev.City } •</span>
											}
											<span class="font-mono text-admin-content-subtle">{ rev.CreatedAt }</span>
										</div>
									</td>

									<!-- Оценка: мягкие благородные звёзды с числовым индикатором -->
									<td class="py-4 px-4 align-top whitespace-nowrap">
										<div class="flex items-center gap-1">
											<div class="flex items-center text-amber-400 text-sm">
												for s := 1; s <= rev.Rating; s++ {
													<span>★</span>
												}
												for s := rev.Rating + 1; s <= 5; s++ {
													<span class="text-admin-border">★</span>
												}
											</div>
											<span class="ml-1 text-xs font-mono font-medium text-admin-content-muted">
												{ fmt.Sprintf("%d.0", rev.Rating) }
											</span>
										</div>
									</td>

									<!-- Услуга / Заказ: если пусто, показываем '—' -->
									<td class="py-4 px-4 align-top">
										if rev.ServiceTitle == "" && rev.OrderCode == "" {
											<span class="text-admin-content-subtle font-medium select-none">—</span>
										} else {
											if rev.ServiceTitle != "" {
												<div class="font-medium text-admin-content text-sm leading-snug">
													{ rev.ServiceTitle }
												</div>
											}
											if rev.OrderCode != "" {
												<span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border">
													✓ Заказ #{ rev.OrderCode }
												</span>
											}
										}
									</td>

									<!-- Отзыв: раскрытие по клику и hover подсказка -->
									<td class="py-4 px-4 align-top max-w-sm sm:max-w-md">
										<div
											@click="expanded = !expanded"
											class="cursor-pointer group/text"
											title={ rev.Comment }
										>
											<p
												:class="expanded ? '' : 'line-clamp-2'"
												class="text-admin-content text-sm leading-relaxed transition"
											>
												{ rev.Comment }
											</p>
											if len(rev.Comment) > 75 {
												<button
													type="button"
													aria-label="Показать отзыв полностью"
													class="text-xs text-admin-accent hover:underline font-medium mt-1.5 inline-flex items-center gap-1 cursor-pointer"
												>
													<span x-text="expanded ? 'Свернуть' : 'Читать полностью'"></span>
													<svg :class="expanded ? 'rotate-180' : ''" class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
													</svg>
												</button>
											}
										</div>
									</td>

									<!-- Статус: темный зеленый текст + точка-индикатор для высокого контраста -->
									<td class="py-4 px-4 align-top whitespace-nowrap" id={ "review-status-" + rev.ID }>
										if rev.IsPublished {
											<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/25">
												<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
												<span>Опубликован</span>
											</span>
										} else {
											<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-500 border border-amber-500/25">
												<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
												<span>На проверке</span>
											</span>
										}
									</td>

									<!-- Действия модератора: результат по кнопке, вторичный стиль, ответить и удалить -->
									<td class="py-4 px-4 align-top text-right whitespace-nowrap">
										<div class="inline-flex items-center gap-1.5 justify-end">
											<!-- Кнопка переключения статуса с понятным текстом по результату -->
											if rev.IsPublished {
												<button
													type="button"
													hx-post={ "/admin/reviews/" + rev.ID + "/toggle" }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													class="px-2.5 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content font-medium text-xs transition-colors shadow-2xs inline-flex items-center gap-1 cursor-pointer"
													title="Снять отзыв с витрины"
												>
													<svg class="w-3.5 h-3.5 text-admin-content-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
													</svg>
													<span>Скрыть</span>
												</button>
											} else {
												<button
													type="button"
													hx-post={ "/admin/reviews/" + rev.ID + "/toggle" }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													class="px-2.5 py-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-500 font-semibold text-xs transition-colors shadow-2xs inline-flex items-center gap-1 cursor-pointer"
													title="Опубликовать отзыв на сайте"
												>
													<svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
													</svg>
													<span>Опубликовать</span>
												</button>
											}

											<!-- Кнопка 'Ответить на отзыв' -->
											<button
												type="button"
												@click={ fmt.Sprintf("replyModalOpen = true; currentReview = { id: '%s', author: '%s' }; replyText = ''", rev.ID, rev.AuthorName) }
												class="px-2.5 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content font-medium text-xs transition-colors shadow-2xs inline-flex items-center gap-1 cursor-pointer"
												title="Написать официальный ответ на отзыв"
											>
												<svg class="w-3.5 h-3.5 text-admin-content-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
												</svg>
												<span>Ответить</span>
											</button>

											<!-- Кнопка 'Удалить' с подтверждением и видимой контрастной иконкой -->
											<button
												type="button"
												hx-post={ "/admin/reviews/" + rev.ID + "/delete" }
												hx-confirm="Удалить этот отзыв безвозвратно?"
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="p-1.5 rounded-lg border border-admin-border hover:border-admin-danger/30 text-admin-content-subtle hover:text-admin-danger hover:bg-admin-danger-muted transition-colors cursor-pointer"
												title="Удалить отзыв"
												aria-label="Удалить отзыв"
											>
												<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
												</svg>
											</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}

		<!-- Модальное окно 'Ответить на отзыв' -->
		<div
			x-show="replyModalOpen"
			x-cloak
			class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs transition-opacity"
		>
			<div
				@click.away="replyModalOpen = false"
				class="bg-admin-surface rounded-2xl border border-admin-border shadow-xl max-w-lg w-full p-6 text-left"
			>
				<div class="flex items-center justify-between pb-3 border-b border-admin-border">
					<div>
						<h3 class="text-base font-bold text-admin-content">Ответ на отзыв</h3>
						<p class="text-xs text-admin-content-muted mt-0.5">
							Клиент: <span class="font-semibold text-admin-content" x-text="currentReview ? currentReview.author : ''"></span>
						</p>
					</div>
					<button
						type="button"
						@click="replyModalOpen = false"
						class="text-admin-content-subtle hover:text-admin-content p-1 rounded-lg"
						aria-label="Закрыть"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<form
					:action="'/admin/reviews/' + (currentReview ? currentReview.id : '') + '/reply'"
					method="POST"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					@submit="replyModalOpen = false"
					class="mt-4 space-y-4"
				>
					<div>
						<label class="block text-xs font-semibold text-admin-content-muted mb-1.5">
							Текст официального ответа
						</label>
						<textarea
							name="reply"
							x-model="replyText"
							rows="4"
							required
							placeholder="Здравствуйте! Благодарим за ваш отзыв..."
							class="w-full px-3.5 py-2.5 rounded-xl bg-admin-surface-muted border border-admin-border text-sm text-admin-content placeholder:text-admin-content-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus focus:border-transparent resize-y"
						></textarea>
						<p class="text-[11px] text-admin-content-subtle mt-1">
							Ответ будет отображаться под отзывом клиента на сайте и в карточке заказа.
						</p>
					</div>

					<div class="flex items-center justify-end gap-2.5 pt-2 border-t border-admin-border">
						<button
							type="button"
							@click="replyModalOpen = false"
							class="px-4 py-2 rounded-xl border border-admin-border text-xs font-semibold text-admin-content-muted hover:bg-admin-surface-muted transition-colors cursor-pointer"
						>
							Отмена
						</button>
						<button
							type="submit"
							class="px-4 py-2 rounded-xl bg-admin-accent hover:bg-admin-accent-hover text-white text-xs font-semibold transition-colors shadow-2xs cursor-pointer"
						>
							Сохранить и отправить ответ
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
