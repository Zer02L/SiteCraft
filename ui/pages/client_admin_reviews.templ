package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientReviewsTab(reviews []models.ReviewItem) {
	{{
		publishedCount := 0
		pendingCount := 0
		totalScore := 0
		for _, r := range reviews {
			if r.IsPublished {
				publishedCount++
			} else {
				pendingCount++
			}
			totalScore += r.Rating
		}
		avgScore := 0.0
		if len(reviews) > 0 {
			avgScore = float64(totalScore) / float64(len(reviews))
		}
	}}
	<div
		x-data="{
			filter: 'all',
			currentReview: null,
			replyText: '',
			openReply(id, author) {
				this.currentReview = { id: id, author: author };
				this.replyText = '';
				const dlg = document.getElementById('review-reply-dialog');
				if (dlg) dlg.showModal();
			},
			closeReply() {
				const dlg = document.getElementById('review-reply-dialog');
				if (dlg && dlg.open) dlg.close();
			},
			hasVisibleReviews() {
				const rows = this.$el.querySelectorAll('tr[data-review-row]');
				if (!rows.length) return true;
				for (const r of rows) {
					const pub = r.dataset.published === 'true';
					if (this.filter === 'all' || (this.filter === 'published' && pub) || (this.filter === 'pending' && !pub)) return true;
				}
				return false;
			}
		}"
		class="space-y-5"
	>
		<!-- Заголовок страницы -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h2 class="text-xl font-bold text-admin-content tracking-tight">Модерация отзывов</h2>
				<p class="text-xs text-admin-content-muted mt-0.5">Управление клиентскими отзывами, ответы модератора и публикация на витрине</p>
			</div>
		</div>

		<!-- Интерактивная сводка KPI (фильтрация по клику) -->
		<div class="grid grid-cols-2 @lg:grid-cols-4 gap-3">
			<button
				type="button"
				@click="filter = 'all'"
				:class="filter === 'all' ? 'border-admin-accent ring-1 ring-admin-accent-border' : 'border-admin-border hover:bg-admin-surface-muted/60'"
				class="text-left p-3.5 rounded-xl bg-admin-surface border transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
			>
				<div class="text-xs font-medium text-admin-content-muted">Всего отзывов</div>
				<div class="text-2xl font-bold text-admin-content mt-1 font-mono tabular-nums">{ fmt.Sprintf("%d", len(reviews)) }</div>
			</button>

			<button
				type="button"
				@click="filter = 'published'"
				:class="filter === 'published' ? 'border-admin-success ring-1 ring-admin-success-border bg-admin-success-muted/30' : 'border-admin-border bg-admin-surface hover:bg-admin-surface-muted/60'"
				class="text-left p-3.5 rounded-xl border transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
			>
				<div class="flex items-center gap-1.5 text-xs font-medium text-admin-success">
					<span class="w-1.5 h-1.5 rounded-full bg-admin-success"></span>
					<span>Опубликовано</span>
				</div>
				<div class="text-2xl font-bold text-admin-content mt-1 font-mono tabular-nums">{ fmt.Sprintf("%d", publishedCount) }</div>
			</button>

			<button
				type="button"
				@click="filter = 'pending'"
				:class="filter === 'pending' ? 'border-admin-warning ring-1 ring-admin-warning-border bg-admin-warning-muted/30' : 'border-admin-border bg-admin-surface hover:bg-admin-surface-muted/60'"
				class="text-left p-3.5 rounded-xl border transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
			>
				<div class="flex items-center gap-1.5 text-xs font-medium text-admin-warning">
					<span class="w-1.5 h-1.5 rounded-full bg-admin-warning"></span>
					<span>На проверке</span>
				</div>
				<div class="text-2xl font-bold text-admin-content mt-1 font-mono tabular-nums">{ fmt.Sprintf("%d", pendingCount) }</div>
			</button>

			<div class="p-3.5 rounded-xl bg-admin-surface border border-admin-border">
				<div class="text-xs font-medium text-admin-content-muted">Средняя оценка</div>
				<div class="text-2xl font-bold text-admin-content mt-1 font-mono tabular-nums flex items-center gap-1.5">
					<svg class="w-4 h-4 text-admin-warning shrink-0" fill="currentColor" viewBox="0 0 20 20">
						<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
					</svg>
					<span>{ fmt.Sprintf("%.1f", avgScore) }</span>
					<span class="text-xs text-admin-content-subtle font-normal font-sans">/ 5.0</span>
				</div>
			</div>
		</div>

		if len(reviews) == 0 {
			<div class="bg-admin-surface border border-admin-border rounded-xl p-10 text-center">
				<div class="w-11 h-11 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content-muted flex items-center justify-center mx-auto mb-3">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
					</svg>
				</div>
				<h3 class="text-admin-content font-semibold text-sm mb-1">Список отзывов пока пустой</h3>
				<p class="text-xs text-admin-content-muted max-w-md mx-auto leading-relaxed">
					Клиенты могут оставлять отзывы в трекере заказов или через форму на сайте. Новые отзывы будут поступать сюда на модерацию.
				</p>
			</div>
		} else {
			<!-- Таблица модерации -->
			<div class="bg-admin-surface border border-admin-border rounded-xl overflow-hidden">
				<div class="overflow-x-auto">
					<table class="tabular-nums w-full text-left text-xs sm:text-sm border-collapse">
						<thead class="bg-admin-surface-muted/60 text-admin-content-muted font-medium border-b border-admin-border text-xs">
							<tr>
								<th class="py-2.5 px-4 font-medium">Автор и дата</th>
								<th class="py-2.5 px-4 font-medium whitespace-nowrap">Оценка</th>
								<th class="py-2.5 px-4 font-medium">Услуга / Заказ</th>
								<th class="py-2.5 px-4 font-medium">Отзыв</th>
								<th class="py-2.5 px-4 font-medium whitespace-nowrap">Статус</th>
								<th class="py-2.5 px-4 font-medium text-right whitespace-nowrap">Действия</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-admin-border text-admin-content">
							for _, rev := range reviews {
								<tr
									data-review-row="1"
									data-published={ fmt.Sprintf("%t", rev.IsPublished) }
									x-show={ fmt.Sprintf("filter === 'all' || (filter === 'published' && %t) || (filter === 'pending' && !%t)", rev.IsPublished, rev.IsPublished) }
									x-data="{ expanded: false }"
									class="hover:bg-admin-surface-muted/50 transition-colors group"
									id={ "review-row-" + rev.ID }
								>
									<td class="py-3.5 px-4 align-top">
										<div class="font-medium text-admin-content text-sm leading-snug">
											{ rev.AuthorName }
										</div>
										<div class="text-xs text-admin-content-muted mt-0.5 flex items-center gap-1.5">
											if rev.City != "" {
												<span>{ rev.City } ·</span>
											}
											<span class="font-mono text-admin-content-subtle">{ rev.CreatedAt }</span>
										</div>
									</td>

									<td class="py-3.5 px-4 align-top whitespace-nowrap">
										<div class="flex items-center gap-0.5">
											for s := 1; s <= 5; s++ {
												<svg
													class={ "w-3.5 h-3.5", templ.KV("text-admin-warning", s <= rev.Rating), templ.KV("text-admin-border", s > rev.Rating) }
													fill="currentColor"
													viewBox="0 0 20 20"
												>
													<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
												</svg>
											}
											<span class="ml-1 text-xs font-mono font-medium text-admin-content-muted">
												{ fmt.Sprintf("%d.0", rev.Rating) }
											</span>
										</div>
									</td>

									<td class="py-3.5 px-4 align-top">
										if rev.ServiceTitle == "" && rev.OrderCode == "" {
											<span class="text-admin-content-subtle select-none">—</span>
										} else {
											if rev.ServiceTitle != "" {
												<div class="font-medium text-admin-content text-xs leading-snug">
													{ rev.ServiceTitle }
												</div>
											}
											if rev.OrderCode != "" {
												<span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 rounded text-[11px] font-mono bg-admin-surface-muted text-admin-content-muted border border-admin-border">
													Заказ #{ rev.OrderCode }
												</span>
											}
										}
									</td>

									<td class="py-3.5 px-4 align-top max-w-sm sm:max-w-md">
										<div
											@click="expanded = !expanded"
											class="cursor-pointer"
											title={ rev.Comment }
										>
											<p :class="expanded ? '' : 'line-clamp-2'" class="text-admin-content text-xs leading-relaxed">
												{ rev.Comment }
											</p>
											if len(rev.Comment) > 75 {
												<button
													type="button"
													aria-label="Показать отзыв полностью"
													class="text-xs text-admin-accent hover:underline font-medium mt-1 inline-flex items-center gap-1 cursor-pointer"
												>
													<span x-text="expanded ? 'Свернуть' : 'Читать полностью'"></span>
												</button>
											}
										</div>
									</td>

									<td class="py-3.5 px-4 align-top whitespace-nowrap" id={ "review-status-" + rev.ID }>
										if rev.IsPublished {
											<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-success-muted text-admin-success border border-admin-success-border">
												<span class="w-1.5 h-1.5 rounded-full bg-admin-success"></span>
												<span>Опубликован</span>
											</span>
										} else {
											<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning-border">
												<span class="w-1.5 h-1.5 rounded-full bg-admin-warning"></span>
												<span>На проверке</span>
											</span>
										}
									</td>

									<td class="py-3.5 px-4 align-top text-right whitespace-nowrap">
										<div class="inline-flex items-center gap-1.5 justify-end">
											if rev.IsPublished {
												<button
													type="button"
													hx-post={ "/admin/reviews/" + rev.ID + "/toggle" }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													class="px-2.5 py-1 rounded-md border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content font-medium text-xs transition-colors inline-flex items-center gap-1 cursor-pointer"
													title="Снять отзыв с витрины"
												>
													<span>Скрыть</span>
												</button>
											} else {
												<button
													type="button"
													hx-post={ "/admin/reviews/" + rev.ID + "/toggle" }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													class="px-2.5 py-1 rounded-md border border-admin-success-border bg-admin-success-muted hover:bg-admin-success/20 text-admin-success font-medium text-xs transition-colors inline-flex items-center gap-1 cursor-pointer"
													title="Опубликовать отзыв на сайте"
												>
													<span>Опубликовать</span>
												</button>
											}

											<button
												type="button"
												@click={ fmt.Sprintf("openReply('%s', '%s')", rev.ID, rev.AuthorName) }
												class="px-2.5 py-1 rounded-md border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content font-medium text-xs transition-colors inline-flex items-center gap-1 cursor-pointer"
												title="Написать официальный ответ"
											>
												<span>Ответить</span>
											</button>

											<button
												type="button"
												hx-post={ "/admin/reviews/" + rev.ID + "/delete" }
												hx-confirm="Удалить этот отзыв безвозвратно?"
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="p-1.5 rounded-md border border-admin-border text-admin-content-subtle hover:text-admin-danger hover:bg-admin-danger-muted hover:border-admin-danger-border transition-colors cursor-pointer"
												title="Удалить отзыв"
												aria-label="Удалить отзыв"
											>
												<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
												</svg>
											</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<div x-show="!hasVisibleReviews()" x-cloak class="p-8 text-center border-t border-admin-border">
					<p class="text-xs text-admin-content-muted mb-2">В выбранной категории отзывов нет.</p>
					<button
						type="button"
						@click="filter = 'all'"
						class="px-3 py-1 rounded-md border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs font-medium text-admin-content cursor-pointer"
					>
						Показать все отзывы
					</button>
				</div>
			</div>
		}

		<!-- Нативный <dialog> для ответа на отзыв -->
		<dialog
			id="review-reply-dialog"
			onclick="if (event.target === this) this.close()"
			class="admin-dialog fixed inset-0 m-auto bg-admin-surface-elevated border border-admin-border rounded-xl p-6 text-admin-content max-w-lg w-[calc(100%-2rem)] shadow-xl z-50 h-fit text-left"
		>
			<div class="flex items-center justify-between pb-3 border-b border-admin-border">
				<div>
					<h3 class="text-base font-semibold text-admin-content">Ответ на отзыв</h3>
					<p class="text-xs text-admin-content-muted mt-0.5">
						Клиент: <span class="font-medium text-admin-content" x-text="currentReview ? currentReview.author : ''"></span>
					</p>
				</div>
				<button
					type="button"
					@click="closeReply()"
					class="text-admin-content-subtle hover:text-admin-content p-1.5 rounded-lg hover:bg-admin-surface-muted cursor-pointer"
					aria-label="Закрыть окно ответа"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>

			<form
				:action="'/admin/reviews/' + (currentReview ? currentReview.id : '') + '/reply'"
				method="POST"
				@submit.prevent="if (currentReview) { htmx.ajax('POST', '/admin/reviews/' + currentReview.id + '/reply', { target: '#admin-tab-content', swap: 'innerHTML', values: { reply: replyText } }); closeReply(); }"
				class="mt-4 space-y-4"
			>
				<div>
					<label for="review-reply-textarea" class="block text-xs font-medium text-admin-content-muted mb-1.5">
						Текст официального ответа
					</label>
					<textarea
						id="review-reply-textarea"
						name="reply"
						x-model="replyText"
						rows="4"
						required
						placeholder="Здравствуйте! Благодарим за ваш отзыв..."
						class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-sm text-admin-content placeholder:text-admin-content-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus resize-y"
					></textarea>
					<p class="text-[11px] text-admin-content-subtle mt-1">
						Ответ отображается под отзывом клиента на сайте и в карточке заказа.
					</p>
				</div>

				<div class="flex items-center justify-end gap-2 pt-2 border-t border-admin-border">
					<button
						type="button"
						@click="closeReply()"
						class="px-3.5 py-2 rounded-lg border border-admin-border text-xs font-medium text-admin-content-muted hover:bg-admin-surface-muted transition-colors cursor-pointer"
					>
						Отмена
					</button>
					<button
						type="submit"
						class="px-4 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent text-xs font-semibold transition-colors cursor-pointer"
					>
						Сохранить и отправить
					</button>
				</div>
			</form>
		</dialog>
	</div>
}
