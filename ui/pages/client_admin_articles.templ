package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientArticlesTab(articles []models.ArticleItem, trashArticles []models.ArticleItem, showTrash bool) {
	<div>
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
			<div>
				<h2 class="text-xl font-bold text-white tracking-tight">Статьи и Новости блога</h2>
				<p class="text-xs text-slate-400 mt-1">Публикация экспертных материалов, отложенный постинг и управление контентом</p>
			</div>
			<div class="flex items-center gap-3">
				if showTrash && len(trashArticles) > 0 {
					<button
						hx-post="/client/articles/trash/empty"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-confirm="Вы уверены, что хотите окончательно очистить корзину? Все удаленные статьи будут стёрты навсегда."
						class="px-3.5 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						<span>Очистить корзину</span>
					</button>
				}
				<button
					hx-get="/client/articles/new"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all shadow-lg shadow-amber-500/20 flex items-center gap-2 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					<span>Написать новую статью</span>
				</button>
			</div>
		</div>

		<!-- Вкладки-фильтры: Все публикации / Корзина -->
		<div class="flex items-center gap-2 mb-4 border-b border-slate-800 pb-3">
			<button
				type="button"
				hx-get="/client/tab/articles?view=all"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 cursor-pointer",
					templ.KV("bg-amber-500/15 text-amber-300 border border-amber-500/30", !showTrash),
					templ.KV("text-slate-400 hover:text-white bg-slate-800/40 border border-transparent", showTrash) }
			>
				<span>Все публикации</span>
				<span class={ "px-1.5 py-0.2 rounded-full text-[10px]",
					templ.KV("bg-amber-500/30 text-amber-200", !showTrash),
					templ.KV("bg-slate-700 text-slate-300", showTrash) }>
					{ fmt.Sprintf("%d", len(articles)) }
				</span>
			</button>

			<button
				type="button"
				hx-get="/client/tab/articles?view=trash"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 cursor-pointer",
					templ.KV("bg-red-500/15 text-red-300 border border-red-500/30", showTrash),
					templ.KV("text-slate-400 hover:text-white bg-slate-800/40 border border-transparent", !showTrash) }
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
				<span>Корзина</span>
				if len(trashArticles) > 0 {
					<span class={ "px-1.5 py-0.2 rounded-full text-[10px]",
						templ.KV("bg-red-500/30 text-red-200", showTrash),
						templ.KV("bg-red-500/20 text-red-400", !showTrash) }>
						{ fmt.Sprintf("%d", len(trashArticles)) }
					</span>
				}
			</button>
		</div>

		if showTrash {
			<!-- Режим просмотра корзины -->
			if len(trashArticles) == 0 {
				<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
					<div class="w-12 h-12 mx-auto rounded-xl bg-slate-800/50 border border-slate-700 text-slate-400 flex items-center justify-center mb-3">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</div>
					<h3 class="text-base font-semibold text-white mb-1">Корзина пуста</h3>
					<p class="text-xs text-slate-400 max-w-sm mx-auto">Удалённые материалы временно хранятся здесь. Вы можете восстановить их в любой момент.</p>
				</div>
			} else {
				<div class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs sm:text-sm">
							<thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
								<tr>
									<th class="py-3.5 px-4 font-semibold">Заголовок</th>
									<th class="py-3.5 px-4 font-semibold">URL (Slug)</th>
									<th class="py-3.5 px-4 font-semibold">Удалено</th>
									<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/60 text-slate-300">
								for _, a := range trashArticles {
									<tr class="hover:bg-slate-800/30 transition-colors">
										<td class="py-3.5 px-4 font-semibold max-w-sm truncate text-slate-400 line-through">
											{ a.Title }
										</td>
										<td class="py-3.5 px-4 font-mono text-xs text-slate-500">
											/blog/{ a.Slug }
										</td>
										<td class="py-3.5 px-4 text-slate-400 text-xs">
											if a.DeletedAt != "" {
												{ a.DeletedAt }
											} else {
												{ a.FormatPublishedAt() }
											}
										</td>
										<td class="py-3.5 px-4 text-right space-x-2">
											<button
												hx-post={ "/client/articles/restore/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs text-emerald-400 hover:text-emerald-300 hover:underline cursor-pointer font-medium"
											>
												Восстановить
											</button>
											<button
												hx-delete={ "/client/articles/permanent/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ "Окончательно удалить «" + a.Title + "»? Это действие нельзя отменить." }
												class="text-xs text-red-400 hover:text-red-300 hover:underline cursor-pointer font-medium"
											>
												Удалить навсегда
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		} else {
			<!-- Режим просмотра активных статей -->
			if len(articles) == 0 {
				<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
					<h3 class="text-base font-semibold text-white mb-1">Статей пока нет</h3>
					<p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">Нажмите кнопку выше, чтобы создать первую экспертную публикацию.</p>
				</div>
			} else {
				<div class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs sm:text-sm">
							<thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
								<tr>
									<th class="py-3.5 px-4 font-semibold">Заголовок</th>
									<th class="py-3.5 px-4 font-semibold">URL (Slug)</th>
									<th class="py-3.5 px-4 font-semibold">Дата публикации</th>
									<th class="py-3.5 px-4 font-semibold">Статус</th>
									<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/60 text-slate-300">
								for _, a := range articles {
									<tr class="hover:bg-slate-800/30 transition-colors">
										<td class="py-3.5 px-4 font-semibold text-white max-w-sm truncate">
											{ a.Title }
										</td>
										<td class="py-3.5 px-4 font-mono text-xs text-amber-400/80">
											/blog/{ a.Slug }
										</td>
										<td class="py-3.5 px-4 text-slate-300 text-xs">
											{ a.FormatPublishedAt() }
										</td>
										<td class="py-3.5 px-4">
											if a.IsScheduled() {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/10 text-amber-300 border border-amber-500/20" title="Публикация запланирована на будущее">
													<svg class="w-3 h-3 text-amber-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
													</svg>
													<span>Запланирована</span>
												</span>
											} else if a.IsPublished {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
													Опубликована
												</span>
											} else {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
													Черновик / Скрыта
												</span>
											}
										</td>
										<td class="py-3.5 px-4 text-right space-x-2">
											<!-- Быстрое переключение: Скрыть / Опубликовать в 1 клик -->
											<button
												hx-post={ "/client/articles/toggle/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class={ "text-xs font-medium cursor-pointer transition-colors",
													templ.KV("text-slate-400 hover:text-amber-400", a.IsPublished),
													templ.KV("text-emerald-400 hover:text-emerald-300", !a.IsPublished) }
												title={ templ.EscapeString(func() string { if a.IsPublished { return "Скрыть статью с сайта" } else { return "Опубликовать на сайте" } }()) }
											>
												if a.IsPublished {
													<span>Скрыть</span>
												} else {
													<span>Опубликовать</span>
												}
											</button>

											<button
												hx-get={ "/client/articles/edit/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs text-amber-400 hover:underline cursor-pointer"
											>
												Редактировать
											</button>

											if a.IsLive() {
												<a href={ templ.SafeURL("/blog/" + a.Slug) } target="_blank" class="text-xs text-slate-400 hover:text-white">
													Просмотр
												</a>
											}

											<!-- Кнопка удаления в корзину -->
											<button
												hx-post={ "/client/articles/trash/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ "Переместить статью «" + a.Title + "» в корзину?" }
												title="Переместить в корзину"
												class="text-xs text-red-400 hover:text-red-300 hover:underline cursor-pointer"
											>
												В корзину
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		}
	</div>
}

