package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientArticlesTab(articles []models.ArticleItem, trashArticles []models.ArticleItem, showTrash bool) {
	<div x-data="articleHoverPreview()" @keydown.escape.window="closePreview()" class="space-y-5">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h2 class="text-xl font-bold text-admin-content tracking-tight">Статьи и Новости блога</h2>
				<p class="text-xs text-admin-content-muted mt-0.5">Публикация экспертных материалов, отложенный постинг и управление контентом</p>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				if showTrash && len(trashArticles) > 0 {
					<button
						type="button"
						hx-post="/client/articles/trash/empty"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-confirm="Вы уверены, что хотите окончательно очистить корзину? Все удалённые статьи будут стёрты навсегда."
						class="px-3 py-2 rounded-lg bg-admin-danger-muted hover:bg-admin-danger/20 text-admin-danger border border-admin-danger-border font-medium text-xs transition-colors flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						<span>Очистить корзину</span>
					</button>
				}
				<button
					type="button"
					hx-get="/client/articles/new"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-3.5 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					<span>Написать новую статью</span>
				</button>
			</div>
		</div>

		<!-- Сегментированный переключатель: Публикации / Корзина -->
		<div class="inline-flex items-center p-1 rounded-lg bg-admin-surface-muted border border-admin-border text-xs font-medium">
			<button
				type="button"
				hx-get="/client/tab/articles?view=all"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3 py-1.5 rounded-md transition-colors flex items-center gap-2 cursor-pointer",
					templ.KV("bg-admin-surface text-admin-content font-semibold shadow-2xs", !showTrash),
					templ.KV("text-admin-content-muted hover:text-admin-content", showTrash) }
			>
				<span>Все публикации</span>
				<span class="px-1.5 py-0.5 rounded bg-admin-surface-muted text-admin-content-muted text-[10px] font-mono tabular-nums border border-admin-border">
					{ fmt.Sprintf("%d", len(articles)) }
				</span>
			</button>

			<button
				type="button"
				hx-get="/client/tab/articles?view=trash"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3 py-1.5 rounded-md transition-colors flex items-center gap-1.5 cursor-pointer",
					templ.KV("bg-admin-surface text-admin-danger font-semibold shadow-2xs", showTrash),
					templ.KV("text-admin-content-muted hover:text-admin-danger", !showTrash) }
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
				<span>Корзина</span>
				if len(trashArticles) > 0 {
					<span class="px-1.5 py-0.5 rounded bg-admin-danger-muted text-admin-danger text-[10px] font-mono tabular-nums border border-admin-danger-border">
						{ fmt.Sprintf("%d", len(trashArticles)) }
					</span>
				}
			</button>
		</div>

		if showTrash {
			if len(trashArticles) == 0 {
				<div class="bg-admin-surface border border-admin-border rounded-xl p-10 text-center">
					<div class="w-11 h-11 mx-auto rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content-muted flex items-center justify-center mb-3">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</div>
					<h3 class="text-sm font-semibold text-admin-content mb-1">Корзина пуста</h3>
					<p class="text-xs text-admin-content-muted max-w-sm mx-auto">Удалённые материалы временно хранятся здесь и могут быть восстановлены.</p>
				</div>
			} else {
				<div class="bg-admin-surface border border-admin-border rounded-xl overflow-hidden">
					<div class="overflow-x-auto">
						<table class="tabular-nums w-full text-left text-xs sm:text-sm">
							<thead class="bg-admin-surface-muted/60 border-b border-admin-border text-admin-content-muted text-xs font-medium">
								<tr>
									<th class="py-2.5 px-4 font-medium">Заголовок</th>
									<th class="py-2.5 px-4 font-medium">URL (Slug)</th>
									<th class="py-2.5 px-4 font-medium">Удалено</th>
									<th class="py-2.5 px-4 font-medium text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-admin-border text-admin-content">
								for _, a := range trashArticles {
									<tr class="hover:bg-admin-surface-muted/50 transition-colors">
										<td class="py-3 px-4 font-medium max-w-sm truncate text-admin-content-muted line-through">
											{ a.Title }
										</td>
										<td class="py-3 px-4 font-mono text-xs text-admin-content-subtle">
											/blog/{ a.Slug }
										</td>
										<td class="py-3 px-4 text-admin-content-muted text-xs font-mono">
											if a.DeletedAt != "" {
												{ a.DeletedAt }
											} else {
												{ a.FormatPublishedAt() }
											}
										</td>
										<td class="py-3 px-4 text-right whitespace-nowrap">
											<div class="inline-flex items-center gap-1.5">
												<button
													type="button"
													hx-post={ "/client/articles/restore/" + a.ID }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													class="px-2.5 py-1 rounded-md text-xs font-medium text-admin-success bg-admin-success-muted border border-admin-success-border hover:bg-admin-success/20 transition-colors cursor-pointer"
												>
													Восстановить
												</button>
												<button
													type="button"
													hx-delete={ "/client/articles/permanent/" + a.ID }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													hx-confirm={ "Окончательно удалить «" + a.Title + "»? Это действие нельзя отменить." }
													class="px-2.5 py-1 rounded-md text-xs font-medium text-admin-danger border border-admin-danger-border hover:bg-admin-danger-muted transition-colors cursor-pointer"
												>
													Удалить навсегда
												</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		} else {
			if len(articles) == 0 {
				<div class="bg-admin-surface border border-admin-border rounded-xl p-10 text-center">
					<h3 class="text-sm font-semibold text-admin-content mb-1">Статей пока нет</h3>
					<p class="text-xs text-admin-content-muted max-w-sm mx-auto mb-4">Создайте первую экспертную публикацию для корпоративного блога.</p>
					<button
						type="button"
						hx-get="/client/articles/new"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						class="px-3.5 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-xs transition-colors cursor-pointer"
					>
						Написать статью
					</button>
				</div>
			} else {
				<div class="bg-admin-surface border border-admin-border rounded-xl overflow-hidden">
					<div class="overflow-x-auto">
						<table class="tabular-nums w-full text-left text-xs sm:text-sm">
							<thead class="bg-admin-surface-muted/60 border-b border-admin-border text-admin-content-muted text-xs font-medium">
								<tr>
									<th class="py-2.5 px-4 font-medium">Заголовок</th>
									<th class="py-2.5 px-4 font-medium">URL (Slug)</th>
									<th class="py-2.5 px-4 font-medium">Дата публикации</th>
									<th class="py-2.5 px-4 font-medium">Статус</th>
									<th class="py-2.5 px-4 font-medium text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-admin-border text-admin-content">
								for _, a := range articles {
									<tr
										class="hover:bg-admin-surface-muted/50 transition-colors group cursor-default"
										@mouseenter.debounce.400ms={ fmt.Sprintf("showPreview('/blog/%s', %s)", a.Slug, escapeJSONString(a.Title)) }
										@mouseleave="hidePreview()"
									>
										<td class="py-3 px-4 font-medium text-admin-content max-w-sm truncate">
											<div class="flex items-center gap-2">
												<span class="truncate">{ a.Title }</span>
												<button
													type="button"
													@click.stop={ fmt.Sprintf("openPreviewNow('/blog/%s', %s)", a.Slug, escapeJSONString(a.Title)) }
													title="Быстрый предпросмотр"
													aria-label="Быстрый предпросмотр статьи"
													class="opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity text-admin-content-subtle hover:text-admin-accent cursor-pointer p-1 rounded shrink-0"
												>
													<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
													</svg>
												</button>
											</div>
										</td>
										<td class="py-3 px-4 font-mono text-xs text-admin-accent">
											/blog/{ a.Slug }
										</td>
										<td class="py-3 px-4 text-admin-content-muted text-xs font-mono">
											{ a.FormatPublishedAt() }
										</td>
										<td class="py-3 px-4 whitespace-nowrap">
											if a.IsScheduled() {
												<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning-border" title="Публикация запланирована на будущее">
													<svg class="w-3 h-3 text-admin-warning shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
													</svg>
													<span>Запланирована</span>
												</span>
											} else if a.IsPublished {
												<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-success-muted text-admin-success border border-admin-success-border">
													<span class="w-1.5 h-1.5 rounded-full bg-admin-success"></span>
													<span>Опубликована</span>
												</span>
											} else {
												<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border">
													<span class="w-1.5 h-1.5 rounded-full bg-admin-content-subtle"></span>
													<span>Черновик</span>
												</span>
											}
										</td>
										<td class="py-3 px-4 text-right whitespace-nowrap">
											<div class="inline-flex items-center gap-1.5 justify-end">
												<button
													type="button"
													hx-post={ "/client/articles/toggle/" + a.ID }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													class={ "px-2 py-1 rounded-md text-xs font-medium border cursor-pointer transition-colors",
														templ.KV("border-admin-border bg-admin-surface text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted", a.IsPublished),
														templ.KV("border-admin-success-border bg-admin-success-muted text-admin-success hover:bg-admin-success/20", !a.IsPublished) }
												>
													if a.IsPublished {
														<span>Скрыть</span>
													} else {
														<span>Опубликовать</span>
													}
												</button>

												<button
													type="button"
													hx-get={ "/client/articles/edit/" + a.ID }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													class="px-2.5 py-1 rounded-md text-xs font-medium text-admin-accent bg-admin-accent-muted border border-admin-accent-border hover:bg-admin-accent/20 transition-colors cursor-pointer"
												>
													Редактировать
												</button>

												<button
													type="button"
													@click.stop={ fmt.Sprintf("openPreviewNow('/blog/%s', %s)", a.Slug, escapeJSONString(a.Title)) }
													class="p-1.5 rounded-md border border-admin-border text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted transition-colors cursor-pointer"
													title="Открыть предпросмотр"
													aria-label="Открыть предпросмотр статьи"
												>
													<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
													</svg>
												</button>

												if a.IsLive() {
													<a
														href={ templ.SafeURL("/blog/" + a.Slug) }
														target="_blank"
														class="p-1.5 rounded-md border border-admin-border text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted transition-colors"
														title="Открыть на сайте"
														aria-label="Открыть статью в новой вкладке"
													>
														<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
														</svg>
													</a>
												}

												<button
													type="button"
													hx-post={ "/client/articles/trash/" + a.ID }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													hx-confirm={ "Переместить статью «" + a.Title + "» в корзину?" }
													title="Переместить в корзину"
													aria-label="Переместить статью в корзину"
													class="p-1.5 rounded-md border border-admin-border text-admin-content-subtle hover:text-admin-danger hover:bg-admin-danger-muted hover:border-admin-danger-border transition-colors cursor-pointer"
												>
													<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
													</svg>
												</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		}

		<!-- Live Hover Preview Singleton Container (Фича 5: UX-фокус и Live Preview) -->
		<div
			x-show="isOpen"
			x-cloak
			@mouseenter="keepPreview()"
			@mouseleave="hidePreview()"
			class="hover-preview-singleton fixed bottom-5 right-5 z-50 w-96 sm:w-[440px] max-w-[calc(100vw-2rem)] h-[560px] max-h-[82vh] bg-admin-surface-elevated border border-admin-border rounded-xl shadow-xl flex flex-col overflow-hidden pointer-events-auto"
		>
			<!-- Preview Header -->
			<div class="px-3.5 py-2.5 bg-admin-surface-muted border-b border-admin-border flex items-center justify-between shrink-0 select-none gap-2">
				<div class="min-w-0">
					<div class="text-xs font-semibold text-admin-content truncate" x-text="previewTitle || 'Превью публикации'"></div>
					<div class="text-[11px] font-mono text-admin-accent truncate" x-text="previewUrlDisplay"></div>
				</div>

				<div class="flex items-center gap-1 shrink-0">
					<a
						:href="previewUrl"
						target="_blank"
						title="Открыть в новой вкладке"
						aria-label="Открыть в новой вкладке"
						class="p-1.5 rounded-md text-admin-content-muted hover:text-admin-content hover:bg-admin-surface transition-colors"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
						</svg>
					</a>
					<button
						type="button"
						@click="closePreview()"
						title="Закрыть превью (Esc)"
						aria-label="Закрыть превью"
						class="p-1.5 rounded-md text-admin-content-muted hover:text-admin-danger hover:bg-admin-danger-muted transition-colors cursor-pointer"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			</div>

			<!-- Preview Content Area -->
			<div class="relative flex-1 w-full bg-admin-bg overflow-hidden">
				<div
					x-show="isLoading"
					class="absolute inset-0 flex flex-col items-center justify-center bg-admin-surface/85 z-10"
				>
					<div class="w-6 h-6 border-2 border-admin-accent border-t-transparent rounded-full animate-spin mb-2"></div>
					<p class="text-[11px] font-mono text-admin-content-muted">Загрузка превью...</p>
				</div>

				<template x-if="previewUrl">
					<iframe
						:src="previewUrl"
						@load="isLoading = false"
						class="w-full h-full border-0 bg-white"
						loading="lazy"
					></iframe>
				</template>
			</div>
		</div>

		<!-- Touch screen disable safeguard -->
		<style>
			@media not all and (hover: hover) and (pointer: fine) {
				.hover-preview-singleton {
					display: none !important;
				}
			}
		</style>

		<!-- Script for Hover Preview controller -->
		<script>
			function articleHoverPreview() {
				return {
					previewUrl: '',
					previewUrlDisplay: '',
					previewTitle: '',
					isOpen: false,
					isLoading: false,

					isFinePointer() {
						return window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
					},

					showPreview(url, title) {
						if (!this.isFinePointer() || !url) return;
						this.previewUrl = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'preview=1';
						this.previewUrlDisplay = url;
						this.previewTitle = title;
						this.isLoading = true;
						this.isOpen = true;
					},

					openPreviewNow(url, title) {
						if (!url) return;
						this.previewUrl = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'preview=1';
						this.previewUrlDisplay = url;
						this.previewTitle = title;
						this.isLoading = true;
						this.isOpen = true;
					},

					hidePreview() {
						this.isOpen = false;
						this.previewUrl = '';
						this.isLoading = false;
					},

					keepPreview() {
						this.isOpen = true;
					},

					closePreview() {
						this.isOpen = false;
						this.previewUrl = '';
						this.isLoading = false;
					}
				};
			}
		</script>
	</div>
}

