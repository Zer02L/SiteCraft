package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientArticlesTab(articles []models.ArticleItem, trashArticles []models.ArticleItem, showTrash bool) {
	<div>
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
			<div>
				<h2 class="text-xl font-bold text-admin-content tracking-tight">Статьи и Новости блога</h2>
				<p class="text-xs text-admin-content-muted mt-1">Публикация экспертных материалов, отложенный постинг и управление контентом</p>
			</div>
			<div class="flex items-center gap-3">
				if showTrash && len(trashArticles) > 0 {
					<button
						hx-post="/client/articles/trash/empty"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-confirm="Вы уверены, что хотите окончательно очистить корзину? Все удалённые статьи будут стёрты навсегда."
						class="px-3.5 py-2 rounded-xl bg-admin-danger-muted hover:bg-admin-danger/20 text-admin-danger border border-admin-danger/20 font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						<span>Очистить корзину</span>
					</button>
				}
				<button
					hx-get="/client/articles/new"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-4 py-2 rounded-xl bg-admin-accent hover:bg-admin-accent-hover text-white font-semibold text-xs transition-all shadow-sm flex items-center gap-2 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					<span>Написать новую статью</span>
				</button>
			</div>
		</div>

		<!-- Вкладки-фильтры: Все публикации / Корзина -->
		<div class="flex items-center gap-2 mb-4 border-b border-admin-border pb-3">
			<button
				type="button"
				hx-get="/client/tab/articles?view=all"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 cursor-pointer",
					templ.KV("bg-admin-accent-muted text-admin-accent border border-admin-accent-border font-semibold", !showTrash),
					templ.KV("text-admin-content-muted hover:text-admin-content bg-admin-surface border border-transparent", showTrash) }
			>
				<span>Все публикации</span>
				<span class={ "px-1.5 py-0.2 rounded-full text-[10px] font-mono",
					templ.KV("bg-admin-accent/20 text-admin-accent", !showTrash),
					templ.KV("bg-admin-surface-muted text-admin-content-muted", showTrash) }>
					{ fmt.Sprintf("%d", len(articles)) }
				</span>
			</button>

			<button
				type="button"
				hx-get="/client/tab/articles?view=trash"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 cursor-pointer",
					templ.KV("bg-admin-danger-muted text-admin-danger border border-admin-danger/30 font-semibold", showTrash),
					templ.KV("text-admin-content-muted hover:text-admin-content bg-admin-surface border border-transparent", !showTrash) }
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
				<span>Корзина</span>
				if len(trashArticles) > 0 {
					<span class={ "px-1.5 py-0.2 rounded-full text-[10px] font-mono",
						templ.KV("bg-admin-danger/30 text-admin-danger", showTrash),
						templ.KV("bg-admin-danger-muted text-admin-danger", !showTrash) }>
						{ fmt.Sprintf("%d", len(trashArticles)) }
					</span>
				}
			</button>
		</div>

		if showTrash {
			<!-- Режим просмотра корзины -->
			if len(trashArticles) == 0 {
				<div class="bg-admin-surface border border-admin-border rounded-2xl p-12 text-center">
					<div class="w-12 h-12 mx-auto rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content-muted flex items-center justify-center mb-3">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</div>
					<h3 class="text-base font-semibold text-admin-content mb-1">Корзина пуста</h3>
					<p class="text-xs text-admin-content-muted max-w-sm mx-auto">Удалённые материалы временно хранятся здесь. Вы можете восстановить их в любой момент.</p>
				</div>
			} else {
				<div class="bg-admin-surface border border-admin-border rounded-2xl overflow-hidden shadow-sm">
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs sm:text-sm">
							<thead class="bg-admin-surface-muted border-b border-admin-border text-admin-content-subtle text-[11px] uppercase tracking-wider">
								<tr>
									<th class="py-3.5 px-4 font-semibold">Заголовок</th>
									<th class="py-3.5 px-4 font-semibold">URL (Slug)</th>
									<th class="py-3.5 px-4 font-semibold">Удалено</th>
									<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-admin-border/60 text-admin-content">
								for _, a := range trashArticles {
									<tr class="hover:bg-admin-surface-hover transition-colors">
										<td class="py-3.5 px-4 font-semibold max-w-sm truncate text-admin-content-muted line-through">
											{ a.Title }
										</td>
										<td class="py-3.5 px-4 font-mono text-xs text-admin-content-subtle">
											/blog/{ a.Slug }
										</td>
										<td class="py-3.5 px-4 text-admin-content-muted text-xs">
											if a.DeletedAt != "" {
												{ a.DeletedAt }
											} else {
												{ a.FormatPublishedAt() }
											}
										</td>
										<td class="py-3.5 px-4 text-right space-x-2">
											<button
												hx-post={ "/client/articles/restore/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs text-admin-success hover:underline cursor-pointer font-medium"
											>
												Восстановить
											</button>
											<button
												hx-delete={ "/client/articles/permanent/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ "Окончательно удалить «" + a.Title + "»? Это действие нельзя отменить." }
												class="text-xs text-admin-danger hover:underline cursor-pointer font-medium"
											>
												Удалить навсегда
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		} else {
			<!-- Режим просмотра активных статей -->
			if len(articles) == 0 {
				<div class="bg-admin-surface border border-admin-border rounded-2xl p-12 text-center">
					<h3 class="text-base font-semibold text-admin-content mb-1">Статей пока нет</h3>
					<p class="text-xs text-admin-content-muted max-w-sm mx-auto mb-4">Нажмите кнопку выше, чтобы создать первую экспертную публикацию.</p>
				</div>
			} else {
				<div class="bg-admin-surface border border-admin-border rounded-2xl overflow-hidden shadow-sm">
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs sm:text-sm">
							<thead class="bg-admin-surface-muted border-b border-admin-border text-admin-content-subtle text-[11px] uppercase tracking-wider">
								<tr>
									<th class="py-3.5 px-4 font-semibold">Заголовок</th>
									<th class="py-3.5 px-4 font-semibold">URL (Slug)</th>
									<th class="py-3.5 px-4 font-semibold">Дата публикации</th>
									<th class="py-3.5 px-4 font-semibold">Статус</th>
									<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-admin-border/60 text-admin-content">
								for _, a := range articles {
									<tr class="hover:bg-admin-surface-hover transition-colors">
										<td class="py-3.5 px-4 font-semibold text-admin-content max-w-sm truncate">
											{ a.Title }
										</td>
										<td class="py-3.5 px-4 font-mono text-xs text-admin-accent">
											/blog/{ a.Slug }
										</td>
										<td class="py-3.5 px-4 text-admin-content-muted text-xs">
											{ a.FormatPublishedAt() }
										</td>
										<td class="py-3.5 px-4">
											if a.IsScheduled() {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning/20" title="Публикация запланирована на будущее">
													<svg class="w-3 h-3 text-admin-warning animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
													</svg>
													<span>Запланирована</span>
												</span>
											} else if a.IsPublished {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-admin-success-muted text-admin-success border border-admin-success/20">
													Опубликована
												</span>
											} else {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border">
													Черновик / Скрыта
												</span>
											}
										</td>
										<td class="py-3.5 px-4 text-right space-x-2">
											<!-- Быстрое переключение: Скрыть / Опубликовать в 1 клик -->
											<button
												hx-post={ "/client/articles/toggle/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class={ "text-xs font-medium cursor-pointer transition-colors",
													templ.KV("text-admin-content-muted hover:text-admin-accent", a.IsPublished),
													templ.KV("text-admin-success hover:underline", !a.IsPublished) }
												title={ templ.EscapeString(func() string { if a.IsPublished { return "Скрыть статью с сайта" } else { return "Опубликовать на сайте" } }()) }
											>
												if a.IsPublished {
													<span>Скрыть</span>
												} else {
													<span>Опубликовать</span>
												}
											</button>

											<button
												hx-get={ "/client/articles/edit/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs text-admin-accent hover:underline cursor-pointer"
											>
												Редактировать
											</button>

											if a.IsLive() {
												<a href={ templ.SafeURL("/blog/" + a.Slug) } target="_blank" class="text-xs text-admin-content-muted hover:text-admin-content">
													Просмотр
												</a>
											}

											<!-- Кнопка удаления в корзину -->
											<button
												hx-post={ "/client/articles/trash/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ "Переместить статью «" + a.Title + "» в корзину?" }
												title="Переместить в корзину"
												class="text-xs text-admin-danger hover:underline cursor-pointer"
											>
												В корзину
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		}
	</div>
}

