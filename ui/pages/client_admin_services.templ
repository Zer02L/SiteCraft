package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientServicesTab(services []models.ServiceItem, trashServices []models.ServiceItem, filter string) {
	{{
		activeCount := 0
		hiddenCount := 0
		for _, s := range services {
			if s.Active {
				activeCount++
			} else {
				hiddenCount++
			}
		}

		isTrashView := filter == "trash"
		var displayList []models.ServiceItem
		if isTrashView {
			displayList = trashServices
		} else if filter == "active" {
			for _, s := range services {
				if s.Active {
					displayList = append(displayList, s)
				}
			}
		} else if filter == "hidden" {
			for _, s := range services {
				if !s.Active {
					displayList = append(displayList, s)
				}
			}
		} else {
			displayList = services
		}
	}}
	<div>
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
			<div>
				<div class="flex items-center gap-3 flex-wrap">
					<h2 class="text-xl font-bold text-white tracking-tight">Каталог услуг и прайс-лист</h2>
					<div class="flex items-center gap-2">
						<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
							Активно: <strong class="font-bold">{ fmt.Sprintf("%d", activeCount) }</strong>
						</span>
						if hiddenCount > 0 {
							<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700">
								Скрыто: <strong class="font-bold">{ fmt.Sprintf("%d", hiddenCount) }</strong>
							</span>
						}
						if len(trashServices) > 0 {
							<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20">
								В корзине: <strong class="font-bold">{ fmt.Sprintf("%d", len(trashServices)) }</strong>
							</span>
						}
					</div>
				</div>
				<p class="text-xs text-slate-400 mt-1">Управление прайсом, складскими остатками, порядком вывода и безопасное двухэтапное удаление</p>
			</div>
			<div class="flex items-center gap-3">
				if isTrashView && len(trashServices) > 0 {
					<button
						type="button"
						hx-post="/client/services/trash/empty"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-confirm="Вы уверены, что хотите окончательно очистить корзину? Все удаленные услуги будут стёрты безвозвратно."
						class="px-3.5 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						<span>Очистить корзину</span>
					</button>
				}
				<button
					type="button"
					hx-get="/client/services/new"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all shadow-lg shadow-amber-500/20 flex items-center gap-2 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					<span>Добавить услугу</span>
				</button>
			</div>
		</div>

		<!-- Фильтры и Корзина -->
		<div class="flex items-center gap-2 mb-4 border-b border-slate-800 pb-3 flex-wrap">
			<button
				type="button"
				hx-get="/client/tab/services?filter=all"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer",
					templ.KV("bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold", filter == "" || filter == "all"),
					templ.KV("text-slate-400 hover:text-slate-200 hover:bg-slate-800/40", filter != "" && filter != "all") }
			>
				Все позиции ({ fmt.Sprintf("%d", len(services)) })
			</button>
			<button
				type="button"
				hx-get="/client/tab/services?filter=active"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer",
					templ.KV("bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold", filter == "active"),
					templ.KV("text-slate-400 hover:text-slate-200 hover:bg-slate-800/40", filter != "active") }
			>
				Только активные ({ fmt.Sprintf("%d", activeCount) })
			</button>
			if hiddenCount > 0 {
				<button
					type="button"
					hx-get="/client/tab/services?filter=hidden"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class={ "px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer",
						templ.KV("bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold", filter == "hidden"),
						templ.KV("text-slate-400 hover:text-slate-200 hover:bg-slate-800/40", filter != "hidden") }
				>
					Скрытые ({ fmt.Sprintf("%d", hiddenCount) })
				</button>
			}
			if len(trashServices) > 0 || isTrashView {
				<button
					type="button"
					hx-get="/client/tab/services?filter=trash"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class={ "px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer flex items-center gap-1.5",
						templ.KV("bg-rose-500/15 text-rose-400 border border-rose-500/30 font-semibold", isTrashView),
						templ.KV("text-rose-400/80 hover:text-rose-300 hover:bg-rose-500/10 border border-transparent", !isTrashView) }
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
					<span>Корзина ({ fmt.Sprintf("%d", len(trashServices)) })</span>
				</button>
			}
		</div>

		if len(displayList) == 0 {
			<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
				<div class="w-12 h-12 rounded-full bg-slate-800 text-slate-500 flex items-center justify-center mx-auto mb-3 text-xl">
					if isTrashView {
						🗑️
					} else {
						💼
					}
				</div>
				<h3 class="text-white font-bold text-base mb-1">
					if isTrashView {
						Корзина пуста
					} else {
						Позиций не найдено
					}
				</h3>
				<p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">
					if isTrashView {
						Удаленные услуги отсутствуют. Все созданные позиции находятся в активном каталоге.
					} else if filter != "" && filter != "all" {
						В этой категории нет позиций. Попробуйте переключить фильтр.
					} else {
						В каталоге пока нет услуг. Нажмите кнопку «Добавить услугу», чтобы создать первую позицию.
					}
				</p>
			</div>
		} else {
			<div class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs sm:text-sm">
						<thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
							<tr>
								if !isTrashView {
									<th class="py-3.5 px-3 font-semibold text-center w-24">Порядок</th>
								}
								<th class="py-3.5 px-4 font-semibold">Услуга / Товар</th>
								<th class="py-3.5 px-4 font-semibold">Стоимость</th>
								<th class="py-3.5 px-4 font-semibold">Склад / Наличие</th>
								<th class="py-3.5 px-4 font-semibold">Статус</th>
								<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800/60 text-slate-300">
							for i, s := range displayList {
								<tr class="hover:bg-slate-800/30 transition-colors" id={ "service-row-" + s.ID }>
									if !isTrashView {
										<td class="py-3.5 px-3 text-center whitespace-nowrap">
											<div class="inline-flex items-center gap-1 font-mono text-xs text-slate-400">
												<button
													type="button"
													hx-post={ "/client/services/" + s.ID + "/reorder?dir=up" }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													disabled?={ i == 0 }
													class="p-1 rounded text-slate-400 hover:text-amber-400 hover:bg-slate-800 disabled:opacity-20 disabled:hover:text-slate-400 disabled:cursor-not-allowed cursor-pointer transition-colors"
													title="Переместить выше"
												>
													▲
												</button>
												<span class="w-5 text-center font-bold">{ fmt.Sprintf("%d", s.Order) }</span>
												<button
													type="button"
													hx-post={ "/client/services/" + s.ID + "/reorder?dir=down" }
													hx-target="#admin-tab-content"
													hx-swap="innerHTML"
													disabled?={ i == len(displayList)-1 }
													class="p-1 rounded text-slate-400 hover:text-amber-400 hover:bg-slate-800 disabled:opacity-20 disabled:hover:text-slate-400 disabled:cursor-not-allowed cursor-pointer transition-colors"
													title="Переместить ниже"
												>
													▼
												</button>
											</div>
										</td>
									}
									<td class="py-3.5 px-4 max-w-sm">
										<div class="font-semibold text-white">{ s.Title }</div>
										if s.Description != "" {
											<div class="text-[11px] text-slate-400 mt-0.5 line-clamp-1">{ s.Description }</div>
										}
										if isTrashView && s.DeletedAt != "" {
											<div class="text-[10px] text-rose-400/80 mt-1">Удалено: { s.DeletedAt }</div>
										}
									</td>
									<td class="py-3.5 px-4 font-medium text-amber-300 whitespace-nowrap">
										if s.Price != "" {
											<span>{ s.Price }</span>
										} else {
											<span class="text-slate-500 text-xs">—</span>
										}
									</td>
									<td class="py-3.5 px-4 whitespace-nowrap">
										if s.StockCount > 0 {
											<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
												Остаток: { fmt.Sprintf("%d шт.", s.StockCount) }
											</span>
										} else if s.StockCount == 0 {
											<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20">
												Нет в наличии
											</span>
										} else if s.IsPreorder {
											<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
												Под заказ
											</span>
										} else {
											<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
												Неограниченно
											</span>
										}
									</td>
									<td class="py-3.5 px-4 whitespace-nowrap">
										if isTrashView {
											<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">
												В корзине
											</span>
										} else if s.Active {
											<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
												Активна
											</span>
										} else {
											<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-800 text-slate-400 border border-slate-700">
												Скрыта
											</span>
										}
									</td>
									<td class="py-3.5 px-4 text-right space-x-2 whitespace-nowrap">
										if isTrashView {
											<!-- Действия в корзине: Восстановить в 1 клик или Удалить навсегда -->
											<button
												type="button"
												hx-post={ "/client/services/" + s.ID + "/restore" }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 px-2.5 py-1 rounded-lg border border-emerald-500/20 bg-emerald-500/10 hover:bg-emerald-500/20 transition-colors cursor-pointer"
											>
												Восстановить
											</button>

											<button
												type="button"
												hx-delete={ "/client/services/" + s.ID + "/permanent" }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ fmt.Sprintf("Удалить позицию «%s» навсегда? Это действие нельзя отменить.", s.Title) }
												class="text-xs font-medium text-rose-400 hover:text-rose-300 px-2 py-1 rounded-lg border border-rose-500/20 hover:bg-rose-500/10 transition-colors cursor-pointer"
											>
												Удалить навсегда
											</button>
										} else {
											<!-- Стандартные действия: Тоггл, Редактирование, В корзину -->
											<button
												type="button"
												hx-post={ "/client/services/" + s.ID + "/toggle" }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class={ "text-xs font-medium cursor-pointer transition-colors px-2 py-1 rounded-lg border",
													templ.KV("border-slate-700 text-slate-300 hover:bg-slate-800 hover:text-amber-400", s.Active),
													templ.KV("border-emerald-500/20 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20", !s.Active) }
											>
												if s.Active {
													<span>Скрыть</span>
												} else {
													<span>Включить</span>
												}
											</button>

											<button
												type="button"
												hx-get={ "/client/services/edit/" + s.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs font-medium text-amber-400 hover:text-amber-300 px-2 py-1 rounded-lg border border-amber-500/20 bg-amber-500/10 hover:bg-amber-500/20 transition-colors cursor-pointer"
											>
												Изменить
											</button>

											<button
												type="button"
												hx-post={ "/client/services/" + s.ID + "/trash" }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ fmt.Sprintf("Переместить услугу «%s» в корзину? Вы сможете восстановить её в любой момент.", s.Title) }
												class="text-xs font-medium text-rose-400 hover:text-rose-300 px-2 py-1 rounded-lg border border-rose-500/20 hover:bg-rose-500/10 transition-colors cursor-pointer"
												title="Переместить в корзину"
											>
												В корзину
											</button>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>
}

templ ClientServiceForm(service models.ServiceItem, isNew bool) {
	<div class="max-w-2xl mx-auto">
		<div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
			<div>
				<h2 class="text-xl font-bold text-white tracking-tight">
					if isNew {
						Добавить услугу или товар
					} else {
						Редактирование: { service.Title }
					}
				</h2>
				<p class="text-xs text-slate-400 mt-1">Заполните данные для отображения в блоке услуг и каталоге сайта</p>
			</div>
			<button
				type="button"
				hx-get="/client/tab/services"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class="text-xs text-slate-400 hover:text-white px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/60 hover:bg-slate-800 transition-colors cursor-pointer flex items-center gap-1.5"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
				</svg>
				<span>Назад к списку</span>
			</button>
		</div>

		<form
			hx-post="/client/services/save"
			hx-target="#admin-tab-content"
			hx-swap="innerHTML"
			class="space-y-5 bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl"
		>
			<input type="hidden" name="id" value={ service.ID } />

			<!-- Название услуги -->
			<div>
				<label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
					Название услуги или товара <span class="text-amber-400">*</span>
				</label>
				<input
					type="text"
					name="title"
					value={ service.Title }
					required
					placeholder="Например: Замена масла и фильтров, Экспресс-консультация..."
					class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all text-sm"
				/>
			</div>

			<!-- Стоимость и Порядок сортировки в 2 колонки -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
						Стоимость / Тариф
					</label>
					<input
						type="text"
						name="price"
						value={ service.Price }
						placeholder="от 2 500 ₽, 1 900 ₽/мес, Бесплатно..."
						class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all text-sm"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Произвольный текстовый формат или точная сумма с валютой</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
						Порядок вывода (сортировка)
					</label>
					<input
						type="number"
						name="order"
						value={ fmt.Sprintf("%d", service.Order) }
						min="0"
						step="1"
						placeholder="1"
						class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all text-sm"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Меньшее число выводится выше в списке</p>
				</div>
			</div>

			<!-- Складской учет и доступность -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
						Остаток на складе (шт.)
					</label>
					<input
						type="number"
						name="stock_count"
						value={ fmt.Sprintf("%d", service.StockCount) }
						placeholder="-1"
						class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all text-sm"
					/>
					<p class="text-[11px] text-slate-500 mt-1">-1 для неограниченного запаса, 0 при отсутствии</p>
				</div>

				<div class="flex flex-col justify-end space-y-3 pb-1">
					<label class="flex items-center gap-2.5 cursor-pointer">
						<input
							type="checkbox"
							name="is_preorder"
							value="true"
							checked?={ service.IsPreorder }
							class="w-4 h-4 rounded bg-slate-800 border-slate-700 text-amber-500 focus:ring-amber-500 focus:ring-offset-slate-900"
						/>
						<span class="text-xs text-slate-300 font-medium">Доступно под заказ (Preorder)</span>
					</label>

					<label class="flex items-center gap-2.5 cursor-pointer">
						<input
							type="checkbox"
							name="active"
							value="true"
							checked?={ service.Active }
							class="w-4 h-4 rounded bg-slate-800 border-slate-700 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-slate-900"
						/>
						<span class="text-xs text-slate-300 font-medium">Активна (показывать на витрине сайта)</span>
					</label>
				</div>
			</div>

			<!-- Подробное описание -->
			<div>
				<label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
					Краткое описание / Особенности
				</label>
				<textarea
					name="description"
					rows="3"
					placeholder="Укажите, что входит в услугу, сроки исполнения, гарантию..."
					class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all text-sm resize-none"
				>{ service.Description }</textarea>
			</div>

			<div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
				<button
					type="button"
					hx-get="/client/tab/services"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-4 py-2.5 rounded-xl border border-slate-700 text-slate-400 hover:text-white hover:bg-slate-800 text-xs font-medium transition-colors cursor-pointer"
				>
					Отмена
				</button>
				<button
					type="submit"
					class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all shadow-lg shadow-amber-500/20 active:scale-[0.99] flex items-center gap-2 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>Сохранить позицию</span>
				</button>
			</div>
		</form>
	</div>
}
