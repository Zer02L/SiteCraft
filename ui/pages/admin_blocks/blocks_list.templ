package admin_blocks

import (
	"fmt"
	"sitecraft/internal/models"
	"strings"
)

templ BlockTypeIcon(bType string) {
	switch strings.ToLower(strings.TrimSpace(bType)) {
		case "hero":
			<svg class="w-3.5 h-3.5 shrink-0 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 14h8m-8 4h5"></path>
			</svg>
		case "services":
			<svg class="w-3.5 h-3.5 shrink-0 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
			</svg>
		case "booking":
			<svg class="w-3.5 h-3.5 shrink-0 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
			</svg>
		case "reviews":
			<svg class="w-3.5 h-3.5 shrink-0 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
			</svg>
		case "map", "contacts", "branches":
			<svg class="w-3.5 h-3.5 shrink-0 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
			</svg>
		default:
			<svg class="w-3.5 h-3.5 shrink-0 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h10"></path>
			</svg>
	}
}

templ BlocksList(blocks []models.PageBlock) {
	<!-- Состояние ошибки синхронизации -->
	<div
		x-show="saveStatus && saveStatus.includes('Ошибка')"
		x-cloak
		class="p-2.5 rounded-lg bg-admin-danger-muted border border-admin-danger-border text-admin-danger text-xs flex items-center justify-between gap-2"
		role="alert"
	>
		<span x-text="saveStatus"></span>
		<button
			type="button"
			@click="refreshCanvas()"
			class="px-2 py-0.5 rounded bg-admin-surface border border-admin-danger-border font-medium cursor-pointer"
		>
			Повторить
		</button>
	</div>

	<!-- Индикатор загрузки HTMX -->
	<div id="blocks-loading-state" class="htmx-indicator p-3 rounded-lg border border-admin-border bg-admin-surface-muted/50 text-xs text-admin-content-muted text-center">
		Обновление списка секций...
	</div>

	if len(blocks) == 0 {
		<div class="p-8 text-center bg-admin-surface-muted/30 rounded-xl border border-dashed border-admin-border space-y-3">
			<p class="text-admin-content-muted text-xs">Секции лендинга пока не добавлены.</p>
			<button
				type="button"
				onclick="document.getElementById('new-block-dialog').showModal()"
				class="px-3.5 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent text-xs font-semibold transition-colors cursor-pointer"
			>
				Добавить первую секцию
			</button>
		</div>
	} else {
		<div class="space-y-2">
			for idx, b := range blocks {
				{{
					typeName, _ := HumanBlockType(b.Type)
					variantStr := ""
					if v, ok := b.Payload["variant"].(string); ok {
						variantStr = v
					}
					popoverID := "block-menu-" + b.ID
					anchorName := "--blk-" + b.ID
				}}
				<div
					id={ "block-card-" + b.ID }
					@click={ fmt.Sprintf("selectBlock('%s', '%s')", b.ID, b.Type) }
					:class={ fmt.Sprintf("selectedBlockId === '%s' ? 'ring-1 ring-admin-border-focus border-admin-border-focus bg-admin-accent-muted/25' : ''", b.ID) }
					class={ "p-3 rounded-xl border transition-colors cursor-pointer relative group",
						templ.KV("bg-admin-surface border-admin-border hover:border-admin-border-focus", b.Active),
						templ.KV("opacity-60 bg-admin-surface-muted/50 border-dashed border-admin-border", !b.Active) }
				>
					<div class="flex items-start justify-between gap-2.5">
						<!-- Левая группа: Ручка, Номер, Заголовок и тип -->
						<div class="flex items-start gap-2 min-w-0 flex-1">
							<div class="pt-0.5 text-admin-content-subtle group-hover:text-admin-content-muted cursor-grab shrink-0 select-none" title="Порядок секции">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h.01M8 15h.01M16 9h.01M16 15h.01"></path>
								</svg>
							</div>

							<div class="w-5 h-5 shrink-0 rounded-md bg-admin-surface-muted text-admin-content-muted text-[11px] font-mono tabular-nums font-semibold flex items-center justify-center select-none border border-admin-border">
								{ fmt.Sprintf("%d", idx+1) }
							</div>

							<div class="min-w-0 flex-1">
								<h4 class="font-medium text-admin-content text-xs leading-snug break-words">
									{ b.Title }
								</h4>

								<div class="flex items-center gap-1.5 mt-1 flex-wrap">
									<span
										class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[11px] text-admin-content-muted bg-admin-surface-muted border border-admin-border"
										title={ "Код блока: " + b.Type }
									>
										@BlockTypeIcon(b.Type)
										<span>{ typeName }</span>
									</span>

									if variantStr != "" {
										<span class="px-1.5 py-0.5 rounded-md text-[10px] font-mono text-admin-content-subtle bg-admin-surface-muted border border-admin-border">
											{ variantStr }
										</span>
									}
								</div>
							</div>
						</div>

						<!-- Правая группа: Спокойный переключатель видимости + Нативное меню действий -->
						<div class="flex items-center gap-1.5 shrink-0 pt-0.5" @click.stop>
							<button
								type="button"
								role="switch"
								aria-checked={ fmt.Sprintf("%t", b.Active) }
								hx-post={ fmt.Sprintf("/admin/blocks/%s/toggle", b.ID) }
								hx-target="#admin-tab-content"
								hx-swap="innerHTML"
								hx-indicator="#blocks-loading-state"
								class={ "relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus",
									templ.KV("bg-admin-success border-admin-success", b.Active),
									templ.KV("bg-admin-surface-hover border-admin-border", !b.Active) }
								title={ func() string { if b.Active { return "Скрыть секцию на сайте" } else { return "Показать секцию на сайте" } }() }
								aria-label={ func() string { if b.Active { return "Секция видна — скрыть" } else { return "Секция скрыта — показать" } }() }
							>
								<span
									class={ "pointer-events-none inline-block h-3.5 w-3.5 rounded-full bg-white shadow-2xs transition-transform",
										templ.KV("translate-x-4", b.Active),
										templ.KV("translate-x-0.5", !b.Active) }
								></span>
							</button>

							<!-- Нативное меню действий (Popover API + CSS Anchor) -->
							<button
								type="button"
								popovertarget={ popoverID }
								style={ fmt.Sprintf("anchor-name: %s;", anchorName) }
								class="p-1 rounded-md border border-transparent hover:border-admin-border hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
								title="Действия над секцией"
								aria-label="Действия над секцией"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path>
								</svg>
							</button>

							<div
								id={ popoverID }
								popover="auto"
								style={ fmt.Sprintf("position-anchor: %s;", anchorName) }
								class="admin-popover w-44 rounded-xl bg-admin-surface-elevated border border-admin-border shadow-lg py-1 text-xs text-admin-content font-medium"
							>
								<button
									type="button"
									@click={ fmt.Sprintf("openEdit('%s', '%s', '%s', '%s', '%s'); document.getElementById('%s')?.hidePopover();", b.ID, b.Title, b.Content, b.Type, variantStr, popoverID) }
									class="w-full px-3 py-2 text-left hover:bg-admin-surface-muted flex items-center gap-2 cursor-pointer"
								>
									<svg class="w-3.5 h-3.5 text-admin-content-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
									</svg>
									<span>Свойства блока</span>
								</button>

								if idx > 0 {
									<button
										type="button"
										hx-post={ fmt.Sprintf("/admin/blocks/%s/move-up", b.ID) }
										hx-target="#admin-tab-content"
										hx-swap="innerHTML"
										class="w-full px-3 py-2 text-left hover:bg-admin-surface-muted flex items-center gap-2 cursor-pointer"
									>
										<svg class="w-3.5 h-3.5 text-admin-content-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
										</svg>
										<span>Поднять выше</span>
									</button>
								}

								if idx < len(blocks)-1 {
									<button
										type="button"
										hx-post={ fmt.Sprintf("/admin/blocks/%s/move-down", b.ID) }
										hx-target="#admin-tab-content"
										hx-swap="innerHTML"
										class="w-full px-3 py-2 text-left hover:bg-admin-surface-muted flex items-center gap-2 cursor-pointer"
									>
										<svg class="w-3.5 h-3.5 text-admin-content-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
										</svg>
										<span>Опустить ниже</span>
									</button>
								}

								<div class="my-1 border-t border-admin-border"></div>

								<button
									type="button"
									hx-post={ fmt.Sprintf("/admin/blocks/%s/delete", b.ID) }
									hx-confirm="Удалить этот блок лендинга безвозвратно?"
									hx-target="#admin-tab-content"
									hx-swap="innerHTML"
									class="w-full px-3 py-2 text-left hover:bg-admin-danger-muted text-admin-danger flex items-center gap-2 cursor-pointer"
								>
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
									<span>Удалить блок</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
}
