package admin_blocks

templ EditModal() {
	<!-- Диалог добавления новой секции -->
	<dialog
		id="new-block-dialog"
		onclick="if (event.target === this) this.close()"
		class="admin-dialog fixed inset-0 m-auto bg-admin-surface-elevated border border-admin-border rounded-xl p-6 text-admin-content max-w-lg w-[calc(100%-2rem)] shadow-xl z-50 h-fit"
	>
		<div class="flex items-center justify-between pb-3 border-b border-admin-border">
			<h3 class="text-base font-semibold text-admin-content">Добавить секцию в лендинг</h3>
			<button
				type="button"
				onclick="document.getElementById('new-block-dialog').close()"
				class="text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted cursor-pointer p-1.5 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				aria-label="Закрыть окно добавления секции"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<form
			hx-post="/admin/blocks/new"
			hx-target="#admin-tab-content"
			hx-swap="innerHTML"
			onsubmit="document.getElementById('new-block-dialog').close(); setTimeout(() => { const f = document.getElementById('preview-canvas'); if(f) f.src = f.src; }, 350);"
			class="space-y-4 mt-4"
		>
			<div>
				<label for="new-block-type" class="block text-xs font-medium text-admin-content-muted mb-1.5">Тип секции</label>
				<select
					id="new-block-type"
					name="type"
					class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					<option value="hero">Главный экран (Hero)</option>
					<option value="cinematic_odometer">Интерактивный счётчик (Odometer)</option>
					<option value="cinematic_spotlight">Световой прожектор (Spotlight)</option>
					<option value="comparison">Сравнение до / после (Comparison)</option>
					<option value="cinematic_sticky_stack">Каскадные карточки (Sticky Stack)</option>
					<option value="cinematic_marquee">Бегущая строка (Marquee)</option>
					<option value="features">Ключевые преимущества (Features)</option>
					<option value="services">Услуги и цены (Services)</option>
					<option value="booking">Форма онлайн-записи (Booking)</option>
					<option value="quiz">Калькулятор / Квиз (Quiz)</option>
					<option value="steps">Этапы работы (Steps)</option>
					<option value="reviews">Отзывы клиентов (Reviews)</option>
					<option value="team">Команда специалистов (Team)</option>
					<option value="faq">Вопросы и ответы (FAQ)</option>
					<option value="gallery">Фотогалерея (Gallery)</option>
					<option value="map">Интерактивная карта (Map)</option>
				</select>
			</div>

			<div>
				<label for="new-block-title" class="block text-xs font-medium text-admin-content-muted mb-1.5">Заголовок секции</label>
				<input
					id="new-block-title"
					type="text"
					name="title"
					required
					placeholder="Например: Ключевые преимущества"
					class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				/>
			</div>

			<div>
				<label for="new-block-content" class="block text-xs font-medium text-admin-content-muted mb-1.5">Описание / Подзаголовок</label>
				<textarea
					id="new-block-content"
					name="content"
					rows="3"
					placeholder="Краткое описание назначения секции..."
					class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				></textarea>
			</div>

			<div class="flex items-center justify-end gap-2.5 pt-3 border-t border-admin-border">
				<button
					type="button"
					onclick="document.getElementById('new-block-dialog').close()"
					class="px-3.5 py-2 rounded-lg bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content text-xs font-medium transition-colors border border-admin-border cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					Отмена
				</button>
				<button
					type="submit"
					class="px-4 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent text-xs font-semibold transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					Создать секцию
				</button>
			</div>
		</form>
	</dialog>

	<!-- Диалог редактирования свойств секции -->
	<dialog
		id="edit-block-dialog"
		onclick="if (event.target === this) this.close()"
		class="admin-dialog fixed inset-0 m-auto bg-admin-surface-elevated border border-admin-border rounded-xl p-6 text-admin-content max-w-lg w-[calc(100%-2rem)] shadow-xl z-50 h-fit"
	>
		<div class="flex items-center justify-between pb-3 border-b border-admin-border">
			<h3 class="text-base font-semibold text-admin-content">Свойства секции</h3>
			<button
				type="button"
				onclick="document.getElementById('edit-block-dialog').close()"
				class="text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted cursor-pointer p-1.5 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				aria-label="Закрыть окно редактирования секции"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<form
			hx-post="/admin/blocks/edit"
			hx-target="#admin-tab-content"
			hx-swap="innerHTML"
			onsubmit="document.getElementById('edit-block-dialog').close(); setTimeout(() => { const f = document.getElementById('preview-canvas'); if(f) f.src = f.src; }, 350);"
			class="space-y-4 mt-4"
		>
			<input type="hidden" name="id" id="edit-block-id" :value="editBlock.id"/>
			<input type="hidden" name="type" id="edit-block-type" :value="editBlock.type"/>

			<div>
				<label for="edit-block-title" class="block text-xs font-medium text-admin-content-muted mb-1.5">Заголовок секции</label>
				<input
					type="text"
					name="title"
					id="edit-block-title"
					x-model="editBlock.title"
					required
					class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				/>
			</div>

			<div>
				<label for="edit-block-content" class="block text-xs font-medium text-admin-content-muted mb-1.5">Текст / Описание</label>
				<textarea
					name="content"
					id="edit-block-content"
					x-model="editBlock.content"
					rows="3"
					class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				></textarea>
			</div>

			<div id="edit-variant-row" x-show="editBlock.type === 'hero'">
				<label for="edit-block-variant" class="block text-xs font-medium text-admin-content-muted mb-1.5">Стилевой вариант</label>
				<select
					name="variant"
					id="edit-block-variant"
					x-model="editBlock.variant"
					class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					<option value="classic">Classic (Лаконичный)</option>
					<option value="split">Split (Разделенный с акцентом)</option>
					<option value="cyber">Cyber (Контрастный)</option>
					<option value="legal">Legal (Архитектурный)</option>
				</select>
			</div>

			<div class="flex items-center justify-end gap-2.5 pt-3 border-t border-admin-border">
				<button
					type="button"
					onclick="document.getElementById('edit-block-dialog').close()"
					class="px-3.5 py-2 rounded-lg bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content text-xs font-medium transition-colors border border-admin-border cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					Отмена
				</button>
				<button
					type="submit"
					class="px-4 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent text-xs font-semibold transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					Сохранить изменения
				</button>
			</div>
		</form>
	</dialog>
}
