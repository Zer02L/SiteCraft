package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/layouts"
)

templ ClientLogin(settings models.SiteSettings, errMsg string) {
	@layouts.Base("Вход в панель управления — "+settings.SiteName, "Авторизация в клиентской панели", settings) {
		<div class="min-h-screen flex items-center justify-center bg-admin-bg px-4 py-12">
			<div class="w-full max-w-md bg-admin-surface border border-admin-border rounded-2xl shadow-2xl p-8 backdrop-blur-sm">
				<div class="text-center mb-8">
					<div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-admin-accent-muted border border-admin-accent-border text-admin-accent mb-4">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
						</svg>
					</div>
					<h1 class="text-xl font-bold tracking-tight text-admin-content mb-1">Панель управления</h1>
					<p class="text-xs text-admin-content-muted font-mono">{ settings.SiteName }</p>
				</div>

				if errMsg != "" {
					<div class="mb-6 p-3.5 rounded-xl bg-admin-danger-muted border border-admin-danger/25 text-admin-danger text-xs flex items-center gap-2.5">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}

				<form method="POST" action="/client/login" class="space-y-4">
					<div>
						<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Пароль доступа</label>
						<input
							type="password"
							name="password"
							required
							autofocus
							placeholder="Введите мастер-пароль..."
							class="w-full px-3.5 py-2.5 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus:ring-2 focus:ring-admin-border-focus focus:border-transparent transition-colors"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-2.5 px-4 rounded-xl bg-admin-accent hover:bg-admin-accent-hover text-white font-semibold text-sm transition-all shadow-sm active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<span>Войти в консоль</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</form>

				<div class="mt-8 pt-6 border-t border-admin-border text-center">
					<a href="/" class="text-xs text-admin-content-muted hover:text-admin-content transition-colors inline-flex items-center gap-1.5 font-medium">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Вернуться на сайт
					</a>
				</div>
			</div>
		</div>
	}
}

templ ClientInitialSetup(settings models.SiteSettings, errMsg string) {
	@layouts.Base("Первоначальная настройка — "+settings.SiteName, "Установка пароля администратора", settings) {
		<div class="min-h-screen flex items-center justify-center bg-admin-bg px-4 py-12">
			<div class="w-full max-w-md bg-admin-surface border border-admin-border rounded-2xl shadow-2xl p-8 backdrop-blur-sm">
				<div class="text-center mb-8">
					<div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-admin-success-muted border border-admin-success/25 text-admin-success mb-4">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
						</svg>
					</div>
					<h1 class="text-xl font-bold tracking-tight text-admin-content mb-1">Инициализация доступа</h1>
					<p class="text-xs text-admin-content-muted">Задайте мастер-пароль для входа в панель управления</p>
				</div>

				if errMsg != "" {
					<div class="mb-6 p-3.5 rounded-xl bg-admin-danger-muted border border-admin-danger/25 text-admin-danger text-xs flex items-center gap-2.5">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}

				<form method="POST" action="/client/setup" class="space-y-4">
					<div>
						<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Мастер-пароль</label>
						<input
							type="password"
							name="password"
							required
							autofocus
							minlength="8"
							placeholder="Не менее 8 символов..."
							class="w-full px-3.5 py-2.5 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus:ring-2 focus:ring-admin-border-focus focus:border-transparent transition-colors"
						/>
						<p class="mt-1 text-[11px] font-mono text-admin-content-subtle">Минимум 8 знаков</p>
					</div>

					<div>
						<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Подтверждение пароля</label>
						<input
							type="password"
							name="password_confirm"
							required
							minlength="8"
							placeholder="Повторите ввод пароля..."
							class="w-full px-3.5 py-2.5 rounded-xl bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus:ring-2 focus:ring-admin-border-focus focus:border-transparent transition-colors"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-2.5 px-4 rounded-xl bg-admin-accent hover:bg-admin-accent-hover text-white font-semibold text-sm transition-all shadow-sm active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<span>Сохранить и войти</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</form>

				<div class="mt-8 pt-6 border-t border-admin-border text-center">
					<a href="/" class="text-xs text-admin-content-muted hover:text-admin-content transition-colors inline-flex items-center gap-1.5 font-medium">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Вернуться на сайт
					</a>
				</div>
			</div>
		</div>
	}
}

templ AdminTabIcon(id string) {
	switch id {
		case "leads":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
			</svg>
		case "contacts":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
			</svg>
		case "services":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
			</svg>
		case "articles", "blog":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
			</svg>
		case "reviews":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
			</svg>
		case "security":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
			</svg>
		case "blocks", "editor":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
			</svg>
		case "fleet":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
			</svg>
		default:
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
			</svg>
	}
}

templ ClientFleetTab() {
	<div class="p-6 bg-admin-surface border border-admin-border rounded-2xl text-admin-content shadow-sm">
		<div class="flex items-center gap-3 mb-4">
			<div class="w-10 h-10 rounded-xl bg-admin-accent-muted border border-admin-accent-border text-admin-accent flex items-center justify-center font-bold text-sm font-mono">
				⚡
			</div>
			<div>
				<h3 class="font-semibold text-admin-content text-base">Fleet Cluster Management</h3>
				<p class="text-xs text-admin-content-muted">Управление микросайтами и централизованными обновлениями</p>
			</div>
		</div>
		<p class="text-xs text-admin-content-muted leading-relaxed">
			Управление кластером микросайтов активно в автономном режиме. Инстанс подключен к реестру Fleet Master.
		</p>
	</div>
}

templ renderFallbackTab(modules []models.AdminTabModule, leads []models.Lead, content models.SiteContent, settings models.SiteSettings, services []models.ServiceItem, articles []models.ArticleItem, reviews []models.ReviewItem) {
	if len(modules) > 0 {
		if modules[0].ID == "leads" {
			@ClientLeadsTab(leads)
		} else if modules[0].ID == "contacts" {
			@ClientContactsTab(content, settings)
		} else if modules[0].ID == "services" {
			@ClientServicesTab(services, nil, "")
		} else if modules[0].ID == "articles" {
			@ClientArticlesTab(articles, nil, false)
		} else if modules[0].ID == "reviews" {
			@ClientReviewsTab(reviews)
		} else if modules[0].ID == "security" {
			@ClientSecurityTab("", "")
		} else if modules[0].ID == "fleet" {
			@ClientFleetTab()
		} else {
			<div class="p-6 bg-admin-surface border border-admin-border rounded-2xl text-admin-content">
				<p class="text-sm">Раздел загружен.</p>
			</div>
		}
	} else {
		<div class="p-8 text-center bg-admin-surface border border-admin-border rounded-2xl text-admin-content-muted">
			<p class="text-sm">Нет активных модулей для данной конфигурации.</p>
		</div>
	}
}

templ ClientDashboard(settings models.SiteSettings, content models.SiteContent, leads []models.Lead, articles []models.ArticleItem, trashArticles []models.ArticleItem, reviews []models.ReviewItem, services []models.ServiceItem, trashServices []models.ServiceItem, activeTab string, modules []models.AdminTabModule, blocks []models.PageBlock) {
	@layouts.Base("Кабинет управления — "+settings.SiteName, "Управление контактами, заявками и контентом", settings) {
		{{
			initialTab := activeTab
			if initialTab == "" && len(modules) > 0 {
				initialTab = modules[0].ID
			} else if initialTab == "" {
				initialTab = "leads"
			}
			newLeads, inProgressLeads := countLeadsByStatus(leads)
		}}
		<div
			x-data={ fmt.Sprintf("{ currentTab: '%s' }", initialTab) }
			@popstate.window="currentTab = (new URLSearchParams(window.location.search)).get('tab') || 'leads'"
			class="min-h-screen bg-admin-bg text-admin-content antialiased flex flex-col font-sans"
		>
			<!-- Верхний командный бар (Header) -->
			<header class="border-b border-admin-border bg-admin-header backdrop-blur-md sticky top-0 z-40">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div class="w-8 h-8 rounded-lg bg-admin-accent-muted border border-admin-accent-border text-admin-accent flex items-center justify-center font-bold text-sm font-mono shadow-xs">
							SC
						</div>
						<div>
							<div class="font-bold text-admin-content text-sm leading-tight tracking-tight">{ settings.SiteName }</div>
							<div class="text-[10px] font-mono text-admin-content-muted uppercase tracking-wider">Клиентская панель</div>
						</div>
					</div>

					<div class="flex items-center gap-2.5">
						<a href="/" target="_blank" class="px-3 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs text-admin-content-muted hover:text-admin-content transition-colors flex items-center gap-1.5 font-medium shadow-2xs">
							<span>Открыть сайт</span>
							<svg class="w-3.5 h-3.5 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
							</svg>
						</a>
						<a href="/client/logout" class="px-3 py-1.5 rounded-lg border border-admin-border text-admin-content-muted hover:text-admin-danger hover:bg-admin-danger-muted hover:border-admin-danger/20 text-xs transition-colors flex items-center gap-1.5 font-medium">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v2"></path>
							</svg>
							<span>Выход</span>
						</a>
					</div>
				</div>

				<!-- Мобильный селектор вкладок (< md) -->
				<div class="px-4 py-2.5 border-t border-admin-border md:hidden bg-admin-surface/60">
					<label for="admin-mobile-tabs" class="sr-only">Выберите раздел</label>
					<div class="relative">
						<select
							id="admin-mobile-tabs"
							x-model="currentTab"
							@change="
								htmx.ajax('GET', '/client/tab/' + currentTab, {
									target: '#admin-tab-content',
									swap: 'innerHTML'
								});
								history.pushState(null, '', '/client?tab=' + currentTab);
							"
							class="w-full bg-admin-surface border border-admin-border text-admin-content text-xs sm:text-sm rounded-xl px-3.5 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-admin-border-focus appearance-none font-medium cursor-pointer"
						>
							for _, mod := range modules {
								<option value={ mod.ID } selected?={ mod.ID == initialTab }>
									{ mod.Title }
									if mod.BadgeCount > 0 {
										{ fmt.Sprintf(" (%d)", mod.BadgeCount) }
									}
								</option>
							}
						</select>
						<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-admin-content-muted">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</div>
					</div>
				</div>
			</header>

			<!-- Основная контентная сетка: Сайдбар слева + Контент справа -->
			<div
				:class="(currentTab === 'blocks' || currentTab === 'editor') ? 'max-w-[1720px]' : 'max-w-7xl'"
				class="flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8 flex flex-col md:flex-row gap-6 lg:gap-8 items-start transition-all duration-200"
			>
				<!-- Левый вертикальный сайдбар навигации (Desktop / Tablet >= md) -->
				<aside
					:class="(currentTab === 'blocks' || currentTab === 'editor') ? 'w-16' : 'w-72 lg:w-80'"
					class="hidden md:block shrink-0 transition-all duration-200"
				>
					<nav class="sticky top-24 bg-admin-sidebar/95 border border-admin-border rounded-2xl p-2 backdrop-blur-md shadow-xs space-y-1" aria-label="Вкладки кабинета">
						<div
							x-show="currentTab !== 'blocks' && currentTab !== 'editor'"
							class="text-[10px] font-mono font-semibold uppercase tracking-wider text-admin-content-subtle px-3 py-1.5 mb-1"
						>
							Разделы кабинета
						</div>

						for _, mod := range modules {
							<button
								type="button"
								hx-get={ mod.Route }
								hx-target="#admin-tab-content"
								hx-swap="innerHTML"
								hx-push-url={ "/client?tab=" + mod.ID }
								@click={ "currentTab = '" + mod.ID + "'" }
								title={ mod.Title }
								:class={ fmt.Sprintf("{ 'bg-admin-surface-active text-admin-content font-semibold border-transparent shadow-2xs relative before:absolute before:left-0 before:top-2 before:bottom-2 before:w-1 before:bg-admin-accent before:rounded-r-full': currentTab === '%s', 'border-transparent text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted/50': currentTab !== '%s' }", mod.ID, mod.ID) }
								class="w-full px-3 py-2.5 rounded-xl text-xs sm:text-sm border flex items-center justify-between gap-2.5 transition-colors cursor-pointer text-left focus:outline-none"
							>
								<div class="flex items-center gap-2.5 min-w-0">
									@AdminTabIcon(mod.ID)
									<span class="truncate" x-show="currentTab !== 'blocks' && currentTab !== 'editor'">{ mod.Title }</span>
								</div>
								if mod.ID == "leads" {
									<div x-show="currentTab !== 'blocks' && currentTab !== 'editor'">
										@LeadsBadges(newLeads, inProgressLeads, mod.BadgeCount)
									</div>
								} else if mod.BadgeCount > 0 {
									<span x-show="currentTab !== 'blocks' && currentTab !== 'editor'" class={ "px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold border " + mod.BadgeClass }>
										{ fmt.Sprintf("%d", mod.BadgeCount) }
									</span>
								}
							</button>
						}
					</nav>
				</aside>

				<!-- Основная контентная область с HTMX-свопом -->
				<main class="flex-1 min-w-0 w-full" id="admin-tab-content">
					if (activeTab == "blocks" || activeTab == "editor") && isTabActive("blocks", modules) {
						@AdminBlocksTab(blocks, settings)
					} else if activeTab == "contacts" && isTabActive("contacts", modules) {
						@ClientContactsTab(content, settings)
					} else if activeTab == "services" && isTabActive("services", modules) {
						@ClientServicesTab(services, trashServices, "")
					} else if activeTab == "articles" && isTabActive("articles", modules) {
						@ClientArticlesTab(articles, trashArticles, false)
					} else if activeTab == "reviews" && isTabActive("reviews", modules) {
						@ClientReviewsTab(reviews)
					} else if activeTab == "security" && isTabActive("security", modules) {
						@ClientSecurityTab("", "")
					} else if activeTab == "fleet" && isTabActive("fleet", modules) {
						@ClientFleetTab()
					} else if activeTab == "leads" && isTabActive("leads", modules) {
						@ClientLeadsTab(leads)
					} else {
						@renderFallbackTab(modules, leads, content, settings, services, articles, reviews)
					}
				</main>
			</div>
		</div>
	}
}
