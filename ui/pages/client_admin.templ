package pages

import (
	"fmt"
	"sitecraft/internal/ai"
	"sitecraft/internal/checker"
	"sitecraft/internal/models"
	"sitecraft/ui/layouts"
)

templ AdminThemeToggle(extraClass ...string) {
	{{
		cls := "px-2.5 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs text-admin-content-muted hover:text-admin-content transition-colors flex items-center gap-1.5 font-medium cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
		if len(extraClass) > 0 {
			cls += " " + extraClass[0]
		}
	}}
	<button
		type="button"
		x-data="{
			theme: document.documentElement.getAttribute('data-admin-theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'),
			switching: false,
			toggle(event) {
				if (this.switching) return;
				const next = this.theme === 'dark' ? 'light' : 'dark';
				const root = document.documentElement;
				const apply = () => {
					root.setAttribute('data-admin-theme', next);
					this.theme = next;
					try {
						localStorage.setItem('sitecraft_admin_theme', next);
						document.cookie = 'sitecraft_admin_theme=' + next + '; path=/; max-age=31536000; SameSite=Lax';
					} catch(e) {}
					window.dispatchEvent(new CustomEvent('admin-theme-changed', { detail: { theme: next } }));
				};
				if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					apply();
					return;
				}
				// Без View Transitions интерполируем только токены на :root.
				// Потомкам запрещаем свои color-переходы: иначе каждый кадр перезапускает
				// их transition и цвет доезжает вторым рывком после окончания 320 мс.
				if (!document.startViewTransition) {
					this.switching = true;
					root.classList.add('theme-crossfade');
					apply();
					window.setTimeout(() => {
						root.classList.remove('theme-crossfade');
						this.switching = false;
					}, 320);
					return;
				}
				this.switching = true;
				// Замораживаем переходы ДО снимка: иначе ::view-transition-new(root)
				// фиксирует середину 200ms color-перехода, а живой DOM включается рывком.
				root.classList.add('theme-freeze');
				const release = () => { root.classList.remove('theme-freeze'); this.switching = false; };
				let transition;
				try {
					transition = document.startViewTransition(apply);
				} catch (e) {
					release();
					apply();
					return;
				}
				transition.finished.then(release, release);
				transition.ready.then(() => {
					// Клавиатурный клик (Enter/Space) не имеет координат — раскрываем из центра.
					const fromKeyboard = !event || event.detail === 0;
					const x = fromKeyboard ? window.innerWidth / 2 : event.clientX;
					const y = fromKeyboard ? window.innerHeight / 2 : event.clientY;
					const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
					const reveal = root.animate(
						{ clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + radius + 'px at ' + x + 'px ' + y + 'px)'] },
						{ duration: 450, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' }
					);
					reveal.finished.then(release, release);
				}).catch(release);
			}
		}"
		@click="toggle($event)"
		@admin-theme-changed.window="theme = $event.detail.theme"
		class={ cls }
		:title="theme === 'dark' ? 'Переключить на светлую тему' : 'Переключить на темную тему'"
		:aria-label="theme === 'dark' ? 'Переключить на светлую тему' : 'Переключить на темную тему'"
	>
		<!-- Луна (когда светлая тема, предлагаем включить тёмную) -->
		<template x-if="theme !== 'dark'">
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-4 h-4 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
				</svg>
				<span class="hidden lg:inline">Темная</span>
			</span>
		</template>
		<!-- Солнце (когда тёмная тема, предлагаем включить светлую) -->
		<template x-if="theme === 'dark'">
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-4 h-4 text-admin-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
				</svg>
				<span class="hidden lg:inline">Светлая</span>
			</span>
		</template>
	</button>
}

templ ClientLogin(settings models.SiteSettings, errMsg string) {
	@layouts.Base("Вход в панель управления — "+settings.SiteName, "Авторизация в клиентской панели", settings) {
		<link rel="stylesheet" href="/assets/admin.css"/>
		<div class="min-h-screen flex items-center justify-center bg-admin-bg px-4 py-12 relative">
			<div class="absolute top-4 right-4 sm:top-6 sm:right-6">
				@AdminThemeToggle()
			</div>
			<div class="w-full max-w-md bg-admin-surface border border-admin-border rounded-xl shadow-sm p-7 sm:p-8">
				<div class="text-center mb-7">
					<div class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-admin-accent-muted border border-admin-accent-border text-admin-accent mb-4">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
						</svg>
					</div>
					<h1 class="text-xl font-bold tracking-tight text-admin-content mb-1">Панель управления</h1>
					<p class="text-xs text-admin-content-muted">{ settings.SiteName }</p>
				</div>

				if errMsg != "" {
					<div class="mb-5 p-3 rounded-lg bg-admin-danger-muted border border-admin-danger-border text-admin-danger text-xs flex items-center gap-2.5">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}

				<form method="POST" action="/client/login" class="space-y-4">
					<div>
						<label for="login-password" class="block text-xs font-medium text-admin-content-muted mb-1.5">Пароль доступа</label>
						<input
							id="login-password"
							type="password"
							name="password"
							required
							autofocus
							placeholder="Введите мастер-пароль..."
							class="admin-input w-full px-3.5 py-2.5 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus focus:border-transparent transition-colors"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-2.5 px-4 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-sm transition-colors active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<span>Войти в консоль</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</form>

				<div class="mt-7 pt-5 border-t border-admin-border text-center">
					<a href="/" class="text-xs text-admin-content-muted hover:text-admin-content transition-colors inline-flex items-center gap-1.5 font-medium">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Вернуться на сайт
					</a>
				</div>
			</div>
		</div>
	}
}

templ ClientInitialSetup(settings models.SiteSettings, errMsg string) {
	@layouts.Base("Первоначальная настройка — "+settings.SiteName, "Установка пароля администратора", settings) {
		<link rel="stylesheet" href="/assets/admin.css"/>
		<div class="min-h-screen flex items-center justify-center bg-admin-bg px-4 py-12 relative">
			<div class="absolute top-4 right-4 sm:top-6 sm:right-6">
				@AdminThemeToggle()
			</div>
			<div class="w-full max-w-md bg-admin-surface border border-admin-border rounded-xl shadow-sm p-7 sm:p-8">
				<div class="text-center mb-7">
					<div class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-admin-success-muted border border-admin-success-border text-admin-success mb-4">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
						</svg>
					</div>
					<h1 class="text-xl font-bold tracking-tight text-admin-content mb-1">Инициализация доступа</h1>
					<p class="text-xs text-admin-content-muted">Задайте мастер-пароль для входа в панель управления</p>
				</div>

				if errMsg != "" {
					<div class="mb-5 p-3 rounded-lg bg-admin-danger-muted border border-admin-danger-border text-admin-danger text-xs flex items-center gap-2.5">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}

				<form method="POST" action="/client/setup" class="space-y-4">
					<div>
						<label for="setup-password" class="block text-xs font-medium text-admin-content-muted mb-1.5">Мастер-пароль</label>
						<input
							id="setup-password"
							type="password"
							name="password"
							required
							autofocus
							minlength="8"
							placeholder="Не менее 8 символов..."
							class="admin-input w-full px-3.5 py-2.5 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus focus:border-transparent transition-colors"
						/>
						<p class="mt-1 text-[11px] text-admin-content-subtle">Минимум 8 знаков</p>
					</div>

					<div>
						<label for="setup-password-confirm" class="block text-xs font-medium text-admin-content-muted mb-1.5">Подтверждение пароля</label>
						<input
							id="setup-password-confirm"
							type="password"
							name="password_confirm"
							required
							minlength="8"
							placeholder="Повторите ввод пароля..."
							class="admin-input w-full px-3.5 py-2.5 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content placeholder:text-admin-content-subtle text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus focus:border-transparent transition-colors"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-2.5 px-4 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-sm transition-colors active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<span>Сохранить и войти</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</form>

				<div class="mt-7 pt-5 border-t border-admin-border text-center">
					<a href="/" class="text-xs text-admin-content-muted hover:text-admin-content transition-colors inline-flex items-center gap-1.5 font-medium">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Вернуться на сайт
					</a>
				</div>
			</div>
		</div>
	}
}

templ AdminTabIcon(id string) {
	switch id {
		case "leads":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
			</svg>
		case "contacts":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
			</svg>
		case "services":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
			</svg>
		case "articles", "blog":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
			</svg>
		case "media":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
			</svg>
		case "reviews":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
			</svg>
		case "settings":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
			</svg>
		case "security":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
			</svg>
		case "blocks", "editor":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
			</svg>
		case "fleet":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
			</svg>
		case "importer", "redirects":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
			</svg>
		case "ai":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
			</svg>
		default:
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
			</svg>
	}
}

templ ClientFleetTab() {
	<div class="p-6 bg-admin-surface border border-admin-border rounded-xl text-admin-content">
		<div class="flex items-center gap-3 mb-3">
			<div class="w-9 h-9 rounded-lg bg-admin-accent-muted border border-admin-accent-border text-admin-accent flex items-center justify-center shrink-0">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"></path>
				</svg>
			</div>
			<div>
				<h2 class="font-semibold text-admin-content text-base">Fleet Cluster Management</h2>
				<p class="text-xs text-admin-content-muted">Управление микросайтами и централизованными обновлениями</p>
			</div>
		</div>
		<p class="text-xs text-admin-content-muted leading-relaxed">
			Управление кластером микросайтов активно в автономном режиме. Инстанс подключен к реестру Fleet Master.
		</p>
	</div>
}

templ renderFallbackTab(modules []models.AdminTabModule, leads []models.Lead, content models.SiteContent, settings models.SiteSettings, services []models.ServiceItem, articles []models.ArticleItem, reviews []models.ReviewItem) {
	if len(modules) > 0 {
		if modules[0].ID == "leads" {
			@ClientLeadsTab(leads)
		} else if modules[0].ID == "contacts" {
			@ClientContactsTab(content, settings)
		} else if modules[0].ID == "services" {
			@ClientServicesTab(services, nil, "")
		} else if modules[0].ID == "articles" {
			@ClientArticlesTab(articles, nil, false)
		} else if modules[0].ID == "reviews" {
			@ClientReviewsTab(reviews)
		} else if modules[0].ID == "settings" {
			@AdminSettingsTab(settings, content, "")
		} else if modules[0].ID == "media" {
			<div hx-get="/admin/tab/media" hx-trigger="load" hx-swap="outerHTML" class="p-8 text-center text-xs text-admin-content-muted">
				Загрузка медиатеки...
			</div>
		} else if modules[0].ID == "security" {
			@ClientSecurityTab("", "")
		} else if modules[0].ID == "fleet" {
			@ClientFleetTab()
		} else if modules[0].ID == "importer" {
			@ClientImporterTab(nil, "")
		} else if modules[0].ID == "ai" {
			@ClientAITab(settings, ai.Presets, "", false)
		} else {
			<div class="p-6 bg-admin-surface border border-admin-border rounded-xl text-admin-content">
				<p class="text-sm">Раздел загружен.</p>
			</div>
		}
	} else {
		<div class="p-8 text-center bg-admin-surface border border-admin-border rounded-xl text-admin-content-muted">
			<p class="text-sm">Нет активных модулей для данной конфигурации.</p>
		</div>
	}
}

templ ClientDashboard(settings models.SiteSettings, content models.SiteContent, leads []models.Lead, articles []models.ArticleItem, trashArticles []models.ArticleItem, reviews []models.ReviewItem, services []models.ServiceItem, trashServices []models.ServiceItem, activeTab string, modules []models.AdminTabModule, blocks []models.PageBlock, checklist checker.ChecklistResult) {
	@layouts.Base("Кабинет управления — "+settings.SiteName, "Управление контактами, заявками и контентом", settings) {
		<link rel="stylesheet" href="/assets/admin.css"/>
		<script defer src="/assets/js/admin-blocks-editor.js"></script>
		<script defer src="/assets/js/admin-article-editor.js"></script>
		{{
			initialTab := activeTab
			if initialTab == "" && len(modules) > 0 {
				initialTab = modules[0].ID
			} else if initialTab == "" {
				initialTab = "leads"
			}
			newLeads, inProgressLeads := countLeadsByStatus(leads)
			tabTitlesJSON := adminModulesLookupJSON(modules)
		}}
		<div
			x-data={ fmt.Sprintf("{ currentTab: '%s', focusMode: false, sidebarCompact: false, htmxError: '', toasts: [], cmdQuery: '', tabTitles: %s, activeTitle() { return this.tabTitles[this.currentTab] || 'Обзор'; }, toggleSidebar() { this.sidebarCompact = !this.sidebarCompact; try { localStorage.setItem('sitecraft_admin_sidebar_compact', this.sidebarCompact); } catch(e) {} }, openTab(id, route) { this.currentTab = id; this.htmxError = ''; htmx.ajax('GET', route, { target: '#admin-tab-content', swap: 'innerHTML transition:true' }); history.pushState(null, '', '/admin?tab=' + id); }, openCommandPalette() { this.cmdQuery = ''; const dlg = document.getElementById('admin-command-palette'); if (dlg && !dlg.open) { dlg.showModal(); this.$nextTick(() => this.$refs.cmdSearchInput?.focus()); } }, closeCommandPalette() { const dlg = document.getElementById('admin-command-palette'); if (dlg && dlg.open) dlg.close(); }, cmdHasMatches() { const dlg = document.getElementById('admin-command-palette'); if (!dlg) return true; const q = this.cmdQuery.trim().toLowerCase(); if (!q) return true; return Array.from(dlg.querySelectorAll('[data-cmd-title]')).some(el => (el.dataset.cmdTitle || '').toLowerCase().includes(q)); }, addToast(message, tone) { const id = Date.now() + Math.random(); this.toasts.push({ id, message, tone: tone || 'info' }); setTimeout(() => this.dismissToast(id), 3500); }, dismissToast(id) { this.toasts = this.toasts.filter(t => t.id !== id); } }", initialTab, tabTitlesJSON) }
			x-init="try { const saved = localStorage.getItem('sitecraft_admin_sidebar_compact'); if (saved !== null) { sidebarCompact = (saved === 'true'); } else if (currentTab === 'blocks' || currentTab === 'editor') { sidebarCompact = true; } } catch(e) {}"
			@toggle-sidebar.window="toggleSidebar()"
			@popstate.window="currentTab = (new URLSearchParams(window.location.search)).get('tab') || 'leads'"
			@toggle-focus-mode.window="focusMode = !focusMode"
			@exit-focus-mode.window="focusMode = false"
			@admin-toast.window="if ($event.detail && $event.detail.message) addToast($event.detail.message, $event.detail.tone)"
			@htmx:before-request.window="htmxError = ''"
			@htmx:response-error.window="htmxError = 'Не удалось загрузить раздел. Проверьте соединение и повторите попытку.'"
			@keydown.window="if (($event.metaKey || $event.ctrlKey) && $event.key.toLowerCase() === 'k') { $event.preventDefault(); openCommandPalette(); return; } if (['INPUT','TEXTAREA','SELECT'].includes($event.target.tagName) || $event.target.isContentEditable) return; if ($event.key === '[') { $event.preventDefault(); toggleSidebar(); }"
			@keydown.escape.window="if (focusMode) { focusMode = false; }"
			class="min-h-screen bg-admin-bg text-admin-content antialiased flex font-sans"
			:class="{ 'admin-focus-mode': focusMode }"
		>
			<!-- Левая фиксированная навигационная рельса (Desktop / Tablet >= md) -->
			<aside
				x-show="!focusMode"
				:class="sidebarCompact ? 'w-[60px]' : 'w-[240px]'"
				class="hidden md:flex flex-col sticky top-0 h-screen shrink-0 border-r border-admin-border bg-admin-sidebar z-30"
			>
				<!-- Бренд / Сайт -->
				<div
					class="h-13 px-3 border-b border-admin-border flex items-center gap-2.5 shrink-0"
					:class="sidebarCompact ? 'justify-center px-0' : ''"
				>
					<div class="w-7 h-7 rounded-lg bg-admin-accent text-admin-on-accent flex items-center justify-center font-bold text-xs font-mono shrink-0">
						SC
					</div>
					<div x-show="!sidebarCompact" class="min-w-0">
						<div class="font-semibold text-admin-content text-xs leading-tight tracking-tight truncate">{ settings.SiteName }</div>
						<div class="text-[11px] text-admin-content-subtle truncate">Клиентская панель</div>
					</div>
				</div>

				<!-- Сгруппированная навигация -->
				<nav class="flex-1 overflow-y-auto px-2 py-3 space-y-4" aria-label="Вкладки кабинета">
					for grpIdx, grp := range adminModuleGroups() {
						{{ grpModules := filterModulesByGroup(modules, grp.Key) }}
						if len(grpModules) > 0 {
							<div class="space-y-0.5">
								if grpIdx > 0 {
									<div x-show="sidebarCompact" class="my-2 mx-2 border-t border-admin-border"></div>
								}
								<div
									x-show="!sidebarCompact"
									class="px-2.5 pb-1 text-[11px] font-medium text-admin-content-subtle select-none truncate"
								>
									{ grp.Label }
								</div>
								for _, mod := range grpModules {
									<button
										type="button"
										hx-get={ mod.Route }
										hx-target="#admin-tab-content"
										hx-swap="innerHTML transition:true"
										hx-push-url={ "/admin?tab=" + mod.ID }
										hx-indicator="#admin-htmx-indicator"
										@click={ "currentTab = '" + mod.ID + "'" }
										title={ mod.Title }
										:class={ fmt.Sprintf("{ 'bg-admin-surface-active text-admin-content font-semibold before:absolute before:left-0 before:top-1.5 before:bottom-1.5 before:w-0.5 before:bg-admin-accent before:rounded-r-full': currentTab === '%s', 'text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted/70': currentTab !== '%s', 'justify-center px-0': sidebarCompact, 'justify-between px-2.5 gap-2': !sidebarCompact }", mod.ID, mod.ID) }
										class="w-full relative py-2 rounded-lg text-[13px] flex items-center transition-colors cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
									>
										<div class="flex items-center gap-2.5 min-w-0" :class="{ 'justify-center': sidebarCompact }">
											@AdminTabIcon(mod.ID)
											<span class="truncate" x-show="!sidebarCompact">{ mod.Title }</span>
										</div>
										if mod.ID == "leads" {
											<div x-show="!sidebarCompact">
												@LeadsBadges(newLeads, inProgressLeads, mod.BadgeCount)
											</div>
											if newLeads > 0 || mod.BadgeCount > 0 {
												<span x-show="sidebarCompact" class="absolute top-1.5 right-2 w-1.5 h-1.5 rounded-full bg-admin-danger"></span>
											}
										} else if mod.BadgeCount > 0 {
											<span x-show="!sidebarCompact" class={ "px-1.5 py-0.5 rounded-md text-[10px] font-mono tabular-nums font-medium border " + mod.BadgeClass }>
												{ fmt.Sprintf("%d", mod.BadgeCount) }
											</span>
											<span x-show="sidebarCompact" class="absolute top-1.5 right-2 w-1.5 h-1.5 rounded-full bg-admin-accent"></span>
										}
									</button>
								}
							</div>
						}
					}
				</nav>

				<!-- Одна кнопка сворачивания в футере рельсы -->
				<div class="p-2 border-t border-admin-border shrink-0">
					<button
						type="button"
						@click="toggleSidebar()"
						:title="sidebarCompact ? 'Развернуть меню ([)' : 'Свернуть меню ([)'"
						:aria-label="sidebarCompact ? 'Развернуть меню' : 'Свернуть меню'"
						class="w-full py-1.5 rounded-lg text-xs text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted transition-colors flex items-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						:class="sidebarCompact ? 'justify-center px-0' : 'justify-between px-2.5'"
					>
						<span class="inline-flex items-center gap-2 min-w-0">
							<svg class="w-4 h-4 shrink-0 transition-transform duration-200" :class="{ 'rotate-180': sidebarCompact }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<rect width="18" height="18" x="3" y="3" rx="2" stroke-width="1.8"></rect>
								<path stroke-width="1.8" d="M9 3v18"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 15l-3-3 3-3"></path>
							</svg>
							<span x-show="!sidebarCompact" class="truncate font-medium">Свернуть</span>
						</span>
						<kbd x-show="!sidebarCompact" class="px-1.5 py-0.5 rounded bg-admin-surface-muted border border-admin-border text-[10px] font-mono text-admin-content-subtle">[</kbd>
					</button>
				</div>
			</aside>

			<!-- Правая рабочая область -->
			<div class="flex-1 min-w-0 flex flex-col min-h-screen">
				<!-- Верхняя контекстная панель (52px) -->
				<header
					x-show="!focusMode"
					class="h-13 px-4 sm:px-6 border-b border-admin-border bg-admin-header backdrop-blur-md sticky top-0 z-30 flex items-center justify-between gap-3 shrink-0"
				>
					<!-- Левая группа: мобильное меню + хлебные крошки -->
					<div class="flex items-center gap-2.5 min-w-0">
						<button
							type="button"
							onclick="document.getElementById('admin-mobile-nav-dialog').showModal()"
							class="md:hidden p-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
							aria-label="Открыть навигацию"
							title="Меню разделов"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
							</svg>
						</button>
						<div class="flex items-center gap-1.5 text-xs min-w-0">
							<span class="hidden sm:inline text-admin-content-subtle truncate max-w-[160px]">{ settings.SiteName }</span>
							<span class="hidden sm:inline text-admin-content-subtle">/</span>
							<span class="font-semibold text-admin-content truncate" x-text="activeTitle()">{ activeModuleTitle(initialTab, modules) }</span>
						</div>
					</div>

					<!-- Правая группа: Поиск (⌘K), Чеклист готовности, Тема, Сайт, Выход -->
					<div class="flex items-center gap-2 shrink-0">
						<button
							type="button"
							@click="openCommandPalette()"
							class="inline-flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs text-admin-content-muted hover:text-admin-content transition-colors cursor-pointer"
							title="Быстрый переход (⌘K / Ctrl+K)"
							aria-label="Открыть быстрый переход"
						>
							<svg class="w-3.5 h-3.5 text-admin-content-subtle shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
							</svg>
							<span class="hidden lg:inline">Перейти...</span>
							<kbd class="hidden sm:inline px-1.5 py-0.5 rounded bg-admin-surface-muted border border-admin-border text-[10px] font-mono text-admin-content-subtle">⌘K</kbd>
						</button>
						@SetupChecklistWidget(checklist)
						@AdminThemeToggle()
						<a
							href="/"
							target="_blank"
							class="px-2.5 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs text-admin-content-muted hover:text-admin-content transition-colors flex items-center gap-1.5 font-medium"
							title="Открыть сайт в новой вкладке"
						>
							<span class="hidden sm:inline">Открыть сайт</span>
							<svg class="w-3.5 h-3.5 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
							</svg>
						</a>
						<a
							href="/client/logout"
							class="px-2.5 py-1.5 rounded-lg border border-admin-border text-admin-content-muted hover:text-admin-danger hover:bg-admin-danger-muted hover:border-admin-danger-border text-xs transition-colors flex items-center gap-1.5 font-medium"
							title="Выйти из панели"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v2"></path>
							</svg>
							<span class="hidden sm:inline">Выход</span>
						</a>
					</div>
				</header>

				<!-- Тонкая линия прогресса HTMX -->
				<div id="admin-htmx-indicator" class="h-0.5 w-full bg-admin-border-subtle overflow-hidden sticky top-13 z-30" aria-hidden="true">
					<div class="admin-progress-bar h-full w-1/2 bg-admin-accent"></div>
				</div>

				<!-- Focus Mode Minimalist Top Bar (Фича 5: UX-фокус UltimaPress) -->
				<div
					x-show="focusMode"
					x-cloak
					class="sticky top-0 z-40 h-13 bg-admin-header backdrop-blur-md border-b border-admin-border px-4 sm:px-8 flex items-center justify-between"
				>
					<div class="flex items-center gap-2.5">
						<div class="w-7 h-7 rounded-lg bg-admin-accent-muted border border-admin-accent-border text-admin-accent flex items-center justify-center font-bold text-xs font-mono">
							FM
						</div>
						<div class="flex items-center gap-2 text-xs">
							<span class="font-semibold text-admin-content">Режим Focus Mode</span>
							<span class="hidden sm:inline text-admin-content-muted">Чистый редактор без отвлекающих элементов</span>
						</div>
					</div>
					<div class="flex items-center gap-2.5">
						@AdminThemeToggle()
						<span class="text-[11px] font-mono text-admin-content-subtle hidden md:inline">Esc для выхода</span>
						<button
							type="button"
							@click="focusMode = false"
							class="px-3 py-1.5 rounded-lg bg-admin-surface hover:bg-admin-surface-muted border border-admin-border text-admin-content-muted hover:text-admin-content text-xs font-medium transition-colors flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
							<span>Выйти из фокуса</span>
						</button>
					</div>
				</div>

				<!-- Глобальный баннер сетевой ошибки HTMX -->
				<div
					x-show="htmxError"
					x-cloak
					class="mx-4 sm:mx-6 mt-4 p-3 rounded-lg bg-admin-danger-muted border border-admin-danger-border text-admin-danger text-xs flex items-center justify-between gap-3"
					role="alert"
				>
					<span x-text="htmxError"></span>
					<div class="flex items-center gap-2 shrink-0">
						<button
							type="button"
							@click="openTab(currentTab, '/admin/tab/' + currentTab)"
							class="px-2.5 py-1 rounded-md bg-admin-surface border border-admin-danger-border text-admin-danger font-medium hover:bg-admin-surface-muted cursor-pointer"
						>
							Повторить
						</button>
						<button
							type="button"
							@click="htmxError = ''"
							class="p-1 text-admin-danger hover:opacity-75 cursor-pointer"
							aria-label="Скрыть уведомление об ошибке"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
				</div>

				<!-- Основная контентная область с HTMX-свопом -->
				<main
					id="admin-tab-content"
					class="@container flex-1 w-full min-w-0"
					:class="focusMode ? 'max-w-4xl mx-auto px-4 sm:px-6 py-6' : ((currentTab === 'blocks' || currentTab === 'editor') ? 'p-0' : 'max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6')"
				>
					if (activeTab == "blocks" || activeTab == "editor") && isTabActive("blocks", modules) {
						@AdminBlocksTab(blocks, settings)
					} else if activeTab == "contacts" && isTabActive("contacts", modules) {
						@ClientContactsTab(content, settings)
					} else if activeTab == "services" && isTabActive("services", modules) {
						@ClientServicesTab(services, trashServices, "")
					} else if activeTab == "articles" && isTabActive("articles", modules) {
						@ClientArticlesTab(articles, trashArticles, false)
					} else if activeTab == "media" && isTabActive("media", modules) {
						<div hx-get="/admin/tab/media" hx-trigger="load" hx-swap="outerHTML" class="p-8 text-center text-xs text-admin-content-muted">
							Загрузка медиатеки...
						</div>
					} else if activeTab == "reviews" && isTabActive("reviews", modules) {
						@ClientReviewsTab(reviews)
					} else if activeTab == "settings" && isTabActive("settings", modules) {
						@AdminSettingsTab(settings, content, "")
					} else if activeTab == "security" && isTabActive("security", modules) {
						@ClientSecurityTab("", "")
					} else if activeTab == "fleet" && isTabActive("fleet", modules) {
						@ClientFleetTab()
					} else if activeTab == "importer" && isTabActive("importer", modules) {
						@ClientImporterTab(nil, "")
					} else if activeTab == "ai" && isTabActive("ai", modules) {
						@ClientAITab(settings, ai.Presets, "", false)
					} else if activeTab == "leads" && isTabActive("leads", modules) {
						@ClientLeadsTab(leads)
					} else {
						@renderFallbackTab(modules, leads, content, settings, services, articles, reviews)
					}
				</main>
			</div>

			<!-- Мобильная шторка навигации (< md) на нативном <dialog> -->
			<dialog
				id="admin-mobile-nav-dialog"
				onclick="if (event.target === this) this.close()"
				class="admin-drawer-left fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-admin-sidebar border-r border-admin-border p-0 text-admin-content shadow-xl z-50 md:hidden"
			>
				<div class="h-13 px-4 border-b border-admin-border flex items-center justify-between">
					<div class="flex items-center gap-2 min-w-0">
						<div class="w-7 h-7 rounded-lg bg-admin-accent text-admin-on-accent flex items-center justify-center font-bold text-xs font-mono shrink-0">
							SC
						</div>
						<span class="font-semibold text-xs text-admin-content truncate">{ settings.SiteName }</span>
					</div>
					<button
						type="button"
						onclick="document.getElementById('admin-mobile-nav-dialog').close()"
						class="p-1.5 rounded-lg text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted cursor-pointer"
						aria-label="Закрыть меню"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<nav class="p-3 space-y-4 overflow-y-auto max-h-[calc(100dvh-52px)]" aria-label="Мобильная навигация">
					for _, grp := range adminModuleGroups() {
						{{ grpModules := filterModulesByGroup(modules, grp.Key) }}
						if len(grpModules) > 0 {
							<div class="space-y-0.5">
								<div class="px-2.5 pb-1 text-[11px] font-medium text-admin-content-subtle">
									{ grp.Label }
								</div>
								for _, mod := range grpModules {
									<button
										type="button"
										@click={ fmt.Sprintf("document.getElementById('admin-mobile-nav-dialog').close(); openTab('%s', '%s')", mod.ID, mod.Route) }
										:class={ fmt.Sprintf("currentTab === '%s' ? 'bg-admin-surface-active text-admin-content font-semibold' : 'text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted/70'", mod.ID) }
										class="w-full px-2.5 py-2 rounded-lg text-[13px] flex items-center justify-between gap-2 transition-colors cursor-pointer text-left"
									>
										<span class="flex items-center gap-2.5 min-w-0">
											@AdminTabIcon(mod.ID)
											<span class="truncate">{ mod.Title }</span>
										</span>
										if mod.BadgeCount > 0 {
											<span class={ "px-1.5 py-0.5 rounded-md text-[10px] font-mono tabular-nums font-medium border " + mod.BadgeClass }>
												{ fmt.Sprintf("%d", mod.BadgeCount) }
											</span>
										}
									</button>
								}
							</div>
						}
					}
				</nav>
			</dialog>

			<!-- Командная палитра быстрого перехода (⌘K / Ctrl+K) -->
			<dialog
				id="admin-command-palette"
				onclick="if (event.target === this) this.close()"
				class="admin-dialog fixed top-[12vh] mx-auto w-[92vw] max-w-lg rounded-xl bg-admin-surface-elevated border border-admin-border p-0 text-admin-content shadow-xl"
			>
				<div class="flex items-center gap-2.5 px-4 py-3 border-b border-admin-border">
					<svg class="w-4 h-4 text-admin-content-subtle shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<input
						type="search"
						x-ref="cmdSearchInput"
						x-model="cmdQuery"
						placeholder="Перейти в раздел или выполнить действие..."
						class="w-full bg-transparent rounded-md px-1.5 py-0.5 text-sm text-admin-content placeholder:text-admin-content-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					/>
					<button
						type="button"
						@click="closeCommandPalette()"
						class="px-1.5 py-0.5 rounded bg-admin-surface-muted border border-admin-border text-[10px] font-mono text-admin-content-subtle hover:text-admin-content cursor-pointer shrink-0"
					>
						ESC
					</button>
				</div>

				<div class="max-h-80 overflow-y-auto p-2 space-y-1">
					<div class="px-2.5 pt-1 pb-1 text-[11px] font-medium text-admin-content-subtle">Разделы</div>
					for _, mod := range modules {
						<button
							type="button"
							data-cmd-title={ mod.Title + " " + mod.ID }
							x-show={ fmt.Sprintf("!cmdQuery.trim() || $el.dataset.cmdTitle.toLowerCase().includes(cmdQuery.trim().toLowerCase())") }
							@click={ fmt.Sprintf("closeCommandPalette(); openTab('%s', '%s')", mod.ID, mod.Route) }
							class="w-full px-3 py-2 rounded-lg text-xs text-admin-content hover:bg-admin-surface-hover flex items-center justify-between gap-2 transition-colors cursor-pointer text-left"
						>
							<span class="flex items-center gap-2.5 min-w-0">
								<span class="text-admin-content-muted">@AdminTabIcon(mod.ID)</span>
								<span class="font-medium truncate">{ mod.Title }</span>
							</span>
							if mod.BadgeCount > 0 {
								<span class={ "px-1.5 py-0.5 rounded-md text-[10px] font-mono tabular-nums font-medium border " + mod.BadgeClass }>
									{ fmt.Sprintf("%d", mod.BadgeCount) }
								</span>
							}
						</button>
					}

					<div class="px-2.5 pt-2 pb-1 text-[11px] font-medium text-admin-content-subtle border-t border-admin-border-subtle mt-1">Действия</div>
					<button
						type="button"
						data-cmd-title="свернуть развернуть боковую панель сайдбар меню"
						x-show="!cmdQuery.trim() || $el.dataset.cmdTitle.toLowerCase().includes(cmdQuery.trim().toLowerCase())"
						@click="closeCommandPalette(); toggleSidebar()"
						class="w-full px-3 py-2 rounded-lg text-xs text-admin-content hover:bg-admin-surface-hover flex items-center justify-between gap-2 transition-colors cursor-pointer text-left"
					>
						<span>Переключить компактность меню</span>
						<kbd class="px-1.5 py-0.5 rounded bg-admin-surface-muted border border-admin-border text-[10px] font-mono text-admin-content-subtle">[</kbd>
					</button>
					<a
						href="/"
						target="_blank"
						data-cmd-title="открыть сайт витрина предпросмотр"
						x-show="!cmdQuery.trim() || $el.dataset.cmdTitle.toLowerCase().includes(cmdQuery.trim().toLowerCase())"
						@click="closeCommandPalette()"
						class="w-full px-3 py-2 rounded-lg text-xs text-admin-content hover:bg-admin-surface-hover flex items-center justify-between gap-2 transition-colors text-left"
					>
						<span>Открыть сайт в новой вкладке</span>
						<span class="text-[11px] font-mono text-admin-content-subtle">↗</span>
					</a>

					<div x-show="!cmdHasMatches()" x-cloak class="p-6 text-center text-xs text-admin-content-muted">
						Раздел или действие не найдены
					</div>
				</div>
			</dialog>

			<!-- Глобальная лента Toast-уведомлений -->
			<div
				class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-xs w-full pointer-events-none"
				aria-live="polite"
			>
				<template x-for="toast in toasts" :key="toast.id">
					<div
						class="pointer-events-auto p-3 rounded-lg border shadow-lg bg-admin-surface-elevated text-xs flex items-center justify-between gap-2.5"
						:class="toast.tone === 'success' ? 'border-admin-success-border text-admin-success' : (toast.tone === 'error' ? 'border-admin-danger-border text-admin-danger' : 'border-admin-border text-admin-content')"
					>
						<span class="font-medium" x-text="toast.message"></span>
						<button
							type="button"
							@click="dismissToast(toast.id)"
							class="p-0.5 text-admin-content-subtle hover:text-admin-content cursor-pointer shrink-0"
							aria-label="Скрыть уведомление"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
				</template>
			</div>
		</div>
	}
}
