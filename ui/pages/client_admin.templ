package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/layouts"
)

templ ClientLogin(settings models.SiteSettings, errMsg string) {
	@layouts.Base("Вход в панель управления — "+settings.SiteName, "Авторизация в клиентской панели", settings) {
		<div class="min-h-screen flex items-center justify-center bg-slate-950 px-4 py-12">
			<div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-8 backdrop-blur-xl">
				<div class="text-center mb-8">
					<div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 mb-4">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
						</svg>
					</div>
					<h1 class="text-2xl font-bold tracking-tight text-white mb-2">Кабинет управления</h1>
					<p class="text-sm text-slate-400">{ settings.SiteName }</p>
				</div>

				if errMsg != "" {
					<div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-3">
						<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}

				<form method="POST" action="/client/login" class="space-y-5">
					<div>
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Пароль доступа</label>
						<input
							type="password"
							name="password"
							required
							autofocus
							placeholder="Введите пароль..."
							class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-3.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition-all shadow-lg shadow-amber-500/20 active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
					>
						<span>Войти в кабинет</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</form>

				<div class="mt-8 pt-6 border-t border-slate-800 text-center">
					<a href="/" class="text-xs text-slate-500 hover:text-slate-300 transition-colors inline-flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Вернуться на сайт
					</a>
				</div>
			</div>
		</div>
	}
}

templ ClientInitialSetup(settings models.SiteSettings, errMsg string) {
	@layouts.Base("Первоначальная настройка — "+settings.SiteName, "Установка пароля администратора", settings) {
		<div class="min-h-screen flex items-center justify-center bg-slate-950 px-4 py-12">
			<div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-8 backdrop-blur-xl">
				<div class="text-center mb-8">
					<div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mb-4">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
						</svg>
					</div>
					<h1 class="text-2xl font-bold tracking-tight text-white mb-2">Настройка безопасности</h1>
					<p class="text-xs text-slate-400">Установите мастер-пароль для защиты кабинета управления сайтом</p>
				</div>

				if errMsg != "" {
					<div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-3">
						<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}

				<form method="POST" action="/client/setup" class="space-y-5">
					<div>
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Мастер-пароль</label>
						<input
							type="password"
							name="password"
							required
							autofocus
							minlength="8"
							placeholder="Не менее 8 символов..."
							class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
						/>
						<p class="mt-1 text-[11px] text-slate-500">Пароль должен содержать минимум 8 символов</p>
					</div>

					<div>
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Повторите пароль</label>
						<input
							type="password"
							name="password_confirm"
							required
							minlength="8"
							placeholder="Повторите ввод пароля..."
							class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-3.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
					>
						<span>Защитить и войти</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</form>

				<div class="mt-8 pt-6 border-t border-slate-800 text-center">
					<a href="/" class="text-xs text-slate-500 hover:text-slate-300 transition-colors inline-flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Вернуться на сайт
					</a>
				</div>
			</div>
		</div>
	}
}

templ AdminTabIcon(id string) {
	switch id {
		case "leads":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
			</svg>
		case "contacts":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
			</svg>
		case "services":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
			</svg>
		case "articles", "blog":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
			</svg>
		case "reviews":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
			</svg>
		case "security":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
			</svg>
		case "fleet":
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
			</svg>
		default:
			<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
			</svg>
	}
}

templ ClientFleetTab() {
	<div class="p-6 bg-slate-900/60 border border-slate-800 rounded-2xl text-slate-300 backdrop-blur-md shadow-xl">
		<div class="flex items-center gap-3 mb-4">
			<div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center font-bold">
				⚡
			</div>
			<div>
				<h3 class="font-bold text-white text-base">Fleet Cluster Management</h3>
				<p class="text-xs text-slate-400">Управление микросайтами и централизованными обновлениями</p>
			</div>
		</div>
		<p class="text-xs text-slate-300 leading-relaxed">
			Управление кластером микросайтов активно в автономном режиме. Инстанс подключен к реестру Fleet Master.
		</p>
	</div>
}

templ renderFallbackTab(modules []models.AdminTabModule, leads []models.Lead, content models.SiteContent, settings models.SiteSettings, services []models.ServiceItem, articles []models.ArticleItem, reviews []models.ReviewItem) {
	if len(modules) > 0 {
		if modules[0].ID == "leads" {
			@ClientLeadsTab(leads)
		} else if modules[0].ID == "contacts" {
			@ClientContactsTab(content, settings)
		} else if modules[0].ID == "services" {
			@ClientServicesTab(services, nil, "")
		} else if modules[0].ID == "articles" {
			@ClientArticlesTab(articles, nil, false)
		} else if modules[0].ID == "reviews" {
			@ClientReviewsTab(reviews)
		} else if modules[0].ID == "security" {
			@ClientSecurityTab("", "")
		} else if modules[0].ID == "fleet" {
			@ClientFleetTab()
		} else {
			<div class="p-6 bg-slate-900/60 border border-slate-800 rounded-2xl text-slate-300">
				<p class="text-sm">Раздел загружен.</p>
			</div>
		}
	} else {
		<div class="p-8 text-center bg-slate-900/60 border border-slate-800 rounded-2xl text-slate-400">
			<p class="text-sm">Нет активных модулей для данной конфигурации.</p>
		</div>
	}
}

templ ClientDashboard(settings models.SiteSettings, content models.SiteContent, leads []models.Lead, articles []models.ArticleItem, trashArticles []models.ArticleItem, reviews []models.ReviewItem, services []models.ServiceItem, trashServices []models.ServiceItem, activeTab string, modules []models.AdminTabModule) {
	@layouts.Base("Кабинет управления — "+settings.SiteName, "Управление контактами, заявками и контентом", settings) {
		{{
			initialTab := activeTab
			if initialTab == "" && len(modules) > 0 {
				initialTab = modules[0].ID
			} else if initialTab == "" {
				initialTab = "leads"
			}
			newLeads, inProgressLeads := countLeadsByStatus(leads)
		}}
		<div
			x-data={ fmt.Sprintf("{ currentTab: '%s' }", initialTab) }
			@popstate.window="currentTab = (new URLSearchParams(window.location.search)).get('tab') || 'leads'"
			class="min-h-screen bg-slate-950 text-slate-100 antialiased flex flex-col"
		>
			<!-- Шапка панели -->
			<header class="border-b border-slate-800/80 bg-slate-900/60 backdrop-blur-md sticky top-0 z-40">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-lg">
							⚡
						</div>
						<div>
							<div class="font-bold text-white text-sm leading-tight">{ settings.SiteName }</div>
							<div class="text-xs text-slate-400">Клиентская панель</div>
						</div>
					</div>

					<div class="flex items-center gap-3">
						<a href="/" target="_blank" class="px-3 py-1.5 rounded-lg border border-slate-700/80 bg-slate-800/60 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition-colors flex items-center gap-1.5">
							<span>Открыть сайт</span>
							<svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
							</svg>
						</a>
						<a href="/client/logout" class="px-3 py-1.5 rounded-lg border border-slate-800 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 hover:border-rose-500/30 text-xs transition-colors flex items-center gap-1.5">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v2"></path>
							</svg>
							<span>Выход</span>
						</a>
					</div>
				</div>

				<!-- Мобильный селектор вкладок (< md) -->
				<div class="px-4 py-2.5 border-t border-slate-800/60 md:hidden bg-slate-900/40">
					<label for="admin-mobile-tabs" class="sr-only">Выберите раздел</label>
					<div class="relative">
						<select
							id="admin-mobile-tabs"
							x-model="currentTab"
							@change="
								htmx.ajax('GET', '/client/tab/' + currentTab, {
									target: '#admin-tab-content',
									swap: 'innerHTML'
								});
								history.pushState(null, '', '/client?tab=' + currentTab);
							"
							class="w-full bg-slate-900 border border-slate-700/80 text-white text-xs sm:text-sm rounded-xl px-3.5 py-2.5 pr-8 focus:outline-none focus:ring-2 focus:ring-amber-500/50 appearance-none font-medium cursor-pointer"
						>
							for _, mod := range modules {
								<option value={ mod.ID } selected?={ mod.ID == initialTab }>
									{ mod.Title }
									if mod.BadgeCount > 0 {
										{ fmt.Sprintf(" (%d)", mod.BadgeCount) }
									}
								</option>
							}
						</select>
						<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</div>
					</div>
				</div>
			</header>

			<!-- Основная контентная область: Сайдбар слева + Контент справа -->
			<div class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8 flex flex-col md:flex-row gap-6 lg:gap-8 items-start">
				<!-- Левый вертикальный сайдбар навигации (Desktop / Tablet >= md) -->
				<aside class="hidden md:block w-72 lg:w-80 shrink-0">
					<nav class="sticky top-24 bg-slate-900/60 border border-slate-800/80 rounded-2xl p-2.5 backdrop-blur-md shadow-xl space-y-1" aria-label="Вкладки кабинета">
						<div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 px-3 py-1.5 mb-1">
							Разделы кабинета
						</div>

						for _, mod := range modules {
							<button
								type="button"
								hx-get={ mod.Route }
								hx-target="#admin-tab-content"
								hx-swap="innerHTML"
								hx-push-url={ "/client?tab=" + mod.ID }
								@click={ "currentTab = '" + mod.ID + "'" }
								:class={ fmt.Sprintf("currentTab === '%s' ? 'bg-amber-500/10 text-amber-400 font-semibold border-amber-500/30 shadow-xs' : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50'", mod.ID) }
								class={ "w-full px-3 py-2.5 rounded-xl text-xs sm:text-sm border flex items-center justify-between gap-2.5 transition-all cursor-pointer text-left",
									templ.KV("bg-amber-500/10 text-amber-400 font-semibold border-amber-500/30 shadow-xs", activeTab == mod.ID),
									templ.KV("border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50", activeTab != mod.ID) }
							>
								<div class="flex items-center gap-2.5 min-w-0">
									@AdminTabIcon(mod.ID)
									<span class="truncate">{ mod.Title }</span>
								</div>
								if mod.ID == "leads" {
									@LeadsBadges(newLeads, inProgressLeads, mod.BadgeCount)
								} else if mod.BadgeCount > 0 {
									<span class={ "px-2 py-0.5 rounded-full text-[11px] font-mono font-medium border " + mod.BadgeClass }>
										{ fmt.Sprintf("%d", mod.BadgeCount) }
									</span>
								}
							</button>
						}
					</nav>
				</aside>

				<!-- Основная контентная область с HTMX-свопом -->
				<main class="flex-1 min-w-0 w-full" id="admin-tab-content">
					if activeTab == "contacts" && isTabActive("contacts", modules) {
						@ClientContactsTab(content, settings)
					} else if activeTab == "services" && isTabActive("services", modules) {
						@ClientServicesTab(services, trashServices, "")
					} else if activeTab == "articles" && isTabActive("articles", modules) {
						@ClientArticlesTab(articles, trashArticles, false)
					} else if activeTab == "reviews" && isTabActive("reviews", modules) {
						@ClientReviewsTab(reviews)
					} else if activeTab == "security" && isTabActive("security", modules) {
						@ClientSecurityTab("", "")
					} else if activeTab == "fleet" && isTabActive("fleet", modules) {
						@ClientFleetTab()
					} else if activeTab == "leads" && isTabActive("leads", modules) {
						@ClientLeadsTab(leads)
					} else {
						@renderFallbackTab(modules, leads, content, settings, services, articles, reviews)
					}
				</main>
		</div>
	</div>
}
}
