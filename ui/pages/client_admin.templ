package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/layouts"
)

templ ClientLogin(settings models.SiteSettings, errMsg string) {
	@layouts.Base("Вход в панель управления — "+settings.SiteName, "Авторизация в клиентской панели", settings) {
		<div class="min-h-screen flex items-center justify-center bg-slate-950 px-4 py-12">
			<div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-8 backdrop-blur-xl">
				<div class="text-center mb-8">
					<div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 mb-4">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
						</svg>
					</div>
					<h1 class="text-2xl font-bold tracking-tight text-white mb-2">Кабинет управления</h1>
					<p class="text-sm text-slate-400">{ settings.SiteName }</p>
				</div>

				if errMsg != "" {
					<div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-3">
						<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>{ errMsg }</span>
					</div>
				}

				<form method="POST" action="/client/login" class="space-y-5">
					<div>
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Пароль доступа</label>
						<input
							type="password"
							name="password"
							required
							autofocus
							placeholder="Введите пароль..."
							class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
						/>
						<p class="mt-2 text-xs text-slate-500">По умолчанию для нового сайта: <code class="text-amber-400 font-mono">admin</code></p>
					</div>

					<button
						type="submit"
						class="w-full py-3.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition-all shadow-lg shadow-amber-500/20 active:scale-[0.99] flex items-center justify-center gap-2"
					>
						<span>Войти в кабинет</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
						</svg>
					</button>
				</form>

				<div class="mt-8 pt-6 border-t border-slate-800 text-center">
					<a href="/" class="text-xs text-slate-500 hover:text-slate-300 transition-colors inline-flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Вернуться на сайт
					</a>
				</div>
			</div>
		</div>
	}
}

templ ClientDashboard(settings models.SiteSettings, content models.SiteContent, leads []models.Lead, articles []models.ArticleItem, trashArticles []models.ArticleItem, activeTab string) {
	@layouts.Base("Кабинет управления — "+settings.SiteName, "Управление контактами, заявками и контентом", settings) {
		<div class="min-h-screen bg-slate-950 text-slate-100 antialiased flex flex-col">
			<!-- Шапка панели -->
			<header class="border-b border-slate-800/80 bg-slate-900/60 backdrop-blur-md sticky top-0 z-40">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-lg">
							⚡
						</div>
						<div>
							<div class="font-bold text-white text-sm leading-tight">{ settings.SiteName }</div>
							<div class="text-xs text-slate-400">Клиентская панель</div>
						</div>
					</div>

					<div class="flex items-center gap-3">
						<a href="/" target="_blank" class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/60 hover:bg-slate-800 text-xs text-slate-300 transition-colors flex items-center gap-1.5">
							<span>Открыть сайт</span>
							<svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
							</svg>
						</a>
						<a href="/client/logout" class="px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs transition-colors flex items-center gap-1.5 border border-red-500/20">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
							</svg>
							<span>Выход</span>
						</a>
					</div>
				</div>

				<!-- Навигационные вкладки -->
				{{
					initialTab := activeTab
					if initialTab == "" {
						initialTab = "leads"
					}
					newLeads, inProgressLeads := countLeadsByStatus(leads)
				}}
				<div
					x-data={ fmt.Sprintf("{ currentTab: '%s' }", initialTab) }
					@popstate.window="currentTab = (new URLSearchParams(window.location.search)).get('tab') || 'leads'"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-1 overflow-x-auto border-t border-slate-800/50"
				>
					<button
						type="button"
						hx-get="/client/tab/leads"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-push-url="/client?tab=leads"
						@click="currentTab = 'leads'"
						:class="currentTab === 'leads' ? 'border-amber-400 text-amber-400 bg-amber-400/5' : 'border-transparent text-slate-400 hover:text-slate-200'"
						class={ "px-4 py-3 text-xs sm:text-sm font-semibold border-b-2 flex items-center gap-2 transition-colors cursor-pointer",
							templ.KV("border-amber-400 text-amber-400 bg-amber-400/5", activeTab == "leads" || activeTab == ""),
							templ.KV("border-transparent text-slate-400 hover:text-slate-200", activeTab != "leads" && activeTab != "") }
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
						</svg>
						<span>Входящие заявки</span>
						@LeadsBadges(newLeads, inProgressLeads, len(leads))
					</button>

					<button
						type="button"
						hx-get="/client/tab/contacts"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-push-url="/client?tab=contacts"
						@click="currentTab = 'contacts'"
						:class="currentTab === 'contacts' ? 'border-amber-400 text-amber-400 bg-amber-400/5' : 'border-transparent text-slate-400 hover:text-slate-200'"
						class={ "px-4 py-3 text-xs sm:text-sm font-semibold border-b-2 flex items-center gap-2 transition-colors cursor-pointer",
							templ.KV("border-amber-400 text-amber-400 bg-amber-400/5", activeTab == "contacts"),
							templ.KV("border-transparent text-slate-400 hover:text-slate-200", activeTab != "contacts") }
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
						</svg>
						<span>Контакты и реквизиты</span>
					</button>

					<button
						type="button"
						hx-get="/client/tab/articles"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-push-url="/client?tab=articles"
						@click="currentTab = 'articles'"
						:class="currentTab === 'articles' ? 'border-amber-400 text-amber-400 bg-amber-400/5' : 'border-transparent text-slate-400 hover:text-slate-200'"
						class={ "px-4 py-3 text-xs sm:text-sm font-semibold border-b-2 flex items-center gap-2 transition-colors cursor-pointer",
							templ.KV("border-amber-400 text-amber-400 bg-amber-400/5", activeTab == "articles"),
							templ.KV("border-transparent text-slate-400 hover:text-slate-200", activeTab != "articles") }
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
						</svg>
						<span>Блог и статьи</span>
						if len(articles) > 0 {
							<span class="ml-1 px-1.5 py-0.5 rounded-full text-[10px] bg-slate-800 text-slate-400 font-mono">
								{ fmt.Sprintf("%d", len(articles)) }
							</span>
						}
					</button>
				</div>
			</header>

			<!-- Основная контентная область с HTMX-свопом -->
			<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8" id="admin-tab-content">
				if activeTab == "contacts" {
					@ClientContactsTab(content, settings)
				} else if activeTab == "articles" {
					@ClientArticlesTab(articles, trashArticles, false)
				} else {
					@ClientLeadsTab(leads)
				}
			</main>
		</div>
	}
}

templ ClientLeadsTab(leads []models.Lead) {
	{{
		newCount, inProgressCount := countLeadsByStatus(leads)
	}}
	<div>
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
			<div>
				<div class="flex items-center gap-3 flex-wrap">
					<h2 class="text-xl font-bold text-white tracking-tight">Входящие заявки</h2>
					if len(leads) > 0 {
						<div class="flex items-center gap-1.5">
							<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20" title="Новые заявки">
								<span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
								<span>Новые: <strong class="font-bold">{ fmt.Sprintf("%d", newCount) }</strong></span>
							</span>
							<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20" title="Заявки в обработке">
								<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
								<span>В обработке: <strong class="font-bold">{ fmt.Sprintf("%d", inProgressCount) }</strong></span>
							</span>
						</div>
					}
				</div>
				<p class="text-xs text-slate-400 mt-1">Клиентские обращения с форм захвата, онлайн-записи и витрины</p>
			</div>
			<div class="flex items-center gap-2">
				<a
					href="/client/export/leads.csv"
					class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition-colors flex items-center gap-2 border border-slate-700"
				>
					<svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
					</svg>
					<span>Экспорт в CSV / Excel</span>
				</a>
			</div>
		</div>

		if len(leads) == 0 {
			<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
				<div class="w-12 h-12 rounded-2xl bg-slate-800 flex items-center justify-center mx-auto mb-4 text-slate-500">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
					</svg>
				</div>
				<h3 class="text-base font-semibold text-white mb-1">Заявок пока нет</h3>
				<p class="text-xs text-slate-400 max-w-sm mx-auto">Новые заявки с форм на сайте будут мгновенно отображаться здесь в реальном времени.</p>
			</div>
		} else {
			<div class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs sm:text-sm">
						<thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
							<tr>
								<th class="py-3.5 px-4 font-semibold">Клиент</th>
								<th class="py-3.5 px-4 font-semibold">Контакты</th>
								<th class="py-3.5 px-4 font-semibold">Дата / Время</th>
								<th class="py-3.5 px-4 font-semibold">Источник / Детали</th>
								<th class="py-3.5 px-4 font-semibold">Статус</th>
								<th class="py-3.5 px-4 font-semibold text-right">Действие</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800/60 text-slate-300">
							for _, lead := range leads {
								<tr class="hover:bg-slate-800/30 transition-colors" id={ "lead-row-" + lead.ID }>
									<td class="py-3.5 px-4 font-semibold text-white whitespace-nowrap">
										{ lead.Name }
									</td>
									<td class="py-3.5 px-4 whitespace-nowrap">
										<a href={ templ.SafeURL("tel:" + lead.Phone) } class="text-amber-400 hover:underline font-mono">
											{ lead.Phone }
										</a>
										if lead.Email != "" {
											<div class="text-[11px] text-slate-500 font-mono mt-0.5">{ lead.Email }</div>
										}
									</td>
									<td class="py-3.5 px-4 whitespace-nowrap text-slate-400 font-mono text-xs">
										if lead.BookingDate != "" {
											<div class="text-slate-200">{ lead.BookingDate }</div>
										}
										if lead.BookingTime != "" {
											<div class="text-amber-400/80">{ lead.BookingTime }</div>
										}
										if lead.BookingDate == "" && lead.BookingTime == "" {
											<span class="text-slate-600">—</span>
										}
									</td>
									<td class="py-3.5 px-4 max-w-xs truncate">
										if lead.Source != "" {
											<span class="inline-block px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 text-[10px] mr-1.5">
												{ lead.Source }
											</span>
										}
										if lead.Payload != nil {
											if comment, ok := lead.Payload["comment"].(string); ok && comment != "" {
												<span class="text-slate-400">{ comment }</span>
											}
										}
									</td>
									<td class="py-3.5 px-4 whitespace-nowrap">
										@LeadStatusBadge(lead.Status)
									</td>
									<td class="py-3.5 px-4 whitespace-nowrap text-right">
										<div class="inline-flex items-center gap-1.5">
											<select
												class="bg-slate-800 border border-slate-700 text-slate-300 text-xs rounded-lg px-2 py-1 focus:outline-none focus:ring-1 focus:ring-amber-500"
												hx-post={ "/client/leads/" + lead.ID + "/status" }
												hx-target={ "#lead-row-" + lead.ID }
												hx-swap="outerHTML"
												name="status"
											>
												<option value="новая" selected?={ lead.Status == "новая" || lead.Status == "" }>Новая</option>
												<option value="в обработке" selected?={ lead.Status == "в обработке" }>В обработке</option>
												<option value="выполнена" selected?={ lead.Status == "выполнена" || lead.Status == "обработана" }>Выполнена</option>
												<option value="отменена" selected?={ lead.Status == "отменена" }>Отменена</option>
											</select>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>
}

templ LeadStatusBadge(status string) {
	if status == "новая" || status == "" {
		<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
			Новая
		</span>
	} else if status == "в обработке" {
		<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
			В обработке
		</span>
	} else if status == "выполнена" || status == "обработана" {
		<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
			Выполнена
		</span>
	} else if status == "отменена" {
		<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-800 text-slate-500 border border-slate-700">
			Отменена
		</span>
	} else {
		<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-800 text-slate-400">
			{ status }
		</span>
	}
}

templ LeadRowSingle(lead models.Lead) {
	<tr class="hover:bg-slate-800/30 transition-colors bg-amber-500/5" id={ "lead-row-" + lead.ID }>
		<td class="py-3.5 px-4 font-semibold text-white whitespace-nowrap">
			{ lead.Name }
		</td>
		<td class="py-3.5 px-4 whitespace-nowrap">
			<a href={ templ.SafeURL("tel:" + lead.Phone) } class="text-amber-400 hover:underline font-mono">
				{ lead.Phone }
			</a>
			if lead.Email != "" {
				<div class="text-[11px] text-slate-500 font-mono mt-0.5">{ lead.Email }</div>
			}
		</td>
		<td class="py-3.5 px-4 whitespace-nowrap text-slate-400 font-mono text-xs">
			if lead.BookingDate != "" {
				<div class="text-slate-200">{ lead.BookingDate }</div>
			}
			if lead.BookingTime != "" {
				<div class="text-amber-400/80">{ lead.BookingTime }</div>
			}
			if lead.BookingDate == "" && lead.BookingTime == "" {
				<span class="text-slate-600">—</span>
			}
		</td>
		<td class="py-3.5 px-4 max-w-xs truncate">
			if lead.Source != "" {
				<span class="inline-block px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 text-[10px] mr-1.5">
					{ lead.Source }
				</span>
			}
			if lead.Payload != nil {
				if comment, ok := lead.Payload["comment"].(string); ok && comment != "" {
					<span class="text-slate-400">{ comment }</span>
				}
			}
		</td>
		<td class="py-3.5 px-4 whitespace-nowrap">
			@LeadStatusBadge(lead.Status)
		</td>
		<td class="py-3.5 px-4 whitespace-nowrap text-right">
			<div class="inline-flex items-center gap-1.5">
				<select
					class="bg-slate-800 border border-slate-700 text-slate-300 text-xs rounded-lg px-2 py-1 focus:outline-none focus:ring-1 focus:ring-amber-500"
					hx-post={ "/client/leads/" + lead.ID + "/status" }
					hx-target={ "#lead-row-" + lead.ID }
					hx-swap="outerHTML"
					name="status"
				>
					<option value="новая" selected?={ lead.Status == "новая" || lead.Status == "" }>Новая</option>
					<option value="в обработке" selected?={ lead.Status == "в обработке" }>В обработке</option>
					<option value="выполнена" selected?={ lead.Status == "выполнена" || lead.Status == "обработана" }>Выполнена</option>
					<option value="отменена" selected?={ lead.Status == "отменена" }>Отменена</option>
				</select>
			</div>
		</td>
	</tr>
}

templ LeadsBadges(newCount int, inProgressCount int, totalCount int) {
	<span id="leads-count-badges" class="inline-flex items-center gap-1.5 ml-1">
		if totalCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 shadow-xs"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 shadow-xs"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}

templ LeadRowWithOOBBadges(lead models.Lead, newCount int, inProgressCount int, totalCount int) {
	@LeadRowSingle(lead)
	<span id="leads-count-badges" hx-swap-oob="true" class="inline-flex items-center gap-1.5 ml-1">
		if totalCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 shadow-xs"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 shadow-xs"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}

templ ClientContactsTab(content models.SiteContent, settings models.SiteSettings) {
	<div class="max-w-4xl">
		<div class="mb-6">
			<h2 class="text-xl font-bold text-white tracking-tight">Контакты и реквизиты</h2>
			<p class="text-xs text-slate-400 mt-1">Изменение телефонов, адреса и рабочего графика на сайте</p>
		</div>

		<form
			x-data
			hx-post="/client/contacts"
			hx-target="#contacts-save-status"
			hx-swap="innerHTML"
			class="bg-slate-900/70 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl"
		>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
						Название компании / Сайта <span class="text-amber-400">*</span>
					</label>
					<input
						type="text"
						name="site_name"
						value={ settings.SiteName }
						required
						minlength="2"
						maxlength="100"
						pattern=".*\S+.*"
						title="Название сайта должно содержать от 2 до 100 символов"
						placeholder="Моя Компания"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Обязательное поле (от 2 до 100 символов)</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Слоган / Деятельность</label>
					<input
						type="text"
						name="tagline"
						value={ settings.Tagline }
						maxlength="150"
						placeholder="Например: Надежная защита ваших интересов"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Краткое описание деятельности (до 150 символов)</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
						Основной телефон <span class="text-amber-400">*</span>
					</label>
					<input
						type="tel"
						name="phone1"
						value={ formatPhoneMask(content.Phone1) }
						required
						x-data
						x-mask="+7 (999) 999-99-99"
						placeholder="+7 (999) 000-00-00"
						pattern="^\+7 \(\d{3}\) \d{3}-\d{2}-\d{2}$"
						title="Формат номера: +7 (999) 999-99-99"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm font-mono focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Формат: +7 (XXX) XXX-XX-XX</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Дополнительный телефон</label>
					<input
						type="tel"
						name="phone2"
						value={ formatPhoneMask(content.Phone2) }
						x-data
						x-mask="+7 (999) 999-99-99"
						placeholder="+7 (999) 000-00-00"
						pattern="^(\+7 \(\d{3}\) \d{3}-\d{2}-\d{2})?$"
						title="Формат номера: +7 (999) 999-99-99 или оставьте пустым"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm font-mono focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Необязательно. Формат: +7 (XXX) XXX-XX-XX</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">WhatsApp (номер для чата)</label>
					<input
						type="tel"
						name="whatsapp_phone"
						value={ formatPhoneMask(settings.WhatsappPhone) }
						x-data
						x-mask="+7 (999) 999-99-99"
						placeholder="+7 (999) 000-00-00"
						pattern="^(\+7 \(\d{3}\) \d{3}-\d{2}-\d{2})?$"
						title="Формат номера WhatsApp: +7 (999) 999-99-99 или оставьте пустым"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm font-mono focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Для прямой ссылки wa.me</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Telegram (юзернейм или ссылка)</label>
					<input
						type="text"
						name="telegram_contact"
						value={ settings.TelegramContact }
						placeholder="@my_channel или t.me/my_channel"
						maxlength="60"
						pattern="^(@[a-zA-Z0-9_]{3,32}|(https?:\/\/)?t\.me\/[a-zA-Z0-9_]{3,32}|[a-zA-Z0-9_]{3,32})?$"
						title="Юзернейм Telegram (@username или t.me/username)"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Формат: &#64;username или t.me/username</p>
				</div>

				<div class="sm:col-span-2">
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
						Адрес офиса / филиала <span class="text-amber-400">*</span>
					</label>
					<input
						type="text"
						name="address"
						value={ content.Address }
						required
						minlength="5"
						maxlength="200"
						pattern=".*\S+.*"
						title="Фактический адрес (от 5 до 200 символов)"
						placeholder="г. Москва, ул. Ленина, д. 10"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Обязательное поле для отображения на сайте и картах</p>
				</div>

				<div class="sm:col-span-2">
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Уточнение адреса (этаж, ориентир, город)</label>
					<input
						type="text"
						name="address_sub"
						value={ content.AddressSub }
						maxlength="100"
						placeholder="Офис 302, 3 этаж, БЦ Плаза"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Дополнительные ориентиры для клиентов</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">График работы</label>
					<input
						type="text"
						name="work_hours"
						value={ content.WorkHours }
						maxlength="60"
						placeholder="Пн-Пт: 09:00 - 18:00"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Рабочие часы в будние дни</p>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Выходные дни</label>
					<input
						type="text"
						name="days_off"
						value={ content.DaysOff }
						maxlength="60"
						placeholder="Сб, Вс"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Дни отдыха или праздники</p>
				</div>
			</div>

			<div class="pt-4 border-t border-slate-800 flex items-center justify-between">
				<div id="contacts-save-status"></div>
				<button
					type="submit"
					class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-amber-500/20 active:scale-[0.99] flex items-center gap-2"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>Сохранить изменения</span>
				</button>
			</div>
		</form>
	</div>
}

templ ClientArticlesTab(articles []models.ArticleItem, trashArticles []models.ArticleItem, showTrash bool) {
	<div>
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
			<div>
				<h2 class="text-xl font-bold text-white tracking-tight">Статьи и Новости блога</h2>
				<p class="text-xs text-slate-400 mt-1">Публикация экспертных материалов, отложенный постинг и управление контентом</p>
			</div>
			<div class="flex items-center gap-3">
				if showTrash && len(trashArticles) > 0 {
					<button
						hx-post="/client/articles/trash/empty"
						hx-target="#admin-tab-content"
						hx-swap="innerHTML"
						hx-confirm="Вы уверены, что хотите окончательно очистить корзину? Все удаленные статьи будут стёрты навсегда."
						class="px-3.5 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						<span>Очистить корзину</span>
					</button>
				}
				<button
					hx-get="/client/articles/new"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all shadow-lg shadow-amber-500/20 flex items-center gap-2 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					<span>Написать новую статью</span>
				</button>
			</div>
		</div>

		<!-- Вкладки-фильтры: Все публикации / Корзина -->
		<div class="flex items-center gap-2 mb-4 border-b border-slate-800 pb-3">
			<button
				type="button"
				hx-get="/client/tab/articles?view=all"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 cursor-pointer",
					templ.KV("bg-amber-500/15 text-amber-300 border border-amber-500/30", !showTrash),
					templ.KV("text-slate-400 hover:text-white bg-slate-800/40 border border-transparent", showTrash) }
			>
				<span>Все публикации</span>
				<span class={ "px-1.5 py-0.2 rounded-full text-[10px]",
					templ.KV("bg-amber-500/30 text-amber-200", !showTrash),
					templ.KV("bg-slate-700 text-slate-300", showTrash) }>
					{ fmt.Sprintf("%d", len(articles)) }
				</span>
			</button>

			<button
				type="button"
				hx-get="/client/tab/articles?view=trash"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class={ "px-3.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 cursor-pointer",
					templ.KV("bg-red-500/15 text-red-300 border border-red-500/30", showTrash),
					templ.KV("text-slate-400 hover:text-white bg-slate-800/40 border border-transparent", !showTrash) }
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
				<span>Корзина</span>
				if len(trashArticles) > 0 {
					<span class={ "px-1.5 py-0.2 rounded-full text-[10px]",
						templ.KV("bg-red-500/30 text-red-200", showTrash),
						templ.KV("bg-red-500/20 text-red-400", !showTrash) }>
						{ fmt.Sprintf("%d", len(trashArticles)) }
					</span>
				}
			</button>
		</div>

		if showTrash {
			<!-- Режим просмотра корзины -->
			if len(trashArticles) == 0 {
				<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
					<div class="w-12 h-12 mx-auto rounded-xl bg-slate-800/50 border border-slate-700 text-slate-400 flex items-center justify-center mb-3">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</div>
					<h3 class="text-base font-semibold text-white mb-1">Корзина пуста</h3>
					<p class="text-xs text-slate-400 max-w-sm mx-auto">Удалённые материалы временно хранятся здесь. Вы можете восстановить их в любой момент.</p>
				</div>
			} else {
				<div class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs sm:text-sm">
							<thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
								<tr>
									<th class="py-3.5 px-4 font-semibold">Заголовок</th>
									<th class="py-3.5 px-4 font-semibold">URL (Slug)</th>
									<th class="py-3.5 px-4 font-semibold">Удалено</th>
									<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/60 text-slate-300">
								for _, a := range trashArticles {
									<tr class="hover:bg-slate-800/30 transition-colors">
										<td class="py-3.5 px-4 font-semibold max-w-sm truncate text-slate-400 line-through">
											{ a.Title }
										</td>
										<td class="py-3.5 px-4 font-mono text-xs text-slate-500">
											/blog/{ a.Slug }
										</td>
										<td class="py-3.5 px-4 text-slate-400 text-xs">
											if a.DeletedAt != "" {
												{ a.DeletedAt }
											} else {
												{ a.FormatPublishedAt() }
											}
										</td>
										<td class="py-3.5 px-4 text-right space-x-2">
											<button
												hx-post={ "/client/articles/restore/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs text-emerald-400 hover:text-emerald-300 hover:underline cursor-pointer font-medium"
											>
												Восстановить
											</button>
											<button
												hx-delete={ "/client/articles/permanent/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ "Окончательно удалить «" + a.Title + "»? Это действие нельзя отменить." }
												class="text-xs text-red-400 hover:text-red-300 hover:underline cursor-pointer font-medium"
											>
												Удалить навсегда
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		} else {
			<!-- Режим просмотра активных статей -->
			if len(articles) == 0 {
				<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
					<h3 class="text-base font-semibold text-white mb-1">Статей пока нет</h3>
					<p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">Нажмите кнопку выше, чтобы создать первую экспертную публикацию.</p>
				</div>
			} else {
				<div class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs sm:text-sm">
							<thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
								<tr>
									<th class="py-3.5 px-4 font-semibold">Заголовок</th>
									<th class="py-3.5 px-4 font-semibold">URL (Slug)</th>
									<th class="py-3.5 px-4 font-semibold">Дата публикации</th>
									<th class="py-3.5 px-4 font-semibold">Статус</th>
									<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/60 text-slate-300">
								for _, a := range articles {
									<tr class="hover:bg-slate-800/30 transition-colors">
										<td class="py-3.5 px-4 font-semibold text-white max-w-sm truncate">
											{ a.Title }
										</td>
										<td class="py-3.5 px-4 font-mono text-xs text-amber-400/80">
											/blog/{ a.Slug }
										</td>
										<td class="py-3.5 px-4 text-slate-300 text-xs">
											{ a.FormatPublishedAt() }
										</td>
										<td class="py-3.5 px-4">
											if a.IsScheduled() {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/10 text-amber-300 border border-amber-500/20" title="Публикация запланирована на будущее">
													<svg class="w-3 h-3 text-amber-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
													</svg>
													<span>Запланирована</span>
												</span>
											} else if a.IsPublished {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
													Опубликована
												</span>
											} else {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
													Черновик / Скрыта
												</span>
											}
										</td>
										<td class="py-3.5 px-4 text-right space-x-2">
											<!-- Быстрое переключение: Скрыть / Опубликовать в 1 клик -->
											<button
												hx-post={ "/client/articles/toggle/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class={ "text-xs font-medium cursor-pointer transition-colors",
													templ.KV("text-slate-400 hover:text-amber-400", a.IsPublished),
													templ.KV("text-emerald-400 hover:text-emerald-300", !a.IsPublished) }
												title={ templ.EscapeString(func() string { if a.IsPublished { return "Скрыть статью с сайта" } else { return "Опубликовать на сайте" } }()) }
											>
												if a.IsPublished {
													<span>Скрыть</span>
												} else {
													<span>Опубликовать</span>
												}
											</button>

											<button
												hx-get={ "/client/articles/edit/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												class="text-xs text-amber-400 hover:underline cursor-pointer"
											>
												Редактировать
											</button>

											if a.IsLive() {
												<a href={ templ.SafeURL("/blog/" + a.Slug) } target="_blank" class="text-xs text-slate-400 hover:text-white">
													Просмотр
												</a>
											}

											<!-- Кнопка удаления в корзину -->
											<button
												hx-post={ "/client/articles/trash/" + a.ID }
												hx-target="#admin-tab-content"
												hx-swap="innerHTML"
												hx-confirm={ "Переместить статью «" + a.Title + "» в корзину?" }
												title="Переместить в корзину"
												class="text-xs text-red-400 hover:text-red-300 hover:underline cursor-pointer"
											>
												В корзину
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		}
	</div>
}

templ ClientArticleForm(article models.ArticleItem, isNew bool) {
	<div class="max-w-4xl">
		<div class="flex items-center justify-between mb-6">
			<div>
				if isNew {
					<h2 class="text-xl font-bold text-white tracking-tight">Новая статья</h2>
				} else {
					<h2 class="text-xl font-bold text-white tracking-tight">Редактирование статьи</h2>
				}
				<p class="text-xs text-slate-400 mt-1">Визуальный редактор публикаций с автогенерацией URL и тегами</p>
			</div>
			<button
				hx-get="/client/tab/articles"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 transition-colors cursor-pointer"
			>
				Назад к списку
			</button>
		</div>

		<form
			hx-post="/client/articles/save"
			hx-target="#admin-tab-content"
			hx-swap="innerHTML"
			hx-encoding="multipart/form-data"
			enctype="multipart/form-data"
			x-data={ fmt.Sprintf("articleEditor({ initialTitle: %s, initialSlug: %s, initialTags: %s, initialCover: %s, isNew: %t })",
				escapeJSONString(article.Title),
				escapeJSONString(article.Slug),
				tagsToJSON(article.Tags),
				escapeJSONString(article.CoverImage),
				isNew,
			) }
			x-init="init()"
			class="bg-slate-900/70 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl"
		>
			<input type="hidden" name="id" value={ article.ID }/>
			<input type="hidden" name="tags" :value="tags.join(',')"/>
			<input type="hidden" name="remove_cover" :value="removeCover ? 'true' : 'false'"/>

			<div class="space-y-6">
				<!-- Заголовок статьи с транслитерацией -->
				<div>
					<div class="flex items-center justify-between mb-2">
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
							Заголовок статьи <span class="text-amber-400">*</span>
						</label>
						<span class="text-[11px] text-slate-500">Автоматически формирует понятный адрес ссылки</span>
					</div>
					<input
						type="text"
						name="title"
						x-model="title"
						x-on:input="onTitleInput()"
						required
						placeholder="Например: Как подготовить документы для сделки в 2026 году..."
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
				</div>

				<!-- URL-адрес (Slug) + Автор -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<div class="flex items-center justify-between mb-2">
							<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
								URL-адрес (Slug) <span class="text-amber-400">*</span>
							</label>
							<button
								type="button"
								x-on:click="regenerateSlug()"
								title="Обновить ссылку по текущему названию статьи"
								class="text-[11px] text-amber-400 hover:text-amber-300 hover:underline flex items-center gap-1 cursor-pointer"
							>
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
								</svg>
								<span>Сгенерировать</span>
							</button>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-xs text-slate-500 font-mono select-none">
								/blog/
							</span>
							<input
								type="text"
								name="slug"
								x-model="slug"
								x-on:input="onSlugInput()"
								required
								placeholder="kak-podgotovit-dokumenty"
								class="w-full pl-16 pr-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-amber-400 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
							/>
						</div>
						<p class="text-[11px] text-slate-500 mt-1 truncate">
							Адрес на сайте: /blog/<span class="text-slate-300 font-mono" x-text="slug || 'vasha-statya'"></span>
						</p>
					</div>

					<div>
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
							Автор публикации
						</label>
						<input
							type="text"
							name="author_name"
							value={ article.AuthorName }
							placeholder="Владислав Захаров"
							class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
						/>
					</div>
				</div>

				<!-- Обложка статьи (Drag & Drop + Preview) -->
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
						Обложка статьи
					</label>

					<input
						type="file"
						name="cover_image"
						x-ref="coverFileInput"
						accept="image/png,image/jpeg,image/webp,image/gif"
						class="hidden"
						x-on:change="handleFileSelect($event)"
					/>

					<!-- Если обложка выбрана / существует -->
					<div x-show="coverPreview" class="relative group rounded-2xl overflow-hidden border border-slate-700 bg-slate-950 max-w-lg shadow-md">
						<img
							:src="coverPreview"
							alt="Обложка статьи"
							class="w-full h-48 sm:h-56 object-cover"
						/>
						<div class="absolute inset-0 bg-slate-950/70 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3 backdrop-blur-xs">
							<button
								type="button"
								x-on:click="$refs.coverFileInput.click()"
								class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-semibold text-xs shadow cursor-pointer transition-colors flex items-center gap-1.5"
							>
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
								<span>Заменить</span>
							</button>
							<button
								type="button"
								x-on:click="clearCover()"
								class="px-3 py-1.5 rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/30 font-semibold text-xs cursor-pointer transition-colors flex items-center gap-1.5"
							>
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
								</svg>
								<span>Удалить</span>
							</button>
						</div>
					</div>

					<!-- Зона Drag & Drop (если обложки нет) -->
					<div
						x-show="!coverPreview"
						x-on:click="$refs.coverFileInput.click()"
						x-on:dragover.prevent="isDragging = true"
						x-on:dragleave.prevent="isDragging = false"
						x-on:drop.prevent="handleDrop($event)"
						:class="isDragging ? 'border-amber-400 bg-amber-400/10' : 'border-slate-700 hover:border-slate-600 bg-slate-800/40 hover:bg-slate-800/60'"
						class="border-2 border-dashed rounded-2xl p-6 text-center cursor-pointer transition-all max-w-lg"
					>
						<div class="w-12 h-12 mx-auto rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mb-3">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
							</svg>
						</div>
						<p class="text-xs font-semibold text-white mb-1">
							Нажмите для выбора или перетащите фото сюда
						</p>
						<p class="text-[11px] text-slate-400">
							Поддерживаются WebP, PNG, JPG до 5 МБ (16:9 рекомендуется)
						</p>
					</div>
				</div>

				<!-- Теги / Рубрикатор (Badge Chips) -->
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
						Теги и рубрики публикации
					</label>

					<!-- Контейнер чипсов -->
					<div class="p-3 rounded-xl bg-slate-800/80 border border-slate-700 min-h-[46px] flex flex-wrap items-center gap-2">
						<template x-for="(tag, idx) in tags" :key="idx">
							<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30 shadow-xs">
								<span x-text="'#' + tag"></span>
								<button
									type="button"
									x-on:click="removeTag(idx)"
									title="Удалить тег"
									class="hover:text-red-400 text-amber-400/80 transition-colors cursor-pointer"
								>
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
								</button>
							</span>
						</template>

						<input
							type="text"
							x-model="newTag"
							x-on:keydown.enter.prevent="addTag()"
							x-on:keydown.comma.prevent="addTag()"
							placeholder="+ Напишите тег и нажмите Enter..."
							class="flex-1 min-w-[200px] bg-transparent text-white text-xs placeholder-slate-500 focus:outline-none py-1"
						/>
					</div>

					<!-- Готовые подсказки тегов -->
					<div class="flex items-center gap-1.5 flex-wrap mt-2">
						<span class="text-[11px] text-slate-500 mr-1">Быстрый выбор:</span>
						for _, suggested := range []string{"Полезное", "Инструкция", "Советы", "Законодательство", "Кейс", "Новости"} {
							<button
								type="button"
								x-on:click={ fmt.Sprintf("suggestTag('%s')", suggested) }
								class="px-2 py-0.5 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-amber-400 text-[11px] transition-colors cursor-pointer border border-slate-700"
							>
								{ "+" + suggested }
							</button>
						}
					</div>
				</div>

				<!-- Краткий анонс (Лид-абзац) -->
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
						Краткий анонс (Лид-абзац для карточки в каталоге)
					</label>
					<textarea
						name="excerpt"
						rows="2"
						placeholder="Краткое описание сути статьи в 1-2 предложениях..."
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					>{ article.Excerpt }</textarea>
				</div>

				<!-- Визуальный редактор текста статьи (Quill.js) -->
				<div class="space-y-2">
					<div class="flex items-center justify-between">
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
							Текст статьи (Визуальный редактор)
						</label>
						<span class="text-[11px] text-amber-400/90 font-medium flex items-center gap-1">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
							<span>WYSIWYG: форматирование как в Word</span>
						</span>
					</div>

					<!-- Скрытое поле для отправки чистого HTML на бэкенд -->
					<textarea
						name="content"
						x-ref="contentInput"
						class="hidden"
					>{ article.Content }</textarea>

					<!-- Контейнер Quill.js со стилизацией под Dark Slate тему -->
					<div class="quill-dark-wrapper rounded-xl overflow-hidden border border-slate-700 bg-slate-900/90 shadow-inner">
						<div x-ref="quillEditor" class="min-h-[340px] text-white"></div>
					</div>
				</div>

				<!-- Дата и время публикации (Отложенный постинг) -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
					<div>
						<div class="flex items-center justify-between mb-2">
							<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
								Дата и время публикации
							</label>
							<span class="text-[11px] text-amber-400/90 font-medium">Отложенная публикация</span>
						</div>
						<input
							type="datetime-local"
							name="published_at"
							id="published_at_input"
							value={ article.PublishedAtInput() }
							class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 font-mono"
						/>
						<p class="text-[11px] text-slate-500 mt-1">
							Если указать дату и время в будущем — материал станет запланированным и появится на сайте автоматически.
						</p>
					</div>

					<div>
						<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
							Быстрый выбор времени
						</label>
						<div class="flex flex-wrap gap-2 pt-1">
							<button
								type="button"
								onclick="const now = new Date(); const offset = now.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(now - offset).toISOString().slice(0, 16);"
								class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 border border-slate-700 transition-colors cursor-pointer"
							>
								Сейчас
							</button>
							<button
								type="button"
								onclick="const d = new Date(); d.setDate(d.getDate() + 1); d.setHours(9, 0, 0, 0); const offset = d.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(d - offset).toISOString().slice(0, 16);"
								class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-amber-400 border border-slate-700 transition-colors cursor-pointer"
							>
								Завтра в 09:00
							</button>
							<button
								type="button"
								onclick="const d = new Date(); d.setDate(d.getDate() + 3); d.setHours(10, 0, 0, 0); const offset = d.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(d - offset).toISOString().slice(0, 16);"
								class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-amber-400 border border-slate-700 transition-colors cursor-pointer"
							>
								Через 3 дня
							</button>
							<button
								type="button"
								onclick="const d = new Date(); d.setDate(d.getDate() + 7); d.setHours(12, 0, 0, 0); const offset = d.getTimezoneOffset() * 60000; document.getElementById('published_at_input').value = new Date(d - offset).toISOString().slice(0, 16);"
								class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-amber-400 border border-slate-700 transition-colors cursor-pointer"
							>
								Через неделю
							</button>
						</div>
					</div>
				</div>

				<!-- Статус публикации -->
				<div class="flex items-center gap-3 pt-2">
					<input
						type="checkbox"
						id="is_published"
						name="is_published"
						value="true"
						checked?={ article.IsPublished }
						class="w-4 h-4 rounded text-amber-500 bg-slate-800 border-slate-700 focus:ring-amber-500 cursor-pointer"
					/>
					<label for="is_published" class="text-sm font-medium text-slate-300 cursor-pointer">
						Опубликовать статью на сайте (если указано будущее время — будет запланирована)
					</label>
				</div>
			</div>

			<div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
				<button
					type="submit"
					class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-amber-500/20 active:scale-[0.99] flex items-center gap-2 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>Сохранить публикацию</span>
				</button>
			</div>
		</form>

		<!-- Стили Dark Theme для Quill Editor -->
		<style>
			.quill-dark-wrapper .ql-toolbar.ql-snow {
				background-color: #0b1120;
				border-color: #334155;
				border-top-left-radius: 0.75rem;
				border-top-right-radius: 0.75rem;
				border-bottom: 1px solid #334155;
				padding: 0.75rem;
			}
			.quill-dark-wrapper .ql-container.ql-snow {
				background-color: #0b1120;
				border-color: #334155;
				border-bottom-left-radius: 0.75rem;
				border-bottom-right-radius: 0.75rem;
				font-size: 0.95rem;
				font-family: inherit;
				color: #e2e8f0;
			}
			.quill-dark-wrapper .ql-editor {
				min-height: 320px;
				line-height: 1.7;
				padding: 1rem 1.25rem;
			}
			.quill-dark-wrapper .ql-editor.ql-blank::before {
				color: #64748b;
				font-style: normal;
			}
			.quill-dark-wrapper .ql-snow .ql-stroke {
				stroke: #94a3b8;
			}
			.quill-dark-wrapper .ql-snow .ql-fill {
				fill: #94a3b8;
			}
			.quill-dark-wrapper .ql-snow .ql-picker {
				color: #94a3b8;
			}
			.quill-dark-wrapper .ql-snow .ql-picker-options {
				background-color: #1e293b;
				border: 1px solid #334155;
				border-radius: 0.5rem;
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
			}
			.quill-dark-wrapper .ql-snow .ql-picker-item:hover,
			.quill-dark-wrapper .ql-snow .ql-picker-item.ql-selected {
				color: #fbbf24;
			}
			.quill-dark-wrapper .ql-snow button:hover .ql-stroke,
			.quill-dark-wrapper .ql-snow button.ql-active .ql-stroke,
			.quill-dark-wrapper .ql-snow .ql-picker-label:hover .ql-stroke {
				stroke: #fbbf24 !important;
			}
			.quill-dark-wrapper .ql-snow button:hover .ql-fill,
			.quill-dark-wrapper .ql-snow button.ql-active .ql-fill {
				fill: #fbbf24 !important;
			}
			.quill-dark-wrapper .ql-snow .ql-picker-label:hover {
				color: #fbbf24 !important;
			}
			.quill-dark-wrapper .ql-editor h2 {
				font-size: 1.4rem;
				font-weight: 700;
				color: #ffffff;
				margin-top: 1rem;
				margin-bottom: 0.5rem;
			}
			.quill-dark-wrapper .ql-editor h3 {
				font-size: 1.2rem;
				font-weight: 600;
				color: #ffffff;
				margin-top: 0.75rem;
				margin-bottom: 0.5rem;
			}
			.quill-dark-wrapper .ql-editor blockquote {
				border-left: 3px solid #fbbf24;
				padding-left: 0.85rem;
				color: #94a3b8;
				font-style: italic;
				margin: 0.75rem 0;
			}
			.quill-dark-wrapper .ql-editor a {
				color: #fbbf24;
				text-decoration: underline;
			}
			.quill-dark-wrapper .ql-editor img {
				border-radius: 0.5rem;
				max-width: 100%;
				margin: 0.75rem 0;
			}
		</style>

		<!-- Скрипт инициализации логики формы статьи -->
		<script>
			function articleEditor(config) {
				return {
					title: config.initialTitle || '',
					slug: config.initialSlug || '',
					slugTouched: !config.isNew && config.initialSlug !== '',
					tags: Array.isArray(config.initialTags) ? config.initialTags : [],
					newTag: '',
					coverPreview: config.initialCover || '',
					removeCover: false,
					isDragging: false,
					quill: null,

					init() {
						this.initQuill();
					},

					transliterate(str) {
						if (!str) return '';
						const ru = {
							'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd',
							'е': 'e', 'ё': 'yo', 'ж': 'zh', 'з': 'z', 'и': 'i',
							'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n',
							'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't',
							'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch',
							'ш': 'sh', 'щ': 'shch', 'ъ': '', 'ы': 'y', 'ь': '',
							'э': 'e', 'ю': 'yu', 'я': 'ya'
						};
						let res = '';
						const lower = str.toLowerCase();
						for (let i = 0; i < lower.length; i++) {
							const ch = lower[i];
							if (ru[ch] !== undefined) {
								res += ru[ch];
							} else {
								res += ch;
							}
						}
						return res
							.replace(/[^a-z0-9\s-]/g, '')
							.trim()
							.replace(/[\s_]+/g, '-')
							.replace(/-+/g, '-');
					},

					onTitleInput() {
						if (!this.slugTouched) {
							this.slug = this.transliterate(this.title);
						}
					},

					onSlugInput() {
						this.slugTouched = true;
					},

					regenerateSlug() {
						this.slug = this.transliterate(this.title);
						this.slugTouched = false;
					},

					addTag() {
						const val = this.newTag.trim().replace(/^#/, '').trim();
						if (val && !this.tags.includes(val)) {
							this.tags.push(val);
						}
						this.newTag = '';
					},

					removeTag(idx) {
						this.tags.splice(idx, 1);
					},

					suggestTag(name) {
						if (!this.tags.includes(name)) {
							this.tags.push(name);
						}
					},

					handleFileSelect(e) {
						const file = e.target.files && e.target.files[0];
						if (file) this.previewImage(file);
					},

					handleDrop(e) {
						this.isDragging = false;
						const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
						if (file) {
							if (this.$refs.coverFileInput) {
								this.$refs.coverFileInput.files = e.dataTransfer.files;
							}
							this.previewImage(file);
						}
					},

					previewImage(file) {
						if (!file || !file.type.startsWith('image/')) return;
						this.removeCover = false;
						const reader = new FileReader();
						reader.onload = (e) => {
							this.coverPreview = e.target.result;
						};
						reader.readAsDataURL(file);
					},

					clearCover() {
						this.coverPreview = '';
						this.removeCover = true;
						if (this.$refs.coverFileInput) {
							this.$refs.coverFileInput.value = '';
						}
					},

					initQuill() {
						const container = this.$refs.quillEditor;
						if (!container) return;
						if (container.__quill) return;

						if (typeof Quill === 'undefined') {
							setTimeout(() => this.initQuill(), 100);
							return;
						}

						const quill = new Quill(container, {
							theme: 'snow',
							placeholder: 'Напишите текст публикации: форматируйте абзацы, выделяйте заголовки H2/H3, списки, добавляйте изображения...',
							modules: {
								toolbar: [
									[{ 'header': [2, 3, false] }],
									['bold', 'italic', 'underline', 'strike'],
									[{ 'list': 'ordered'}, { 'list': 'bullet' }],
									['blockquote', 'link', 'image'],
									['clean']
								]
							}
						});

						container.__quill = quill;
						this.quill = quill;

						const initialHTML = this.$refs.contentInput ? (this.$refs.contentInput.value || '') : '';
						if (initialHTML) {
							quill.root.innerHTML = initialHTML;
						}

						quill.on('text-change', () => {
							const html = quill.root.innerHTML;
							if (this.$refs.contentInput) {
								this.$refs.contentInput.value = (html === '<p><br></p>') ? '' : html;
							}
						});
					}
				};
			}
		</script>
	</div>
}
