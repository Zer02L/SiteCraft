package pages

import (
	"sitecraft/internal/models"
)

templ AdminSettingsTab(settings models.SiteSettings, content models.SiteContent, successMsg string) {
	<div class="max-w-5xl space-y-6">
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-admin-border">
			<div>
				<h2 class="text-lg font-semibold text-admin-content tracking-tight">Настройки сайта и SEO</h2>
				<p class="text-xs text-admin-content-muted mt-0.5">Глобальная конфигурация, мета-теги, реквизиты и интеграции с внешними сервисами</p>
			</div>
		</div>

		if successMsg != "" {
			<div class="p-3.5 rounded-xl bg-admin-success-muted border border-admin-success-border text-admin-success text-xs flex items-center gap-2">
				<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
				</svg>
				<span>{ successMsg }</span>
			</div>
		}

		<form
			x-data="{ dirty: false }"
			@input="dirty = true"
			@change="dirty = true"
			hx-post="/admin/settings"
			hx-target="#admin-tab-content"
			hx-swap="innerHTML"
			class="space-y-6"
		>
			<!-- 1. Бренд и визуальный стиль -->
			<div class="bg-admin-surface border border-admin-border rounded-xl p-5 sm:p-6">
				<div class="grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] gap-6">
					<div>
						<h3 class="text-sm font-semibold text-admin-content">Бренд и визуальный стиль</h3>
						<p class="text-xs text-admin-content-muted mt-1 leading-relaxed">Название сайта, палитра темы, шрифтовая пара и характер скруглений витрины.</p>
					</div>

					<div class="space-y-4">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Название сайта / Компании</label>
								<input type="text" name="site_name" value={ settings.SiteName } required class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm"/>
							</div>
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Слоган (Tagline)</label>
								<input type="text" name="tagline" value={ settings.Tagline } class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm"/>
							</div>
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Цветовая тема</label>
								<select name="theme" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm">
									<option value="main" selected?={ settings.Theme == "main" }>Main / Классическая</option>
									<option value="legal" selected?={ settings.Theme == "legal" }>Legal / Строгая юридическая</option>
									<option value="medical" selected?={ settings.Theme == "medical" }>Medical / Чистая медицинская</option>
									<option value="auto" selected?={ settings.Theme == "auto" }>Auto / Контрастный автосервис</option>
									<option value="tech" selected?={ settings.Theme == "tech" }>Tech / Неоновый IT-стиль</option>
									<option value="beauty" selected?={ settings.Theme == "beauty" }>Beauty / Премиум салон</option>
									<option value="dark" selected?={ settings.Theme == "dark" }>Dark / Глубокая темная</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Вариант шапки (Header)</label>
								<select name="header_variant" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm">
									<option value="classic" selected?={ settings.HeaderVariant == "classic" }>Classic (Лого слева, меню по центру)</option>
									<option value="minimal" selected?={ settings.HeaderVariant == "minimal" }>Minimal (Компактная)</option>
									<option value="centered" selected?={ settings.HeaderVariant == "centered" }>Centered (Центрированное лого)</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Дизайн-настроение (Design Flavor)</label>
								<select name="design_flavor" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm">
									<option value="soft" selected?={ settings.GetDesignFlavor() == "soft" }>Soft / Современный SaaS (Скругления 24px, мягкие тени)</option>
									<option value="corporate" selected?={ settings.GetDesignFlavor() == "corporate" }>Corporate / Строгий деловой (Скругления 8px, деликатные тени)</option>
									<option value="sharp" selected?={ settings.GetDesignFlavor() == "sharp" }>Sharp / Минимализм (Скругления 0px, строгие линии)</option>
									<option value="brutalist" selected?={ settings.GetDesignFlavor() == "brutalist" }>Brutalist / Нео-брутализм (Границы 2px, контраст)</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Шрифтовая пара (Font Pair)</label>
								<select name="font_family" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm">
									<option value="modern" selected?={ settings.GetFontPair() == "modern" }>Modern (Inter / Универсальный чистый)</option>
									<option value="editorial" selected?={ settings.GetFontPair() == "editorial" }>Editorial (Merriweather / Редакционный премиум)</option>
									<option value="condensed" selected?={ settings.GetFontPair() == "condensed" }>Condensed (Bebas Neue / Энергичный акцент)</option>
									<option value="tech" selected?={ settings.GetFontPair() == "tech" }>Tech (Plus Jakarta Sans / IT стиль)</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Основной цвет (Primary)</label>
								<div class="flex items-center gap-2">
									<input type="text" name="primary_color" value={ settings.PrimaryColor } placeholder="#1e293b" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono"/>
									<input type="color" value={ settings.PrimaryColor } oninput="this.previousElementSibling.value = this.value" class="w-9 h-9 rounded-lg bg-transparent border border-admin-border cursor-pointer shrink-0"/>
								</div>
							</div>
							<div>
								<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Акцентный цвет CTA (Accent)</label>
								<div class="flex items-center gap-2">
									<input type="text" name="accent_color" value={ settings.AccentColor } placeholder="#2563eb" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono"/>
									<input type="color" value={ settings.AccentColor } oninput="this.previousElementSibling.value = this.value" class="w-9 h-9 rounded-lg bg-transparent border border-admin-border cursor-pointer shrink-0"/>
								</div>
							</div>
						</div>

						<div class="pt-3 border-t border-admin-border flex flex-wrap items-center justify-between gap-2 text-xs text-admin-content-muted">
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4 text-admin-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
								<span>Нужно подобрать цвета из логотипа? Авто-извлечение доступно в конструкторе темы.</span>
							</div>
							<a href="/admin#tab=blocks" @click.prevent="openTab('blocks', '/admin/tab/blocks')" class="text-admin-accent hover:underline font-medium text-xs shrink-0">
								В конструктор темы →
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- 2. SEO и аналитика -->
			<div class="bg-admin-surface border border-admin-border rounded-xl p-5 sm:p-6">
				<div class="grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] gap-6">
					<div>
						<h3 class="text-sm font-semibold text-admin-content">SEO и аналитика</h3>
						<p class="text-xs text-admin-content-muted mt-1 leading-relaxed">Счётчики посещаемости, Telegram-уведомления и Webhook для интеграции с CRM.</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Яндекс.Метрика ID</label>
							<input type="text" name="yandex_metrika_id" value={ settings.YandexMetrikaID } placeholder="Например: 98765432" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Webhook URL для заявок</label>
							<input type="text" name="webhook_url" value={ settings.WebhookURL } placeholder="https://..." class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Telegram Bot Token</label>
							<input type="text" name="telegram_bot_token" value={ settings.TelegramBotToken } placeholder="bot123456:ABC..." class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Telegram Chat ID</label>
							<input type="text" name="telegram_chat_id" value={ settings.TelegramChatID } placeholder="-100..." class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono"/>
						</div>
					</div>
				</div>
			</div>

			<!-- 3. Контакты и юридические данные -->
			<div class="bg-admin-surface border border-admin-border rounded-xl p-5 sm:p-6">
				<div class="grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)] gap-6">
					<div>
						<h3 class="text-sm font-semibold text-admin-content">Контакты и 152-ФЗ</h3>
						<p class="text-xs text-admin-content-muted mt-1 leading-relaxed">Реквизиты оператора персональных данных для политики конфиденциальности и подвала.</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Основной телефон</label>
							<input type="text" name="phone1" value={ content.Phone1 } placeholder="+7 (999) 000-00-00" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm tabular-nums"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Контактный Email</label>
							<input type="email" name="contact_email" value={ settings.ContactEmail } placeholder="info@domain.ru" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">Юридическое лицо</label>
							<input type="text" name="legal_entity" value={ settings.LegalEntity } placeholder="ООО или ИП" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-admin-content-muted mb-1.5">ИНН</label>
							<input type="text" name="inn" value={ settings.INN } placeholder="7701234567" class="admin-input w-full px-3 py-2 rounded-lg bg-admin-surface-muted border border-admin-border text-admin-content text-sm font-mono tabular-nums"/>
						</div>
					</div>
				</div>
			</div>

			<!-- Sticky Save Bar -->
			<div class="sticky bottom-4 z-10 flex items-center justify-between gap-3 px-4 py-3 rounded-xl border border-admin-border bg-admin-surface-elevated">
				<div class="text-xs text-admin-content-muted">
					<span x-show="dirty" x-cloak class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning-border">
						Есть несохранённые изменения
					</span>
				</div>
				<button
					type="submit"
					class="px-5 py-2 rounded-lg bg-admin-accent hover:bg-admin-accent-hover text-admin-on-accent font-semibold text-xs transition active:scale-[0.99] flex items-center gap-1.5 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					<span>Сохранить настройки</span>
				</button>
			</div>
		</form>
	</div>
}
