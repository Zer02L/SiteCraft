package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/pages/admin_blocks"
)

func humanBlockType(bType string) (name string, icon string) {
	return admin_blocks.HumanBlockType(bType)
}

func initialBlocksConfig(settings models.SiteSettings) string {
	theme := settings.Theme
	if theme == "" {
		theme = "main"
	}
	primary := settings.PrimaryColor
	if primary == "" {
		primary = "#1e293b"
	}
	accent := settings.AccentColor
	if accent == "" {
		accent = "#2563eb"
	}
	surface := settings.GetCustomBgColor()
	if surface == "" {
		surface = "#ffffff"
	}
	flavor := settings.GetDesignFlavor()
	fontPair := settings.GetFontPair()

	return fmt.Sprintf("{theme: %q, flavor: %q, font: %q, primary: %q, accent: %q, surface: %q}",
		theme, flavor, fontPair, primary, accent, surface)
}

templ AdminBlocksTab(blocks []models.PageBlock, settings models.SiteSettings) {
	<div
		x-data={ fmt.Sprintf("adminBlocksEditor(%s)", initialBlocksConfig(settings)) }
		class="flex flex-col md:h-[calc(100dvh-52px)] md:overflow-hidden bg-admin-bg"
	>
		<!-- Standalone Admin Blocks Editor script (Zero CDN) -->
		<script src="/assets/js/admin-blocks-editor.js"></script>

		<!-- 1. Компактная шапка конструктора с переключателями устройств и видов -->
		@admin_blocks.Toolbar()

		<!-- 2. IDE Split-Studio: Инспектор слева + Живой холст справа -->
		<div class="flex-1 min-h-0 flex flex-col md:flex-row md:overflow-hidden w-full">
			<!-- Левая колонка: Вкладки + Список секций / Тюнер дизайн-системы -->
			<div
				x-show="responsiveView === 'both' || responsiveView === 'blocks'"
				:class="responsiveView === 'blocks' ? 'w-full max-w-4xl mx-auto my-5 rounded-xl border border-admin-border bg-admin-surface flex flex-col max-h-full overflow-hidden' : 'w-full md:w-[360px] lg:w-[390px] shrink-0 md:h-full border-b md:border-b-0 md:border-r border-admin-border bg-admin-surface flex flex-col min-h-0'"
			>
				<!-- Вкладки инспектора и действие добавления -->
				<div class="flex items-center justify-between gap-2 px-3.5 pt-2.5 border-b border-admin-border shrink-0">
					<div class="flex items-center gap-5">
						<button
							type="button"
							@click="activeSubTab = 'blocks'"
							:class="activeSubTab === 'blocks' ? 'text-admin-content font-semibold border-admin-accent' : 'text-admin-content-muted hover:text-admin-content border-transparent'"
							class="pb-2.5 text-xs font-medium border-b-2 -mb-px transition-colors cursor-pointer flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						>
							<span>Секции</span>
							<span class="px-1.5 py-0.5 rounded-md text-[10px] font-mono tabular-nums bg-admin-surface-muted text-admin-content-muted border border-admin-border">
								{ fmt.Sprintf("%d", len(blocks)) }
							</span>
						</button>

						<button
							type="button"
							@click="activeSubTab = 'theme'"
							:class="activeSubTab === 'theme' ? 'text-admin-content font-semibold border-admin-accent' : 'text-admin-content-muted hover:text-admin-content border-transparent'"
							class="pb-2.5 text-xs font-medium border-b-2 -mb-px transition-colors cursor-pointer flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						>
							<span>Дизайн-система</span>
						</button>
					</div>

					<button
						type="button"
						onclick="document.getElementById('new-block-dialog').showModal()"
						x-show="activeSubTab === 'blocks'"
						class="mb-2 px-2.5 py-1 rounded-md bg-admin-surface-muted hover:bg-admin-surface-hover border border-admin-border text-xs font-medium text-admin-content transition-colors inline-flex items-center gap-1 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					>
						<svg class="w-3.5 h-3.5 text-admin-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						<span>Секция</span>
					</button>
				</div>

				<!-- Скроллируемое содержимое инспектора -->
				<div class="flex-1 min-h-0 overflow-y-auto p-3.5">
					<!-- Вкладка 1: Список секций лендинга -->
					<div x-show="activeSubTab === 'blocks'" class="space-y-2.5">
						@admin_blocks.BlocksList(blocks)
					</div>

					<!-- Вкладка 2: Дизайн-система (OKLCH Тюнер токенов и пресетов) -->
					<div x-show="activeSubTab === 'theme'" x-cloak class="space-y-4 text-xs">
						@admin_blocks.TokenTuner()
					</div>
				</div>
			</div>

			<!-- Правая колонка: Холст Live Preview -->
			@admin_blocks.PreviewCanvas()
		</div>

		<!-- Диалоговые окна добавления и редактирования секций -->
		@admin_blocks.EditModal()
	</div>
}
