package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"
)

templ AdminBlocksTab(blocks []models.PageBlock, settings models.SiteSettings) {
	<div
		x-data="{
			activeSubTab: 'blocks',
			canvasDevice: 'desktop',
			editModalOpen: false,
			editBlock: {
				id: '',
				title: '',
				content: '',
				type: '',
				variant: ''
			},
			themePreset: 'default',
			tokens: {
				primary: '#1e293b',
				accent: '#2563eb',
				radiusBtn: '8px',
				radiusCard: '24px'
			},
			openEdit(id, title, content, bType, variant) {
				this.editBlock = {
					id: id,
					title: title,
					content: content,
					type: bType,
					variant: variant
				};
				const dlg = document.getElementById('edit-block-dialog');
				if (dlg) dlg.showModal();
			},
			setDevice(dev) {
				this.canvasDevice = dev;
			},
			sendTokenUpdate(key, val) {
				const frame = document.getElementById('preview-canvas');
				if (frame && frame.contentWindow) {
					frame.contentWindow.postMessage({ type: 'SITE_TOKEN_UPDATE', key: key, value: val }, '*');
				}
			},
			sendThemeUpdate(theme) {
				this.themePreset = theme;
				const frame = document.getElementById('preview-canvas');
				if (frame && frame.contentWindow) {
					frame.contentWindow.postMessage({ type: 'SITE_THEME_UPDATE', theme: theme }, '*');
				}
			},
			refreshCanvas() {
				const frame = document.getElementById('preview-canvas');
				if (frame) {
					frame.src = frame.src;
				}
			}
		}"
		class="space-y-4"
	>
		<!-- Верхний тулбар визуального редактора -->
		<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pb-4 border-b border-slate-800">
			<div>
				<div class="flex items-center gap-2">
					<h2 class="text-xl font-bold text-white">Визуальный редактор & Конструктор</h2>
					<span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
						Live Preview
					</span>
				</div>
				<p class="text-xs text-slate-400 mt-0.5">
					Управление структурой секций, текстами и живой дизайн-системой лендинга
				</p>
			</div>

			<!-- Панель переключения устройств (Responsive Canvas Switcher) -->
			<div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 p-1 rounded-xl self-start lg:self-auto shadow-inner">
				<button
					type="button"
					@click="setDevice('desktop')"
					:class="canvasDevice === 'desktop' ? 'bg-amber-500 text-slate-950 font-bold shadow-sm' : 'text-slate-400 hover:text-white'"
					class="px-3 py-1.5 rounded-lg text-xs transition-all flex items-center gap-1.5 cursor-pointer"
					title="Десктоп (100% ширина)"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
					</svg>
					<span class="hidden sm:inline">Десктоп</span>
				</button>
				<button
					type="button"
					@click="setDevice('tablet')"
					:class="canvasDevice === 'tablet' ? 'bg-amber-500 text-slate-950 font-bold shadow-sm' : 'text-slate-400 hover:text-white'"
					class="px-3 py-1.5 rounded-lg text-xs transition-all flex items-center gap-1.5 cursor-pointer"
					title="Планшет (768px)"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
					</svg>
					<span class="hidden sm:inline">Планшет (768px)</span>
				</button>
				<button
					type="button"
					@click="setDevice('mobile')"
					:class="canvasDevice === 'mobile' ? 'bg-amber-500 text-slate-950 font-bold shadow-sm' : 'text-slate-400 hover:text-white'"
					class="px-3 py-1.5 rounded-lg text-xs transition-all flex items-center gap-1.5 cursor-pointer"
					title="Мобильный (390px)"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
					</svg>
					<span class="hidden sm:inline">Мобильный (390px)</span>
				</button>
			</div>

			<!-- Кнопки действий -->
			<div class="flex items-center gap-2">
				<button
					type="button"
					@click="refreshCanvas()"
					class="p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer"
					title="Обновить холст"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
				</button>

				<a
					href="/?preview=true"
					target="_blank"
					class="px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800 text-xs font-semibold transition-all flex items-center gap-1.5"
				>
					<span>Открыть сайт</span>
					<svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
					</svg>
				</a>

				<button
					type="button"
					onclick="document.getElementById('new-block-dialog').showModal()"
					class="px-3.5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs transition-all shadow-md shadow-amber-500/20 flex items-center gap-1.5 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					<span>Добавить блок</span>
				</button>
			</div>
		</div>

		<!-- Сплит-экран: Левая панель настроек + Правый интерактивный холст -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
			<!-- Левая колонка: Структура и Токены (4 из 12 колонок) -->
			<div class="lg:col-span-5 xl:col-span-4 space-y-4">
				<!-- Переключатель подвкладок -->
				<div class="flex items-center gap-1 p-1 bg-slate-900/90 border border-slate-800 rounded-xl">
					<button
						type="button"
						@click="activeSubTab = 'blocks'"
						:class="activeSubTab === 'blocks' ? 'bg-slate-800 text-white font-bold shadow-xs' : 'text-slate-400 hover:text-white'"
						class="flex-1 py-1.5 text-xs rounded-lg transition-all text-center cursor-pointer"
					>
						📑 Секции лендинга ({ fmt.Sprintf("%d", len(blocks)) })
					</button>
					<button
						type="button"
						@click="activeSubTab = 'theme'"
						:class="activeSubTab === 'theme' ? 'bg-slate-800 text-white font-bold shadow-xs' : 'text-slate-400 hover:text-white'"
						class="flex-1 py-1.5 text-xs rounded-lg transition-all text-center cursor-pointer"
					>
						🎨 Дизайн-система
					</button>
				</div>

				<!-- Вкладка 1: Список блоков страницы -->
				<div x-show="activeSubTab === 'blocks'" class="space-y-2.5 max-h-[calc(100vh-230px)] overflow-y-auto pr-1">
					if len(blocks) == 0 {
						<div class="p-8 text-center bg-slate-900/60 rounded-2xl border border-slate-800/80">
							<p class="text-slate-400 text-xs">Блоки страницы пока не добавлены.</p>
						</div>
					}
					for idx, b := range blocks {
						{{
							variantStr := ""
							if v, ok := b.Payload["variant"].(string); ok {
								variantStr = v
							}
						}}
						<div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition-all flex items-center justify-between gap-3 group">
							<div class="flex items-center gap-3 min-w-0">
								<!-- Номер порядка -->
								<div class="w-6 h-6 shrink-0 rounded-lg bg-slate-800 text-slate-400 text-[11px] font-mono font-bold flex items-center justify-center">
									{ fmt.Sprintf("%d", idx+1) }
								</div>
								<div class="min-w-0">
									<div class="flex items-center gap-1.5 flex-wrap">
										<span class="font-bold text-white text-xs truncate max-w-[150px]">{ b.Title }</span>
										<span class="px-1.5 py-0.2 rounded text-[9px] font-mono uppercase bg-slate-800 text-amber-400 border border-amber-500/20">
											{ b.Type }
										</span>
										if variantStr != "" {
											<span class="px-1.5 py-0.2 rounded text-[9px] font-mono text-slate-400 bg-slate-800/60">
												{ variantStr }
											</span>
										}
									</div>
									if b.Content != "" {
										<p class="text-[11px] text-slate-400 truncate mt-0.5">{ b.Content }</p>
									}
								</div>
							</div>

							<!-- Панель действий над блоком -->
							<div class="flex items-center gap-1 shrink-0">
								<!-- Редактировать (карандаш) -->
								<button
									type="button"
									@click={ fmt.Sprintf("window.openBlockEditor('%s', '%s', '%s', '%s', '%s')", b.ID, b.Title, b.Content, b.Type, variantStr) }
									class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors cursor-pointer"
									title="Редактировать текст и вариант"
								>
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
									</svg>
								</button>

								<!-- Переключить видимость -->
								<button
									type="button"
									hx-post={ fmt.Sprintf("/admin/blocks/%s/toggle", b.ID) }
									hx-target="#admin-tab-content"
									hx-swap="innerHTML"
									class={ "p-1.5 rounded-lg transition-all cursor-pointer",
										templ.KV("text-emerald-400 hover:bg-emerald-500/10", b.Active),
										templ.KV("text-slate-500 hover:bg-slate-800", !b.Active) }
									title="Включить / скрыть блок"
								>
									if b.Active {
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
										</svg>
									} else {
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
										</svg>
									}
								</button>

								<!-- Поднять выше -->
								if idx > 0 {
									<button
										type="button"
										hx-post={ fmt.Sprintf("/admin/blocks/%s/move-up", b.ID) }
										hx-target="#admin-tab-content"
										hx-swap="innerHTML"
										class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors cursor-pointer"
										title="Поднять выше"
									>
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
										</svg>
									</button>
								}

								<!-- Опустить ниже -->
								if idx < len(blocks)-1 {
									<button
										type="button"
										hx-post={ fmt.Sprintf("/admin/blocks/%s/move-down", b.ID) }
										hx-target="#admin-tab-content"
										hx-swap="innerHTML"
										class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors cursor-pointer"
										title="Опустить ниже"
									>
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
										</svg>
									</button>
								}

								<!-- Удалить -->
								<button
									type="button"
									hx-delete={ fmt.Sprintf("/admin/blocks/%s", b.ID) }
									hx-confirm="Удалить этот блок лендинга?"
									hx-target="#admin-tab-content"
									hx-swap="innerHTML"
									class="p-1.5 rounded-lg text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer"
									title="Удалить блок"
								>
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
								</button>
							</div>
						</div>
					}
				</div>

				<!-- Вкладка 2: Дизайн-система и Live Токены -->
				<div x-show="activeSubTab === 'theme'" class="space-y-4 p-4 rounded-2xl bg-slate-900/90 border border-slate-800 text-xs">
					<div>
						<label class="block font-semibold uppercase tracking-wider text-slate-400 mb-1.5 text-[11px]">
							Готовые пресеты индустрий
						</label>
						<select
							@change="sendThemeUpdate($event.target.value)"
							class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500"
						>
							<option value="main">Основная тема (Default Day)</option>
							<option value="main-night">Основная ночь (Default Night)</option>
							<option value="cyber">B2B Cyber & High-Tech</option>
							<option value="legal">B2B Legal & Consulting</option>
							<option value="medical">B2C Medical & Health</option>
							<option value="beauty">B2C Beauty & Salon</option>
							<option value="auto">B2C Auto & Service</option>
						</select>
					</div>

					<div class="pt-2 border-t border-slate-800 space-y-3">
						<div class="font-bold text-white text-xs">Интерактивная палитра (Live Bridge)</div>

						<!-- Primary Color -->
						<div class="flex items-center justify-between">
							<span class="text-slate-300">Основной цвет (Primary)</span>
							<input
								type="color"
								value="#1e293b"
								@input="sendTokenUpdate('--color-primary', $event.target.value)"
								class="w-8 h-8 rounded-lg bg-transparent cursor-pointer border border-slate-700"
							/>
						</div>

						<!-- Accent Color -->
						<div class="flex items-center justify-between">
							<span class="text-slate-300">Акцентный цвет (Accent)</span>
							<input
								type="color"
								value="#2563eb"
								@input="sendTokenUpdate('--color-accent', $event.target.value)"
								class="w-8 h-8 rounded-lg bg-transparent cursor-pointer border border-slate-700"
							/>
						</div>

						<!-- Radius Card -->
						<div>
							<div class="flex justify-between text-slate-300 mb-1">
								<span>Скругление карточек</span>
								<span class="font-mono text-amber-400">--radius-card</span>
							</div>
							<input
								type="range"
								min="4"
								max="32"
								value="24"
								@input="sendTokenUpdate('--radius-card', $event.target.value + 'px')"
								class="w-full accent-amber-500 cursor-pointer"
							/>
						</div>

						<!-- Radius Button -->
						<div>
							<div class="flex justify-between text-slate-300 mb-1">
								<span>Скругление кнопок</span>
								<span class="font-mono text-amber-400">--radius-btn</span>
							</div>
							<input
								type="range"
								min="2"
								max="24"
								value="8"
								@input="sendTokenUpdate('--radius-btn', $event.target.value + 'px')"
								class="w-full accent-amber-500 cursor-pointer"
							/>
						</div>
					</div>

					<div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300/90 text-[11px] leading-relaxed">
						⚡ Изменения ползунков и цветов передаются на холст по безопасному мосту postMessage мгновенно со скоростью 60 FPS.
					</div>
				</div>
			</div>

			<!-- Правая колонка: Интерактивный холст (8 из 12 колонок) -->
			<div class="lg:col-span-7 xl:col-span-8 flex flex-col items-center">
				<div
					:class="{
						'w-full': canvasDevice === 'desktop',
						'w-[768px] max-w-full': canvasDevice === 'tablet',
						'w-[390px] max-w-full': canvasDevice === 'mobile'
					}"
					class="transition-all duration-300 ease-out"
				>
					<!-- Рамка устройства -->
					<div
						:class="{
							'rounded-xl border border-slate-800 shadow-xl': canvasDevice === 'desktop',
							'rounded-[24px] border-4 border-slate-800 shadow-2xl': canvasDevice === 'tablet',
							'rounded-[36px] border-[6px] border-slate-800 shadow-2xl': canvasDevice === 'mobile'
						}"
						class="bg-slate-900 overflow-hidden relative"
					>
						<!-- Верхняя строка мобильного фрейма -->
						<div x-show="canvasDevice === 'mobile'" class="h-6 bg-slate-950 flex items-center justify-center">
							<div class="w-20 h-3.5 bg-slate-800 rounded-full"></div>
						</div>

						<!-- iFrame живого сайта -->
						<iframe
							id="preview-canvas"
							src="/?preview=true"
							class="w-full h-[calc(100vh-210px)] min-h-[640px] bg-surface"
							title="Предпросмотр сайта"
						></iframe>
					</div>

					<div class="mt-2 text-center text-[11px] text-slate-500">
						Живой серверный холст • Изоляция в iframe исключает конфликты стилей
					</div>
				</div>
			</div>
		</div>

		<!-- Диалог добавления нового блока -->
		<dialog id="new-block-dialog" style="margin: auto;" class="fixed inset-0 m-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white backdrop:bg-slate-950/80 max-w-lg w-full shadow-2xl z-50 h-fit">
			<form method="dialog">
				<div class="flex items-center justify-between pb-4 border-b border-slate-800">
					<h3 class="text-base font-bold">Добавить блок в конструктор</h3>
					<button class="text-slate-400 hover:text-white cursor-pointer">&times;</button>
				</div>
			</form>
			<form
				hx-post="/admin/blocks/new"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				onsubmit="document.getElementById('new-block-dialog').close(); setTimeout(() => { const f = document.getElementById('preview-canvas'); if(f) f.src = f.src; }, 350);"
				class="space-y-4 mt-4"
			>
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Тип секции</label>
					<select name="type" class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm">
						<option value="hero">Hero (Главный экран)</option>
						<option value="features">Features (Ключевые преимущества)</option>
						<option value="services">Services (Услуги и цены)</option>
						<option value="booking">Booking (Форма онлайн-заявки)</option>
						<option value="quiz">Quiz (Интерактивный калькулятор стоимости)</option>
						<option value="steps">Steps (Этапы работы)</option>
						<option value="reviews">Reviews (Отзывы клиентов)</option>
						<option value="team">Team (Команда специалистов)</option>
						<option value="faq">FAQ (Вопросы и ответы)</option>
						<option value="gallery">Gallery (Фотогалерея)</option>
						<option value="map">Map (Интерактивная карта филиалов)</option>
					</select>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Заголовок блока</label>
					<input
						type="text"
						name="title"
						required
						placeholder="Например: Наши ключевые услуги"
						class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm"
					/>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Описание / Подзаголовок</label>
					<textarea
						name="content"
						rows="3"
						placeholder="Краткое описание блока..."
						class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm"
					></textarea>
				</div>

				<div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
					<button
						type="button"
						onclick="document.getElementById('new-block-dialog').close()"
						class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-all cursor-pointer"
					>
						Отмена
					</button>
					<button
						type="submit"
						class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition-all shadow-md shadow-amber-500/20 cursor-pointer"
					>
						Создать блок
					</button>
				</div>
			</form>
		</dialog>

		<!-- Диалог быстрого редактирования блока (Безопасное редактирование свойств) -->
		<dialog id="edit-block-dialog" style="margin: auto;" class="fixed inset-0 m-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white backdrop:bg-slate-950/80 max-w-lg w-full shadow-2xl z-50 h-fit">
			<form method="dialog">
				<div class="flex items-center justify-between pb-4 border-b border-slate-800">
					<h3 class="text-base font-bold">Редактирование секции</h3>
					<button class="text-slate-400 hover:text-white cursor-pointer">&times;</button>
				</div>
			</form>
			<form
				hx-post="/admin/blocks/edit"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				onsubmit="document.getElementById('edit-block-dialog').close(); setTimeout(() => { const f = document.getElementById('preview-canvas'); if(f) f.src = f.src; }, 350);"
				class="space-y-4 mt-4"
			>
				<input type="hidden" name="id" id="edit-block-id" :value="editBlock.id"/>
				<input type="hidden" name="type" id="edit-block-type" :value="editBlock.type"/>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Заголовок секции</label>
					<input
						type="text"
						name="title"
						id="edit-block-title"
						x-model="editBlock.title"
						required
						class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					/>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Текст / Описание</label>
					<textarea
						name="content"
						id="edit-block-content"
						x-model="editBlock.content"
						rows="3"
						class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
					></textarea>
				</div>

				<div id="edit-variant-row" x-show="editBlock.type === 'hero'">
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Стилевой вариант (Variant)</label>
					<select
						name="variant"
						id="edit-block-variant"
						x-model="editBlock.variant"
						class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm cursor-pointer"
					>
						<option value="classic">Classic (Лаконичный)</option>
						<option value="split">Split (Разделенный с формой/акцентом)</option>
						<option value="cyber">Cyber (High-Tech неон)</option>
						<option value="legal">Legal (Архитектурный строгий)</option>
					</select>
				</div>

				<div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
					<button
						type="button"
						onclick="document.getElementById('edit-block-dialog').close()"
						class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-all cursor-pointer"
					>
						Отмена
					</button>
					@base.Button(base.ButtonProps{
						Variant: base.BtnAccent,
						Type:    "submit",
						Size:    base.BtnSizeSm,
						Class:   "font-bold",
					}) {
						<span>Сохранить изменения</span>
					}
				</div>
			</form>
		</dialog>

		<script>
			window.openBlockEditor = function(id, title, content, bType, variant) {
				var idInp = document.getElementById('edit-block-id');
				if (idInp) idInp.value = id;
				var typeInp = document.getElementById('edit-block-type');
				if (typeInp) typeInp.value = bType;
				var titleInp = document.getElementById('edit-block-title');
				if (titleInp) titleInp.value = title;
				var contentInp = document.getElementById('edit-block-content');
				if (contentInp) contentInp.value = content;
				var variantRow = document.getElementById('edit-variant-row');
				var variantSelect = document.getElementById('edit-block-variant');
				if (variantRow && variantSelect) {
					if (bType === 'hero') {
						variantRow.style.display = 'block';
						variantSelect.value = variant || 'classic';
					} else {
						variantRow.style.display = 'none';
					}
				}
				var dlg = document.getElementById('edit-block-dialog');
				if (dlg) {
					var root = dlg.closest('[x-data]');
					if (root && window.Alpine) {
						try {
							var d = Alpine.$data(root);
							if (d) {
								d.editBlock = { id: id, title: title, content: content, type: bType, variant: variant || 'classic' };
							}
						} catch (e) {}
					}
					dlg.showModal();
				}
			};
		</script>
	</div>
}
