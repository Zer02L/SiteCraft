package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ AdminBlocksTab(blocks []models.PageBlock) {
	<div class="space-y-6">
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-800">
			<div>
				<h2 class="text-xl font-bold text-white">Страницы и Конструктор блоков</h2>
				<p class="text-xs text-slate-400 mt-1">Визуальное управление структурой, порядком и активацией блоков лендинга</p>
			</div>
			<button
				type="button"
				onclick="document.getElementById('new-block-dialog').showModal()"
				class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs transition-all shadow-md shadow-amber-500/20 flex items-center gap-2 cursor-pointer"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
				</svg>
				<span>Добавить блок</span>
			</button>
		</div>

		<!-- Список блоков -->
		<div class="space-y-3" id="blocks-list">
			if len(blocks) == 0 {
				<div class="p-8 text-center bg-slate-900/40 rounded-2xl border border-slate-800/80">
					<p class="text-slate-400 text-sm">Блоки страницы не настроены. Добавьте первый блок.</p>
				</div>
			}
			for idx, b := range blocks {
				<div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-between gap-4 hover:border-slate-700 transition-colors">
					<div class="flex items-center gap-4">
						<div class="flex flex-col items-center justify-center w-8 h-8 rounded-lg bg-slate-800 text-slate-400 text-xs font-mono font-bold">
							{ fmt.Sprintf("%d", idx+1) }
						</div>
						<div>
							<div class="flex items-center gap-2">
								<span class="font-bold text-white text-sm">{ b.Title }</span>
								<span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-slate-800 text-amber-400 border border-amber-500/20">
									{ b.Type }
								</span>
							</div>
							if b.Content != "" {
								<p class="text-xs text-slate-400 line-clamp-1 mt-0.5">{ b.Content }</p>
							}
						</div>
					</div>

					<div class="flex items-center gap-2">
						<!-- Toggle Active -->
						<button
							type="button"
							hx-post={ fmt.Sprintf("/admin/blocks/%s/toggle", b.ID) }
							hx-target="#admin-tab-content"
							hx-swap="innerHTML"
							class={ "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer",
								templ.KV("bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20", b.Active),
								templ.KV("bg-slate-800 text-slate-400 border border-slate-700 hover:bg-slate-700", !b.Active) }
						>
							if b.Active {
								<span>Активен</span>
							} else {
								<span>Скрыт</span>
							}
						</button>

						<!-- Reorder Up -->
						if idx > 0 {
							<button
								type="button"
								hx-post={ fmt.Sprintf("/admin/blocks/%s/move-up", b.ID) }
								hx-target="#admin-tab-content"
								hx-swap="innerHTML"
								class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-colors"
								title="Поднять выше"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
								</svg>
							</button>
						}

						<!-- Reorder Down -->
						if idx < len(blocks)-1 {
							<button
								type="button"
								hx-post={ fmt.Sprintf("/admin/blocks/%s/move-down", b.ID) }
								hx-target="#admin-tab-content"
								hx-swap="innerHTML"
								class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-colors"
								title="Опустить ниже"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</button>
						}

						<!-- Delete Block -->
						<button
							type="button"
							hx-delete={ fmt.Sprintf("/admin/blocks/%s", b.ID) }
							hx-confirm="Удалить этот блок?"
							hx-target="#admin-tab-content"
							hx-swap="innerHTML"
							class="p-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 transition-colors cursor-pointer"
							title="Удалить блок"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
							</svg>
						</button>
					</div>
				</div>
			}
		</div>

		<!-- Модальное окно добавления блока -->
		<dialog id="new-block-dialog" class="bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white backdrop:bg-slate-950/80 max-w-lg w-full">
			<form method="dialog">
				<div class="flex items-center justify-between pb-4 border-b border-slate-800">
					<h3 class="text-base font-bold">Добавить блок в конструктор</h3>
					<button class="text-slate-400 hover:text-white">&times;</button>
				</div>
			</form>
			<form
				hx-post="/admin/blocks/new"
				hx-target="#admin-tab-content"
				hx-swap="innerHTML"
				onsubmit="document.getElementById('new-block-dialog').close()"
				class="space-y-4 mt-4"
			>
				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Тип секции</label>
					<select name="type" class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm">
						<option value="hero">Hero (Главный экран)</option>
						<option value="bento">Bento Grid (Сетка преимуществ)</option>
						<option value="features">Features (Ключевые возможности)</option>
						<option value="services">Services (Прайс-лист / Услуги)</option>
						<option value="schedule">Schedule (График работы и контакты)</option>
						<option value="booking">Booking (Онлайн-запись и форма лидов)</option>
						<option value="faq">FAQ (Частые вопросы)</option>
						<option value="steps">Steps (Этапы работы)</option>
						<option value="reviews">Reviews (Проверенные отзывы)</option>
						<option value="team">Team (Команда специалистов)</option>
						<option value="gallery">Gallery (Фотогалерея)</option>
						<option value="map">Map (Интерактивная карта)</option>
						<option value="rich_text">Rich Text (Текстовая статья / О нас)</option>
					</select>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Заголовок блока</label>
					<input type="text" name="title" required placeholder="Например: Наши ключевые преимущества" class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm"/>
				</div>

				<div>
					<label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Описание / Контент</label>
					<textarea name="content" rows="3" placeholder="Краткое описание или вводный текст секции..." class="w-full px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm"></textarea>
				</div>

				<div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
					<button
						type="button"
						onclick="document.getElementById('new-block-dialog').close()"
						class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-all cursor-pointer"
					>
						Отмена
					</button>
					<button
						type="submit"
						class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition-all shadow-md shadow-amber-500/20 cursor-pointer"
					>
						Создать блок
					</button>
				</div>
			</form>
		</dialog>
	</div>
}
