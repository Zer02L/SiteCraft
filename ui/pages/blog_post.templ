package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components"
	"sitecraft/ui/components/base"
	"sitecraft/ui/layouts"

	icons "sitecraft/ui/components/icons"
)

templ BlogPost(settings models.SiteSettings, content models.SiteContent, article models.ArticleItem, relatedArticles []models.ArticleItem) {
	@layouts.Base(article.Title+" — "+content.HeroTitle, article.Excerpt, settings, models.NewArticleSEO(settings, content, article, "")) {
		if settings.EnableA11y {
			@components.A11yBar()
		}
		@components.Header(content, settings)

		<main class="flex-grow bg-surface py-12 px-4 sm:px-6 lg:px-8">
			<article class="max-w-4xl mx-auto">
				<!-- Хлебные крошки -->
				<nav class="flex items-center text-xs text-content-muted mb-6 space-x-2">
					<a href="/" class="hover:text-primary transition font-medium">Главная</a>
					<span>/</span>
					<a href="/blog" class="hover:text-primary transition font-medium">Блог</a>
					<span>/</span>
					<span class="text-content font-semibold truncate max-w-xs sm:max-w-md">{ article.Title }</span>
				</nav>

				<!-- Заголовок статьи -->
				<header class="mb-8">
					<div class="flex flex-wrap items-center gap-3 text-xs text-content-muted mb-3">
						<span class="flex items-center gap-1.5 font-medium">
							<span class="text-primary flex items-center">
								@icons.Calendar(templ.Attributes{"class": "w-4 h-4"})
							</span>
							{ article.PublishedAt }
						</span>
						if article.AuthorName != "" {
							<span>•</span>
							<span class="font-medium text-content/80">Автор: { article.AuthorName }</span>
						}
						<span>•</span>
						<span class="flex items-center gap-1">
							@icons.Eye(templ.Attributes{"class": "w-4 h-4 text-content-muted"})
							{ fmt.Sprintf("%d просмотров", article.ViewsCount) }
						</span>
					</div>

					<h1 class="text-2xl sm:text-4xl font-serif-title font-bold text-content leading-tight">
						{ article.Title }
					</h1>

					if len(article.Tags) > 0 {
						<div class="flex flex-wrap gap-2 mt-4">
							for _, tag := range article.Tags {
								<span class="px-2.5 py-1 bg-surface-muted text-content/80 rounded-lg text-xs font-medium">
									#{ tag }
								</span>
							}
						</div>
					}
				</header>

				<!-- Обложка -->
				if article.CoverImage != "" {
					<div class="aspect-video w-full rounded-2xl overflow-hidden mb-8 shadow-sm bg-surface-muted">
						<img src={ article.CoverImage } alt={ article.Title } class="w-full h-full object-cover"/>
					</div>
				}

				<!-- Содержимое статьи -->
				<div class="bg-surface rounded-2xl p-6 sm:p-10 border border-content/10 shadow-sm">
					<div class="article-content max-w-none text-content text-base leading-relaxed space-y-4">
						@templ.Raw(article.Content)
					</div>

					<!-- Баннер консультации / записи внутри статьи (CTA) -->
					<div class="mt-12 p-6 sm:p-8 bg-surface rounded-xl border border-primary/20 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
						<div class="text-left">
							<h3 class="text-lg font-bold text-content font-serif-title">Нужна помощь или консультация?</h3>
							<p class="text-xs sm:text-sm text-content-muted mt-1 max-w-md">
								Запишитесь на прием онлайн без очередей в удобное для вас время.
							</p>
						</div>
						@base.Button(base.ButtonProps{
							Variant: base.BtnPrimary,
							Size:    base.BtnSizeLg,
							Href:    "/#booking",
							Class:   "rounded-xl font-bold whitespace-nowrap shadow-md hover:shadow-lg hover:scale-[1.02]",
						}) {
							Записаться на прием
						}
					</div>
				</div>

				<!-- Похожие статьи -->
				if len(relatedArticles) > 0 {
					<div class="mt-12">
						<h3 class="text-xl font-bold font-serif-title text-content mb-6">Читайте также</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							for _, rel := range relatedArticles {
								if rel.ID != article.ID {
									@BlogCard(rel)
								}
							}
						</div>
					</div>
				}

				<!-- Кнопка возврата -->
				<div class="mt-8 text-center">
					<a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline group">
						<span class="group-hover:-translate-x-1 transition-transform flex items-center">
							@icons.ArrowLeft(templ.Attributes{"class": "w-4 h-4"})
						</span>
						<span>Вернуться ко всем статьям</span>
					</a>
				</div>
			</article>
		</main>

		@components.Footer(content, settings)
	}
}
