package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components"
	"sitecraft/ui/layouts"
)

templ BlogList(settings models.SiteSettings, content models.SiteContent, articles []models.ArticleItem, searchQuery string) {
	@layouts.Base("Блог и полезные статьи — "+content.HeroTitle, "Экспертные материалы, советы и ответы на частые вопросы от "+content.HeroTitle, settings) {
		if settings.EnableA11y {
			@components.A11yBar()
		}
		@components.Header(content, settings)

		<main class="flex-grow bg-surface py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-5xl mx-auto">
				<!-- Хлебные крошки -->
				<nav class="flex items-center text-xs text-content-muted mb-6 space-x-2">
					<a href="/" class="hover:text-primary transition font-medium">Главная</a>
					<span>/</span>
					<span class="text-content font-semibold">Блог и публикации</span>
				</nav>

				<!-- Заголовок страницы -->
				<div class="text-center max-w-2xl mx-auto mb-10">
					<span class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full mb-3 uppercase tracking-wider">
						Экспертные материалы
					</span>
					<h1 class="text-3xl sm:text-4xl font-serif-title font-bold text-content leading-tight">
						База знаний и статьи
					</h1>
					<p class="mt-3 text-content-muted text-sm sm:text-base">
						Актуальная правовая информация, практические рекомендации и разбор частых вопросов от специалистов.
					</p>

					<!-- Интерактивный поиск через HTMX -->
					<div class="mt-6 relative max-w-md mx-auto">
						<input
							type="search"
							name="q"
							value={ searchQuery }
							placeholder="Поиск по статьям..."
							hx-get="/blog"
							hx-trigger="keyup changed delay:300ms, search"
							hx-target="#blog-posts-container"
							hx-select="#blog-posts-container"
							hx-push-url="true"
							class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-content/20 bg-surface text-content text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent shadow-sm transition"
						/>
						<svg class="w-5 h-5 text-content-muted absolute left-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
				</div>

				<!-- Сетка статей (фрагмент для HTMX обновления) -->
				<div id="blog-posts-container">
					if len(articles) > 0 {
						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							for _, a := range articles {
								@BlogCard(a)
							}
						</div>
					} else {
						<div class="bg-surface rounded-2xl p-12 text-center border border-content/10 shadow-sm max-w-lg mx-auto">
							<div class="w-12 h-12 mx-auto bg-surface-muted rounded-full flex items-center justify-center text-content-muted mb-4">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
								</svg>
							</div>
							<h3 class="text-base font-bold text-content">Статей не найдено</h3>
							<p class="text-xs text-content-muted mt-1">Попробуйте изменить поисковый запрос или сбросить фильтр.</p>
							if searchQuery != "" {
								<a href="/blog" class="inline-block mt-4 text-xs font-semibold text-primary hover:underline">Показать все статьи</a>
							}
						</div>
					}
				</div>
			</div>
		</main>

		@components.Footer(content)
	}
}

templ BlogCard(a models.ArticleItem) {
	<article class="bg-surface rounded-2xl overflow-hidden border border-content/10 shadow-sm hover:shadow-md transition flex flex-col group">
		if a.CoverImage != "" {
			<a href={ templ.URL("/blog/" + a.Slug) } class="block aspect-video w-full overflow-hidden bg-surface-muted">
				<img src={ a.CoverImage } alt={ a.Title } class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy"/>
			</a>
		}
		<div class="p-6 flex-grow flex flex-col">
			<!-- Мета-информация -->
			<div class="flex items-center justify-between text-xs text-content-muted mb-3">
				<span class="flex items-center gap-1.5">
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					{ a.PublishedAt }
				</span>
				if a.ViewsCount > 0 {
					<span class="flex items-center gap-1">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
						{ fmt.Sprintf("%d", a.ViewsCount) }
					</span>
				}
			</div>

			<!-- Теги -->
			if len(a.Tags) > 0 {
				<div class="flex flex-wrap gap-1.5 mb-2.5">
					for _, tag := range a.Tags {
						<span class="px-2 py-0.5 bg-surface-muted text-content-muted rounded text-[11px] font-medium">
							#{ tag }
						</span>
					}
				</div>
			}

			<!-- Заголовок -->
			<h2 class="text-lg font-serif-title font-bold text-content group-hover:text-primary transition leading-snug">
				<a href={ templ.URL("/blog/" + a.Slug) }>
					{ a.Title }
				</a>
			</h2>

			<!-- Анонс -->
			<p class="mt-2.5 text-content-muted text-xs sm:text-sm line-clamp-3 leading-relaxed flex-grow">
				{ a.Excerpt }
			</p>

			<!-- Подвал карточки -->
			<div class="mt-5 pt-4 border-t border-content/10 flex items-center justify-between text-xs">
				if a.AuthorName != "" {
					<span class="text-content-muted font-medium">Автор: { a.AuthorName }</span>
				} else {
					<span></span>
				}
				<a href={ templ.URL("/blog/" + a.Slug) } class="text-primary font-bold hover:underline flex items-center gap-1">
					Читать статью
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
				</a>
			</div>
		</div>
	</article>
}
