package pages

import (
	"fmt"
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"
	"sitecraft/ui/components"
	"sitecraft/ui/layouts"

	"github.com/axadrn/shadcn-templ/v2/components/badge"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ BlogList(settings models.SiteSettings, content models.SiteContent, articles []models.ArticleItem, searchQuery string) {
	@layouts.Base(i18n.T(ctx, "blog.title")+" — "+content.HeroTitle, i18n.T(ctx, "blog.subtitle"), settings) {
		if settings.EnableA11y {
			@components.A11yBar()
		}
		@components.Header(content, settings)

		<main class="flex-grow bg-surface py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-5xl mx-auto">
				<!-- Хлебные крошки -->
				<nav class="flex items-center text-xs text-content-muted mb-6 space-x-2">
					<a href="/" class="hover:text-primary transition font-medium">{ i18n.T(ctx, "nav.home") }</a>
					<span>/</span>
					<span class="text-content font-semibold">{ i18n.T(ctx, "blog.title") }</span>
				</nav>

				<!-- Заголовок страницы -->
				<div class="text-center max-w-2xl mx-auto mb-10">
					<div class="inline-flex justify-center mb-3">
						@badge.Badge(badge.Props{
							Variant: badge.VariantSecondary,
							Class:   "text-xs font-bold uppercase tracking-wider py-1 px-3 text-primary bg-primary/10",
						}) {
							{ i18n.T(ctx, "blog.badge") }
						}
					</div>
					<h1 class="text-3xl sm:text-4xl font-serif-title font-bold text-content leading-tight">
						{ i18n.T(ctx, "blog.title") }
					</h1>
					<p class="mt-3 text-content-muted text-sm sm:text-base">
						{ i18n.T(ctx, "blog.subtitle") }
					</p>

					<!-- Интерактивный поиск через HTMX -->
					<div class="mt-6 relative max-w-md mx-auto">
						<input
							type="search"
							name="q"
							value={ searchQuery }
							placeholder={ i18n.T(ctx, "blog.search_placeholder") }
							hx-get="/blog"
							hx-trigger="keyup changed delay:300ms, search"
							hx-target="#blog-posts-container"
							hx-select="#blog-posts-container"
							hx-push-url="true"
							class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-content/20 bg-surface text-content text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent shadow-sm transition"
						/>
						<span class="w-5 h-5 text-content-muted absolute left-3 top-3 pointer-events-none flex items-center justify-center">
							@icons.Search(templ.Attributes{"class": "w-4 h-4"})
						</span>
					</div>
				</div>

				<!-- Сетка статей (фрагмент для HTMX обновления) -->
				<div id="blog-posts-container">
					if len(articles) > 0 {
						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							for _, a := range articles {
								@BlogCard(a)
							}
						</div>
					} else {
						<div class="bg-surface rounded-2xl p-12 text-center border border-content/10 shadow-sm max-w-lg mx-auto">
							<div class="w-12 h-12 mx-auto bg-surface-muted rounded-full flex items-center justify-center text-content-muted mb-4">
								@icons.FileText(templ.Attributes{"class": "w-6 h-6"})
							</div>
							<h3 class="text-base font-bold text-content">Статей не найдено</h3>
							<p class="text-xs text-content-muted mt-1">Попробуйте изменить поисковый запрос или сбросить фильтр.</p>
							if searchQuery != "" {
								<a href="/blog" class="inline-block mt-4 text-xs font-semibold text-primary hover:underline">Показать все статьи</a>
							}
						</div>
					}
				</div>
			</div>
		</main>

		@components.Footer(content, settings)
	}
}

templ BlogCard(a models.ArticleItem) {
	<article class="bg-surface rounded-2xl overflow-hidden border border-content/10 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200 flex flex-col group">
		if a.CoverImage != "" {
			<a href={ templ.URL("/blog/" + a.Slug) } class="block aspect-video w-full overflow-hidden bg-surface-muted">
				<img src={ a.CoverImage } alt={ a.Title } class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy"/>
			</a>
		}
		<div class="p-6 flex-grow flex flex-col">
			<!-- Мета-информация -->
			<div class="flex items-center justify-between text-xs text-content-muted mb-3">
				<span class="flex items-center gap-1.5">
					@icons.Calendar(templ.Attributes{"class": "w-3.5 h-3.5"})
					{ a.PublishedAt }
				</span>
				if a.ViewsCount > 0 {
					<span class="flex items-center gap-1">
						@icons.Eye(templ.Attributes{"class": "w-3.5 h-3.5"})
						{ fmt.Sprintf("%d", a.ViewsCount) }
					</span>
				}
			</div>

			<!-- Теги -->
			if len(a.Tags) > 0 {
				<div class="flex flex-wrap gap-1.5 mb-2.5">
					for _, tag := range a.Tags {
						<span class="px-2 py-0.5 bg-surface-muted text-content-muted rounded text-[11px] font-medium">
							#{ tag }
						</span>
					}
				</div>
			}

			<!-- Заголовок -->
			<h2 class="text-lg font-serif-title font-bold text-content group-hover:text-primary transition leading-snug">
				<a href={ templ.URL("/blog/" + a.Slug) }>
					{ a.Title }
				</a>
			</h2>

			<!-- Анонс -->
			<p class="mt-2.5 text-content-muted text-xs sm:text-sm line-clamp-3 leading-relaxed flex-grow">
				{ a.Excerpt }
			</p>

			<!-- Подвал карточки -->
			<div class="mt-5 pt-4 border-t border-content/10 flex items-center justify-between text-xs">
				if a.AuthorName != "" {
					<span class="text-content-muted font-medium">Автор: { a.AuthorName }</span>
				} else {
					<span></span>
				}
				<a href={ templ.URL("/blog/" + a.Slug) } class="text-primary font-bold hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
					<span>{ i18n.T(ctx, "blog.read_more") }</span>
					@icons.ArrowRight(templ.Attributes{"class": "w-3.5 h-3.5"})
				</a>
			</div>
		</div>
	</article>
}
