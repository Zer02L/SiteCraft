package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientLeadsTab(leads []models.Lead) {
	{{
		newCount, inProgressCount := countLeadsByStatus(leads)
		doneCount := 0
		for _, l := range leads {
			if l.Status == "выполнена" || l.Status == "обработана" {
				doneCount++
			}
		}
	}}
	<div
		x-data="{
			search: '',
			filterStatus: 'all',
			activeLeadID: null,
			copiedPhone: null,
			copyText(text, id) {
				navigator.clipboard.writeText(text);
				this.copiedPhone = id;
				setTimeout(() => { if (this.copiedPhone === id) this.copiedPhone = null; }, 2000);
			},
			matchesLead(name, phone, comment, status) {
				const s = this.search.toLowerCase().trim();
				const matchesSearch = !s ||
					name.toLowerCase().includes(s) ||
					phone.toLowerCase().includes(s) ||
					comment.toLowerCase().includes(s);
				const normalizedStatus = (status === '' || status === 'новая') ? 'новая' : status;
				const matchesStatus = this.filterStatus === 'all' ||
					(this.filterStatus === normalizedStatus);
				return matchesSearch && matchesStatus;
			}
		}"
		class="space-y-6"
	>
		<!-- 1. Верхняя панель заголовка и действий -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-3 flex-wrap">
					<h2 class="text-xl font-bold text-admin-content tracking-tight">Входящие заявки</h2>
					if newCount > 0 {
						<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-admin-accent-muted text-admin-accent border border-admin-accent-border">
							<span class="w-1.5 h-1.5 rounded-full bg-admin-accent animate-pulse"></span>
							<span>Новых: { fmt.Sprintf("%d", newCount) }</span>
						</span>
					}
					if inProgressCount > 0 {
						<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-admin-warning-muted text-admin-warning border border-admin-warning/25">
							<span class="w-1.5 h-1.5 rounded-full bg-admin-warning"></span>
							<span>В обработке: { fmt.Sprintf("%d", inProgressCount) }</span>
						</span>
					}
				</div>
				<p class="text-xs text-admin-content-muted mt-1">Клиентские обращения с форм захвата, онлайн-записи и витрины услуг</p>
			</div>
			<div class="flex items-center gap-2.5 flex-wrap">
				<button
					type="button"
					hx-get="/client/tab/leads"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-3 py-2 rounded-xl bg-admin-surface hover:bg-admin-surface-muted text-xs font-medium text-admin-content transition-colors flex items-center gap-1.5 border border-admin-border shadow-2xs cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
					title="Обновить таблицу"
				>
					<svg class="w-3.5 h-3.5 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
					<span>Обновить</span>
				</button>
				<a
					href="/client/export/leads.csv"
					class="px-3.5 py-2 rounded-xl bg-admin-accent hover:bg-admin-accent-hover text-xs font-semibold text-white transition-colors flex items-center gap-2 shadow-2xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				>
					<svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
					</svg>
					<span>Экспорт CSV</span>
				</a>
			</div>
		</div>

		<!-- 2. Сводные метрики (KPI карточки Workbench) -->
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
			<div class="bg-admin-surface border border-admin-border rounded-2xl p-4 shadow-2xs">
				<div class="text-[10px] font-mono uppercase tracking-wider text-admin-content-muted">Всего заявок</div>
				<div class="text-2xl lg:text-3xl font-mono font-semibold text-admin-content mt-1.5">{ fmt.Sprintf("%d", len(leads)) }</div>
				<div class="text-[11px] text-admin-content-subtle mt-1">за все время</div>
			</div>
			<div class="bg-admin-surface border border-admin-border rounded-2xl p-4 shadow-2xs">
				<div class="flex items-center justify-between">
					<span class="text-[10px] font-mono uppercase tracking-wider text-admin-accent">Новые</span>
					if newCount > 0 {
						<span class="w-2 h-2 rounded-full bg-admin-accent animate-ping"></span>
					}
				</div>
				<div class="text-2xl lg:text-3xl font-mono font-semibold text-admin-accent mt-1.5">{ fmt.Sprintf("%d", newCount) }</div>
				<div class="text-[11px] text-admin-content-subtle mt-1">требуют ответа</div>
			</div>
			<div class="bg-admin-surface border border-admin-border rounded-2xl p-4 shadow-2xs">
				<div class="text-[10px] font-mono uppercase tracking-wider text-admin-warning">В обработке</div>
				<div class="text-2xl lg:text-3xl font-mono font-semibold text-admin-warning mt-1.5">{ fmt.Sprintf("%d", inProgressCount) }</div>
				<div class="text-[11px] text-admin-content-subtle mt-1">в работе у менеджера</div>
			</div>
			<div class="bg-admin-surface border border-admin-border rounded-2xl p-4 shadow-2xs">
				<div class="text-[10px] font-mono uppercase tracking-wider text-admin-success">Выполнено</div>
				<div class="text-2xl lg:text-3xl font-mono font-semibold text-admin-success mt-1.5">{ fmt.Sprintf("%d", doneCount) }</div>
				<div class="text-[11px] text-admin-content-subtle mt-1">успешно закрыты</div>
			</div>
		</div>

		if len(leads) == 0 {
			<div class="bg-admin-surface border border-admin-border rounded-2xl p-12 text-center shadow-xs">
				<div class="w-12 h-12 rounded-2xl bg-admin-surface-muted flex items-center justify-center mx-auto mb-4 text-admin-content-muted">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
					</svg>
				</div>
				<h3 class="text-base font-semibold text-admin-content mb-1">Заявок пока нет</h3>
				<p class="text-xs text-admin-content-muted max-w-sm mx-auto">Новые заявки с форм на сайте будут мгновенно отображаться здесь в реальном времени.</p>
			</div>
		} else {
			<!-- 3. Панель быстрого поиска и фильтров по статусам -->
			<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-admin-surface border border-admin-border rounded-2xl p-2.5 shadow-2xs">
				<div class="relative flex-1 max-w-md">
					<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-admin-content-muted">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
					<input
						type="text"
						x-model="search"
						placeholder="Поиск по имени, номеру телефона, деталям..."
						class="w-full bg-admin-surface-muted border border-admin-border text-xs text-admin-content placeholder:text-admin-content-subtle rounded-xl pl-9 pr-8 py-2 focus:outline-none focus:ring-1 focus:ring-admin-border-focus focus:border-admin-border-focus transition-colors"
					/>
					<button
						type="button"
						x-show="search.length > 0"
						@click="search = ''"
						class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-admin-content-muted hover:text-admin-content"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<!-- Табы статусов -->
				<div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 text-xs">
					<button
						type="button"
						@click="filterStatus = 'all'"
						:class="filterStatus === 'all' ? 'bg-admin-surface-active text-admin-content font-semibold border-admin-border shadow-2xs' : 'bg-admin-surface text-admin-content-muted hover:text-admin-content border-admin-border/50'"
						class="px-2.5 py-1.5 rounded-xl border transition-colors cursor-pointer whitespace-nowrap font-mono text-[11px]"
					>
						Все ({ fmt.Sprintf("%d", len(leads)) })
					</button>
					<button
						type="button"
						@click="filterStatus = 'новая'"
						:class="filterStatus === 'новая' ? 'bg-admin-accent-muted text-admin-accent font-semibold border-admin-accent-border shadow-2xs' : 'bg-admin-surface text-admin-content-muted hover:text-admin-content border-admin-border/50'"
						class="px-2.5 py-1.5 rounded-xl border transition-colors cursor-pointer whitespace-nowrap font-mono text-[11px]"
					>
						Новые ({ fmt.Sprintf("%d", newCount) })
					</button>
					<button
						type="button"
						@click="filterStatus = 'в обработке'"
						:class="filterStatus === 'в обработке' ? 'bg-admin-warning-muted text-admin-warning font-semibold border-admin-warning/30 shadow-2xs' : 'bg-admin-surface text-admin-content-muted hover:text-admin-content border-admin-border/50'"
						class="px-2.5 py-1.5 rounded-xl border transition-colors cursor-pointer whitespace-nowrap font-mono text-[11px]"
					>
						В обработке ({ fmt.Sprintf("%d", inProgressCount) })
					</button>
					<button
						type="button"
						@click="filterStatus = 'выполнена'"
						:class="filterStatus === 'выполнена' ? 'bg-admin-success-muted text-admin-success font-semibold border-admin-success/30 shadow-2xs' : 'bg-admin-surface text-admin-content-muted hover:text-admin-content border-admin-border/50'"
						class="px-2.5 py-1.5 rounded-xl border transition-colors cursor-pointer whitespace-nowrap font-mono text-[11px]"
					>
						Выполнены ({ fmt.Sprintf("%d", doneCount) })
					</button>
				</div>
			</div>

			<!-- 4. Таблица заявок -->
			<div class="bg-admin-surface border border-admin-border rounded-2xl overflow-hidden shadow-2xs">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs sm:text-sm">
						<thead class="bg-admin-surface-muted/50 border-b border-admin-border text-admin-content-muted text-[10px] font-mono uppercase tracking-wider">
							<tr>
								<th class="py-3 px-4 font-semibold">Клиент</th>
								<th class="py-3 px-4 font-semibold">Контакты</th>
								<th class="py-3 px-4 font-semibold">Дата и время</th>
								<th class="py-3 px-4 font-semibold">Детали обращения</th>
								<th class="py-3 px-4 font-semibold">Статус</th>
								<th class="py-3 px-4 font-semibold text-right">Действия</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-admin-border text-admin-content">
							for _, lead := range leads {
								@LeadRowSingle(lead)
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- 5. Выдвижные шторки (Detail Drawers) для детального просмотра заявок -->
			for _, lead := range leads {
				@LeadDetailDrawer(lead)
			}
		}
	</div>
}

templ LeadStatusBadge(status string) {
	if status == "новая" || status == "" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-medium bg-admin-accent-muted text-admin-accent border border-admin-accent-border">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-accent"></span>
			<span>Новая</span>
		</span>
	} else if status == "в обработке" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning/25">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-warning"></span>
			<span>В обработке</span>
		</span>
	} else if status == "выполнена" || status == "обработана" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-medium bg-admin-success-muted text-admin-success border border-admin-success/25">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-success"></span>
			<span>Выполнена</span>
		</span>
	} else if status == "отменена" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-content-muted"></span>
			<span>Отменена</span>
		</span>
	} else {
		<span class="inline-flex items-center px-2 py-0.5 rounded-lg text-xs font-medium bg-admin-surface-muted text-admin-content-muted">
			{ status }
		</span>
	}
}

templ LeadRowSingle(lead models.Lead) {
	{{
		comment := ""
		if lead.Payload != nil {
			if c, ok := lead.Payload["comment"].(string); ok {
				comment = c
			}
		}
	}}
	<tr
		id={ "lead-row-" + lead.ID }
		x-show={ fmt.Sprintf("matchesLead('%s', '%s', '%s', '%s')", lead.Name, lead.Phone, comment, lead.Status) }
		class="hover:bg-admin-surface-muted/50 transition-colors group"
	>
		<!-- Клиент -->
		<td class="py-3.5 px-4 whitespace-nowrap">
			<div class="flex items-center gap-3">
				<div class="w-8 h-8 rounded-lg bg-admin-surface-muted text-admin-content-muted font-mono font-semibold flex items-center justify-center text-xs shrink-0 border border-admin-border">
					{ getInitials(lead.Name) }
				</div>
				<div>
					<button
						type="button"
						@click={ fmt.Sprintf("activeLeadID = '%s'", lead.ID) }
						class="font-semibold text-admin-content hover:text-admin-accent transition-colors text-left cursor-pointer"
					>
						{ lead.Name }
					</button>
					if lead.Email != "" {
						<div class="text-[11px] text-admin-content-muted font-normal">
							{ lead.Email }
						</div>
					}
				</div>
			</div>
		</td>

		<!-- Контакты с быстрым копированием и WhatsApp -->
		<td class="py-3.5 px-4 whitespace-nowrap">
			<div class="flex items-center gap-2">
				<a
					href={ templ.SafeURL("tel:" + lead.Phone) }
					class="text-admin-content hover:text-admin-accent font-mono text-xs font-medium transition-colors"
					title="Позвонить клиенту"
				>
					{ formatPhoneMask(lead.Phone) }
				</a>
				<div class="flex items-center gap-1 opacity-70 group-hover:opacity-100 transition-opacity">
					<button
						type="button"
						@click.stop={ fmt.Sprintf("copyText('%s', '%s')", lead.Phone, lead.ID) }
						class="p-1 rounded-md text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted transition-colors cursor-pointer"
						title="Скопировать телефон"
					>
						<template x-if={ fmt.Sprintf("copiedPhone === '%s'", lead.ID) }>
							<svg class="w-3.5 h-3.5 text-admin-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
							</svg>
						</template>
						<template x-if={ fmt.Sprintf("copiedPhone !== '%s'", lead.ID) }>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
							</svg>
						</template>
					</button>

					if formatWhatsAppPhone(lead.Phone) != "" {
						<a
							href={ templ.SafeURL("https://wa.me/" + formatWhatsAppPhone(lead.Phone)) }
							target="_blank"
							rel="noopener noreferrer"
							class="p-1 rounded-md text-admin-content-muted hover:text-admin-success hover:bg-admin-surface-muted transition-colors"
							title="Написать в WhatsApp"
						>
							<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
							</svg>
						</a>
					}
				</div>
			</div>
		</td>

		<!-- Дата и время -->
		<td class="py-3.5 px-4 whitespace-nowrap text-admin-content-muted">
			if lead.BookingDate != "" {
				<div class="flex items-center gap-1.5 text-admin-content font-medium">
					<svg class="w-3.5 h-3.5 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					<span>{ lead.BookingDate }</span>
				</div>
				if lead.BookingTime != "" {
					<div class="text-[11px] text-admin-content-subtle font-mono mt-0.5 ml-5">{ lead.BookingTime }</div>
				}
			} else if lead.Created != "" {
				<div class="text-xs text-admin-content-muted font-mono">{ lead.Created }</div>
			} else {
				<span class="text-admin-content-muted text-xs">—</span>
			}
		</td>

		<!-- Детали обращения -->
		<td class="py-3.5 px-4">
			@LeadDetailsCell(lead)
		</td>

		<!-- Статус заявки -->
		<td class="py-3.5 px-4 whitespace-nowrap">
			<div class="relative inline-block">
				<select
					name="status"
					hx-post={ "/client/leads/" + lead.ID + "/status" }
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class={ "px-3 py-1.5 rounded-xl text-xs font-medium border appearance-none pr-7 cursor-pointer focus:outline-none transition-colors",
						templ.KV("bg-admin-accent-muted text-admin-accent border-admin-accent-border hover:border-admin-accent", lead.Status == "новая" || lead.Status == ""),
						templ.KV("bg-admin-warning-muted text-admin-warning border-admin-warning/25 hover:border-admin-warning/50", lead.Status == "в обработке"),
						templ.KV("bg-admin-success-muted text-admin-success border-admin-success/25 hover:border-admin-success/50", lead.Status == "выполнена" || lead.Status == "обработана"),
						templ.KV("bg-admin-surface-muted text-admin-content-muted border-admin-border hover:border-admin-border-focus", lead.Status == "отменена") }
				>
					<option value="новая" selected?={ lead.Status == "новая" || lead.Status == "" } class="bg-admin-surface text-admin-content">Новая</option>
					<option value="в обработке" selected?={ lead.Status == "в обработке" } class="bg-admin-surface text-admin-content">В обработке</option>
					<option value="выполнена" selected?={ lead.Status == "выполнена" || lead.Status == "обработана" } class="bg-admin-surface text-admin-content">Выполнена</option>
					<option value="отменена" selected?={ lead.Status == "отменена" } class="bg-admin-surface text-admin-content">Отменена</option>
				</select>
				<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2 text-admin-content-muted">
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</div>
			</div>
		</td>

		<!-- Действия -->
		<td class="py-3.5 px-4 text-right whitespace-nowrap">
			<button
				type="button"
				@click={ fmt.Sprintf("activeLeadID = '%s'", lead.ID) }
				class="px-2.5 py-1.5 rounded-xl bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content border border-admin-border text-xs font-medium transition-colors inline-flex items-center gap-1.5 cursor-pointer shadow-2xs"
				title="Открыть карточку заявки"
			>
				<svg class="w-3.5 h-3.5 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
				</svg>
				<span>Подробнее</span>
			</button>
		</td>
	</tr>
}

templ LeadDetailsCell(lead models.Lead) {
	{{
		hasDetails := false
		if lead.Source != "" {
			hasDetails = true
		}
		if lead.Payload != nil {
			if _, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
				hasDetails = true
			}
			if c, ok := lead.Payload["comment"].(string); ok && c != "" {
				hasDetails = true
			}
		}
	}}
	if !hasDetails {
		<span class="text-admin-content-muted text-xs italic">Без комментария</span>
	} else {
		<div class="flex flex-col gap-1 max-w-xs">
			<div class="flex items-center gap-1.5 flex-wrap">
				if lead.Source != "" {
					<span class="inline-block px-1.5 py-0.5 rounded bg-admin-surface-muted text-admin-content-muted text-[10px] font-mono border border-admin-border">
						{ lead.Source }
					</span>
				}
				if lead.Payload != nil {
					if utmSource, ok := lead.Payload["utm_source"].(string); ok && utmSource != "" {
						<span class="inline-block px-1.5 py-0.5 rounded bg-admin-accent-muted text-admin-accent text-[10px] font-mono border border-admin-accent-border" title="UTM Source">
							utm: { utmSource }
						</span>
					}
					if utmCampaign, ok := lead.Payload["utm_campaign"].(string); ok && utmCampaign != "" {
						<span class="inline-block px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 text-[10px] font-mono border border-purple-500/20" title="UTM Campaign">
							cmp: { utmCampaign }
						</span>
					}
				}
			</div>
			if lead.Payload != nil {
				if qMap, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
					<div class="text-[11px] text-admin-warning font-medium font-mono">
						🎯 Квиз-смета: { fmt.Sprintf("%v", qMap["estimated_price"]) } руб.
					</div>
				}
				if comment, ok := lead.Payload["comment"].(string); ok && comment != "" {
					<div class="text-xs text-admin-content-muted italic break-words line-clamp-2">
						«{ comment }»
					</div>
				}
			}
		</div>
	}
}

templ LeadDetailDrawer(lead models.Lead) {
	<div
		x-show={ fmt.Sprintf("activeLeadID === '%s'", lead.ID) }
		x-cloak
		class="relative z-50"
		role="dialog"
		aria-modal="true"
	>
		<!-- Backdrop -->
		<div
			x-show={ fmt.Sprintf("activeLeadID === '%s'", lead.ID) }
			x-transition:enter="ease-out duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			@click="activeLeadID = null"
			class="fixed inset-0 bg-black/60 backdrop-blur-2xs transition-opacity"
		></div>

		<div class="fixed inset-0 overflow-hidden">
			<div class="absolute inset-0 overflow-hidden">
				<div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
					<div
						x-show={ fmt.Sprintf("activeLeadID === '%s'", lead.ID) }
						x-transition:enter="transform transition ease-in-out duration-300"
						x-transition:enter-start="translate-x-full"
						x-transition:enter-end="translate-x-0"
						x-transition:leave="transform transition ease-in-out duration-200"
						x-transition:leave-start="translate-x-0"
						x-transition:leave-end="translate-x-full"
						class="pointer-events-auto w-screen max-w-md bg-admin-surface border-l border-admin-border shadow-2xl flex flex-col"
					>
						<!-- Drawer Header -->
						<div class="p-6 border-b border-admin-border flex items-center justify-between">
							<div class="flex items-center gap-3">
								<div class="w-10 h-10 rounded-xl bg-admin-accent-muted border border-admin-accent-border text-admin-accent font-bold flex items-center justify-center text-sm font-mono">
									{ getInitials(lead.Name) }
								</div>
								<div>
									<h3 class="text-base font-bold text-admin-content leading-tight">{ lead.Name }</h3>
									<div class="text-xs text-admin-content-muted mt-0.5 font-mono">Карточка обращения</div>
								</div>
							</div>
							<button
								type="button"
								@click="activeLeadID = null"
								class="p-2 rounded-xl text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted transition-colors cursor-pointer"
								title="Закрыть"
							>
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>

						<!-- Drawer Body -->
						<div class="flex-1 overflow-y-auto p-6 space-y-5">
							<!-- 1. Быстрые контакты -->
							<div class="bg-admin-surface-muted/50 border border-admin-border rounded-2xl p-4 space-y-3">
								<div class="text-[10px] font-mono font-semibold uppercase tracking-wider text-admin-content-muted">Контакты клиента</div>
								<div class="flex items-center justify-between">
									<span class="text-sm font-mono text-admin-content font-medium">{ formatPhoneMask(lead.Phone) }</span>
									<div class="flex items-center gap-1.5">
										<button
											type="button"
											@click={ fmt.Sprintf("copyText('%s', '%s')", lead.Phone, lead.ID) }
											class="px-2 py-1 rounded-lg bg-admin-surface hover:bg-admin-surface-muted text-xs text-admin-content-muted hover:text-admin-content border border-admin-border transition-colors cursor-pointer"
										>
											<span x-text={ fmt.Sprintf("copiedPhone === '%s' ? 'Скопировано!' : 'Копировать'", lead.ID) }>Копировать</span>
										</button>
										<a
											href={ templ.SafeURL("tel:" + lead.Phone) }
											class="px-2.5 py-1 rounded-lg bg-admin-accent-muted hover:bg-admin-accent/20 text-xs text-admin-accent font-semibold border border-admin-accent-border transition-colors"
										>
											Вызов
										</a>
									</div>
								</div>
								if lead.Email != "" {
									<div class="flex items-center justify-between pt-2 border-t border-admin-border">
										<span class="text-xs text-admin-content-muted">{ lead.Email }</span>
										<a
											href={ templ.SafeURL("mailto:" + lead.Email) }
											class="text-xs text-admin-accent hover:underline"
										>
											Написать email
										</a>
									</div>
								}
								if formatWhatsAppPhone(lead.Phone) != "" {
									<a
										href={ templ.SafeURL("https://wa.me/" + formatWhatsAppPhone(lead.Phone)) }
										target="_blank"
										rel="noopener noreferrer"
										class="w-full py-2 px-3 rounded-xl bg-admin-success-muted hover:bg-admin-success/20 text-admin-success text-xs font-semibold flex items-center justify-center gap-2 border border-admin-success/20 transition-colors"
									>
										<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
											<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
										</svg>
										<span>Открыть чат WhatsApp</span>
									</a>
								}
							</div>

							<!-- 2. Запись / Желаемое время -->
							if lead.BookingDate != "" {
								<div class="bg-admin-surface-muted/50 border border-admin-border rounded-2xl p-4 space-y-2">
									<div class="text-[10px] font-mono font-semibold uppercase tracking-wider text-admin-content-muted">Назначенная дата визита</div>
									<div class="flex items-center gap-2 text-admin-content font-medium">
										<svg class="w-4 h-4 text-admin-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
										</svg>
										<span>{ lead.BookingDate }</span>
										if lead.BookingTime != "" {
											<span class="text-xs text-admin-accent font-mono ml-1">в { lead.BookingTime }</span>
										}
									</div>
								</div>
							}

							<!-- 3. Детали и комментарий -->
							<div class="bg-admin-surface-muted/50 border border-admin-border rounded-2xl p-4 space-y-3">
								<div class="text-[10px] font-mono font-semibold uppercase tracking-wider text-admin-content-muted">Содержание обращения</div>
								if lead.Source != "" {
									<div class="flex items-center gap-2">
										<span class="text-xs text-admin-content-muted">Источник:</span>
										<span class="px-2 py-0.5 rounded-md bg-admin-surface text-admin-content text-xs border border-admin-border font-mono">{ lead.Source }</span>
									</div>
								}
								if lead.Payload != nil {
									if comment, ok := lead.Payload["comment"].(string); ok && comment != "" {
										<div class="pt-2 border-t border-admin-border">
											<div class="text-xs text-admin-content-muted mb-1">Комментарий клиента:</div>
											<div class="text-xs text-admin-content bg-admin-surface p-3 rounded-xl border border-admin-border whitespace-pre-wrap leading-relaxed">
												{ comment }
											</div>
										</div>
									}
									if qMap, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
										<div class="pt-2 border-t border-admin-border">
											<div class="text-xs text-admin-content-muted mb-1">Расчет квиза:</div>
											<div class="text-xs text-admin-warning font-semibold bg-admin-warning-muted p-2.5 rounded-xl border border-admin-warning/20 font-mono">
												Ориентировочная стоимость: { fmt.Sprintf("%v", qMap["estimated_price"]) } руб.
											</div>
										</div>
									}
								}
							</div>

							<!-- 4. Маркетинговые атрибуты -->
							if lead.Payload != nil {
								if utmSource, ok := lead.Payload["utm_source"].(string); ok && utmSource != "" {
									<div class="bg-admin-surface-muted/50 border border-admin-border rounded-2xl p-4 space-y-2">
										<div class="text-[10px] font-mono font-semibold uppercase tracking-wider text-admin-content-muted">Маркетинговые метки</div>
										<div class="text-xs space-y-1 font-mono">
											<div class="text-admin-content">utm_source: <span class="text-admin-accent">{ utmSource }</span></div>
											if utmCampaign, ok := lead.Payload["utm_campaign"].(string); ok && utmCampaign != "" {
												<div class="text-admin-content">utm_campaign: <span class="text-purple-400">{ utmCampaign }</span></div>
											}
										</div>
									</div>
								}
							}
						</div>

						<!-- Drawer Footer -->
						<div class="p-4 border-t border-admin-border bg-admin-surface-muted/30 flex items-center justify-between">
							<div class="text-[11px] text-admin-content-muted font-mono">ID: { lead.ID }</div>
							<button
								type="button"
								@click="activeLeadID = null"
								class="px-4 py-2 rounded-xl bg-admin-surface hover:bg-admin-surface-muted text-xs font-semibold text-admin-content border border-admin-border transition-colors cursor-pointer"
							>
								Закрыть
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ LeadsBadges(newCount int, inProgressCount int, totalCount int) {
	<span id="leads-count-badges" class="inline-flex items-center gap-1.5 ml-1 shrink-0 font-mono">
		if newCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-red-50 text-red-700 border border-red-200"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse"></span>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
		}
		if inProgressCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}

templ LeadRowWithOOBBadges(lead models.Lead, newCount int, inProgressCount int, totalCount int) {
	@LeadRowSingle(lead)
	<span id="leads-count-badges" hx-swap-oob="true" class="inline-flex items-center gap-1.5 ml-1 shrink-0 font-mono">
		if newCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-red-50 text-red-700 border border-red-200"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse"></span>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
		}
		if inProgressCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}
