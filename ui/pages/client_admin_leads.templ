package pages

import (
	"fmt"
	"sitecraft/internal/models"
)

templ ClientLeadsTab(leads []models.Lead) {
	{{
		newCount, inProgressCount := countLeadsByStatus(leads)
		doneCount := 0
		for _, l := range leads {
			if l.Status == "выполнена" || l.Status == "обработана" {
				doneCount++
			}
		}
	}}
	<div
		x-data="{
			search: '',
			filterStatus: 'all',
			activeLeadID: null,
			copiedPhone: null,
			copyText(text, id) {
				navigator.clipboard.writeText(text);
				this.copiedPhone = id;
				setTimeout(() => { if (this.copiedPhone === id) this.copiedPhone = null; }, 2000);
			},
			matchesLead(name, phone, comment, status) {
				const s = this.search.toLowerCase().trim();
				const matchesSearch = !s ||
					name.toLowerCase().includes(s) ||
					phone.toLowerCase().includes(s) ||
					comment.toLowerCase().includes(s);
				const normalizedStatus = (status === '' || status === 'новая') ? 'новая' : status;
				const matchesStatus = this.filterStatus === 'all' ||
					(this.filterStatus === normalizedStatus);
				return matchesSearch && matchesStatus;
			}
		}"
		class="space-y-6"
	>
		<!-- 1. Верхняя панель заголовка и действий -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-3 flex-wrap">
					<h2 class="text-xl font-bold text-white tracking-tight">Входящие заявки</h2>
					if newCount > 0 {
						<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-500/15 text-blue-300 border border-blue-500/30 shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
							<span>Новых: { fmt.Sprintf("%d", newCount) }</span>
						</span>
					}
					if inProgressCount > 0 {
						<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30 shadow-xs">
							<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
							<span>В обработке: { fmt.Sprintf("%d", inProgressCount) }</span>
						</span>
					}
				</div>
				<p class="text-xs text-slate-400 mt-1">Клиентские обращения с форм захвата, онлайн-записи и витрины услуг</p>
			</div>
			<div class="flex items-center gap-2.5 flex-wrap">
				<button
					type="button"
					hx-get="/client/tab/leads"
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class="px-3 py-2 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-xs font-medium text-slate-300 hover:text-white transition-colors flex items-center gap-1.5 border border-slate-700/80 cursor-pointer"
					title="Обновить таблицу"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
					<span>Обновить</span>
				</button>
				<a
					href="/client/export/leads.csv"
					class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 hover:text-white transition-colors flex items-center gap-2 border border-slate-700"
				>
					<svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
					</svg>
					<span>Экспорт в CSV</span>
				</a>
			</div>
		</div>

		<!-- 2. Сводные метрики (KPI карточки) -->
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
			<div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
				<div class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Всего заявок</div>
				<div class="text-2xl font-bold text-white mt-1.5">{ fmt.Sprintf("%d", len(leads)) }</div>
				<div class="text-[11px] text-slate-500 mt-1">за все время</div>
			</div>
			<div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
				<div class="flex items-center justify-between">
					<span class="text-[11px] font-medium uppercase tracking-wider text-blue-400">Новые</span>
					if newCount > 0 {
						<span class="w-2 h-2 rounded-full bg-blue-400 animate-ping"></span>
					}
				</div>
				<div class="text-2xl font-bold text-blue-300 mt-1.5">{ fmt.Sprintf("%d", newCount) }</div>
				<div class="text-[11px] text-slate-400 mt-1">требуют ответа</div>
			</div>
			<div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
				<div class="text-[11px] font-medium uppercase tracking-wider text-amber-400">В обработке</div>
				<div class="text-2xl font-bold text-amber-300 mt-1.5">{ fmt.Sprintf("%d", inProgressCount) }</div>
				<div class="text-[11px] text-slate-400 mt-1">в работе у нотариуса</div>
			</div>
			<div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
				<div class="text-[11px] font-medium uppercase tracking-wider text-emerald-400">Выполнено</div>
				<div class="text-2xl font-bold text-emerald-300 mt-1.5">{ fmt.Sprintf("%d", doneCount) }</div>
				<div class="text-[11px] text-slate-400 mt-1">успешно закрыты</div>
			</div>
		</div>

		if len(leads) == 0 {
			<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
				<div class="w-12 h-12 rounded-2xl bg-slate-800 flex items-center justify-center mx-auto mb-4 text-slate-500">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
					</svg>
				</div>
				<h3 class="text-base font-semibold text-white mb-1">Заявок пока нет</h3>
				<p class="text-xs text-slate-400 max-w-sm mx-auto">Новые заявки с форм на сайте будут мгновенно отображаться здесь в реальном времени.</p>
			</div>
		} else {
			<!-- 3. Панель быстрого поиска и фильтров по статусам -->
			<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-slate-900/60 border border-slate-800/80 rounded-2xl p-2.5 backdrop-blur-sm">
				<div class="relative flex-1 max-w-md">
					<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
					<input
						type="text"
						x-model="search"
						placeholder="Поиск по имени, номеру телефона, деталям..."
						class="w-full bg-slate-950/60 border border-slate-800 text-xs text-white placeholder-slate-500 rounded-xl pl-9 pr-8 py-2 focus:outline-none focus:ring-1 focus:ring-amber-500/50 focus:border-amber-500/50 transition-all"
					/>
					<button
						type="button"
						x-show="search.length > 0"
						@click="search = ''"
						class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-slate-400 hover:text-white"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<!-- Табы статусов -->
				<div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 text-xs">
					<button
						type="button"
						@click="filterStatus = 'all'"
						:class="filterStatus === 'all' ? 'bg-amber-500/15 text-amber-300 font-semibold border-amber-500/40' : 'bg-slate-800/40 text-slate-400 hover:text-slate-200 border-slate-800'"
						class="px-2.5 py-1.5 rounded-xl border transition-all cursor-pointer whitespace-nowrap"
					>
						Все ({ fmt.Sprintf("%d", len(leads)) })
					</button>
					<button
						type="button"
						@click="filterStatus = 'новая'"
						:class="filterStatus === 'новая' ? 'bg-blue-500/20 text-blue-300 font-semibold border-blue-500/40' : 'bg-slate-800/40 text-slate-400 hover:text-slate-200 border-slate-800'"
						class="px-2.5 py-1.5 rounded-xl border transition-all cursor-pointer whitespace-nowrap"
					>
						Новые ({ fmt.Sprintf("%d", newCount) })
					</button>
					<button
						type="button"
						@click="filterStatus = 'в обработке'"
						:class="filterStatus === 'в обработке' ? 'bg-amber-500/20 text-amber-300 font-semibold border-amber-500/40' : 'bg-slate-800/40 text-slate-400 hover:text-slate-200 border-slate-800'"
						class="px-2.5 py-1.5 rounded-xl border transition-all cursor-pointer whitespace-nowrap"
					>
						В обработке ({ fmt.Sprintf("%d", inProgressCount) })
					</button>
					<button
						type="button"
						@click="filterStatus = 'выполнена'"
						:class="filterStatus === 'выполнена' ? 'bg-emerald-500/20 text-emerald-300 font-semibold border-emerald-500/40' : 'bg-slate-800/40 text-slate-400 hover:text-slate-200 border-slate-800'"
						class="px-2.5 py-1.5 rounded-xl border transition-all cursor-pointer whitespace-nowrap"
					>
						Выполнены ({ fmt.Sprintf("%d", doneCount) })
					</button>
				</div>
			</div>

			<!-- 4. Таблица заявок -->
			<div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl overflow-hidden shadow-xl">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs sm:text-sm">
						<thead class="bg-slate-950/70 border-b border-slate-800/80 text-slate-400 text-[11px] uppercase tracking-wider">
							<tr>
								<th class="py-3.5 px-4 font-semibold">Клиент</th>
								<th class="py-3.5 px-4 font-semibold">Контакты</th>
								<th class="py-3.5 px-4 font-semibold">Дата и время</th>
								<th class="py-3.5 px-4 font-semibold">Детали обращения</th>
								<th class="py-3.5 px-4 font-semibold">Статус заявки</th>
								<th class="py-3.5 px-4 font-semibold text-right">Действия</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800/60 text-slate-300">
							for _, lead := range leads {
								@LeadRowSingle(lead)
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- 5. Выдвижные шторки (Detail Drawers) для детального просмотра заявок -->
			for _, lead := range leads {
				@LeadDetailDrawer(lead)
			}
		}
	</div>
}

templ LeadStatusBadge(status string) {
	if status == "новая" || status == "" {
		<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
			<span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
			<span>Новая</span>
		</span>
	} else if status == "в обработке" {
		<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
			<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
			<span>В обработке</span>
		</span>
	} else if status == "выполнена" || status == "обработана" {
		<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
			<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
			<span>Выполнена</span>
		</span>
	} else if status == "отменена" {
		<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700">
			<span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
			<span>Отменена</span>
		</span>
	} else {
		<span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-800 text-slate-400">
			{ status }
		</span>
	}
}

templ LeadRowSingle(lead models.Lead) {
	{{
		comment := ""
		if lead.Payload != nil {
			if c, ok := lead.Payload["comment"].(string); ok {
				comment = c
			}
		}
	}}
	<tr
		id={ "lead-row-" + lead.ID }
		x-show={ fmt.Sprintf("matchesLead('%s', '%s', '%s', '%s')", lead.Name, lead.Phone, comment, lead.Status) }
		class="hover:bg-slate-800/40 transition-colors group"
	>
		<!-- Клиент -->
		<td class="py-3.5 px-4 whitespace-nowrap">
			<div class="flex items-center gap-3">
				<div class="w-8 h-8 rounded-xl bg-slate-800 border border-slate-700/80 flex items-center justify-center font-bold text-xs text-amber-400 shrink-0 select-none shadow-xs">
					{ getInitials(lead.Name) }
				</div>
				<div>
					<button
						type="button"
						@click={ fmt.Sprintf("activeLeadID = '%s'", lead.ID) }
						class="font-semibold text-white hover:text-amber-400 transition-colors text-left cursor-pointer group-hover:text-amber-300"
					>
						{ lead.Name }
					</button>
					if lead.Email != "" {
						<div class="text-[11px] text-slate-400 font-normal">
							{ lead.Email }
						</div>
					}
				</div>
			</div>
		</td>

		<!-- Контакты с быстрым копированием и WhatsApp -->
		<td class="py-3.5 px-4 whitespace-nowrap">
			<div class="flex items-center gap-2">
				<a
					href={ templ.SafeURL("tel:" + lead.Phone) }
					class="text-slate-200 hover:text-amber-400 font-mono text-xs font-medium transition-colors"
					title="Позвонить клиенту"
				>
					{ formatPhoneMask(lead.Phone) }
				</a>
				<div class="flex items-center gap-1 opacity-70 group-hover:opacity-100 transition-opacity">
					<!-- Кнопка быстрого копирования -->
					<button
						type="button"
						@click.stop={ fmt.Sprintf("copyText('%s', '%s')", lead.Phone, lead.ID) }
						class="p-1 rounded-md text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer"
						title="Скопировать телефон"
					>
						<template x-if={ fmt.Sprintf("copiedPhone === '%s'", lead.ID) }>
							<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
							</svg>
						</template>
						<template x-if={ fmt.Sprintf("copiedPhone !== '%s'", lead.ID) }>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
							</svg>
						</template>
					</button>

					<!-- Быстрый WhatsApp -->
					if formatWhatsAppPhone(lead.Phone) != "" {
						<a
							href={ templ.SafeURL("https://wa.me/" + formatWhatsAppPhone(lead.Phone)) }
							target="_blank"
							rel="noopener noreferrer"
							class="p-1 rounded-md text-slate-400 hover:text-emerald-400 hover:bg-slate-800 transition-colors"
							title="Написать в WhatsApp"
						>
							<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
							</svg>
						</a>
					}
				</div>
			</div>
		</td>

		<!-- Дата и время -->
		<td class="py-3.5 px-4 whitespace-nowrap text-slate-300">
			if lead.BookingDate != "" {
				<div class="flex items-center gap-1.5 text-white font-medium">
					<svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					<span>{ lead.BookingDate }</span>
				</div>
				if lead.BookingTime != "" {
					<div class="text-[11px] text-slate-400 font-mono mt-0.5 ml-5">{ lead.BookingTime }</div>
				}
			} else if lead.Created != "" {
				<div class="text-xs text-slate-400">{ lead.Created }</div>
			} else {
				<span class="text-slate-500 text-xs">—</span>
			}
		</td>

		<!-- Детали обращения -->
		<td class="py-3.5 px-4">
			@LeadDetailsCell(lead)
		</td>

		<!-- Статус заявки (Интерактивный селектор без дублирования) -->
		<td class="py-3.5 px-4 whitespace-nowrap">
			<div class="relative inline-block">
				<select
					name="status"
					hx-post={ "/client/leads/" + lead.ID + "/status" }
					hx-target="#admin-tab-content"
					hx-swap="innerHTML"
					class={ "px-3 py-1.5 rounded-xl text-xs font-medium border appearance-none pr-7 cursor-pointer focus:outline-none transition-colors",
						templ.KV("bg-blue-500/15 text-blue-300 border-blue-500/30 hover:border-blue-500/50", lead.Status == "новая" || lead.Status == ""),
						templ.KV("bg-amber-500/15 text-amber-300 border-amber-500/30 hover:border-amber-500/50", lead.Status == "в обработке"),
						templ.KV("bg-emerald-500/15 text-emerald-300 border-emerald-500/30 hover:border-emerald-500/50", lead.Status == "выполнена" || lead.Status == "обработана"),
						templ.KV("bg-slate-800 text-slate-400 border-slate-700 hover:border-slate-600", lead.Status == "отменена") }
				>
					<option value="новая" selected?={ lead.Status == "новая" || lead.Status == "" } class="bg-slate-900 text-white">Новая</option>
					<option value="в обработке" selected?={ lead.Status == "в обработке" } class="bg-slate-900 text-white">В обработке</option>
					<option value="выполнена" selected?={ lead.Status == "выполнена" || lead.Status == "обработана" } class="bg-slate-900 text-white">Выполнена</option>
					<option value="отменена" selected?={ lead.Status == "отменена" } class="bg-slate-900 text-white">Отменена</option>
				</select>
				<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2 text-slate-400">
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</div>
			</div>
		</td>

		<!-- Действия -->
		<td class="py-3.5 px-4 text-right whitespace-nowrap">
			<button
				type="button"
				@click={ fmt.Sprintf("activeLeadID = '%s'", lead.ID) }
				class="px-2.5 py-1.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/80 text-xs font-medium transition-colors inline-flex items-center gap-1.5 cursor-pointer shadow-xs"
				title="Открыть карточку заявки"
			>
				<svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
				</svg>
				<span>Подробнее</span>
			</button>
		</td>
	</tr>
}

templ LeadDetailsCell(lead models.Lead) {
	{{
		hasDetails := false
		if lead.Source != "" {
			hasDetails = true
		}
		if lead.Payload != nil {
			if _, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
				hasDetails = true
			}
			if c, ok := lead.Payload["comment"].(string); ok && c != "" {
				hasDetails = true
			}
		}
	}}
	if !hasDetails {
		<span class="text-slate-500 text-xs italic">Без комментария</span>
	} else {
		<div class="flex flex-col gap-1 max-w-xs">
			<div class="flex items-center gap-1.5 flex-wrap">
				if lead.Source != "" {
					<span class="inline-block px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 text-[10px] font-mono border border-slate-700">
						{ lead.Source }
					</span>
				}
				if lead.Payload != nil {
					if utmSource, ok := lead.Payload["utm_source"].(string); ok && utmSource != "" {
						<span class="inline-block px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 text-[10px] font-mono border border-blue-500/20" title="UTM Source">
							utm: { utmSource }
						</span>
					}
					if utmCampaign, ok := lead.Payload["utm_campaign"].(string); ok && utmCampaign != "" {
						<span class="inline-block px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 text-[10px] font-mono border border-purple-500/20" title="UTM Campaign">
							cmp: { utmCampaign }
						</span>
					}
				}
			</div>
			if lead.Payload != nil {
				if qMap, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
					<div class="text-[11px] text-amber-300/90 font-medium">
						🎯 Квиз-смета: { fmt.Sprintf("%v", qMap["estimated_price"]) } руб.
					</div>
				}
				if comment, ok := lead.Payload["comment"].(string); ok && comment != "" {
					<div class="text-xs text-slate-300 italic break-words line-clamp-2">
						«{ comment }»
					</div>
				}
			}
		</div>
	}
}

templ LeadDetailDrawer(lead models.Lead) {
	<div
		x-show={ fmt.Sprintf("activeLeadID === '%s'", lead.ID) }
		x-cloak
		class="relative z-50"
		role="dialog"
		aria-modal="true"
	>
		<!-- Backdrop -->
		<div
			x-show={ fmt.Sprintf("activeLeadID === '%s'", lead.ID) }
			x-transition:enter="ease-out duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			@click="activeLeadID = null"
			class="fixed inset-0 bg-slate-950/80 backdrop-blur-xs transition-opacity"
		></div>

		<div class="fixed inset-0 overflow-hidden">
			<div class="absolute inset-0 overflow-hidden">
				<div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
					<div
						x-show={ fmt.Sprintf("activeLeadID === '%s'", lead.ID) }
						x-transition:enter="transform transition ease-in-out duration-300"
						x-transition:enter-start="translate-x-full"
						x-transition:enter-end="translate-x-0"
						x-transition:leave="transform transition ease-in-out duration-200"
						x-transition:leave-start="translate-x-0"
						x-transition:leave-end="translate-x-full"
						class="pointer-events-auto w-screen max-w-md bg-slate-900 border-l border-slate-800 shadow-2xl flex flex-col"
					>
						<!-- Drawer Header -->
						<div class="p-6 border-b border-slate-800/80 flex items-center justify-between">
							<div class="flex items-center gap-3">
								<div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 font-bold flex items-center justify-center text-sm">
									{ getInitials(lead.Name) }
								</div>
								<div>
									<h3 class="text-base font-bold text-white leading-tight">{ lead.Name }</h3>
									<div class="text-xs text-slate-400 mt-0.5">Карточка обращения</div>
								</div>
							</div>
							<button
								type="button"
								@click="activeLeadID = null"
								class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer"
								title="Закрыть"
							>
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>

						<!-- Drawer Body -->
						<div class="flex-1 overflow-y-auto p-6 space-y-6">
							<!-- 1. Быстрые контакты -->
							<div class="bg-slate-950/60 border border-slate-800 rounded-2xl p-4 space-y-3">
								<div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Контакты клиента</div>
								<div class="flex items-center justify-between">
									<span class="text-sm font-mono text-white font-medium">{ formatPhoneMask(lead.Phone) }</span>
									<div class="flex items-center gap-1.5">
										<button
											type="button"
											@click={ fmt.Sprintf("copyText('%s', '%s')", lead.Phone, lead.ID) }
											class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 hover:text-white border border-slate-700 transition-colors"
										>
											<span x-text={ fmt.Sprintf("copiedPhone === '%s' ? 'Скопировано!' : 'Копировать'", lead.ID) }>Копировать</span>
										</button>
										<a
											href={ templ.SafeURL("tel:" + lead.Phone) }
											class="px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-xs text-amber-400 font-semibold border border-amber-500/20 transition-colors"
										>
											Вызов
										</a>
									</div>
								</div>
								if lead.Email != "" {
									<div class="flex items-center justify-between pt-2 border-t border-slate-800/80">
										<span class="text-xs text-slate-300">{ lead.Email }</span>
										<a
											href={ templ.SafeURL("mailto:" + lead.Email) }
											class="text-xs text-amber-400 hover:underline"
										>
											Написать email
										</a>
									</div>
								}
								if formatWhatsAppPhone(lead.Phone) != "" {
									<a
										href={ templ.SafeURL("https://wa.me/" + formatWhatsAppPhone(lead.Phone)) }
										target="_blank"
										rel="noopener noreferrer"
										class="w-full py-2 px-3 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold flex items-center justify-center gap-2 border border-emerald-500/20 transition-colors"
									>
										<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
											<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
										</svg>
										<span>Открыть чат WhatsApp</span>
									</a>
								}
							</div>

							<!-- 2. Запись / Желаемое время -->
							if lead.BookingDate != "" {
								<div class="bg-slate-950/60 border border-slate-800 rounded-2xl p-4 space-y-2">
									<div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Назначенная дата визита</div>
									<div class="flex items-center gap-2 text-white font-medium">
										<svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
										</svg>
										<span>{ lead.BookingDate }</span>
										if lead.BookingTime != "" {
											<span class="text-xs text-amber-400 font-mono ml-1">в { lead.BookingTime }</span>
										}
									</div>
								</div>
							}

							<!-- 3. Детали и комментарий -->
							<div class="bg-slate-950/60 border border-slate-800 rounded-2xl p-4 space-y-3">
								<div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Содержание обращения</div>
								if lead.Source != "" {
									<div class="flex items-center gap-2">
										<span class="text-xs text-slate-400">Источник:</span>
										<span class="px-2 py-0.5 rounded-md bg-slate-800 text-white text-xs border border-slate-700 font-mono">{ lead.Source }</span>
									</div>
								}
								if lead.Payload != nil {
									if comment, ok := lead.Payload["comment"].(string); ok && comment != "" {
										<div class="pt-2 border-t border-slate-800/80">
											<div class="text-xs text-slate-400 mb-1">Комментарий клиента:</div>
											<div class="text-xs text-slate-200 bg-slate-900 p-3 rounded-xl border border-slate-800 whitespace-pre-wrap leading-relaxed">
												{ comment }
											</div>
										</div>
									}
									if qMap, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
										<div class="pt-2 border-t border-slate-800/80">
											<div class="text-xs text-slate-400 mb-1">Расчет квиза:</div>
											<div class="text-xs text-amber-300 font-semibold bg-amber-500/10 p-2.5 rounded-xl border border-amber-500/20">
												Ориентировочная стоимость: { fmt.Sprintf("%v", qMap["estimated_price"]) } руб.
											</div>
										</div>
									}
								}
							</div>

							<!-- 4. Маркетинговые атрибуты -->
							if lead.Payload != nil {
								if utmSource, ok := lead.Payload["utm_source"].(string); ok && utmSource != "" {
									<div class="bg-slate-950/60 border border-slate-800 rounded-2xl p-4 space-y-2">
										<div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Маркетинговые метки</div>
										<div class="text-xs space-y-1 font-mono">
											<div class="text-slate-300">utm_source: <span class="text-blue-400">{ utmSource }</span></div>
											if utmCampaign, ok := lead.Payload["utm_campaign"].(string); ok && utmCampaign != "" {
												<div class="text-slate-300">utm_campaign: <span class="text-purple-400">{ utmCampaign }</span></div>
											}
										</div>
									</div>
								}
							}
						</div>

						<!-- Drawer Footer -->
						<div class="p-4 border-t border-slate-800 bg-slate-950/50 flex items-center justify-between">
							<div class="text-[11px] text-slate-500 font-mono">ID: { lead.ID }</div>
							<button
								type="button"
								@click="activeLeadID = null"
								class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition-colors cursor-pointer"
							>
								Закрыть
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ LeadsBadges(newCount int, inProgressCount int, totalCount int) {
	<span id="leads-count-badges" class="inline-flex items-center gap-1.5 ml-1 shrink-0">
		if newCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 shadow-xs"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
		}
		if inProgressCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 shadow-xs"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}

templ LeadRowWithOOBBadges(lead models.Lead, newCount int, inProgressCount int, totalCount int) {
	@LeadRowSingle(lead)
	<span id="leads-count-badges" hx-swap-oob="true" class="inline-flex items-center gap-1.5 ml-1 shrink-0">
		if newCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 shadow-xs"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
		}
		if inProgressCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 shadow-xs"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}
