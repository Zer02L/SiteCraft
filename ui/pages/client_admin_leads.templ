package pages

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/pages/admin_leads"
)

templ ClientLeadsTab(leads []models.Lead) {
	<div
		id="leads-tab-root"
		x-data="{
			search: '',
			filterStatus: 'all',
			activeLead: null,
			copiedPhone: null,
			openLead(btn) {
				try {
					this.activeLead = JSON.parse(btn.dataset.lead || 'null');
					const dlg = document.getElementById('lead-detail-dialog');
					if (dlg && this.activeLead) dlg.showModal();
				} catch (e) {}
			},
			closeLead() {
				const dlg = document.getElementById('lead-detail-dialog');
				if (dlg && dlg.open) dlg.close();
			},
			copyText(text, id) {
				if (navigator && navigator.clipboard) {
					navigator.clipboard.writeText(text);
				}
				this.copiedPhone = id;
				this.$dispatch('admin-toast', { message: 'Телефон скопирован', tone: 'success' });
				setTimeout(() => { if (this.copiedPhone === id) this.copiedPhone = null; }, 2000);
			},
			matchesLead(name, phone, comment, status) {
				const s = this.search.toLowerCase().trim();
				const matchesSearch = !s ||
					(name || '').toLowerCase().includes(s) ||
					(phone || '').toLowerCase().includes(s) ||
					(comment || '').toLowerCase().includes(s);
				const normalizedStatus = (!status || status === 'новая') ? 'новая' : status;
				const matchesStatus = this.filterStatus === 'all' || (this.filterStatus === normalizedStatus);
				return matchesSearch && matchesStatus;
			},
			hasMatchingLead() {
				const body = this.$el.querySelector('#leads-table-body');
				if (!body) return true;
				const rows = body.querySelectorAll('tr[data-lead-row]');
				if (!rows.length) return true;
				for (const r of rows) {
					if (this.matchesLead(r.dataset.name, r.dataset.phone, r.dataset.comment, r.dataset.status)) {
						return true;
					}
				}
				return false;
			}
		}"
		class="space-y-5"
	>
		<div id="leads-tab-body" class="space-y-5">
			@LeadsTabContent(leads)
		</div>
		@admin_leads.LeadDetailDialog()
	</div>
}

templ LeadsTabContent(leads []models.Lead) {
	{{
		newCount, inProgressCount := countLeadsByStatus(leads)
		doneCount := 0
		for _, l := range leads {
			if l.Status == "выполнена" || l.Status == "обработана" {
				doneCount++
			}
		}
	}}
	<!-- 1. Верхняя панель заголовка, интерактивных KPI и поиска -->
	@admin_leads.LeadsToolbar(leads, newCount, inProgressCount, doneCount)

	if len(leads) == 0 {
		<div class="bg-admin-surface border border-admin-border rounded-xl p-10 text-center">
			<div class="w-11 h-11 rounded-xl bg-admin-surface-muted border border-admin-border flex items-center justify-center mx-auto mb-3 text-admin-content-muted">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
				</svg>
			</div>
			<h3 class="text-sm font-semibold text-admin-content mb-1">Список заявок пока пустой</h3>
			<p class="text-xs text-admin-content-muted max-w-sm mx-auto">Новые обращения с форм сайта будут автоматически появляться здесь.</p>
		</div>
	} else {
		<!-- 2. Таблица заявок -->
		<div class="bg-admin-surface border border-admin-border rounded-xl overflow-hidden">
			<div class="overflow-x-auto">
				<table class="tabular-nums w-full text-left text-xs sm:text-sm">
					<thead class="bg-admin-surface-muted/60 border-b border-admin-border text-admin-content-muted text-xs font-medium">
						<tr>
							<th class="py-2.5 px-4 font-medium">Клиент</th>
							<th class="py-2.5 px-4 font-medium">Контакты</th>
							<th class="py-2.5 px-4 font-medium">Дата и время</th>
							<th class="py-2.5 px-4 font-medium">Детали обращения</th>
							<th class="py-2.5 px-4 font-medium">Статус</th>
							<th class="py-2.5 px-4 font-medium text-right">Действия</th>
						</tr>
					</thead>
					<tbody id="leads-table-body" class="divide-y divide-admin-border text-admin-content">
						for _, lead := range leads {
							@LeadRowSingle(lead)
						}
					</tbody>
				</table>
			</div>
			<div x-show="!hasMatchingLead()" x-cloak class="p-10 text-center border-t border-admin-border">
				<p class="text-sm font-medium text-admin-content mb-1">По вашему запросу заявки не найдены</p>
				<p class="text-xs text-admin-content-muted mb-3">Попробуйте изменить строку поиска или сбросить фильтр по статусу.</p>
				<button
					type="button"
					@click="search = ''; filterStatus = 'all'"
					class="px-3 py-1.5 rounded-lg border border-admin-border bg-admin-surface hover:bg-admin-surface-muted text-xs font-medium text-admin-content transition-colors cursor-pointer"
				>
					Сбросить фильтры
				</button>
			</div>
		</div>
	}
}

templ LeadStatusBadge(status string) {
	if status == "новая" || status == "" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-accent-muted text-admin-accent border border-admin-accent-border">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-accent"></span>
			<span>Новая</span>
		</span>
	} else if status == "в обработке" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-warning-muted text-admin-warning border border-admin-warning-border">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-warning"></span>
			<span>В обработке</span>
		</span>
	} else if status == "выполнена" || status == "обработана" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-success-muted text-admin-success border border-admin-success-border">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-success"></span>
			<span>Выполнена</span>
		</span>
	} else if status == "отменена" {
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border">
			<span class="w-1.5 h-1.5 rounded-full bg-admin-content-muted"></span>
			<span>Отменена</span>
		</span>
	} else {
		<span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border">
			{ status }
		</span>
	}
}

templ LeadRowSingle(lead models.Lead) {
	{{
		comment := ""
		if lead.Payload != nil {
			if c, ok := lead.Payload["comment"].(string); ok {
				comment = c
			}
		}
		leadJSON := admin_leads.BuildLeadDetailJSON(lead)
	}}
	<tr
		id={ "lead-row-" + lead.ID }
		data-lead-row="1"
		data-name={ lead.Name }
		data-phone={ lead.Phone }
		data-comment={ comment }
		data-status={ lead.Status }
		x-show="matchesLead($el.dataset.name, $el.dataset.phone, $el.dataset.comment, $el.dataset.status)"
		class="hover:bg-admin-surface-muted/50 transition-colors group"
	>
		<!-- Клиент -->
		<td class="py-3 px-4 whitespace-nowrap">
			<div class="flex items-center gap-2.5">
				<div class="w-8 h-8 rounded-lg bg-admin-surface-muted text-admin-content-muted font-mono font-semibold flex items-center justify-center text-xs shrink-0 border border-admin-border">
					{ getInitials(lead.Name) }
				</div>
				<div>
					<button
						type="button"
						data-lead={ leadJSON }
						@click="openLead($el)"
						class="font-medium text-admin-content hover:text-admin-accent transition-colors text-left cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus rounded"
					>
						{ lead.Name }
					</button>
					if lead.Email != "" {
						<div class="text-[11px] text-admin-content-muted font-normal">
							{ lead.Email }
						</div>
					}
				</div>
			</div>
		</td>

		<!-- Контакты с быстрым копированием и WhatsApp -->
		<td class="py-3 px-4 whitespace-nowrap">
			<div class="flex items-center gap-1.5">
				<a
					href={ templ.SafeURL("tel:" + lead.Phone) }
					class="text-admin-content hover:text-admin-accent font-mono text-xs font-medium transition-colors"
					title="Позвонить клиенту"
				>
					{ formatPhoneMask(lead.Phone) }
				</a>
				<div class="flex items-center gap-0.5 opacity-70 group-hover:opacity-100 transition-opacity">
					<button
						type="button"
						@click.stop={ fmt.Sprintf("copyText('%s', '%s')", lead.Phone, lead.ID) }
						class="p-1 rounded-md text-admin-content-muted hover:text-admin-content hover:bg-admin-surface-muted transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
						title="Скопировать телефон"
						aria-label="Скопировать телефон"
					>
						<template x-if={ fmt.Sprintf("copiedPhone === '%s'", lead.ID) }>
							<svg class="w-3.5 h-3.5 text-admin-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
							</svg>
						</template>
						<template x-if={ fmt.Sprintf("copiedPhone !== '%s'", lead.ID) }>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
							</svg>
						</template>
					</button>

					if formatWhatsAppPhone(lead.Phone) != "" {
						<a
							href={ templ.SafeURL("https://wa.me/" + formatWhatsAppPhone(lead.Phone)) }
							target="_blank"
							rel="noopener noreferrer"
							class="p-1 rounded-md text-admin-content-muted hover:text-admin-success hover:bg-admin-surface-muted transition-colors"
							title="Написать в WhatsApp"
							aria-label="Написать в WhatsApp"
						>
							<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
							</svg>
						</a>
					}
				</div>
			</div>
		</td>

		<!-- Дата и время -->
		<td class="py-3 px-4 whitespace-nowrap text-admin-content-muted">
			if lead.BookingDate != "" {
				<div class="flex items-center gap-1.5 text-admin-content font-medium text-xs">
					<svg class="w-3.5 h-3.5 text-admin-content-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					<span>{ lead.BookingDate }</span>
				</div>
				if lead.BookingTime != "" {
					<div class="text-[11px] text-admin-content-subtle font-mono mt-0.5 ml-5">{ lead.BookingTime }</div>
				}
			} else if lead.Created != "" {
				<div class="text-xs text-admin-content-muted font-mono">{ lead.Created }</div>
			} else {
				<span class="text-admin-content-subtle text-xs">—</span>
			}
		</td>

		<!-- Детали обращения -->
		<td class="py-3 px-4">
			@LeadDetailsCell(lead)
		</td>

		<!-- Статус заявки -->
		<td class="py-3 px-4 whitespace-nowrap">
			<div class="relative inline-block">
				<select
					name="status"
					hx-post={ "/client/leads/" + lead.ID + "/status" }
					hx-target="#leads-tab-body"
					hx-swap="innerHTML"
					aria-label="Статус заявки"
					class={ "px-2.5 py-1 rounded-lg text-xs font-medium border appearance-none pr-7 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus transition-colors",
						templ.KV("bg-admin-accent-muted text-admin-accent border-admin-accent-border hover:border-admin-accent", lead.Status == "новая" || lead.Status == ""),
						templ.KV("bg-admin-warning-muted text-admin-warning border-admin-warning-border hover:border-admin-warning", lead.Status == "в обработке"),
						templ.KV("bg-admin-success-muted text-admin-success border-admin-success-border hover:border-admin-success", lead.Status == "выполнена" || lead.Status == "обработана"),
						templ.KV("bg-admin-surface-muted text-admin-content-muted border-admin-border hover:border-admin-border-focus", lead.Status == "отменена") }
				>
					<option value="новая" selected?={ lead.Status == "новая" || lead.Status == "" } class="bg-admin-surface text-admin-content">Новая</option>
					<option value="в обработке" selected?={ lead.Status == "в обработке" } class="bg-admin-surface text-admin-content">В обработке</option>
					<option value="выполнена" selected?={ lead.Status == "выполнена" || lead.Status == "обработана" } class="bg-admin-surface text-admin-content">Выполнена</option>
					<option value="отменена" selected?={ lead.Status == "отменена" } class="bg-admin-surface text-admin-content">Отменена</option>
				</select>
				<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2 text-admin-content-muted">
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</div>
			</div>
		</td>

		<!-- Действия -->
		<td class="py-3 px-4 text-right whitespace-nowrap">
			<button
				type="button"
				data-lead={ leadJSON }
				@click="openLead($el)"
				class="px-2.5 py-1 rounded-lg bg-admin-surface hover:bg-admin-surface-muted text-admin-content-muted hover:text-admin-content border border-admin-border text-xs font-medium transition-colors inline-flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-admin-border-focus"
				title="Открыть карточку заявки"
			>
				<svg class="w-3.5 h-3.5 text-admin-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
				</svg>
				<span>Подробнее</span>
			</button>
		</td>
	</tr>
}

templ LeadDetailsCell(lead models.Lead) {
	{{
		hasDetails := false
		if lead.Source != "" {
			hasDetails = true
		}
		if lead.Payload != nil {
			if _, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
				hasDetails = true
			}
			if c, ok := lead.Payload["comment"].(string); ok && c != "" {
				hasDetails = true
			}
		}
	}}
	if !hasDetails {
		<span class="text-admin-content-subtle text-xs">—</span>
	} else {
		<div class="flex flex-col gap-1 max-w-xs">
			<div class="flex items-center gap-1.5 flex-wrap">
				if lead.Source != "" {
					<span class="inline-block px-1.5 py-0.5 rounded bg-admin-surface-muted text-admin-content-muted text-[10px] font-mono border border-admin-border">
						{ lead.Source }
					</span>
				}
				if lead.Payload != nil {
					if utmSource, ok := lead.Payload["utm_source"].(string); ok && utmSource != "" {
						<span class="inline-block px-1.5 py-0.5 rounded bg-admin-accent-muted text-admin-accent text-[10px] font-mono border border-admin-accent-border" title="UTM Source">
							utm: { utmSource }
						</span>
					}
					if utmCampaign, ok := lead.Payload["utm_campaign"].(string); ok && utmCampaign != "" {
						<span class="inline-block px-1.5 py-0.5 rounded bg-admin-surface-muted text-admin-content-muted text-[10px] font-mono border border-admin-border" title="UTM Campaign">
							cmp: { utmCampaign }
						</span>
					}
				}
			</div>
			if lead.Payload != nil {
				if qMap, ok := lead.Payload["quiz_summary"].(map[string]interface{}); ok {
					<div class="text-[11px] text-admin-warning font-medium font-mono">
						Квиз-смета: { fmt.Sprintf("%v", qMap["estimated_price"]) } руб.
					</div>
				}
				if comment, ok := lead.Payload["comment"].(string); ok && comment != "" {
					<div class="text-xs text-admin-content-muted break-words line-clamp-2">
						«{ comment }»
					</div>
				}
			}
		</div>
	}
}

templ LeadsBadges(newCount int, inProgressCount int, totalCount int) {
	<span id="leads-count-badges" class="inline-flex items-center gap-1 ml-1 shrink-0 font-mono tabular-nums">
		if newCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-mono font-semibold bg-admin-danger-muted text-admin-danger border border-admin-danger-border"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
		}
		if inProgressCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-mono font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}

templ LeadRowWithOOBBadges(lead models.Lead, newCount int, inProgressCount int, totalCount int) {
	@LeadRowSingle(lead)
	<span id="leads-count-badges" hx-swap-oob="true" class="inline-flex items-center gap-1 ml-1 shrink-0 font-mono tabular-nums">
		if newCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-mono font-semibold bg-admin-danger-muted text-admin-danger border border-admin-danger-border"
				title={ fmt.Sprintf("Новые заявки: %d", newCount) }
			>
				<span>{ fmt.Sprintf("%d", newCount) }</span>
			</span>
		}
		if inProgressCount > 0 {
			<span
				class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-mono font-medium bg-admin-surface-muted text-admin-content-muted border border-admin-border"
				title={ fmt.Sprintf("Заявки в обработке: %d", inProgressCount) }
			>
				<span>{ fmt.Sprintf("%d", inProgressCount) }</span>
			</span>
		}
	</span>
}
