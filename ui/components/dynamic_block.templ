package components

import (
	"sitecraft/internal/models"
)

templ DynamicBlock(block models.PageBlock) {
	<!-- Произвольный блок контента (RichText / Raw HTML) с защитой bluemonday -->
	<section class="py-12 px-4 max-w-6xl mx-auto">
		if block.Title != "" {
			<div class="text-center mb-8">
				<h2 class="section-title">{ block.Title }</h2>
			</div>
		}
		<div class="prose max-w-none text-content/90 leading-relaxed card-base sm:p-8">
			@templ.Raw(block.Content)
		</div>
	</section>
}
