package components

import (
	"lawyer/internal/models"
)

templ ScheduleBar(content models.SiteContent) {
	<!-- Info Bar (График работы) -->
	<section id="schedule" class="bg-white border-b border-stone-200 py-8 px-4 shadow-sm">
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
			<!-- Часы работы -->
			<div class="flex items-start gap-4 p-4 rounded-xl bg-stone-50 border border-stone-200/80">
				<div class="p-3 bg-legal-burgundy/10 text-legal-burgundy rounded-lg">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
				</div>
				<div>
					<h4 class="font-bold text-stone-900 text-sm">Часы приёма:</h4>
					<p class="text-xs text-stone-600 mt-1 font-medium">{ content.WorkHours }</p>
					<p class="text-xs text-stone-500">Перерыв: <span class="font-semibold text-amber-700">{ content.LunchBreak }</span></p>
					<p class="text-xs text-stone-400 mt-0.5">{ content.DaysOff }</p>
				</div>
			</div>

			<!-- Телефоны -->
			<div class="flex items-start gap-4 p-4 rounded-xl bg-stone-50 border border-stone-200/80">
				<div class="p-3 bg-legal-burgundy/10 text-legal-burgundy rounded-lg">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
				</div>
				<div>
					<h4 class="font-bold text-stone-900 text-sm">Телефоны для справок:</h4>
					<div class="mt-1 space-y-0.5">
						if content.Phone1 != "" {
							<a href={ templ.URL("tel:" + content.Phone1) } class="block text-sm font-bold text-legal-burgundy hover:underline">{ content.Phone1 }</a>
						}
						if content.Phone2 != "" {
							<a href={ templ.URL("tel:" + content.Phone2) } class="block text-sm font-semibold text-stone-700 hover:underline">{ content.Phone2 }</a>
						}
					</div>
					<p class="text-xs text-stone-400 mt-0.5">Быстрая предварительная консультация</p>
				</div>
			</div>

			<!-- Порядок приёма -->
			<div class="flex items-start gap-4 p-4 rounded-xl bg-stone-50 border border-stone-200/80">
				<div class="p-3 bg-legal-burgundy/10 text-legal-burgundy rounded-lg">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
				</div>
				<div>
					<h4 class="font-bold text-stone-900 text-sm">Приём граждан и юрлиц:</h4>
					<p class="text-xs text-stone-600 mt-1">Приём ведется по предварительной электронной записи или в порядке живой очереди при наличии свободных окон.</p>
					<a href="#booking" class="text-xs font-semibold text-legal-burgundy hover:underline inline-block mt-1">Выбрать свободное время ↓</a>
				</div>
			</div>
		</div>
	</section>
}
