package components

import "sitecraft/internal/models"

templ CookieConsent(settings models.SiteSettings) {
	<!-- Cookie Consent Banner (152-ФЗ Compliance) -->
	<div
		x-data="{
			show: false,
			init() {
				if (!localStorage.getItem('sitecraft_cookie_consent')) {
					setTimeout(() => { this.show = true }, 1000);
				}
			},
			accept() {
				localStorage.setItem('sitecraft_cookie_consent', 'accepted');
				this.show = false;
			}
		}"
		x-show="show"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-4 scale-95"
		x-transition:enter-end="opacity-100 translate-y-0 scale-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-y-0 scale-100"
		x-transition:leave-end="opacity-0 translate-y-4 scale-95"
		class="fixed bottom-4 right-4 left-4 sm:left-auto sm:max-w-md z-40 bg-surface/95 backdrop-blur-md p-4 rounded-card border border-content/15 shadow-xl text-xs text-content select-none"
		style="display: none;"
		data-component="CookieConsent"
		data-source="ui/components/cookie_consent.templ"
		role="region"
		aria-label="Согласие на использование файлов cookie"
	>
		<div class="flex items-start gap-3">
			<div class="w-8 h-8 rounded-lg bg-accent/15 text-accent flex items-center justify-center flex-shrink-0 text-base">
				🍪
			</div>
			<div class="space-y-2.5 flex-grow">
				<p class="leading-relaxed text-content/90 text-xs">
					Мы используем обязательные файлы cookie и обезличенные данные аналитики (152-ФЗ).
					Используя сайт, вы соглашаетесь с <a href="/privacy" target="_blank" class="text-accent font-semibold underline underline-offset-2 hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-xs">Политикой конфиденциальности</a>.
				</p>
				<div class="flex items-center gap-2 pt-0.5">
					<button
						type="button"
						@click="accept()"
						class="px-3.5 py-1.5 rounded-btn bg-primary text-white font-semibold text-xs hover:bg-primary-dark active:scale-[0.98] transition-all shadow-xs cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
					>
						Понятно, принять
					</button>
					<a
						href="/privacy"
						target="_blank"
						class="px-3 py-1.5 rounded-btn bg-surface-muted hover:bg-surface text-content-muted hover:text-content text-xs font-medium border border-content/10 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
					>
						Подробнее
					</a>
				</div>
			</div>
		</div>
	</div>
}
