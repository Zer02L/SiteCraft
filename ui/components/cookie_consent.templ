package components

import "sitecraft/internal/models"

templ CookieConsent(settings models.SiteSettings) {
	<!-- Cookie Consent Banner (152-ФЗ Compliance) -->
	<div
		x-data="{
			show: false,
			init() {
				if (!localStorage.getItem('sitecraft_cookie_consent')) {
					setTimeout(() => { this.show = true }, 1000);
				}
			},
			accept() {
				localStorage.setItem('sitecraft_cookie_consent', 'accepted');
				this.show = false;
			}
		}"
		x-show="show"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-4 scale-95"
		x-transition:enter-end="opacity-100 translate-y-0 scale-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-y-0 scale-100"
		x-transition:leave-end="opacity-0 translate-y-4 scale-95"
		class="fixed bottom-4 right-4 left-4 sm:left-auto sm:max-w-md z-40 bg-surface/95 backdrop-blur-md p-4 rounded-2xl border border-content/15 shadow-xl text-xs text-content select-none"
		style="display: none;"
	>
		<div class="flex items-start gap-3">
			<span class="text-xl flex-shrink-0">🍪</span>
			<div class="space-y-2 flex-grow">
				<p class="leading-relaxed text-content/85 text-[11px]">
					Мы используем обязательные файлы cookie и обезличенные данные аналитики в соответствии с требованиями 152-ФЗ.
					Продолжая использовать сайт, вы соглашаетесь с <a href="/privacy" target="_blank" class="text-primary font-bold underline hover:opacity-80">Политикой конфиденциальности</a>.
				</p>
				<div class="flex items-center gap-2 pt-1">
					<button
						type="button"
						@click="accept()"
						class="px-4 py-1.5 rounded-lg bg-primary text-white font-bold text-xs hover:bg-primary-dark transition shadow-xs cursor-pointer active:scale-95"
					>
						Понятно, принять
					</button>
					<a
						href="/privacy"
						target="_blank"
						class="px-3 py-1.5 rounded-lg bg-surface-muted text-content-muted hover:text-content text-xs font-semibold transition"
					>
						Подробнее
					</a>
				</div>
			</div>
		</div>
	</div>
}
