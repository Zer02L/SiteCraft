package cinematic

templ GlitchText(text string, tag string) {
	<div class="cinematic-glitch-container relative inline-block select-none">
		<span class="cinematic-glitch-text relative inline-block font-extrabold tracking-tight uppercase" data-glitch-text={ text }>
			{ text }
		</span>
	</div>

	<style>
		.cinematic-glitch-text {
			position: relative;
			color: inherit;
		}
		.cinematic-glitch-text::before,
		.cinematic-glitch-text::after {
			content: attr(data-glitch-text);
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
		}
		.cinematic-glitch-text::before {
			left: 2px;
			text-shadow: -2px 0 #00ffff;
			animation: glitch-anim-1 2.5s infinite linear alternate-reverse;
		}
		.cinematic-glitch-text::after {
			left: -2px;
			text-shadow: 2px 0 #ff007f;
			animation: glitch-anim-2 3s infinite linear alternate-reverse;
		}

		@keyframes glitch-anim-1 {
			0% { clip-path: inset(20% 0 60% 0); transform: skew(0.3deg); }
			20% { clip-path: inset(80% 0 5% 0); transform: skew(-0.2deg); }
			40% { clip-path: inset(10% 0 70% 0); transform: skew(0.5deg); }
			60% { clip-path: inset(50% 0 30% 0); transform: skew(-0.4deg); }
			80% { clip-path: inset(25% 0 50% 0); transform: skew(0.2deg); }
			100% { clip-path: inset(70% 0 10% 0); transform: skew(0deg); }
		}

		@keyframes glitch-anim-2 {
			0% { clip-path: inset(10% 0 80% 0); transform: skew(-0.4deg); }
			20% { clip-path: inset(60% 0 20% 0); transform: skew(0.3deg); }
			40% { clip-path: inset(30% 0 50% 0); transform: skew(-0.2deg); }
			60% { clip-path: inset(80% 0 10% 0); transform: skew(0.5deg); }
			80% { clip-path: inset(15% 0 65% 0); transform: skew(-0.3deg); }
			100% { clip-path: inset(45% 0 35% 0); transform: skew(0deg); }
		}

		@media (prefers-reduced-motion: reduce) {
			.cinematic-glitch-text::before,
			.cinematic-glitch-text::after {
				display: none !important;
			}
		}
	</style>
}
