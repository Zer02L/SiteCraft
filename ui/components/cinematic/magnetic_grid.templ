package cinematic

templ MagneticRepelGrid(title string, subtitle string) {
	<section class="cinematic-magnetic-grid py-20 px-4 max-w-5xl mx-auto text-center" data-repel-section>
		if title != "" || subtitle != "" {
			<div class="mb-12">
				if subtitle != "" {
					<span class="text-xs uppercase tracking-widest text-accent font-semibold mb-2 block">{ subtitle }</span>
				}
				if title != "" {
					<h2 class="text-3xl sm:text-5xl font-extrabold text-content tracking-tight">{ title }</h2>
				}
			</div>
		}

		<div
			class="repel-canvas-grid mx-auto grid grid-cols-6 sm:grid-cols-10 md:grid-cols-12 gap-3 sm:gap-4 p-8 rounded-3xl bg-surface border border-surface-muted/80 shadow-xl overflow-hidden select-none"
			data-repel-grid
		>
			<!-- Точки/плитки генерируются циклом или скриптом -->
			for i := 0; i < 72; i++ {
				<div class="repel-dot w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-surface-muted/60 border border-surface-muted flex items-center justify-center transition-transform duration-100 ease-out will-change-transform">
					<span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
				</div>
			}
		</div>
	</section>

	<script>
		(function() {
			function initRepelGrid() {
				document.querySelectorAll('[data-repel-section]').forEach(function(section) {
					if (section.dataset.repelInit) return;
					section.dataset.repelInit = 'true';

					var dots = section.querySelectorAll('.repel-dot');
					var maxDist = 120;
					var repelForce = 32;

					section.addEventListener('mousemove', function(e) {
						var mouseX = e.clientX;
						var mouseY = e.clientY;

						dots.forEach(function(dot) {
							var rect = dot.getBoundingClientRect();
							var cx = rect.left + rect.width / 2;
							var cy = rect.top + rect.height / 2;
							var dx = cx - mouseX;
							var dy = cy - mouseY;
							var dist = Math.hypot(dx, dy);

							if (dist < maxDist) {
								var factor = (1 - dist / maxDist) * repelForce;
								var angle = Math.atan2(dy, dx);
								var tx = Math.cos(angle) * factor;
								var ty = Math.sin(angle) * factor;
								dot.style.transform = 'translate(' + tx.toFixed(1) + 'px, ' + ty.toFixed(1) + 'px) scale(1.15)';
								dot.style.borderColor = 'rgba(var(--color-accent), 0.6)';
							} else {
								dot.style.transform = 'translate(0px, 0px) scale(1)';
								dot.style.borderColor = '';
							}
						});
					});

					section.addEventListener('mouseleave', function() {
						dots.forEach(function(dot) {
							dot.style.transform = 'translate(0px, 0px) scale(1)';
							dot.style.borderColor = '';
						});
					});
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initRepelGrid);
			} else {
				initRepelGrid();
			}
			document.addEventListener('htmx:afterSwap', initRepelGrid);
		})();
	</script>
}
