package cinematic

type ColorShiftSection struct {
	ThemeAttribute string // например "legal", "medical", "auto", "cyber" или hex/rgb
	Badge          string
	Title          string
	Description    string
}

templ ScrollColorShift(sections []ColorShiftSection) {
	<div class="cinematic-color-shift-wrapper relative w-full" data-color-shift-wrapper>
		for idx, sec := range sections {
			<section
				class="min-h-[85vh] flex flex-col items-center justify-center text-center px-4 py-20 transition-colors duration-700"
				data-color-shift-section={ sec.ThemeAttribute }
				data-section-index={ templ.EscapeString(string(rune(idx))) }
			>
				<div class="max-w-3xl mx-auto p-8 sm:p-12 rounded-3xl bg-surface/80 border border-surface-muted backdrop-blur-md shadow-xl">
					if sec.Badge != "" {
						<span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent mb-4">
							{ sec.Badge }
						</span>
					}
					<h2 class="text-3xl sm:text-5xl font-extrabold text-content tracking-tight mb-4">
						{ sec.Title }
					</h2>
					<p class="text-lg text-content-muted leading-relaxed">
						{ sec.Description }
					</p>
				</div>
			</section>
		}
	</div>

	<script>
		(function() {
			function initColorShift() {
				var sections = document.querySelectorAll('[data-color-shift-section]');
				if (sections.length === 0) return;

				var observer = new IntersectionObserver(function(entries) {
					entries.forEach(function(entry) {
						if (entry.isIntersecting) {
							var theme = entry.target.dataset.colorShiftSection;
							if (theme) {
								document.documentElement.setAttribute('data-theme', theme);
							}
						}
					});
				}, {
					threshold: 0.5
				});

				sections.forEach(function(s) {
					observer.observe(s);
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initColorShift);
			} else {
				initColorShift();
			}
			document.addEventListener('htmx:afterSwap', initColorShift);
		})();
	</script>
}
