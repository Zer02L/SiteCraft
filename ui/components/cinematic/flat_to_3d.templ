package cinematic

import (
	"fmt"
	"github.com/Oudwins/tailwind-merge-go"
)

type FlatTo3DLayer struct {
	ID          string `json:"id"`
	Number      string `json:"number"`
	Title       string `json:"title"`
	Subtitle    string `json:"subtitle"`
	Description string `json:"description"`
	Material    string `json:"material"`
	Thickness   string `json:"thickness"`
}

type FlatTo3DProps struct {
	ID           string
	ProjectName  string
	Subtitle     string
	Layers       []FlatTo3DLayer
	ScrollHeight string // e.g. "h-[360vh]"
	Class        string
}

// DefaultNordicHouseLayers returns the canonical 5-layer architectural breakdown for a modern timber villa.
func DefaultNordicHouseLayers() []FlatTo3DLayer {
	return []FlatTo3DLayer{
		{
			ID:          "foundation",
			Number:      "01",
			Title:       "Фундаментная плита и терраса",
			Subtitle:    "Утепленная шведская плита (УШП)",
			Description: "Монолитный железобетонный цоколь с интегрированными коммуникациями и настилом открытой террасы из термоясеня.",
			Material:    "Бетон B25 / Термоясень",
			Thickness:   "300 мм",
		},
		{
			ID:          "framing",
			Number:      "02",
			Title:       "Несущий клееный каркас",
			Subtitle:    "Стойки и ригели из клееного бруса",
			Description: "Высокоточный деревянный остов заводской зарезки с узлами на скрытых стальных пластинах повышенной сейсмостойкости.",
			Material:    "Северная ель / Клей Melamine",
			Thickness:   "200×240 мм",
		},
		{
			ID:          "glazing",
			Number:      "03",
			Title:       "Теплый контур и остекление",
			Subtitle:    "Мультифункциональные стеклопакеты",
			Description: "Безрамные порталы от пола до потолка с аргоновым заполнением и напылением Solar Control для максимальной инсоляции.",
			Material:    "Триплекс 6-16Ar-6i",
			Thickness:   "52 мм",
		},
		{
			ID:          "cladding",
			Number:      "04",
			Title:       "Вентилируемый фасад",
			Subtitle:    "Лиственничный планкен скрытого монтажа",
			Description: "Фасадная рейка со скошенным профилем и ветрозащитной супердиффузионной мембраной с пассивной циркуляцией воздуха.",
			Material:    "Сибирская лиственница",
			Thickness:   "45 мм",
		},
		{
			ID:          "roof",
			Number:      "05",
			Title:       "Стропильная ферма и кровля",
			Subtitle:    "Кликфальц с базальтовым утеплением",
			Description: "Двускатная кровля с углом 28° и интегрированными мансардными окнами, устойчивая к снеговым нагрузкам IV района.",
			Material:    "Сталь Ruukki 0.5 мм / Paroc 250мм",
			Thickness:   "280 мм",
		},
	}
}

templ FlatTo3D(props FlatTo3DProps) {
	<!-- Синхронный контроллер Alpine.js для гарантированной ранней инициализации -->
	<script>
		(function() {
			// Константы GLSL-шейдеров
			var VERTEX_SHADER_SRC = [
				'attribute vec3 position;',
				'attribute vec3 normal;',
				'uniform mat4 modelMatrix;',
				'uniform mat4 viewMatrix;',
				'uniform mat4 projectionMatrix;',
				'varying vec3 vWorld;',
				'varying vec3 vNormal;',
				'varying vec3 vLocal;',
				'void main() {',
				'    vLocal = position;',
				'    vNormal = normal;',
				'    vec4 wp = modelMatrix * vec4(position, 1.0);',
				'    vWorld = wp.xyz;',
				'    gl_Position = projectionMatrix * viewMatrix * wp;',
				'}'
			].join('\n');

			var FRAGMENT_SHADER_SRC = [
				'precision highp float;',
				'uniform float uDrawSweep;',
				'uniform vec3 uBaseColor;',
				'uniform vec3 uAccentColor;',
				'uniform float uOpacity;',
				'varying vec3 vWorld;',
				'varying vec3 vNormal;',
				'varying vec3 vLocal;',
				'float hashPaper(vec3 p) {',
				'    p = fract(p * vec3(443.897, 441.423, 437.195));',
				'    p += dot(p, p.yzx + 19.19);',
				'    return fract((p.x + p.y) * p.z);',
				'}',
				'void main() {',
				'    if (vWorld.y > uDrawSweep) discard;',
				'    vec3 lightDir = normalize(vec3(0.55, 0.85, 0.45));',
				'    float diff = max(0.55, dot(vNormal, lightDir));',
				'    vec3 col = uBaseColor * (0.65 + 0.35 * diff);',
				'    float edge = abs(vWorld.y - uDrawSweep);',
				'    if (edge < 0.4) {',
				'        col = mix(uAccentColor, col, smoothstep(0.0, 0.4, edge));',
				'    }',
				'    float grain = (hashPaper(floor(vLocal * 140.0)) - 0.5) * 0.035;',
				'    col *= (1.0 + grain);',
				'    gl_FragColor = vec4(col, uOpacity);',
				'}'
			].join('\n');

			function defineController() {
				return {
					progress: 0,
					activeLayerIndex: 0,
					activeLayerTitle: 'Плита основания',
					fovDisplay: '1.5°',
					headingAngle: 45,
					reducedMotion: false,
					isActive: true,
					observer: null,

					renderer: null,
					camera: null,
					scene: null,
					layers: [],
					drawSweepUniform: { value: 50.0 },
					OGL: null,

					async init() {
						this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
							|| document.documentElement.classList.contains('a11y-mode')
							|| document.body.classList.contains('a11y-mode');

						if (this.reducedMotion) return;

						try {
							this.OGL = await import('/assets/js/ogl.mjs');
							this.initOGL();
						} catch (e) {
							console.warn('[FlatTo3D] OGL import failed, falling back to static:', e);
							this.reducedMotion = true;
							return;
						}

						if ('IntersectionObserver' in window) {
							this.observer = new IntersectionObserver((entries) => {
								for (const entry of entries) {
									if (entry.isIntersecting) {
										this.resume();
									} else {
										this.pause();
									}
								}
							}, { threshold: 0.05 });
							this.observer.observe(this.$el);
						}

						window.addEventListener('scroll', () => this.onScroll(), { passive: true });
						window.addEventListener('resize', () => this.onResize(), { passive: true });
						this.onScroll();

						// HTMX очистка контекста WebGL
						document.body.addEventListener('htmx:beforeCleanupElement', (e) => {
							if (e.target.contains(this.$el)) {
								this.cleanup();
							}
						}, { once: true });
					},

					initOGL() {
						const canvas = this.$refs.canvas;
						if (!canvas || !this.OGL) return;

						const { Renderer, Camera, Transform } = this.OGL;

						try {
							this.renderer = new Renderer({
								canvas,
								dpr: Math.min(window.devicePixelRatio || 1, 2),
								antialias: true,
								alpha: true,
								preserveDrawingBuffer: true,
								powerPreference: 'high-performance'
							});
						} catch (err) {
							console.warn('[FlatTo3D] WebGL not available:', err);
							this.reducedMotion = true;
							return;
						}

						const gl = this.renderer.gl;
						this.scene = new Transform();

						// Камера под углом 45°/28°
						this.camera = new Camera(gl, { fov: 1.5, near: 0.5, far: 4000 });

						this.buildLayers(gl);
						this.onResize();
						this.updateScene(0);
						this.renderScene();

						// Отложенный повторный замер для гарантии правильных габаритов
						requestAnimationFrame(() => {
							this.onResize();
							this.onScroll();
							this.renderScene();
						});
					},

					buildLayers(gl) {
						const { Transform, Mesh, Box, Color, Program, WireMesh } = this.OGL;
						const darkInk = new Color(0.14, 0.14, 0.13);
						const accent = new Color(0.91, 0.36, 0.02);

						// Фабрика деталей с контурными ребрами
						const makePart = (w, h, d, colorRgb, opacity = 1.0) => {
							const geom = new Box(gl, { width: w, height: h, depth: d });
							
							const prog = new Program(gl, {
								vertex: VERTEX_SHADER_SRC,
								fragment: FRAGMENT_SHADER_SRC,
								uniforms: {
									uDrawSweep: this.drawSweepUniform,
									uBaseColor: { value: new Color(...colorRgb) },
									uAccentColor: { value: accent },
									uOpacity: { value: opacity }
								},
								transparent: opacity < 1.0,
								depthTest: true,
								depthWrite: opacity >= 1.0
							});

							const mesh = new Mesh(gl, { geometry: geom, program: prog });
							const wire = new WireMesh(gl, { geometry: geom, wireColor: darkInk });
							mesh.addChild(wire);
							return mesh;
						};

						// Цвета материалов
						const colConcrete = [0.86, 0.84, 0.80]; // Бетон плиты
						const colTimber = [0.84, 0.70, 0.54];   // Клееный брус
						const colGlass = [0.75, 0.88, 0.92];    // Панорамное остекление
						const colFacade = [0.78, 0.62, 0.44];   // Лиственничный планкен
						const colRoof = [0.28, 0.32, 0.36];     // Графитовый фальц

						// Слой 1: Плита фундамента с террасой
						const slabNode = new Transform();
						slabNode.addChild(makePart(10.0, 0.4, 8.0, colConcrete));
						this.scene.addChild(slabNode);

						// Слой 2: Силовой каркас
						const frameNode = new Transform();
						const p1 = makePart(0.24, 2.9, 0.24, colTimber); p1.position.set(-4.5, 1.45, -3.5); frameNode.addChild(p1);
						const p2 = makePart(0.24, 2.9, 0.24, colTimber); p2.position.set(4.5, 1.45, -3.5); frameNode.addChild(p2);
						const p3 = makePart(0.24, 2.9, 0.24, colTimber); p3.position.set(-4.5, 1.45, 3.5); frameNode.addChild(p3);
						const p4 = makePart(0.24, 2.9, 0.24, colTimber); p4.position.set(4.5, 1.45, 3.5); frameNode.addChild(p4);
						const beamTop = makePart(9.2, 0.25, 7.2, colTimber); beamTop.position.set(0, 2.95, 0); frameNode.addChild(beamTop);
						this.scene.addChild(frameNode);

						// Слой 3: Остекление
						const glassNode = new Transform();
						const glassFront = makePart(8.8, 2.6, 0.08, colGlass, 0.65); glassFront.position.set(0, 1.4, 3.4); glassNode.addChild(glassFront);
						const glassSide = makePart(0.08, 2.6, 6.8, colGlass, 0.65); glassSide.position.set(4.4, 1.4, 0); glassNode.addChild(glassSide);
						this.scene.addChild(glassNode);

						// Слой 4: Вентилируемый фасад
						const facadeNode = new Transform();
						const wallBack = makePart(9.2, 2.8, 0.25, colFacade); wallBack.position.set(0, 1.4, -3.5); facadeNode.addChild(wallBack);
						const wallLeft = makePart(0.25, 2.8, 7.0, colFacade); wallLeft.position.set(-4.5, 1.4, 0); facadeNode.addChild(wallLeft);
						this.scene.addChild(facadeNode);

						// Слой 5: Кровля
						const roofNode = new Transform();
						const r1 = makePart(9.8, 0.35, 4.4, colRoof); r1.position.set(0, 4.2, -1.8); r1.rotation.x = -0.38; roofNode.addChild(r1);
						const r2 = makePart(9.8, 0.35, 4.4, colRoof); r2.position.set(0, 4.2, 1.8); r2.rotation.x = 0.38; roofNode.addChild(r2);
						this.scene.addChild(roofNode);

						// Реестр слоев для анимации
						this.layers = [
							{ node: slabNode, baseY: 0.2, floatY: 0.2, title: 'Фундаментная плита' },
							{ node: frameNode, baseY: 0.2, floatY: 5.5, title: 'Несущий каркас CLT' },
							{ node: glassNode, baseY: 0.2, floatY: 10.5, title: 'Панорамное остекление' },
							{ node: facadeNode, baseY: 0.2, floatY: 15.5, title: 'Лиственничный фасад' },
							{ node: roofNode, baseY: 0.2, floatY: 21.0, title: 'Двускатная кровля' }
						];
					},

					onScroll() {
						if (!this.isActive || this.reducedMotion || !this.renderer) return;
						const rect = this.$el.getBoundingClientRect();
						const scrollDist = this.$el.offsetHeight - window.innerHeight;
						if (scrollDist <= 0) return;

						const p = Math.max(0, Math.min(1, -rect.top / scrollDist));
						this.progress = p;

						this.updateScene(p);
						this.renderScene();
					},

					updateScene(p) {
						if (!this.camera || !this.renderer || !this.layers.length) return;

						const easeCubic = t => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
						const win = (val, a, b) => Math.min(1, Math.max(0, (val - a) / (b - a)));

						// Поочередное опускание слоев
						const pFrame = easeCubic(win(p, 0.08, 0.26));
						this.layers[1].node.position.y = this.layers[1].floatY * (1 - pFrame) + this.layers[1].baseY * pFrame;

						const pGlass = easeCubic(win(p, 0.22, 0.40));
						this.layers[2].node.position.y = this.layers[2].floatY * (1 - pGlass) + this.layers[2].baseY * pGlass;

						const pFacade = easeCubic(win(p, 0.36, 0.54));
						this.layers[3].node.position.y = this.layers[3].floatY * (1 - pFacade) + this.layers[3].baseY * pFacade;

						const pRoof = easeCubic(win(p, 0.50, 0.68));
						this.layers[4].node.position.y = this.layers[4].floatY * (1 - pRoof) + this.layers[4].baseY * pRoof;

						// Dolly Zoom (Камера от 1.5° аксонометрии до 50° перспективы)
						const pDolly = easeCubic(win(p, 0.62, 1.0));
						const fov = 1.5 + pDolly * 48.5;
						const aspect = this.renderer.width / this.renderer.height;
						this.camera.perspective({ fov, aspect, near: 0.5, far: 4000 });

						// Интерполяция угла азимута и дистанции
						const D2R = Math.PI / 180;
						const az = (45 - pDolly * 30) * D2R; // 45° -> 15°
						const el = (28 - pDolly * 23) * D2R; // 28° -> 5°
						
						// Дистанция от 1100 м до 6 м у крыльца
						const dist = 1100 * (1 - pDolly * 0.9945);
						const targetY = 7.5 * (1 - pDolly) + 1.65 * pDolly;

						const camX = dist * Math.cos(el) * Math.cos(az);
						const camY = targetY + dist * Math.sin(el);
						const camZ = dist * Math.cos(el) * Math.sin(az);

						this.camera.position.set(camX, camY, camZ);
						this.camera.lookAt([0, targetY, 0]);

						// Обновление HUD
						this.fovDisplay = fov.toFixed(1) + '°';
						this.headingAngle = Math.round(45 + p * 45);

						if (p < 0.20) this.activeLayerIndex = 0;
						else if (p < 0.35) this.activeLayerIndex = 1;
						else if (p < 0.48) this.activeLayerIndex = 2;
						else if (p < 0.64) this.activeLayerIndex = 3;
						else this.activeLayerIndex = 4;

						this.activeLayerTitle = this.layers[this.activeLayerIndex].title;
					},

					renderScene() {
						if (this.renderer && this.scene && this.camera) {
							this.renderer.render({ scene: this.scene, camera: this.camera });
						}
					},

					onResize() {
						if (!this.renderer || !this.camera) return;
						const w = this.$el.clientWidth || window.innerWidth;
						const h = window.innerHeight;
						this.renderer.setSize(w, h);
						this.camera.perspective({ aspect: w / h });
						this.renderScene();
					},

					resume() {
						this.isActive = true;
						this.renderScene();
					},

					pause() {
						this.isActive = false;
					},

					scrollToLayer(idx) {
						const scrollDist = this.$el.offsetHeight - window.innerHeight;
						if (scrollDist <= 0) return;
						const targets = [0.0, 0.22, 0.38, 0.52, 0.72];
						const targetP = targets[idx] || 0;
						const targetScroll = this.$el.offsetTop + targetP * scrollDist;
						window.scrollTo({ top: targetScroll, behavior: 'smooth' });
					},

					cleanup() {
						this.pause();
						if (this.observer) {
							this.observer.disconnect();
							this.observer = null;
						}
						if (this.renderer?.gl) {
							this.renderer.gl.getExtension('WEBGL_lose_context')?.loseContext();
							this.renderer = null;
						}
					}
				};
			}

			window.flatTo3DController = defineController;
			if (window.Alpine) {
				window.Alpine.data('flatTo3DController', defineController);
			} else {
				document.addEventListener('alpine:init', function() {
					window.Alpine.data('flatTo3DController', defineController);
				});
			}
		})();
	</script>

	<section
		id={ props.ID }
		class={ twmerge.Merge("relative w-full bg-surface text-content", props.ScrollHeight, props.Class) }
		data-flat-to-3d
		data-id={ props.ID }
		x-data="flatTo3DController()"
	>
		<!-- 100svh Sticky Viewport Scene -->
		<div class="sticky top-0 h-screen w-full overflow-hidden select-none bg-surface">
			<!-- Canvas для OGL WebGL -->
			<canvas
				x-ref="canvas"
				class="absolute inset-0 h-full w-full block transition-opacity duration-700"
				:class="{ 'opacity-0 pointer-events-none': reducedMotion }"
				aria-hidden="true"
			></canvas>

			<!-- Чертежная CAD-рамка в архитектурном стиле -->
			<div class="pointer-events-none absolute inset-3 sm:inset-6 border border-content/15 flex flex-col justify-between p-3 sm:p-6">
				<!-- Верхний статус-бар чертежа -->
				<div class="flex justify-between items-start font-mono text-[11px] sm:text-xs">
					<div class="space-y-0.5">
						<div class="flex items-center space-x-2">
							<span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
							<span class="font-bold tracking-widest uppercase">{ props.ProjectName }</span>
							<span class="text-content/40 hidden sm:inline">| AXO-SCAN</span>
						</div>
						<div class="text-content/60 text-[10px]">
							{ props.Subtitle } &middot; <span class="text-accent font-semibold" x-text="'[' + activeLayerTitle + ']'"></span>
						</div>
					</div>
					<div class="text-right">
						<div class="font-bold text-accent" x-text="'СБОРКА: ' + Math.round(progress * 100) + '%'"></div>
						<div class="text-[10px] text-content/40 font-mono">DRAFT REV 4.2</div>
					</div>
				</div>

				<!-- Нижняя навигационная панель чертежа с радаром -->
				<div class="flex justify-between items-end">
					<div class="font-mono text-[10px] sm:text-[11px] text-content/60 space-y-1">
						<div class="flex items-center space-x-2">
							<span class="inline-block w-2.5 h-0.5 bg-accent"></span>
							<span>МАСШТАБ 1:50 (OGL WebGL)</span>
						</div>
						<div>ОБЪЕКТИВ: <span class="text-content font-bold" x-text="fovDisplay"></span></div>
						<div class="text-content/40 hidden sm:block">ПРОЦЕДУРНАЯ ГЕОМЕТРИЯ &middot; 0 КБ ТЕКСТУР</div>
					</div>

					<!-- Мини-компас ориентации на север -->
					<div class="flex flex-col items-center space-y-1">
						<div class="w-11 h-11 sm:w-14 sm:h-14 border border-content/25 rounded-full relative flex items-center justify-center bg-surface/40 backdrop-blur-sm">
							<div
								class="w-0.5 h-4 sm:h-5 bg-accent absolute top-1.5 origin-bottom transition-transform duration-75"
								:style="'transform: rotate(' + headingAngle + 'deg)'"
							></div>
							<div class="w-1 h-1 rounded-full bg-content/60"></div>
							<span class="text-[8px] font-mono text-content/60 absolute top-0.5">N</span>
						</div>
						<span class="text-[9px] font-mono text-content/50">АЗИМУТ</span>
					</div>
				</div>
			</div>

			<!-- Информационные плашки шагов (Scrollytelling HUD) -->
			<div class="pointer-events-none absolute right-4 sm:right-10 top-1/2 -translate-y-1/2 w-72 sm:w-88 space-y-2.5 z-10">
				for i, layer := range props.Layers {
					<div
						class="p-3.5 sm:p-4 rounded-xl border backdrop-blur-md transition-all duration-300 pointer-events-auto cursor-pointer"
						:class={ fmt.Sprintf("activeLayerIndex === %d ? 'bg-surface/90 border-accent shadow-xl translate-x-0' : 'bg-surface/40 border-content/10 text-content/40 translate-x-2 opacity-70 hover:opacity-100'", i) }
						@click={ fmt.Sprintf("scrollToLayer(%d)", i) }
					>
						<div class="flex items-center justify-between">
							<div class="flex items-center space-x-2">
								<span
									class="w-5 h-5 rounded-md flex items-center justify-center font-mono text-[10px] font-bold border transition-colors"
									:class={ fmt.Sprintf("activeLayerIndex === %d ? 'bg-accent text-white border-accent' : 'border-content/20 text-content/50'", i) }
								>
									{ layer.Number }
								</span>
								<h3 class="font-semibold text-xs sm:text-sm tracking-tight text-content">{ layer.Title }</h3>
							</div>
							<span class="font-mono text-[9px] uppercase tracking-wider text-content/50">{ layer.Thickness }</span>
						</div>
						<div
							x-show={ fmt.Sprintf("activeLayerIndex === %d", i) }
							x-transition:enter="transition ease-out duration-200"
							x-transition:enter-start="opacity-0 -translate-y-1"
							x-transition:enter-end="opacity-100 translate-y-0"
						>
							<p class="mt-2 text-xs text-content/80 leading-relaxed">
								{ layer.Description }
							</p>
							<div class="mt-2.5 pt-2 border-t border-content/10 flex items-center justify-between font-mono text-[10px] text-content/60">
								<span>МАТЕРИАЛ:</span>
								<span class="text-accent font-medium">{ layer.Material }</span>
							</div>
						</div>
					</div>
				}
			</div>

			<!-- Доступный статический фоллбек (ГОСТ Р 52872-2019 / Reduced Motion) -->
			<div
				x-show="reducedMotion"
				class="absolute inset-0 z-20 bg-surface p-6 sm:p-12 overflow-y-auto"
				role="region"
				aria-label="Архитектурная экспликация проекта"
			>
				<div class="max-w-4xl mx-auto space-y-8">
					<div class="border-b border-content/15 pb-5">
						<span class="text-accent font-mono text-xs uppercase font-bold tracking-wider">ГОСТ Р 52872-2019</span>
						<h2 class="text-2xl sm:text-3xl font-bold text-content mt-1">{ props.ProjectName } &mdash; Экспликация слоев</h2>
						<p class="text-sm text-content/70 mt-1">Режим высокой доступности: статический архитектурный планшет без эффектов движения.</p>
					</div>

					<div class="grid gap-4 sm:grid-cols-2">
						for _, layer := range props.Layers {
							<div class="p-5 border border-content/15 rounded-xl bg-surface/50 space-y-2">
								<div class="flex items-center justify-between font-mono text-xs">
									<span class="text-accent font-bold">СЛОЙ { layer.Number }</span>
									<span class="text-content/50">{ layer.Thickness }</span>
								</div>
								<h3 class="text-base font-semibold text-content">{ layer.Title }</h3>
								<div class="text-xs text-accent font-mono">{ layer.Subtitle }</div>
								<p class="text-xs text-content/75 leading-relaxed">{ layer.Description }</p>
								<div class="pt-2 text-[11px] font-mono text-content/60 border-t border-content/10">
									Материал: <strong class="text-content">{ layer.Material }</strong>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</section>
}
