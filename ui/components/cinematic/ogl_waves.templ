package cinematic

import "sitecraft/internal/models"

type OglWavesProps struct {
	PrimaryColor string
	AccentColor  string
	Wireframe    bool
	Interactive  bool
}

// OglWavesBackground provides a zero-bundle-overhead 3D WebGL liquid wave background powered by OGL.
// It features:
// - Direct ESM import from embedded /assets/js/ogl.mjs (Zero external CDN)
// - Dynamic theme colors from SiteCraft / PocketBase settings
// - IntersectionObserver for 0% CPU/GPU overhead when off-screen
// - Full a11y & prefers-reduced-motion compliance (GOST compatible)
// - Automatic HTMX cleanup to eliminate WebGL context leaks
templ OglWavesBackground(settings models.SiteSettings) {
	@OglWaves(OglWavesProps{
		PrimaryColor: settings.PrimaryColor,
		AccentColor:  settings.AccentColor,
		Wireframe:    false,
		Interactive:  true,
	})
}

templ OglWaves(props OglWavesProps) {
	<div
		class="cinematic-ogl-waves absolute inset-0 -z-10 overflow-hidden pointer-events-none select-none"
		data-ogl-waves
		data-primary={ props.PrimaryColor }
		data-accent={ props.AccentColor }
		data-wireframe={ templ.EscapeString(boolToString(props.Wireframe)) }
		data-interactive={ templ.EscapeString(boolToString(props.Interactive)) }
	>
		<canvas class="w-full h-full block opacity-75"></canvas>
	</div>

	<script type="module">
		import { Renderer, Camera, Transform, Program, Mesh, Plane } from '/assets/js/ogl.mjs';

		function hexToRgb(hex, fallback) {
			if (!hex || typeof hex !== 'string') return fallback;
			hex = hex.trim().replace('#', '');
			if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
			if (hex.length !== 6) return fallback;
			const num = parseInt(hex, 16);
			return [
				((num >> 16) & 255) / 255,
				((num >> 8) & 255) / 255,
				(num & 255) / 255
			];
		}

		function getComputedColor(varName, fallback) {
			const val = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
			if (!val) return fallback;
			if (val.startsWith('#')) return hexToRgb(val, fallback);
			return fallback;
		}

		function initOglContainer(container) {
			if (container.__oglInitialized) return;
			container.__oglInitialized = true;

			const canvas = container.querySelector('canvas');
			if (!canvas) return;

			// Проверка режима доступности (ГОСТ) и prefers-reduced-motion
			const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const isA11y = document.documentElement.classList.contains('a11y-mode');

			let renderer;
			try {
				renderer = new Renderer({
					canvas,
					alpha: true,
					antialias: true,
					dpr: Math.min(window.devicePixelRatio || 1, 2),
					powerPreference: 'low-power'
				});
			} catch (e) {
				console.warn('[SiteCraft OGL] WebGL not supported, falling back to clean CSS.', e);
				return;
			}

			const gl = renderer.gl;
			const scene = new Transform();
			const camera = new Camera(gl, { fov: 45 });
			camera.position.set(0, 1.2, 3.2);
			camera.lookAt([0, 0, 0]);

			// Разрешение цветов с учетом темы
			const primaryHex = container.getAttribute('data-primary');
			const accentHex = container.getAttribute('data-accent');
			const uPrimary = hexToRgb(primaryHex, getComputedColor('--color-primary', [0.12, 0.16, 0.23]));
			const uAccent = hexToRgb(accentHex, getComputedColor('--color-accent', [0.15, 0.45, 0.95]));

			const vertexShader = `
				attribute vec3 position;
				attribute vec2 uv;
				uniform mat4 modelViewMatrix;
				uniform mat4 projectionMatrix;
				uniform float uTime;
				uniform vec2 uMouse;

				varying vec2 vUv;
				varying float vElevation;

				void main() {
					vUv = uv;
					vec3 pos = position;

					// Расчет органических 3D-волн
					float wave1 = sin(pos.x * 2.5 + uTime * 0.9) * 0.18;
					float wave2 = cos(pos.y * 2.0 + uTime * 0.7) * 0.14;
					float wave3 = sin((pos.x + pos.y) * 1.8 + uTime * 0.5) * 0.12;

					// Реакция на положение курсора
					float distToMouse = length(pos.xy - uMouse * 2.0);
					float mousePush = sin(clamp(1.0 - distToMouse * 0.5, 0.0, 1.0) * 3.1415) * 0.22;

					pos.z += wave1 + wave2 + wave3 + mousePush;
					vElevation = pos.z;

					gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
				}
			`;

			const fragmentShader = `
				precision highp float;
				uniform vec3 uPrimaryColor;
				uniform vec3 uAccentColor;
				uniform float uTime;
				varying vec2 vUv;
				varying float vElevation;

				void main() {
					float mixFactor = clamp((vElevation + 0.35) * 1.4, 0.0, 1.0);
					vec3 col = mix(uPrimaryColor, uAccentColor, mixFactor);

					// Мягкий световой блик по краю гребня волны
					float highlight = pow(clamp(vElevation * 2.2, 0.0, 1.0), 2.5) * 0.35;
					col += vec3(highlight);

					// Градиентное затухание к краям канваса для бесшовности
					float edgeFade = smoothstep(0.0, 0.2, vUv.x) * smoothstep(1.0, 0.8, vUv.x) *
					                 smoothstep(0.0, 0.2, vUv.y) * smoothstep(1.0, 0.8, vUv.y);

					gl_FragColor = vec4(col, edgeFade * 0.7);
				}
			`;

			// Плотная сетка 48x48 для плавных деформаций
			const geometry = new Plane(gl, {
				width: 4.8,
				height: 3.4,
				widthSegments: 48,
				heightSegments: 48
			});

			const program = new Program(gl, {
				vertex: vertexShader,
				fragment: fragmentShader,
				transparent: true,
				cullFace: null,
				uniforms: {
					uTime: { value: 0 },
					uMouse: { value: [0, 0] },
					uPrimaryColor: { value: uPrimary },
					uAccentColor: { value: uAccent }
				}
			});

			const mesh = new Mesh(gl, { geometry, program });
			mesh.rotation.x = -Math.PI * 0.32;
			mesh.setParent(scene);

			function resize() {
				const rect = container.getBoundingClientRect();
				const width = Math.max(rect.width, 300);
				const height = Math.max(rect.height, 200);
				renderer.setSize(width, height);
				camera.perspective({ aspect: width / height });
			}
			window.addEventListener('resize', resize, { passive: true });
			resize();

			// Интерактивность мыши с плавным lerp
			let targetMouse = [0, 0];
			let currentMouse = [0, 0];
			if (container.getAttribute('data-interactive') === 'true') {
				const parent = container.parentElement || window;
				parent.addEventListener('mousemove', (e) => {
					const rect = container.getBoundingClientRect();
					const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
					const y = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
					targetMouse = [x, y];
				}, { passive: true });
			}

			let animId = null;
			let isVisible = true;
			let lastTime = performance.now();

			// IntersectionObserver: пауза рендеринга при уходе из видимости (0% CPU/GPU)
			const observer = new IntersectionObserver((entries) => {
				isVisible = entries[0].isIntersecting;
				if (isVisible && !animId && !prefersReduced && !isA11y) {
					lastTime = performance.now();
					animId = requestAnimationFrame(render);
				}
			}, { threshold: 0.05 });
			observer.observe(container);

			function render(now) {
				if (!isVisible) {
					animId = null;
					return;
				}

				const delta = Math.min((now - lastTime) * 0.001, 0.05);
				lastTime = now;

				program.uniforms.uTime.value += delta * 1.2;
				currentMouse[0] += (targetMouse[0] - currentMouse[0]) * 0.05;
				currentMouse[1] += (targetMouse[1] - currentMouse[1]) * 0.05;
				program.uniforms.uMouse.value = currentMouse;

				renderer.render({ scene, camera });

				if (!prefersReduced && !isA11y) {
					animId = requestAnimationFrame(render);
				} else {
					animId = null;
				}
			}

			// Отрисовка первого кадра (для reduced-motion и мгновенного отображения)
			renderer.render({ scene, camera });
			if (!prefersReduced && !isA11y) {
				animId = requestAnimationFrame(render);
			}

			// Очистка при HTMX-удалении DOM
			function cleanup() {
				if (animId) cancelAnimationFrame(animId);
				window.removeEventListener('resize', resize);
				observer.disconnect();
				if (renderer && renderer.gl) {
					const ext = renderer.gl.getExtension('WEBGL_lose_context');
					if (ext) ext.loseContext();
				}
				container.__oglInitialized = false;
			}

			document.body.addEventListener('htmx:beforeCleanupElement', (e) => {
				if (e.target.contains(container)) cleanup();
			}, { once: true });
		}

		// Инициализация существующих контейнеров
		function scanContainers() {
			document.querySelectorAll('[data-ogl-waves]').forEach(initOglContainer);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', scanContainers);
		} else {
			scanContainers();
		}

		// Поддержка динамических свопов HTMX
		document.body.addEventListener('htmx:afterSwap', scanContainers);
	</script>
}

func boolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
