package cinematic

type FlipCardItem struct {
	FrontBadge string
	FrontTitle string
	FrontDesc  string
	FrontImage string
	BackTitle  string
	BackDesc   string
	ActionText string
	ActionURL  string
}

templ FlipCards(title string, subtitle string, items []FlipCardItem) {
	<section class="cinematic-flip-cards py-16 px-4 max-w-7xl mx-auto">
		if title != "" || subtitle != "" {
			<div class="text-center mb-12">
				if subtitle != "" {
					<span class="text-xs uppercase tracking-widest text-accent font-semibold mb-2 block">{ subtitle }</span>
				}
				if title != "" {
					<h2 class="text-3xl sm:text-4xl font-bold text-content tracking-tight">{ title }</h2>
				}
			</div>
		}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 [perspective:1200px]">
			for _, item := range items {
				<div
					class="flip-card-container group h-[380px] w-full cursor-pointer focus:outline-none"
					tabindex="0"
					onclick="this.classList.toggle('flipped')"
				>
					<div class="flip-card-inner relative h-full w-full rounded-2xl transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] group-[.flipped]:[transform:rotateY(180deg)] shadow-sm hover:shadow-xl">
						<!-- Лицевая сторона (Front) -->
						<div class="flip-card-front absolute inset-0 h-full w-full rounded-2xl bg-surface border border-surface-muted/60 p-7 flex flex-col justify-between [backface-visibility:hidden] overflow-hidden">
							if item.FrontImage != "" {
								<div class="absolute inset-0 opacity-10 bg-cover bg-center" style={ "background-image: url('" + item.FrontImage + "')" }></div>
							}
							<div class="relative z-10">
								if item.FrontBadge != "" {
									<span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-accent/10 text-accent mb-4">
										{ item.FrontBadge }
									</span>
								}
								<h3 class="text-2xl font-bold text-content tracking-tight mb-3">
									{ item.FrontTitle }
								</h3>
								<p class="text-sm text-content-muted leading-relaxed">
									{ item.FrontDesc }
								</p>
							</div>
							<div class="relative z-10 flex items-center justify-between text-xs text-content-muted font-medium pt-4 border-t border-surface-muted/60">
								<span>Нажмите или наведите</span>
								<span class="flex items-center gap-1 text-accent">
									<span>Подробнее</span>
									<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
									</svg>
								</span>
							</div>
						</div>

						<!-- Обратная сторона (Back) -->
						<div class="flip-card-back absolute inset-0 h-full w-full rounded-2xl bg-gradient-to-br from-surface to-surface-muted border border-accent/30 p-7 flex flex-col justify-between [transform:rotateY(180deg)] [backface-visibility:hidden]">
							<div>
								<div class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-bold text-sm mb-4 shadow-md">
									✦
								</div>
								<h3 class="text-xl font-bold text-content mb-3">
									{ item.BackTitle }
								</h3>
								<p class="text-sm text-content-muted leading-relaxed">
									{ item.BackDesc }
								</p>
							</div>
							if item.ActionURL != "" {
								<a
									href={ templ.SafeURL(item.ActionURL) }
									class="inline-flex items-center justify-center w-full px-5 py-2.5 rounded-xl bg-accent text-white font-medium text-sm hover:bg-accent-hover transition-colors shadow-sm"
									onclick="event.stopPropagation();"
								>
									{ item.ActionText }
								</a>
							}
						</div>
					</div>
				</div>
			}
		</div>
	</section>
}
