package cinematic

templ ParticleButton(text string, href string, btnClass string) {
	<div class="relative inline-block">
		<canvas
			class="particle-canvas pointer-events-none absolute -inset-16 z-20"
			width="300"
			height="200"
		></canvas>

		<a
			if href != "" {
				href={ templ.SafeURL(href) }
			}
			class={
				"particle-btn relative z-10 inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-semibold text-white bg-accent hover:bg-accent-hover transition-transform active:scale-95 shadow-lg shadow-accent/25 cursor-pointer ",
				btnClass,
			}
			data-particle-trigger
		>
			<span>{ text }</span>
		</a>
	</div>

	<script>
		(function() {
			function initParticleButtons() {
				document.querySelectorAll('[data-particle-trigger]').forEach(function(btn) {
					if (btn.dataset.particleInit) return;
					btn.dataset.particleInit = 'true';

					var parent = btn.parentElement;
					var canvas = parent.querySelector('.particle-canvas');
					if (!canvas) return;
					var ctx = canvas.getContext('2d');

					btn.addEventListener('click', function(e) {
						var rect = btn.getBoundingClientRect();
						var cRect = canvas.getBoundingClientRect();
						var originX = (rect.left + rect.width / 2) - cRect.left;
						var originY = (rect.top + rect.height / 2) - cRect.top;

						var particles = [];
						var count = 35;
						var colors = ['#38bdf8', '#818cf8', '#c084fc', '#f472b6', '#fbbf24'];

						for (var i = 0; i < count; i++) {
							var angle = Math.random() * Math.PI * 2;
							var speed = 2 + Math.random() * 5;
							particles.push({
								x: originX,
								y: originY,
								vx: Math.cos(angle) * speed,
								vy: Math.sin(angle) * speed,
								size: 3 + Math.random() * 4,
								alpha: 1,
								color: colors[Math.floor(Math.random() * colors.length)],
								decay: 0.02 + Math.random() * 0.02
							});
						}

						function animate() {
							ctx.clearRect(0, 0, canvas.width, canvas.height);
							var activeCount = 0;
							for (var i = 0; i < particles.length; i++) {
								var p = particles[i];
								if (p.alpha <= 0) continue;
								p.x += p.vx;
								p.y += p.vy;
								p.vy += 0.15; // гравитация
								p.alpha -= p.decay;

								ctx.save();
								ctx.globalAlpha = Math.max(0, p.alpha);
								ctx.fillStyle = p.color;
								ctx.beginPath();
								ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
								ctx.fill();
								ctx.restore();
								activeCount++;
							}

							if (activeCount > 0) {
								requestAnimationFrame(animate);
							} else {
								ctx.clearRect(0, 0, canvas.width, canvas.height);
							}
						}
						requestAnimationFrame(animate);
					});
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initParticleButtons);
			} else {
				initParticleButtons();
			}
			document.addEventListener('htmx:afterSwap', initParticleButtons);
		})();
	</script>
}
