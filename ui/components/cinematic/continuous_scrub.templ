package cinematic

type ScrubTimelineItem struct {
	StepPercent int
	Title       string
	Description string
	Badge       string
}

templ ContinuousScrub(title string, subtitle string, items []ScrubTimelineItem) {
	<section class="cinematic-continuous-scrub relative h-[280vh] w-full" data-continuous-scrub>
		<div class="sticky top-0 h-[100dvh] w-full overflow-hidden flex flex-col justify-between p-6 sm:p-12 bg-surface">
			<!-- Верхняя плашка скраббинга -->
			<div class="flex items-center justify-between border-b border-surface-muted/60 pb-6 z-20">
				<div>
					if subtitle != "" {
						<span class="text-xs uppercase tracking-widest text-accent font-semibold mb-1 block">{ subtitle }</span>
					}
					if title != "" {
						<h2 class="text-2xl sm:text-4xl font-extrabold text-content tracking-tight">{ title }</h2>
					}
				</div>
				<!-- Индикатор прогресса скраббинга -->
				<div class="flex items-center gap-3">
					<span class="text-xs font-mono text-content-muted">Scrub Progress:</span>
					<span class="text-sm font-mono font-bold text-accent min-w-[48px]" data-scrub-percent>0%</span>
				</div>
			</div>

			<!-- Центральный интерактивный объект, непрерывно скраббируемый колесиком -->
			<div class="relative flex-1 flex items-center justify-center z-10 [perspective:1200px]">
				<div
					class="scrub-hero-card w-full max-w-lg p-8 sm:p-12 rounded-3xl bg-surface border border-surface-muted shadow-2xl flex flex-col justify-between will-change-transform"
					data-scrub-card
				>
					<div class="flex items-center justify-between mb-6">
						<span class="px-3 py-1 rounded-full text-xs font-bold bg-accent/10 text-accent font-mono" data-scrub-badge>
							ЭТАП 01
						</span>
						<div class="w-3 h-3 rounded-full bg-accent animate-ping"></div>
					</div>

					<div class="my-4">
						<h3 class="text-3xl sm:text-4xl font-extrabold text-content tracking-tight mb-3" data-scrub-title>
							if len(items) > 0 {
								{ items[0].Title }
							}
						</h3>
						<p class="text-base text-content-muted leading-relaxed" data-scrub-desc>
							if len(items) > 0 {
								{ items[0].Description }
							}
						</p>
					</div>

					<!-- Полоса непрерывного заполнения внутри карточки -->
					<div class="w-full bg-surface-muted rounded-full h-2 mt-8 overflow-hidden">
						<div class="scrub-card-fill h-full bg-accent transition-[width] duration-75" style="width: 0%;" data-scrub-bar></div>
					</div>
				</div>
			</div>

			<!-- Нижняя шкала таймлайна скраббинга -->
			<div class="z-20 pt-6 border-t border-surface-muted/60 flex items-center justify-between text-xs text-content-muted">
				<div class="flex items-center gap-2">
					<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
					<span class="font-mono">Motion One ~3.8 KB WAAPI Engine</span>
				</div>
				<span class="font-mono">Непрерывный Scrubbing кадр-в-кадр</span>
			</div>
		</div>
	</section>

	<script>
		(function() {
			function loadMotion(cb) {
				if (window.Motion) return cb(window.Motion);
				var s = document.querySelector('script[data-motion-cdn]');
				if (!s) {
					s = document.createElement('script');
					s.src = 'https://cdn.jsdelivr.net/npm/motion@10.18.0/dist/motion.min.js';
					s.dataset.motionCdn = 'true';
					document.head.appendChild(s);
				}
				s.addEventListener('load', function() { cb(window.Motion); });
			}

			function initContinuousScrub() {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				var sections = document.querySelectorAll('[data-continuous-scrub]');
				if (sections.length === 0) return;

				loadMotion(function(Motion) {
					sections.forEach(function(section) {
						if (section.dataset.motionBound) return;
						section.dataset.motionBound = 'true';

						var card = section.querySelector('[data-scrub-card]');
						var pctEl = section.querySelector('[data-scrub-percent]');
						var barEl = section.querySelector('[data-scrub-bar]');
						if (!card) return;

						// Непрерывный скраббинг движения и поворота
						Motion.scroll(function(info) {
							var p = typeof info === 'number' ? info : (info && info.y ? info.y.progress : 0);
							var percent = Math.round(p * 100);

							if (pctEl) pctEl.textContent = percent + '%';
							if (barEl) barEl.style.width = percent + '%';

							// Субпиксельная кинематика: поворот, наклон и легкий скейл
							var rotX = Math.sin(p * Math.PI) * 14;
							var rotY = (p - 0.5) * 20;
							var scale = 0.95 + Math.sin(p * Math.PI) * 0.1;
							card.style.transform = 'perspective(1200px) rotateX(' + rotX.toFixed(2) + 'deg) rotateY(' + rotY.toFixed(2) + 'deg) scale(' + scale.toFixed(3) + ')';
						}, {
							target: section,
							offset: ["start start", "end end"]
						});
					});
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initContinuousScrub);
			} else {
				initContinuousScrub();
			}
			document.addEventListener('htmx:afterSwap', initContinuousScrub);
		})();
	</script>
}
