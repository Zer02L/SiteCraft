package cinematic

type ImageRevealProps struct {
	BeforeImage string
	BeforeLabel string
	AfterImage  string
	AfterLabel  string
	Title       string
	Subtitle    string
}

templ ImageReveal(props ImageRevealProps) {
	<section class="cinematic-image-reveal py-16 px-4 max-w-5xl mx-auto select-none">
		if props.Title != "" || props.Subtitle != "" {
			<div class="text-center mb-10">
				if props.Subtitle != "" {
					<span class="text-xs uppercase tracking-widest text-accent font-semibold mb-2 block">{ props.Subtitle }</span>
				}
				if props.Title != "" {
					<h2 class="text-3xl sm:text-4xl font-bold text-content tracking-tight">{ props.Title }</h2>
				}
			</div>
		}

		<div
			class="image-reveal-container relative h-[420px] sm:h-[500px] w-full rounded-2xl overflow-hidden shadow-xl border border-surface-muted cursor-ew-resize"
			data-image-reveal
		>
			<!-- Картинка ПОСЛЕ (Фон) -->
			<div
				class="absolute inset-0 w-full h-full bg-cover bg-center"
				style={ "background-image: url('" + props.AfterImage + "');" }
			>
				if props.AfterLabel != "" {
					<span class="absolute bottom-4 right-4 z-0 px-3 py-1 text-xs font-bold rounded-lg bg-black/60 text-white backdrop-blur-md whitespace-nowrap select-none pointer-events-none">
						{ props.AfterLabel }
					</span>
				}
			</div>

			<!-- Картинка ДО (Слой с clip-path) -->
			<div
				class="reveal-overlay absolute inset-0 w-full h-full bg-cover bg-center z-10"
				style={ "background-image: url('" + props.BeforeImage + "'); clip-path: inset(0 50% 0 0); -webkit-clip-path: inset(0 50% 0 0);" }
			>
				if props.BeforeLabel != "" {
					<span class="absolute bottom-4 left-4 z-10 px-3 py-1 text-xs font-bold rounded-lg bg-black/60 text-white backdrop-blur-md whitespace-nowrap select-none pointer-events-none">
						{ props.BeforeLabel }
					</span>
				}
			</div>

			<!-- Разделительная линия и бегунок -->
			<div
				class="reveal-handle absolute top-0 bottom-0 w-1 bg-white shadow-2xl cursor-ew-resize z-20 flex items-center justify-center -translate-x-1/2"
				style="left: 50%;"
			>
				<div class="w-8 h-8 rounded-full bg-white text-zinc-800 shadow-lg flex items-center justify-center text-xs font-bold border border-zinc-200">
					⇆
				</div>
			</div>
		</div>
	</section>

	<script>
		(function() {
			function initImageReveals() {
				document.querySelectorAll('[data-image-reveal]').forEach(function(container) {
					if (container.dataset.revealInit) return;
					container.dataset.revealInit = 'true';

					var overlay = container.querySelector('.reveal-overlay');
					var handle = container.querySelector('.reveal-handle');
					var isDragging = false;

					function updatePosition(clientX) {
						var rect = container.getBoundingClientRect();
						var x = Math.max(0, Math.min(clientX - rect.left, rect.width));
						var percent = (x / rect.width) * 100;
						overlay.style.clipPath = 'inset(0 ' + (100 - percent).toFixed(2) + '% 0 0)';
						handle.style.left = percent.toFixed(2) + '%';
					}

					container.addEventListener('mousedown', function(e) {
						isDragging = true;
						updatePosition(e.clientX);
					});

					window.addEventListener('mousemove', function(e) {
						if (!isDragging) return;
						updatePosition(e.clientX);
					});

					window.addEventListener('mouseup', function() {
						isDragging = false;
					});

					// Touch support для смартфонов
					container.addEventListener('touchstart', function(e) {
						if (e.touches.length > 0) updatePosition(e.touches[0].clientX);
					}, { passive: true });

					container.addEventListener('touchmove', function(e) {
						if (e.touches.length > 0) updatePosition(e.touches[0].clientX);
					}, { passive: true });
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initImageReveals);
			} else {
				initImageReveals();
			}
			document.addEventListener('htmx:afterSwap', initImageReveals);
		})();
	</script>
}
