package cinematic

templ MeshGradientBackground() {
	<div class="cinematic-mesh-bg pointer-events-none absolute inset-0 overflow-hidden -z-10 select-none">
		<!-- Орб 1: Primary цвет -->
		<div
			class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-primary/20 blur-[100px] animate-mesh-float-1"
		></div>
		
		<!-- Орб 2: Accent цвет -->
		<div
			class="absolute top-1/3 -right-20 w-[450px] h-[450px] rounded-full bg-accent/15 blur-[120px] animate-mesh-float-2"
		></div>

		<!-- Орб 3: Светлый блик по центру снизу -->
		<div
			class="absolute -bottom-32 left-1/3 w-[500px] h-[500px] rounded-full bg-primary-light/20 blur-[130px] animate-mesh-float-3"
		></div>
	</div>

	<style>
		@keyframes mesh-float-1 {
			0%, 100% { transform: translate(0px, 0px) scale(1); }
			50% { transform: translate(60px, 40px) scale(1.15); }
		}
		@keyframes mesh-float-2 {
			0%, 100% { transform: translate(0px, 0px) scale(1); }
			50% { transform: translate(-50px, -60px) scale(1.08); }
		}
		@keyframes mesh-float-3 {
			0%, 100% { transform: translate(0px, 0px) scale(1); }
			50% { transform: translate(40px, -30px) scale(0.95); }
		}
		.animate-mesh-float-1 { animation: mesh-float-1 14s ease-in-out infinite; }
		.animate-mesh-float-2 { animation: mesh-float-2 18s ease-in-out infinite; }
		.animate-mesh-float-3 { animation: mesh-float-3 16s ease-in-out infinite; }

		@media (prefers-reduced-motion: reduce) {
			.animate-mesh-float-1,
			.animate-mesh-float-2,
			.animate-mesh-float-3 {
				animation: none !important;
			}
		}
	</style>
}
