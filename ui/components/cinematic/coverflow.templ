package cinematic

type CoverflowItem struct {
	Title    string
	Subtitle string
	ImageURL string
	Badge    string
}

templ Coverflow(title string, subtitle string, items []CoverflowItem) {
	<section class="cinematic-coverflow py-20 px-4 max-w-6xl mx-auto overflow-hidden [perspective:1200px]" data-coverflow-carousel>
		if title != "" || subtitle != "" {
			<div class="text-center mb-12">
				if subtitle != "" {
					<span class="text-xs uppercase tracking-widest text-accent font-semibold mb-2 block">{ subtitle }</span>
				}
				if title != "" {
					<h2 class="text-3xl sm:text-5xl font-extrabold text-content tracking-tight">{ title }</h2>
				}
			</div>
		}

		<!-- Трек карусели -->
		<div class="coverflow-track relative h-[420px] flex items-center justify-center [transform-style:preserve-3d]">
			for idx, itm := range items {
				<div
					class="coverflow-slide absolute w-[280px] sm:w-[340px] h-[380px] rounded-3xl p-7 flex flex-col justify-end bg-surface border border-surface-muted/80 shadow-2xl transition-all duration-500 ease-out cursor-pointer select-none overflow-hidden"
					data-coverflow-slide
					data-index={ templ.EscapeString(string(rune(idx))) }
					style="backface-visibility: hidden;"
				>
					if itm.ImageURL != "" {
						<div
							class="absolute inset-0 bg-cover bg-center -z-10"
							style={ "background-image: url('" + itm.ImageURL + "');" }
						></div>
						<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent -z-10"></div>
					}

					<div class="relative z-10 text-white">
						if itm.Badge != "" {
							<span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-accent text-white mb-3">
								{ itm.Badge }
							</span>
						}
						<h3 class="text-2xl font-bold mb-1 tracking-tight text-white">{ itm.Title }</h3>
						<p class="text-sm text-white/80">{ itm.Subtitle }</p>
					</div>
				</div>
			}
		</div>

		<!-- Кнопки управления -->
		<div class="flex items-center justify-center gap-4 mt-8">
			<button
				class="w-12 h-12 rounded-full border border-surface-muted bg-surface text-content hover:bg-surface-muted flex items-center justify-center font-bold text-lg shadow-sm transition-colors"
				data-coverflow-prev
				aria-label="Previous slide"
			>
				‹
			</button>
			<button
				class="w-12 h-12 rounded-full border border-surface-muted bg-surface text-content hover:bg-surface-muted flex items-center justify-center font-bold text-lg shadow-sm transition-colors"
				data-coverflow-next
				aria-label="Next slide"
			>
				›
			</button>
		</div>
	</section>

	<script>
		(function() {
			function initCoverflow() {
				document.querySelectorAll('[data-coverflow-carousel]').forEach(function(carousel) {
					var slides = carousel.querySelectorAll('[data-coverflow-slide]');
					var prevBtn = carousel.querySelector('[data-coverflow-prev]');
					var nextBtn = carousel.querySelector('[data-coverflow-next]');
					if (slides.length === 0) return;

					var current = 0;

					function update() {
						slides.forEach(function(slide, idx) {
							var diff = idx - current;
							if (diff === 0) {
								slide.style.transform = 'translateX(0px) translateZ(0px) rotateY(0deg)';
								slide.style.opacity = '1';
								slide.style.zIndex = '30';
							} else if (diff < 0) {
								var tx = diff * 160 - 80;
								var tz = -Math.abs(diff) * 120;
								slide.style.transform = 'translateX(' + tx + 'px) translateZ(' + tz + 'px) rotateY(40deg)';
								slide.style.opacity = String(Math.max(0.2, 1 - Math.abs(diff) * 0.3));
								slide.style.zIndex = String(20 - Math.abs(diff));
							} else {
								var tx = diff * 160 + 80;
								var tz = -Math.abs(diff) * 120;
								slide.style.transform = 'translateX(' + tx + 'px) translateZ(' + tz + 'px) rotateY(-40deg)';
								slide.style.opacity = String(Math.max(0.2, 1 - Math.abs(diff) * 0.3));
								slide.style.zIndex = String(20 - Math.abs(diff));
							}
						});
					}

					slides.forEach(function(s, idx) {
						s.addEventListener('click', function() {
							current = idx;
							update();
						});
					});

					if (prevBtn) {
						prevBtn.addEventListener('click', function() {
							if (current > 0) current--;
							update();
						});
					}
					if (nextBtn) {
						nextBtn.addEventListener('click', function() {
							if (current < slides.length - 1) current++;
							update();
						});
					}

					update();
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initCoverflow);
			} else {
				initCoverflow();
			}
			document.addEventListener('htmx:afterSwap', initCoverflow);
		})();
	</script>
}
