package components

import (
	"fmt"
	"strings"
	"sitecraft/internal/models"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

func sanitizePhoneForLink(phone string) string {
	cleaned := strings.Map(func(r rune) rune {
		if (r >= '0' && r <= '9') || r == '+' {
			return r
		}
		return -1
	}, phone)

	// Если начинается с 8..., меняем на +7... для WhatsApp
	if strings.HasPrefix(cleaned, "8") && len(cleaned) == 11 {
		cleaned = "+7" + cleaned[1:]
	} else if !strings.HasPrefix(cleaned, "+") && len(cleaned) == 10 {
		cleaned = "+7" + cleaned
	}
	return cleaned
}

templ FloatingContact(content models.SiteContent, settings models.SiteSettings) {
	{{
		phone := content.Phone1
		if phone == "" {
			phone = content.Phone2
		}
		cleanPhone := sanitizePhoneForLink(phone)

		waPhone := settings.WhatsappPhone
		if waPhone == "" {
			waPhone = cleanPhone
		} else {
			waPhone = sanitizePhoneForLink(waPhone)
		}
		// Убираем плюс для wa.me
		waDigits := strings.TrimPrefix(waPhone, "+")

		tgUser := settings.TelegramContact
		if tgUser == "" {
			tgUser = strings.TrimPrefix(settings.TelegramChatID, "@")
		}
		if tgUser == "" {
			tgUser = "SiteCraftSupport"
		}
		tgLink := "https://t.me/" + strings.TrimPrefix(tgUser, "@")
	}}

	<div
		x-data="{
			open: false,
			modalOpen: false
		}"
		class="fixed bottom-6 right-6 z-50 print:hidden font-sans"
	>
		<!-- Всплывающие кнопки мессенджеров -->
		<div
			x-show="open"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 translate-y-4 scale-95"
			x-transition:enter-end="opacity-100 translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 translate-y-4 scale-95"
			x-on:click.outside="open = false"
			class="flex flex-col-reverse gap-3 mb-3 items-end"
			style="display: none;"
		>
			<!-- Быстрый обратный звонок (Экспресс-модалка) -->
			<button
				type="button"
				x-on:click="modalOpen = true; open = false"
				class="flex items-center gap-3 group focus:outline-none"
				title="Заказать экспресс-звонок"
			>
				<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-xl shadow-lg border border-content/10 group-hover:bg-accent group-hover:text-primary-dark transition whitespace-nowrap">
					Обратный звонок (30 сек)
				</span>
				<div class="w-12 h-12 rounded-full bg-amber-500 text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition">
					@icons.Zap(templ.Attributes{"class": "w-6 h-6"})
				</div>
			</button>

			<!-- Прямой звонок -->
			if phone != "" {
				<a
					href={ templ.SafeURL("tel:" + cleanPhone) }
					class="flex items-center gap-3 group focus:outline-none"
					title="Позвонить сейчас"
				>
					<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-xl shadow-lg border border-content/10 group-hover:bg-accent group-hover:text-primary-dark transition whitespace-nowrap">
						Позвонить { phone }
					</span>
					<div class="w-12 h-12 rounded-full bg-emerald-600 text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition">
						@icons.PhoneCall(templ.Attributes{"class": "w-5 h-5"})
					</div>
				</a>
			}

			<!-- WhatsApp -->
			if waDigits != "" {
				<a
					href={ templ.SafeURL(fmt.Sprintf("https://wa.me/%s?text=Здравствуйте!%%20Хочу%%20получить%%20консультацию", waDigits)) }
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-3 group focus:outline-none"
					title="Написать в WhatsApp"
				>
					<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-xl shadow-lg border border-content/10 group-hover:bg-accent group-hover:text-primary-dark transition whitespace-nowrap">
						Написать в WhatsApp
					</span>
					<div class="w-12 h-12 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition">
						@icons.MessageCircle(templ.Attributes{"class": "w-6 h-6"})
					</div>
				</a>
			}

			<!-- Telegram -->
			<a
				href={ templ.SafeURL(tgLink) }
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-3 group focus:outline-none"
				title="Написать в Telegram"
			>
				<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-xl shadow-lg border border-content/10 group-hover:bg-accent group-hover:text-primary-dark transition whitespace-nowrap">
					Написать в Telegram
				</span>
				<div class="w-12 h-12 rounded-full bg-[#0088cc] text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition">
					@icons.Send(templ.Attributes{"class": "w-5 h-5"})
				</div>
			</a>
		</div>

		<!-- Главная плавающая кнопка-триггер -->
		<button
			type="button"
			x-on:click="open = !open"
			:class="open ? 'rotate-90 bg-content text-surface' : 'bg-accent text-primary-dark'"
			class="w-14 h-14 rounded-full flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95 transition-all duration-300 relative group cursor-pointer focus:outline-none ring-4 ring-accent/20"
			aria-label="Связаться с нами"
		>
			<!-- Пульсирующий ореол (когда закрыто) -->
			<span x-show="!open" class="absolute -inset-1 rounded-full bg-accent/40 animate-ping pointer-events-none opacity-75"></span>

			<template x-if="!open">
				@icons.MessageSquare(templ.Attributes{"class": "w-7 h-7 relative z-10 transition"})
			</template>
			<template x-if="open">
				@icons.X(templ.Attributes{"class": "w-7 h-7 relative z-10 transition"})
			</template>
		</button>

		<!-- Модальное окно экспресс-звонка за 30 секунд -->
		<div
			x-show="modalOpen"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
			style="display: none;"
		>
			<div
				x-on:click.outside="modalOpen = false"
				class="bg-surface border border-content/10 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative"
			>
				<button
					type="button"
					x-on:click="modalOpen = false"
					class="absolute top-4 right-4 text-content-muted hover:text-content p-1 rounded-lg"
				>
					@icons.X(templ.Attributes{"class": "w-5 h-5"})
				</button>

				<div id="quick-callback-container">
					<div class="flex items-center gap-3 mb-4">
						<div class="w-10 h-10 rounded-2xl bg-accent/15 text-accent flex items-center justify-center">
							@icons.PhoneCall(templ.Attributes{"class": "w-5 h-5"})
						</div>
						<div>
							<h3 class="font-bold text-lg text-content">Экспресс-звонок</h3>
							<p class="text-xs text-content-muted">Перезвоним и ответим на вопросы за 30 секунд</p>
						</div>
					</div>

					<form
						hx-post="/api/leads"
						hx-target="#quick-callback-container"
						hx-swap="innerHTML transition:true"
						class="space-y-4"
					>
						<input type="hidden" name="source" value="quick_callback"/>
						<input type="hidden" name="action_type" value="Запрос обратного экспресс-звонка"/>
						<input type="hidden" name="company_website_url" value=""/> <!-- Honeypot -->
						<input type="hidden" name="consent" value="on"/>

						<div>
							<label class="block text-xs font-semibold text-content-muted mb-1">Ваше имя</label>
							<input
								type="text"
								name="name"
								required
								placeholder="Иван"
								class="w-full px-4 py-2.5 rounded-xl border border-content/15 bg-surface text-content text-sm focus:outline-none focus:border-accent"
							/>
						</div>
						<div>
							<label class="block text-xs font-semibold text-content-muted mb-1">Номер телефона</label>
							<input
								type="tel"
								name="phone"
								required
								x-mask="+7 (999) 999-99-99"
								placeholder="+7 (___) ___-__-__"
								class="w-full px-4 py-2.5 rounded-xl border border-content/15 bg-surface text-content text-sm focus:outline-none focus:border-accent"
							/>
						</div>

						<button
							type="submit"
							class="w-full py-3 rounded-xl bg-accent text-primary-dark font-bold text-sm hover:brightness-105 shadow-md transition flex items-center justify-center gap-2"
						>
							@icons.Zap(templ.Attributes{"class": "w-4 h-4"})
							<span>Жду звонка прямо сейчас</span>
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
}
