package components

import (
	"fmt"
	"strings"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

func sanitizePhoneForLink(phone string) string {
	cleaned := strings.Map(func(r rune) rune {
		if (r >= '0' && r <= '9') || r == '+' {
			return r
		}
		return -1
	}, phone)

	// Если начинается с 8..., меняем на +7... для WhatsApp
	if strings.HasPrefix(cleaned, "8") && len(cleaned) == 11 {
		cleaned = "+7" + cleaned[1:]
	} else if !strings.HasPrefix(cleaned, "+") && len(cleaned) == 10 {
		cleaned = "+7" + cleaned
	}
	return cleaned
}

templ FloatingContact(content models.SiteContent, settings models.SiteSettings) {
	{{
		phone := content.Phone1
		if phone == "" {
			phone = content.Phone2
		}
		cleanPhone := sanitizePhoneForLink(phone)

		waPhone := settings.WhatsappPhone
		if waPhone == "" {
			waPhone = cleanPhone
		} else {
			waPhone = sanitizePhoneForLink(waPhone)
		}
		// Убираем плюс для wa.me
		waDigits := strings.TrimPrefix(waPhone, "+")

		tgUser := settings.TelegramContact
		if tgUser == "" {
			tgUser = strings.TrimPrefix(settings.TelegramChatID, "@")
		}
		if tgUser == "" {
			tgUser = "SiteCraftSupport"
		}
		tgLink := "https://t.me/" + strings.TrimPrefix(tgUser, "@")
	}}

	<div
		x-data="{
			open: false,
			modalOpen: false
		}"
		class="fixed bottom-6 right-6 z-50 print:hidden font-sans"
		data-component="FloatingContact"
		data-source="ui/components/floating_contact.templ"
	>
		<!-- Всплывающие кнопки мессенджеров -->
		<div
			x-show="open"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 translate-y-4 scale-95"
			x-transition:enter-end="opacity-100 translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 translate-y-4 scale-95"
			x-on:click.outside="open = false"
			class="flex flex-col-reverse gap-3 mb-3 items-end"
			style="display: none;"
		>
			<!-- Быстрый обратный звонок (Экспресс-модалка) -->
			<button
				type="button"
				x-on:click="modalOpen = true; open = false"
				class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-btn"
				title="Заказать экспресс-звонок"
			>
				<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-btn shadow-md border border-content/10 group-hover:bg-accent group-hover:text-surface transition-all whitespace-nowrap">
					Обратный звонок (30 сек)
				</span>
				<div class="w-12 h-12 rounded-full bg-amber-500 text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition-all">
					@icons.Zap(templ.Attributes{"class": "w-6 h-6"})
				</div>
			</button>

			<!-- Прямой звонок -->
			if phone != "" {
				<a
					href={ templ.SafeURL("tel:" + cleanPhone) }
					class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-btn"
					title="Позвонить сейчас"
				>
					<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-btn shadow-md border border-content/10 group-hover:bg-accent group-hover:text-surface transition-all whitespace-nowrap">
						Позвонить { phone }
					</span>
					<div class="w-12 h-12 rounded-full bg-emerald-600 text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition-all">
						@icons.PhoneCall(templ.Attributes{"class": "w-5 h-5"})
					</div>
				</a>
			}

			<!-- WhatsApp -->
			if waDigits != "" {
				<a
					href={ templ.SafeURL(fmt.Sprintf("https://wa.me/%s?text=Здравствуйте!%%20Хочу%%20получить%%20консультацию", waDigits)) }
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-btn"
					title="Написать в WhatsApp"
				>
					<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-btn shadow-md border border-content/10 group-hover:bg-accent group-hover:text-surface transition-all whitespace-nowrap">
						Написать в WhatsApp
					</span>
					<div class="w-12 h-12 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition-all">
						@icons.MessageCircle(templ.Attributes{"class": "w-6 h-6"})
					</div>
				</a>
			}

			<!-- Telegram -->
			<a
				href={ templ.SafeURL(tgLink) }
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-btn"
				title="Написать в Telegram"
			>
				<span class="bg-surface text-content text-xs font-semibold py-1.5 px-3 rounded-btn shadow-md border border-content/10 group-hover:bg-accent group-hover:text-surface transition-all whitespace-nowrap">
					Написать в Telegram
				</span>
				<div class="w-12 h-12 rounded-full bg-[#0088cc] text-white flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition-all">
					@icons.Send(templ.Attributes{"class": "w-5 h-5"})
				</div>
			</a>
		</div>

		<!-- Главная плавающая кнопка-триггер -->
		<button
			type="button"
			x-on:click="open = !open"
			:class="open ? 'rotate-90 bg-content text-surface' : 'bg-accent text-surface'"
			class="w-14 h-14 rounded-full flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200 relative group cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-accent/30"
			aria-label="Связаться с нами"
		>
			<!-- Пульсирующий ореол (когда закрыто) -->
			<span x-show="!open" class="absolute -inset-1 rounded-full bg-accent/40 animate-ping pointer-events-none opacity-75"></span>

			<template x-if="!open">
				@icons.MessageSquare(templ.Attributes{"class": "w-6 h-6 relative z-10 transition"})
			</template>
			<template x-if="open">
				@icons.X(templ.Attributes{"class": "w-6 h-6 relative z-10 transition"})
			</template>
		</button>

		<!-- Модальное окно экспресс-звонка за 30 секунд -->
		@base.Modal(base.ModalProps{
			ModelExpression: "modalOpen",
		}) {
			<div id="quick-callback-container">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-10 h-10 rounded-xl bg-accent/15 text-accent flex items-center justify-center">
						@icons.PhoneCall(templ.Attributes{"class": "w-5 h-5"})
					</div>
					<div>
						<h3 class="font-bold text-lg text-content tracking-tight">Экспресс-звонок</h3>
						<p class="text-xs text-content-muted">Перезвоним и ответим на вопросы за 30 секунд</p>
					</div>
				</div>

				<form
					hx-post="/api/leads"
					hx-target="#quick-callback-container"
					hx-swap="innerHTML transition:true"
					class="space-y-4"
				>
					<input type="hidden" name="source" value="quick_callback"/>
					<input type="hidden" name="action_type" value="Запрос обратного экспресс-звонка"/>
					<input type="hidden" name="company_website_url" value=""/> <!-- Honeypot -->
					<input type="hidden" name="consent" value="on"/>

					@base.Input(base.InputProps{
						Label:       "Ваше имя",
						Name:        "name",
						Required:    true,
						Placeholder: "Иван",
					})
					@base.Input(base.InputProps{
						Label:       "Номер телефона",
						Name:        "phone",
						Type:        "tel",
						Required:    true,
						Placeholder: "+7 (___) ___-__-__",
						Class:       "font-mono",
						Attrs:       templ.Attributes{"x-mask": "+7 (999) 999-99-99"},
					})

					@base.Button(base.ButtonProps{
						Variant: base.BtnAccent,
						Type:    "submit",
						Class:   "w-full py-3",
					}) {
						@icons.Zap(templ.Attributes{"class": "w-4 h-4 mr-2"})
						<span>Жду звонка прямо сейчас</span>
					}
				</form>
			</div>
		}
	</div>
}
