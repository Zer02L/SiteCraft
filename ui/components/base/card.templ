package base

import (
	"github.com/Oudwins/tailwind-merge-go"
)

type CardVariant uint8

const (
	CardBase CardVariant = iota
	CardInteractive
	CardSm
	CardMuted
)

type CardProps struct {
	Variant CardVariant
	Class   string
	Attrs   templ.Attributes
}

func (p CardProps) Classes() string {
	var variant string
	switch p.Variant {
	case CardInteractive:
		variant = "bg-surface text-content p-6 rounded-card border border-content/10 shadow-xs transition-all duration-200 hover:shadow-xl hover:border-accent/60 hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 cursor-pointer"
	case CardSm:
		variant = "bg-surface text-content p-4 rounded-card-sm border border-content/10 shadow-xs transition-all duration-200"
	case CardMuted:
		variant = "bg-surface-muted text-content p-6 rounded-card border border-content/10 shadow-xs transition-all duration-200"
	default: // CardBase
		variant = "bg-surface text-content p-6 rounded-card border border-content/10 shadow-xs transition-all duration-200"
	}

	if p.Class == "" {
		return variant
	}
	return twmerge.Merge(variant, p.Class)
}

templ Card(props CardProps) {
	<div
		data-component="Card"
		data-source="ui/components/base/card.templ"
		class={ props.Classes() }
		{ props.Attrs... }
	>
		{ children... }
	</div>
}

templ CardTitle(class ...string) {
	{{
		cls := "text-lg font-bold text-content"
		if len(class) > 0 && class[0] != "" {
			cls = twmerge.Merge(cls, class[0])
		}
	}}
	<h3 data-component="CardTitle" data-source="ui/components/base/card.templ" class={ cls }>
		{ children... }
	</h3>
}

templ CardDescription(class ...string) {
	{{
		cls := "text-content-muted text-sm leading-relaxed"
		if len(class) > 0 && class[0] != "" {
			cls = twmerge.Merge(cls, class[0])
		}
	}}
	<p data-component="CardDescription" data-source="ui/components/base/card.templ" class={ cls }>
		{ children... }
	</p>
}
