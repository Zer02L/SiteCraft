package components

import (
	"lawyer/internal/models"
)

templ Booking(content models.SiteContent, bookedSlots map[string][]string) {
	<!-- Booking & Interactive Calendar Section -->
	<section id="booking" class="py-16 px-4 bg-stone-100 border-t border-stone-200">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-10">
				<div class="inline-block px-3 py-1 bg-legal-burgundy/10 text-legal-burgundy text-xs font-semibold rounded-full border border-legal-burgundy/20 uppercase tracking-wider mb-2">Интерактивный календарь</div>
				<h2 class="font-serif-title text-3xl font-bold text-stone-900">Онлайн-запись на приём к нотариусу</h2>
				<p class="text-stone-500 mt-2 text-sm max-w-2xl mx-auto">Выберите удобную дату и доступный слот времени. Зеленым отмечены свободные часы приёма, серым — занятые.</p>
			</div>

			<div
				x-data="{
					selectedDate: '2026-10-07',
					selectedTime: '',
					name: '',
					phone: '',
					comment: '',
					agreeConsent: true,
					bookedMap: {},
					errors: {
						name: '',
						phone: '',
						time: '',
						consent: ''
					},
					touched: {
						name: false,
						phone: false
					},
					dates: [
						{ label: 'Ср, 7 окт', date: '2026-10-07', slots: [
							{ time: '09:30', defaultFree: true },
							{ time: '10:15', defaultFree: true },
							{ time: '11:00', defaultFree: false },
							{ time: '12:00', defaultFree: true },
							{ time: '14:30', defaultFree: true },
							{ time: '15:30', defaultFree: false },
							{ time: '16:30', defaultFree: true }
						]},
						{ label: 'Чт, 8 окт', date: '2026-10-08', slots: [
							{ time: '09:30', defaultFree: false },
							{ time: '10:30', defaultFree: true },
							{ time: '11:30', defaultFree: true },
							{ time: '12:15', defaultFree: false },
							{ time: '14:30', defaultFree: true },
							{ time: '15:15', defaultFree: true },
							{ time: '16:00', defaultFree: false }
						]},
						{ label: 'Пт, 9 окт', date: '2026-10-09', slots: [
							{ time: '09:30', defaultFree: true },
							{ time: '10:00', defaultFree: true },
							{ time: '11:00', defaultFree: false },
							{ time: '12:00', defaultFree: false },
							{ time: '14:30', defaultFree: true },
							{ time: '15:30', defaultFree: true },
							{ time: '16:15', defaultFree: true }
						]},
						{ label: 'Пн, 12 окт', date: '2026-10-12', slots: [
							{ time: '09:30', defaultFree: true },
							{ time: '10:30', defaultFree: true },
							{ time: '11:30', defaultFree: true },
							{ time: '12:00', defaultFree: true },
							{ time: '14:30', defaultFree: false },
							{ time: '15:30', defaultFree: true },
							{ time: '16:30', defaultFree: true }
						]},
						{ label: 'Вт, 13 окт', date: '2026-10-13', slots: [
							{ time: '09:30', defaultFree: false },
							{ time: '10:30', defaultFree: false },
							{ time: '11:30', defaultFree: true },
							{ time: '12:00', defaultFree: true },
							{ time: '14:30', defaultFree: true },
							{ time: '15:30', defaultFree: true },
							{ time: '16:30', defaultFree: false }
						]}
					],
					init() {
						const el = document.getElementById('booked-data-json');
						if (el) {
							try {
								this.bookedMap = JSON.parse(el.textContent) || {};
							} catch (e) {}
						}
					},
					isSlotFree(time) {
						const booked = this.bookedMap[this.selectedDate] || [];
						if (booked.includes(time)) {
							return false;
						}
						const day = this.dates.find(d => d.date === this.selectedDate);
						if (!day) return true;
						const slot = day.slots.find(s => s.time === time);
						return slot ? slot.defaultFree : true;
					},
					currentSlots() {
						const day = this.dates.find(d => d.date === this.selectedDate);
						if (!day) return [];
						return day.slots.map(s => ({
							time: s.time,
							free: this.isSlotFree(s.time)
						}));
					},
					selectSlot(time, isFree) {
						if (isFree) {
							this.selectedTime = time;
							this.errors.time = '';
						}
					},
					formatPhone(val) {
						let digits = (val || '').replace(/\D/g, '');
						if (!digits) return '';
						if (digits.startsWith('7') || digits.startsWith('8')) {
							digits = digits.substring(1);
						}
						let res = '+7';
						if (digits.length > 0) res += ' (' + digits.substring(0, 3);
						if (digits.length >= 4) res += ') ' + digits.substring(3, 6);
						if (digits.length >= 7) res += '-' + digits.substring(6, 8);
						if (digits.length >= 9) res += '-' + digits.substring(8, 10);
						return res;
					},
					onPhoneInput(e) {
						this.phone = this.formatPhone(e.target.value);
						if (this.touched.phone) {
							this.validatePhone();
						}
					},
					validateName() {
						const val = (this.name || '').trim();
						if (!val) {
							this.errors.name = 'Укажите ФИО заявителя';
							return false;
						}
						if (val.length < 2) {
							this.errors.name = 'ФИО должно содержать не менее 2 символов';
							return false;
						}
						if (!/^[a-zA-Zа-яА-ЯёЁ\s\.\-]+$/.test(val)) {
							this.errors.name = 'ФИО может содержать только буквы, пробелы и дефис';
							return false;
						}
						this.errors.name = '';
						return true;
					},
					validatePhone() {
						const digits = (this.phone || '').replace(/\D/g, '');
						if (!digits) {
							this.errors.phone = 'Укажите контактный номер телефона';
							return false;
						}
						if (digits.length < 11) {
							this.errors.phone = 'Укажите номер полностью (10 цифр номера)';
							return false;
						}
						this.errors.phone = '';
						return true;
					},
					validateTime() {
						if (!this.selectedTime) {
							this.errors.time = 'Пожалуйста, выберите удобное время приёма из сетки слева';
							return false;
						}
						this.errors.time = '';
						return true;
					},
					validateConsent() {
						if (!this.agreeConsent) {
							this.errors.consent = 'Необходимо согласие на обработку персональных данных';
							return false;
						}
						this.errors.consent = '';
						return true;
					},
					validateAll() {
						this.touched.name = true;
						this.touched.phone = true;
						const vTime = this.validateTime();
						const vName = this.validateName();
						const vPhone = this.validatePhone();
						const vConsent = this.validateConsent();
						return vTime && vName && vPhone && vConsent;
					},
					handleSubmit(e) {
						if (!this.validateAll()) {
							e.preventDefault();
							e.stopPropagation();
							return false;
						}
					},
					handleSuccess() {
						if (this.selectedDate && this.selectedTime) {
							if (!this.bookedMap[this.selectedDate]) {
								this.bookedMap[this.selectedDate] = [];
							}
							this.bookedMap[this.selectedDate].push(this.selectedTime);
						}
						this.name = '';
						this.phone = '';
						this.comment = '';
						this.selectedTime = '';
						this.touched.name = false;
						this.touched.phone = false;
						this.errors = { name: '', phone: '', time: '', consent: '' };
					}
				}"
				class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
			>
				@templ.JSONScript("booked-data-json", bookedSlots)
				<!-- Календарь и сетка времени (левая колонка) -->
				<div class="lg:col-span-7 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200">
					<div class="flex items-center justify-between mb-4 pb-3 border-b border-stone-100">
						<h3 class="font-bold text-stone-900 text-base flex items-center gap-2">
							<svg class="w-5 h-5 text-legal-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
							1. Выберите дату приёма
						</h3>
						<div class="flex items-center gap-3 text-xs">
							<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Свободно</span>
							<span class="flex items-center gap-1.5 text-stone-400"><span class="w-2.5 h-2.5 rounded-full bg-stone-300"></span> Занято</span>
						</div>
					</div>

					<!-- Выбор дней недели -->
					<div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-6">
						<template x-for="day in dates" :key="day.date">
							<button
								type="button"
								@click="selectedDate = day.date; selectedTime = ''"
								:class="selectedDate === day.date
									? 'bg-legal-burgundy text-white border-legal-burgundy shadow-sm'
									: 'bg-stone-50 text-stone-700 border-stone-200 hover:bg-stone-100'"
								class="p-2.5 rounded-xl border text-center transition flex flex-col items-center justify-center"
							>
								<span class="text-xs font-semibold" x-text="day.label"></span>
							</button>
						</template>
					</div>

					<!-- Сетка слотов времени -->
					<div class="mb-4">
						<h4 class="font-semibold text-stone-800 text-sm mb-3">2. Выберите свободное время:</h4>
						<div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
							<template x-for="slot in currentSlots()" :key="slot.time">
								<button
									type="button"
									:disabled="!slot.free"
									@click="selectSlot(slot.time, slot.free)"
									:class="!slot.free
										? 'bg-stone-100 text-stone-400 border-stone-200 cursor-not-allowed line-through'
										: (selectedTime === slot.time
											? 'bg-emerald-600 text-white border-emerald-700 shadow-md ring-2 ring-emerald-300'
											: 'bg-emerald-50/80 text-emerald-800 border-emerald-200 hover:bg-emerald-100 hover:border-emerald-300 cursor-pointer font-medium')"
									class="py-2.5 px-3 rounded-lg border text-sm transition flex items-center justify-center gap-1.5"
								>
									<span x-text="slot.time"></span>
									<template x-if="!slot.free">
										<span class="text-[10px] uppercase font-normal">(занято)</span>
									</template>
								</button>
							</template>
						</div>
					</div>

					<div class="p-3 bg-amber-50/80 rounded-lg border border-amber-200/80 text-xs text-amber-800 flex items-center gap-2">
						<svg class="w-4 h-4 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						<span>Обеденный перерыв: { content.LunchBreak } (слоты на это время закрыты).</span>
					</div>
				</div>

				<!-- Форма подтверждения (правая колонка) -->
				<div class="lg:col-span-5 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200">
					<h3 class="font-serif-title text-xl font-bold text-stone-900 mb-1">Оформление записи</h3>
					<p class="text-xs text-stone-500 mb-5">Заполните данные заявителя для бронирования времени</p>

					<!-- Индикатор выбранного времени -->
					<div
						:class="errors.time ? 'border-rose-300 bg-rose-50/50' : (selectedTime ? 'border-emerald-300 bg-emerald-50/30' : 'border-stone-200 bg-stone-50')"
						class="mb-4 p-3 rounded-xl border text-xs flex items-center justify-between transition"
					>
						<span class="text-stone-500">Выбранное время:</span>
						<span
							:class="selectedTime ? 'text-emerald-700' : 'text-stone-500'"
							class="font-bold"
							x-text="selectedTime ? (selectedDate + ' в ' + selectedTime) : 'Не выбрано (выберите слева)'"
						></span>
					</div>

					<!-- Предупреждение об отсутствии выбранного времени -->
					<template x-if="errors.time">
						<div class="mb-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 flex items-center gap-2 animate-fade-in">
							<svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span x-text="errors.time"></span>
						</div>
					</template>

					<form
						hx-post="/api/leads"
						hx-target="#booking-response"
						hx-swap="innerHTML"
						@submit="handleSubmit($event)"
						@htmx:after-request="if ($event.detail.successful) handleSuccess()"
						class="space-y-4"
						novalidate
					>
						<input type="hidden" name="booking_date" :value="selectedDate"/>
						<input type="hidden" name="booking_time" :value="selectedTime"/>

						<!-- Поле: ФИО -->
						<div>
							<label class="block text-xs font-semibold text-stone-700 mb-1">ФИО заявителя *</label>
							<input
								type="text"
								name="name"
								x-model="name"
								@input="if (touched.name) validateName()"
								@blur="touched.name = true; validateName()"
								placeholder="Иванов Иван Иванович"
								maxlength="100"
								:class="errors.name ? 'border-rose-400 bg-rose-50/20 focus:ring-rose-400 focus:border-rose-400' : (touched.name && name.trim().length >= 2 ? 'border-emerald-500 focus:ring-emerald-500' : 'border-stone-300 focus:ring-legal-gold')"
								class="w-full px-3.5 py-2.5 border rounded-lg focus:ring-2 focus:outline-none text-sm transition"
							/>
							<template x-if="errors.name">
								<p class="text-xs text-rose-600 mt-1 flex items-center gap-1 font-medium">
									<svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<span x-text="errors.name"></span>
								</p>
							</template>
						</div>

						<!-- Поле: Телефон -->
						<div>
							<label class="block text-xs font-semibold text-stone-700 mb-1">Контактный телефон *</label>
							<input
								type="tel"
								name="phone"
								x-model="phone"
								@input="onPhoneInput($event)"
								@blur="touched.phone = true; validatePhone()"
								placeholder="+7 (999) 000-00-00"
								maxlength="18"
								:class="errors.phone ? 'border-rose-400 bg-rose-50/20 focus:ring-rose-400 focus:border-rose-400' : (touched.phone && phone.replace(/\D/g, '').length >= 11 ? 'border-emerald-500 focus:ring-emerald-500' : 'border-stone-300 focus:ring-legal-gold')"
								class="w-full px-3.5 py-2.5 border rounded-lg focus:ring-2 focus:outline-none text-sm transition"
							/>
							<template x-if="errors.phone">
								<p class="text-xs text-rose-600 mt-1 flex items-center gap-1 font-medium">
									<svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<span x-text="errors.phone"></span>
								</p>
							</template>
						</div>

						<!-- Поле: Действие -->
						<div>
							<label class="block text-xs font-semibold text-stone-700 mb-1">Нотариальное действие</label>
							<select
								name="action_type"
								class="w-full px-3.5 py-2.5 border border-stone-300 rounded-lg focus:ring-2 focus:ring-legal-gold focus:outline-none text-sm bg-white"
							>
								<option value="доверенность">Оформление доверенности</option>
								<option value="согласие">Нотариальное согласие / заявление</option>
								<option value="сделка">Договор купли-продажи / дарения</option>
								<option value="наследство">Наследственное дело</option>
								<option value="заверение">Свидетельствование верности копий</option>
								<option value="другое">Другое нотариальное действие</option>
							</select>
						</div>

						<!-- Поле: Комментарий -->
						<div>
							<div class="flex items-center justify-between mb-1">
								<label class="text-xs font-semibold text-stone-700">Комментарий / пожелания</label>
								<span x-show="comment.length > 0" x-text="comment.length + '/1000'" class="text-[10px] text-stone-400"></span>
							</div>
							<textarea
								name="comment"
								x-model="comment"
								rows="2"
								maxlength="1000"
								placeholder="Укажите детали или необходимые документы..."
								class="w-full px-3.5 py-2.5 border border-stone-300 rounded-lg focus:ring-2 focus:ring-legal-gold focus:outline-none text-sm transition"
							></textarea>
						</div>

						<!-- Чекбокс: Согласие 152-ФЗ -->
						<div class="pt-1">
							<label class="flex items-start gap-2.5 cursor-pointer select-none">
								<input
									type="checkbox"
									name="consent"
									x-model="agreeConsent"
									@change="validateConsent()"
									class="mt-0.5 rounded border-stone-300 text-legal-burgundy focus:ring-legal-gold"
								/>
								<span class="text-xs text-stone-600 leading-snug">
									Я даю согласие на обработку персональных данных в соответствии с <span class="underline decoration-stone-400">152-ФЗ</span> *
								</span>
							</label>
							<template x-if="errors.consent">
								<p class="text-xs text-rose-600 mt-1 flex items-center gap-1 font-medium">
									<svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<span x-text="errors.consent"></span>
								</p>
							</template>
						</div>

						<!-- Кнопка отправки с индикатором -->
						<button
							type="submit"
							class="w-full text-white font-bold py-3 px-4 rounded-lg transition text-sm shadow flex items-center justify-center gap-2 bg-legal-burgundy hover:bg-legal-burgundydark active:scale-[0.99] cursor-pointer"
						>
							<span class="htmx-indicator animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span>
							<span>Подтвердить запись</span>
						</button>
					</form>

					<div id="booking-response" class="mt-4"></div>
				</div>
			</div>
		</div>
	</section>
}
