package components

import (
	"lawyer/internal/models"
)

templ MapSection(content models.SiteContent) {
	<!-- Interactive Yandex Map Section -->
	<section id="map" class="py-16 px-4 max-w-6xl mx-auto">
		<div class="text-center mb-8">
			<div class="inline-block px-3 py-1 bg-stone-100 text-stone-700 text-xs font-semibold rounded-full border border-stone-200 uppercase tracking-wider mb-2">Местоположение</div>
			<h2 class="font-serif-title text-3xl font-bold text-stone-900">Нотариальная контора на карте</h2>
			<p class="text-stone-500 mt-2 text-sm max-w-xl mx-auto">Удобный подъезд и транспортная доступность. Перед визитом рекомендуем согласовать время.</p>
		</div>

		<div class="bg-white rounded-2xl shadow-sm border border-stone-200 overflow-hidden grid grid-cols-1 lg:grid-cols-12">
			<!-- Адрес и контакты рядом с картой -->
			<div class="lg:col-span-4 p-6 sm:p-8 bg-stone-50 border-b lg:border-b-0 lg:border-r border-stone-200 flex flex-col justify-between">
				<div class="space-y-6">
					<div>
						<span class="text-xs font-semibold uppercase tracking-wider text-legal-burgundy">Адрес нотариуса</span>
						<p class="mt-1.5 text-base font-bold text-stone-900 leading-snug">
							{ content.Address }
						</p>
						<p class="text-xs text-stone-600 mt-1">{ content.AddressSub }</p>
					</div>

					<div class="border-t border-stone-200 pt-4">
						<span class="text-xs font-semibold uppercase tracking-wider text-stone-500">Прямые телефоны:</span>
						<div class="mt-2 space-y-1">
							if content.Phone1 != "" {
								<a href={ templ.URL("tel:" + content.Phone1) } class="block text-base font-bold text-legal-burgundy hover:underline">{ content.Phone1 }</a>
							}
							if content.Phone2 != "" {
								<a href={ templ.URL("tel:" + content.Phone2) } class="block text-sm font-semibold text-stone-800 hover:underline">{ content.Phone2 }</a>
							}
						</div>
					</div>

					<div class="border-t border-stone-200 pt-4">
						<span class="text-xs font-semibold uppercase tracking-wider text-stone-500">График:</span>
						<p class="text-xs text-stone-700 mt-1">{ content.WorkHours } (Обед { content.LunchBreak })</p>
						<p class="text-xs text-stone-500">{ content.DaysOff }</p>
					</div>
				</div>

				<div class="mt-8 pt-4 border-t border-stone-200">
					<a href="#booking" class="w-full inline-block text-center bg-legal-gold hover:bg-legal-goldhover text-legal-burgundydark font-bold py-2.5 px-4 rounded-lg text-xs transition">
						Забронировать время в календаре
					</a>
				</div>
			</div>

			<!-- Интерактивная карта Яндекс -->
			<div class="lg:col-span-8 min-h-[420px] relative bg-stone-100">
				<div class="w-full h-full min-h-[420px] flex items-center justify-center">
					<iframe
						src={ content.MapIframe }
						width="100%"
						height="100%"
						frameborder="0"
						allowfullscreen="true"
						class="w-full h-full min-h-[420px] border-0"
						title={ "Интерактивная карта — " + content.HeroTitle + " " + content.NotaryName }
					></iframe>
				</div>
			</div>
		</div>
	</section>
}
