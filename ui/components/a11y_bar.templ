package components

templ A11yBar() {
	<!-- Панель управления версией для слабовидящих (ГОСТ Р 52872-2019) -->
	<div
		x-show="a11y.active"
		x-cloak
		class="bg-stone-100 text-stone-900 border-b-2 border-stone-800 py-2 px-4 shadow-md sticky top-0 z-50 text-sm font-medium"
	>
		<div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
			<!-- Размер шрифта -->
			<div class="flex items-center gap-1 sm:gap-2">
				<span class="text-xs uppercase font-bold mr-1">Шрифт:</span>
				<button
					type="button"
					@click="setA11yFont('normal')"
					:class="a11y.fontSize === 'normal' ? 'bg-stone-900 text-white font-bold' : 'bg-white hover:bg-stone-200'"
					class="px-2.5 py-1 border border-stone-800 text-xs rounded"
				>
					А (Стандарт)
				</button>
				<button
					type="button"
					@click="setA11yFont('large')"
					:class="a11y.fontSize === 'large' ? 'bg-stone-900 text-white font-bold' : 'bg-white hover:bg-stone-200'"
					class="px-2.5 py-1 border border-stone-800 text-sm font-bold rounded"
				>
					А (Крупный)
				</button>
				<button
					type="button"
					@click="setA11yFont('xlarge')"
					:class="a11y.fontSize === 'xlarge' ? 'bg-stone-900 text-white font-bold' : 'bg-white hover:bg-stone-200'"
					class="px-2.5 py-1 border border-stone-800 text-base font-extrabold rounded"
				>
					А+ (Макс)
				</button>
			</div>

			<!-- Цветовые схемы -->
			<div class="flex items-center gap-1 sm:gap-2">
				<span class="text-xs uppercase font-bold mr-1">Цвет:</span>
				<button
					type="button"
					@click="setA11yTheme('black-on-white')"
					:class="a11y.colorScheme === 'black-on-white' ? 'ring-2 ring-stone-900 font-bold' : ''"
					class="px-2.5 py-1 bg-white text-black border-2 border-black text-xs rounded"
					title="Чёрным по белому"
				>
					Ц (Ч/Б)
				</button>
				<button
					type="button"
					@click="setA11yTheme('white-on-black')"
					:class="a11y.colorScheme === 'white-on-black' ? 'ring-2 ring-yellow-400 font-bold' : ''"
					class="px-2.5 py-1 bg-black text-white border-2 border-white text-xs rounded"
					title="Белым по чёрному"
				>
					Ц (Инверсия)
				</button>
				<button
					type="button"
					@click="setA11yTheme('blue-on-cyan')"
					:class="a11y.colorScheme === 'blue-on-cyan' ? 'ring-2 ring-blue-900 font-bold' : ''"
					class="px-2.5 py-1 bg-[#c6e2ff] text-[#063462] border-2 border-[#063462] text-xs rounded"
					title="Синим по голубому"
				>
					Ц (Синий)
				</button>
			</div>

			<!-- Интервал и Изображения -->
			<div class="flex items-center gap-1 sm:gap-2">
				<button
					type="button"
					@click="setA11ySpacing(a11y.spacing === 'normal' ? 'wide' : 'normal')"
					:class="a11y.spacing === 'wide' ? 'bg-stone-900 text-white font-bold' : 'bg-white hover:bg-stone-200'"
					class="px-2.5 py-1 border border-stone-800 text-xs rounded"
				>
					<span x-text="a11y.spacing === 'wide' ? 'Интервал: Широкий' : 'Интервал: Обычный'"></span>
				</button>
				<button
					type="button"
					@click="toggleA11yImages()"
					:class="a11y.images === 'off' ? 'bg-red-800 text-white font-bold' : 'bg-white hover:bg-stone-200'"
					class="px-2.5 py-1 border border-stone-800 text-xs rounded"
				>
					<span x-text="a11y.images === 'off' ? 'Изображения: Выкл' : 'Изображения: Вкл'"></span>
				</button>
			</div>

			<!-- Закрыть режим -->
			<div>
				<button
					type="button"
					@click="toggleA11y()"
					class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded border border-red-800 transition"
				>
					✕ Обычная версия
				</button>
			</div>
		</div>
	</div>
}
