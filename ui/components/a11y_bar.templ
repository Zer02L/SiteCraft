package components

templ A11yBar() {
	<!-- Панель управления версией для слабовидящих (ГОСТ Р 52872-2019, Vanilla JS) -->
	<div
		id="a11y-toolbar"
		class="hidden bg-surface-muted text-content border-b-2 border-stone-800 py-2 px-4 shadow-md sticky top-0 z-50 text-sm font-medium"
	>
		<div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
			<!-- Размер шрифта -->
			<div class="flex items-center gap-1 sm:gap-2">
				<span class="text-xs uppercase font-bold mr-1">Шрифт:</span>
				<button
					type="button"
					onclick="window.A11Y.setFont('normal')"
					data-a11y-btn-font="normal"
					class="px-2.5 py-1 border border-stone-800 text-xs rounded bg-surface hover:bg-stone-200 transition"
				>
					А (Стандарт)
				</button>
				<button
					type="button"
					onclick="window.A11Y.setFont('large')"
					data-a11y-btn-font="large"
					class="px-2.5 py-1 border border-stone-800 text-sm font-bold rounded bg-surface hover:bg-stone-200 transition"
				>
					А (Крупный)
				</button>
				<button
					type="button"
					onclick="window.A11Y.setFont('xlarge')"
					data-a11y-btn-font="xlarge"
					class="px-2.5 py-1 border border-stone-800 text-base font-extrabold rounded bg-surface hover:bg-stone-200 transition"
				>
					А+ (Макс)
				</button>
			</div>

			<!-- Цветовые схемы -->
			<div class="flex items-center gap-1 sm:gap-2">
				<span class="text-xs uppercase font-bold mr-1">Цвет:</span>
				<button
					type="button"
					onclick="window.A11Y.setColorScheme('black-on-white')"
					data-a11y-btn-theme="black-on-white"
					class="px-2.5 py-1 bg-surface text-black border-2 border-black text-xs rounded transition"
					title="Чёрным по белому"
				>
					Ц (Ч/Б)
				</button>
				<button
					type="button"
					onclick="window.A11Y.setColorScheme('white-on-black')"
					data-a11y-btn-theme="white-on-black"
					class="px-2.5 py-1 bg-black text-white border-2 border-white text-xs rounded transition"
					title="Белым по чёрному"
				>
					Ц (Инверсия)
				</button>
				<button
					type="button"
					onclick="window.A11Y.setColorScheme('blue-on-cyan')"
					data-a11y-btn-theme="blue-on-cyan"
					class="px-2.5 py-1 bg-[#c6e2ff] text-[#063462] border-2 border-[#063462] text-xs rounded transition"
					title="Синим по голубому"
				>
					Ц (Синий)
				</button>
			</div>

			<!-- Интервал и Изображения -->
			<div class="flex items-center gap-1 sm:gap-2">
				<button
					type="button"
					id="a11y-spacing-btn"
					onclick="window.A11Y.toggleSpacing()"
					class="px-2.5 py-1 border border-stone-800 text-xs rounded bg-surface hover:bg-stone-200 transition"
				>
					Интервал: Обычный
				</button>
				<button
					type="button"
					id="a11y-images-btn"
					onclick="window.A11Y.toggleImages()"
					class="px-2.5 py-1 border border-stone-800 text-xs rounded bg-surface hover:bg-stone-200 transition"
				>
					Изображения: Вкл
				</button>
			</div>

			<!-- Закрыть режим -->
			<div>
				<button
					type="button"
					onclick="window.A11Y.toggle()"
					class="px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded border border-rose-800 transition cursor-pointer"
				>
					✕ Обычная версия
				</button>
			</div>
		</div>
	</div>
}
