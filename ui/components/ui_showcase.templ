package components

import (
	"github.com/Oudwins/tailwind-merge-go"
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

// UIShowcase demonstrates seamless integration of shadcn-templ, lucide-icons, tailwind-merge-go, and animations.
templ UIShowcase() {
	<div class="p-6 bg-surface rounded-2xl border border-content/10 shadow-sm space-y-4 animate-fade-in-up">
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-3">
				<span class="p-2 rounded-xl bg-primary/10 text-primary animate-pulse-glow">
					@icons.Sparkles(templ.Attributes{"class": "w-5 h-5"})
				</span>
				<div>
					<h3 class="text-base font-bold text-content">Интеграция shadcn-templ + Lucide</h3>
					<p class="text-xs text-content-muted">Типобезопасные компоненты и иконки без Node.js рантайма</p>
				</div>
			</div>
			@badge.Badge(badge.Props{
				Variant: badge.VariantSecondary,
				Class:   twmerge.Merge("text-xs uppercase tracking-wide font-semibold"),
			}) {
				Ready
			}
		</div>

		<div class="flex flex-wrap items-center gap-3 pt-2">
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Class:   twmerge.Merge("shadow-sm font-medium transition hover:scale-105 active:scale-95"),
			}) {
				@icons.Phone(templ.Attributes{"class": "w-4 h-4 mr-2"})
				Позвонить
			}

			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   twmerge.Merge("border-content/20 hover:bg-surface-muted transition"),
			}) {
				@icons.Calendar(templ.Attributes{"class": "w-4 h-4 mr-2"})
				Онлайн-запись
			}

			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   twmerge.Merge("text-content-muted hover:text-content"),
			}) {
				@icons.ArrowRight(templ.Attributes{"class": "w-4 h-4 ml-1.5"})
				Подробнее
			}
		</div>
	</div>
}
