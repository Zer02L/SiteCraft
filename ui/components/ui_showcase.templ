package components

import (
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

// UIShowcase demonstrates seamless integration of:
// 1. Zero-cost Go Variants (CVA pattern in Go) for base UI primitives (Button, Badge, Card).
// 2. Hallmark 8-State interactive controls (default, hover, focus-visible, active, disabled, loading).
// 3. Native Tailwind v4 CSS Variants (@custom-variant data-open, data-closed, data-active) with Alpine.js.
templ UIShowcase() {
	<div class="p-6 bg-surface rounded-card border border-content/10 shadow-xs space-y-6 animate-fade-in-up">
		<!-- Header -->
		<div class="flex items-center justify-between border-b border-content/10 pb-4">
			<div class="flex items-center gap-3">
				<span class="p-2 rounded-xl bg-accent/15 text-accent animate-pulse-glow">
					@icons.Sparkles(templ.Attributes{"class": "w-5 h-5"})
				</span>
				<div>
					<h3 class="text-base font-bold text-content tracking-tight">Hallmark Modern-Minimal UI System</h3>
					<p class="text-xs text-content-muted">Типобезопасные примитивы Go + 8 состояний контролов + Tailwind v4 Oxide</p>
				</div>
			</div>
			<div class="flex items-center gap-2">
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeAccent,
					Size:    base.BadgeSizeSm,
					Class:   "uppercase font-bold tracking-wider",
				}) {
					Hallmark v2.0
				}
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeSecondary,
					Size:    base.BadgeSizeSm,
					Class:   "uppercase font-semibold",
				}) {
					8 States
				}
			</div>
		</div>

		<!-- 1. Go Variants Showcase: Button Matrix & States -->
		<div class="space-y-3">
			<div class="flex items-center justify-between">
				<span class="text-xs font-semibold text-content/70 uppercase tracking-wider block">Button Matrix & 8-State Controls</span>
				<span class="text-[11px] text-content-muted">Hover · Focus · Active · Disabled · Loading</span>
			</div>
			<div class="flex flex-wrap items-center gap-3">
				@base.Button(base.ButtonProps{
					Variant: base.BtnPrimary,
					Size:    base.BtnSizeSm,
				}) {
					@icons.Check(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
					Primary
				}

				@base.Button(base.ButtonProps{
					Variant: base.BtnSecondary,
					Size:    base.BtnSizeSm,
				}) {
					@icons.Layers(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
					Secondary
				}

				@base.Button(base.ButtonProps{
					Variant: base.BtnAccent,
					Size:    base.BtnSizeSm,
				}) {
					@icons.Sparkles(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
					Accent
				}

				@base.Button(base.ButtonProps{
					Variant: base.BtnOutline,
					Size:    base.BtnSizeSm,
				}) {
					@icons.Calendar(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
					Outline
				}

				@base.Button(base.ButtonProps{
					Variant: base.BtnGhost,
					Size:    base.BtnSizeSm,
				}) {
					@icons.Phone(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
					Ghost
				}

				@base.Button(base.ButtonProps{
					Variant: base.BtnDestructive,
					Size:    base.BtnSizeSm,
				}) {
					@icons.Trash(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
					Destructive
				}

				@base.Button(base.ButtonProps{
					Variant:   base.BtnPrimary,
					Size:      base.BtnSizeSm,
					IsLoading: true,
				}) {
					Processing...
				}

				@base.Button(base.ButtonProps{
					Variant:  base.BtnOutline,
					Size:     base.BtnSizeSm,
					Disabled: true,
				}) {
					Disabled
				}
			</div>
		</div>

		<!-- 2. Badge Matrix -->
		<div class="space-y-3 pt-2 border-t border-content/10">
			<span class="text-xs font-semibold text-content/70 uppercase tracking-wider block">Badge System</span>
			<div class="flex flex-wrap items-center gap-2.5">
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeDefault,
					Size:    base.BadgeSizeSm,
				}) {
					Default
				}
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeSecondary,
					Size:    base.BadgeSizeSm,
				}) {
					Secondary
				}
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeAccent,
					Size:    base.BadgeSizeSm,
				}) {
					Accent Tech
				}
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeOutline,
					Size:    base.BadgeSizeSm,
				}) {
					Outline
				}
				@base.Badge(base.BadgeProps{
					Variant: base.BadgeDestructive,
					Size:    base.BadgeSizeSm,
				}) {
					Alert / Error
				}
			</div>
		</div>

		<!-- 3. Card Elevation Showcase -->
		<div class="space-y-3 pt-2 border-t border-content/10">
			<span class="text-xs font-semibold text-content/70 uppercase tracking-wider block">Card Surfaces & Layered Elevation</span>
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
				@base.Card(base.CardProps{
					Variant: base.CardInteractive,
					Class:   "p-4",
				}) {
					<div class="flex items-center gap-2 mb-1.5">
						<span class="w-2 h-2 rounded-full bg-accent"></span>
						@base.CardTitle("text-sm font-semibold") {
							CardInteractive
						}
					</div>
					@base.CardDescription("text-xs") {
						Тактильный hover lift (-0.5px) и акцентная граница.
					}
				}
				@base.Card(base.CardProps{
					Variant: base.CardBase,
					Class:   "p-4",
				}) {
					<div class="flex items-center gap-2 mb-1.5">
						<span class="w-2 h-2 rounded-full bg-content-muted"></span>
						@base.CardTitle("text-sm font-semibold") {
							CardBase
						}
					</div>
					@base.CardDescription("text-xs") {
						Стандартная карточка с hairline-рамкой и shadow-xs.
					}
				}
				@base.Card(base.CardProps{
					Variant: base.CardMuted,
					Class:   "p-4",
				}) {
					<div class="flex items-center gap-2 mb-1.5">
						<span class="w-2 h-2 rounded-full bg-content/30"></span>
						@base.CardTitle("text-sm font-semibold") {
							CardMuted
						}
					</div>
					@base.CardDescription("text-xs") {
						Мягкая подложка surface-muted для группировки данных.
					}
				}
			</div>
		</div>

		<!-- 4. Tailwind v4 CSS Data-Variant + Alpine.js Showcase -->
		<div class="pt-2 border-t border-content/10" x-data="{ expanded: false }">
			<div class="flex items-center justify-between">
				<div class="text-xs text-content-muted">
					Демонстрация Tailwind v4: <code class="text-accent font-mono text-[11px]">{ "@custom-variant data-open / data-closed" }</code>
				</div>
				<button
					type="button"
					x-on:click="expanded = !expanded"
					:data-active="expanded ? 'true' : 'false'"
					class="px-2.5 py-1 text-xs font-medium rounded-btn border border-content/20 transition-all cursor-pointer flex items-center gap-1.5 data-active:bg-accent/15 data-active:border-accent data-active:text-accent text-content-muted hover:text-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
				>
					<span x-text="expanded ? 'Скрыть интерактивный блок' : 'Раскрыть интерактивный блок'">Раскрыть</span>
					<span :class="expanded ? 'rotate-180' : ''" class="transition-transform duration-200 inline-block">
						@icons.ChevronDown(templ.Attributes{"class": "w-3.5 h-3.5"})
					</span>
				</button>
			</div>

			<!-- Collapsible panel powered purely by Tailwind v4 data-state styling -->
			<div
				:data-state="expanded ? 'open' : 'closed'"
				class="overflow-hidden transition-all duration-300 data-closed:max-h-0 data-closed:opacity-0 data-open:max-h-60 data-open:opacity-100 data-open:mt-4"
			>
				<div class="p-4 rounded-xl bg-surface-muted border border-content/10 text-xs space-y-2">
					<p class="font-semibold text-content">🚀 Zero JavaScript Class Swapping!</p>
					<p class="text-content-muted leading-relaxed">
						Alpine меняет только состояние <code class="font-mono text-accent">data-state="open|closed"</code>. Вся анимация и стили рассчитываются напрямую CSS-движком Tailwind v4 Oxide через директивы <code class="font-mono text-accent">data-open:</code> и <code class="font-mono text-accent">data-closed:</code> без аллокаций в Go и без тяжелых JS-библиотек.
					</p>
				</div>
			</div>
		</div>
	</div>
}
