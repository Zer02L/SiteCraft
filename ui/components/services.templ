package components

import (
	"lawyer/internal/models"
)

templ Services(services []models.ServiceItem) {
	<!-- Services Section -->
	<section id="services" class="py-16 px-4 max-w-6xl mx-auto">
		<div class="text-center mb-12">
			<div class="inline-block px-3 py-1 bg-amber-50 text-amber-800 text-xs font-semibold rounded-full border border-amber-200 uppercase tracking-wider mb-2">Компетенции</div>
			<h2 class="font-serif-title text-3xl font-bold text-stone-900">Нотариальные действия и услуги</h2>
			<p class="text-stone-500 mt-2 max-w-xl mx-auto text-sm">Оформление документов в строгом соответствии с Основами законодательства РФ о нотариате</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			for _, s := range services {
				<div class="bg-white p-6 rounded-xl border border-stone-200/90 shadow-sm hover:shadow-md hover:border-legal-gold/50 transition flex flex-col justify-between">
					<div>
						<div class="w-8 h-8 rounded-lg bg-stone-100 text-legal-burgundy flex items-center justify-center font-serif-title font-bold text-sm mb-3">§</div>
						<h3 class="text-lg font-bold text-stone-900 mb-2">{ s.Title }</h3>
						<p class="text-stone-600 text-sm leading-relaxed mb-4">{ s.Description }</p>
					</div>
					<div class="pt-4 border-t border-stone-100 flex items-center justify-between">
						<span class="text-xs text-stone-400">Тариф:</span>
						<span class="font-bold text-legal-burgundy text-sm">{ s.Price }</span>
					</div>
				</div>
			}
		</div>
	</section>
}
