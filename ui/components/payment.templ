package components

import (
	"fmt"
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "sitecraft/ui/components/icons"
)

templ PaymentModal(settings models.SiteSettings, service models.ServiceItem, fixedAmount float64, orderCode string) {
	<!-- Модуль онлайн-оплаты заказа / предоплаты услуги -->
	<div
		id="payment-modal"
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-fade-in"
		data-component="PaymentModal"
		data-source="ui/components/payment.templ"
		role="dialog"
		aria-modal="true"
		aria-labelledby="payment-modal-title"
	>
		<div class="bg-surface max-w-md w-full p-6 sm:p-8 rounded-card shadow-2xl relative animate-zoom-in border border-content/15 text-content">
			<button
				type="button"
				onclick="document.getElementById('payment-modal').remove()"
				class="absolute top-4 right-4 text-content-muted hover:text-content w-8 h-8 rounded-btn flex items-center justify-center hover:bg-content/5 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent cursor-pointer"
				aria-label="Закрыть"
			>
				@icons.X(templ.Attributes{"class": "w-4 h-4"})
			</button>

			<div class="text-center mb-6">
				<div class="w-12 h-12 rounded-xl bg-accent/15 text-accent mx-auto flex items-center justify-center mb-3 shadow-xs">
					@icons.CreditCard(templ.Attributes{"class": "w-6 h-6"})
				</div>
				if orderCode != "" {
					@base.Badge(base.BadgeProps{
						Variant: base.BadgeAccent,
						Class:   "text-xs font-bold uppercase tracking-wider mb-2",
					}) {
						Квитанция № { orderCode }
					}
					<h3 id="payment-modal-title" class="font-serif-title text-xl font-bold text-content mt-2 tracking-tight">Оплата выполненных работ</h3>
				} else {
					<h3 id="payment-modal-title" class="font-serif-title text-xl font-bold text-content tracking-tight">Оплата услуги</h3>
				}
				<p class="text-xs text-content-muted mt-1">{ service.Title }</p>
			</div>


			<form
				hx-post="/api/payment/create"
				hx-target="#payment-result"
				hx-swap="innerHTML"
				class="space-y-4"
			>
				<input type="hidden" name="service_id" value={ service.ID }/>
				<input type="hidden" name="description" value={ service.Title }/>

				if orderCode != "" && fixedAmount > 0 {
					<!-- Фиксированная сумма из заказ-наряда: пользователь НЕ может изменить -->
					<input type="hidden" name="order_code" value={ orderCode }/>
					<input type="hidden" name="amount" value={ fmt.Sprintf("%.2f", fixedAmount) }/>
					<div class="p-4 bg-surface-muted rounded-xl border border-content/10">
						<div class="flex items-center justify-between">
							<span class="text-xs font-semibold text-content-muted">Сумма к оплате:</span>
							<span class="text-2xl font-extrabold text-content">{ fmt.Sprintf("%.0f", fixedAmount) } ₽</span>
						</div>
						<p class="text-[11px] text-content-muted mt-1 flex items-center gap-1">
							@icons.Lock(templ.Attributes{"class": "w-3.5 h-3.5 text-accent shrink-0"})
							<span>Сумма зафиксирована в заказ-наряде и не подлежит изменению.</span>
						</p>
					</div>
				} else {
					<!-- Обычная оплата услуги с вводом суммы -->
					<div>
						<label class="form-label">Сумма к оплате (₽)</label>
						<input
							type="number"
							name="amount"
							value="1000"
							min="100"
							required
							class="form-input font-bold"
						/>
					</div>
				}

				<!-- Honeypot anti-spam protection (скрытое поле) -->
				<input type="text" name="company_website_url" class="hidden" tabindex="-1" autocomplete="off"/>

				<div>
					<label class="form-label">Ваш Email для чека (54-ФЗ) *</label>
					<input
						type="email"
						name="email"
						required
						placeholder="client@mail.ru"
						class="form-input"
					/>
				</div>

				<div>
					<label class="form-label">
						if orderCode != "" {
							<span>Номер телефона для связи *</span>
						} else {
							<span>Номер телефона</span>
						}
					</label>
					<input
						type="tel"
						name="phone"
						x-data
						x-mask="+7 (999) 999-99-99"
						placeholder="+7 (999) 000-00-00"
						if orderCode != "" {
							required
						}
						class="form-input"
					/>
				</div>

				<!-- Согласие 152-ФЗ и оферта -->
				<div class="flex items-start gap-2 pt-1">
					<input
						type="checkbox"
						id="payment-consent"
						name="consent"
						value="on"
						checked
						required
						class="mt-1 h-4 w-4 rounded border-content/30 text-accent focus:ring-accent cursor-pointer"
					/>
					<label for="payment-consent" class="text-[11px] text-content-muted leading-snug cursor-pointer select-none">
						Согласен с <a href="/policy" target="_blank" class="underline hover:text-content">политикой конфиденциальности</a> (152-ФЗ) и условиями публичной оферты
					</label>
				</div>

				if settings.PaymentSandbox {
					<div class="p-2.5 bg-accent/15 rounded-lg border border-accent/30 text-[11px] text-accent flex items-center gap-1.5">
						<span>⚠️ Включен тестовый режим (реальное списание средств отключено).</span>
					</div>
				}

				@base.Button(base.ButtonProps{
					Variant: base.BtnAccent,
					Size:    base.BtnSizeLg,
					Type:    "submit",
					Class:   "w-full text-surface font-bold shadow gap-2",
				}) {
					<span class="htmx-indicator">
						@icons.Loader2(templ.Attributes{"class": "animate-spin w-4 h-4 mr-2"})
					</span>
					if orderCode != "" && fixedAmount > 0 {
						<span>Оплатить { fmt.Sprintf("%.0f", fixedAmount) } ₽ онлайн</span>
					} else {
						<span>Перейти к защищенной оплате</span>
					}
				}
			</form>

			<div id="payment-result" class="mt-4"></div>
		</div>
	</div>
}

templ PaymentSuccessMessage(res models.PaymentResponse) {
	<div class="p-4 bg-emerald-50 border border-emerald-300 rounded-xl text-emerald-900 text-sm animate-fade-in-up">
		<div class="font-bold flex items-center gap-2">
			@icons.CheckCircle2(templ.Attributes{"class": "w-5 h-5 text-emerald-600 shrink-0"})
			<span>Ссылка на оплату сформирована</span>
		</div>
		<p class="text-xs text-emerald-700 mt-1">Заказ #{ res.PaymentID } зарегистрирован.</p>
		<div class="mt-3">
			@base.Button(base.ButtonProps{
				Variant: base.BtnPrimary,
				Size:    base.BtnSizeSm,
				Href:    res.PaymentURL,
				Target:  "_blank",
				Class:   "font-bold shadow-xs",
			}) {
				Оплатить онлайн →
			}
		</div>
	</div>
}

