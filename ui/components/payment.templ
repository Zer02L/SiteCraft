package components

import (
	"fmt"
	"sitecraft/internal/models"
)

templ PaymentModal(settings models.SiteSettings, service models.ServiceItem) {
	<!-- Модуль онлайн-оплаты заказа / предоплаты услуги -->
	<div
		id="payment-modal"
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
	>
		<div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 sm:p-8 border border-stone-200 relative animate-fade-in">
			<button
				type="button"
				onclick="document.getElementById('payment-modal').remove()"
				class="absolute top-4 right-4 text-stone-400 hover:text-stone-700 text-xl font-bold cursor-pointer"
			>
				✕
			</button>

			<div class="text-center mb-6">
				<div class="w-12 h-12 rounded-full bg-primary/10 text-primary mx-auto flex items-center justify-center text-xl font-bold mb-3">
					💳
				</div>
				<h3 class="font-serif-title text-xl font-bold text-stone-900">Оплата услуги</h3>
				<p class="text-xs text-stone-500 mt-1">{ service.Title }</p>
			</div>

			<form
				hx-post="/api/payment/create"
				hx-target="#payment-result"
				hx-swap="innerHTML"
				class="space-y-4"
			>
				<input type="hidden" name="service_id" value={ service.ID }/>
				<input type="hidden" name="description" value={ service.Title }/>

				<div>
					<label class="block text-xs font-semibold text-stone-700 mb-1">Сумма к оплате (₽)</label>
					<input
						type="number"
						name="amount"
						value="1000"
						min="100"
						required
						class="w-full px-3.5 py-2.5 border border-stone-300 rounded-lg text-sm font-bold text-stone-900 focus:ring-2 focus:ring-accent focus:outline-none"
					/>
				</div>

				<div>
					<label class="block text-xs font-semibold text-stone-700 mb-1">Ваш Email для чека *</label>
					<input
						type="email"
						name="email"
						required
						placeholder="client@mail.ru"
						class="w-full px-3.5 py-2.5 border border-stone-300 rounded-lg text-sm focus:ring-2 focus:ring-accent focus:outline-none"
					/>
				</div>

				<div>
					<label class="block text-xs font-semibold text-stone-700 mb-1">Номер телефона</label>
					<input
						type="tel"
						name="phone"
						placeholder="+7 (999) 000-00-00"
						class="w-full px-3.5 py-2.5 border border-stone-300 rounded-lg text-sm focus:ring-2 focus:ring-accent focus:outline-none"
					/>
				</div>

				if settings.PaymentSandbox {
					<div class="p-2.5 bg-amber-50 rounded-lg border border-amber-200 text-[11px] text-amber-800 flex items-center gap-1.5">
						<span>⚠️ Включен тестовый режим (реальное списание средств отключено).</span>
					</div>
				}

				<button
					type="submit"
					class="w-full text-white font-bold py-3 px-4 rounded-lg transition text-sm shadow flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark cursor-pointer active:scale-[0.99]"
				>
					<span class="htmx-indicator animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span>
					<span>Перейти к защищенной оплате</span>
				</button>
			</form>

			<div id="payment-result" class="mt-4"></div>
		</div>
	</div>
}

templ PaymentSuccessMessage(res models.PaymentResponse) {
	<div class="p-4 bg-emerald-50 border border-emerald-300 rounded-xl text-emerald-900 text-sm">
		<div class="font-bold flex items-center gap-2">
			<span>✓</span> Ссылка на оплату сформирована
		</div>
		<p class="text-xs text-emerald-700 mt-1">Заказ #{ res.PaymentID } зарегистрирован.</p>
		<div class="mt-3">
			<a
				href={ templ.URL(res.PaymentURL) }
				target="_blank"
				class="inline-block bg-primary text-white font-bold px-4 py-2 rounded-lg text-xs hover:bg-primary-dark transition"
			>
				{ fmt.Sprintf("Оплатить онлайн →") }
			</a>
		</div>
	</div>
}
