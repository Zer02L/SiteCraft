package components

import (
	"sitecraft/internal/models"

	icons "sitecraft/ui/components/icons"
)

templ ChatWidget(settings models.SiteSettings) {
	if settings.EnableLiveChat {
		<div
			x-data="{
				isOpen: false,
				sessionId: '',
				hasUnread: false,
				init() {
					let sid = localStorage.getItem('sitecraft_chat_sid');
					if (!sid) {
						sid = 'cs_' + Math.random().toString(36).substring(2, 9);
						localStorage.setItem('sitecraft_chat_sid', sid);
					}
					this.sessionId = sid;

					// Listen for SSE incoming messages when widget is closed
					window.addEventListener('chat-new-msg', () => {
						if (!this.isOpen) {
							this.hasUnread = true;
						}
						this.$nextTick(() => {
							if (this.$refs.scrollBox) {
								this.$refs.scrollBox.scrollTop = this.$refs.scrollBox.scrollHeight;
							}
						});
					});
				},
				toggleChat() {
					this.isOpen = !this.isOpen;
					if (this.isOpen) {
						this.hasUnread = false;
						this.$nextTick(() => {
							if (this.$refs.scrollBox) {
								this.$refs.scrollBox.scrollTop = this.$refs.scrollBox.scrollHeight;
							}
						});
					}
				}
			}"
			class="fixed bottom-6 right-6 z-50 print:hidden font-sans"
		>
			<!-- Всплывающее окно чата -->
			<div
				x-show="isOpen"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-y-6 scale-95"
				x-transition:enter-end="opacity-100 translate-y-0 scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0 scale-100"
				x-transition:leave-end="opacity-0 translate-y-6 scale-95"
				class="w-[360px] sm:w-[400px] max-w-[calc(100vw-2rem)] h-[520px] max-h-[calc(100vh-6rem)] bg-surface text-content rounded-3xl shadow-2xl border border-content/10 flex flex-col overflow-hidden mb-4"
				style="display: none;"
			>
				<!-- Шапка чата -->
				<div class="px-5 py-4 bg-surface-muted border-b border-content/10 flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div class="relative">
							<div class="w-10 h-10 rounded-2xl bg-accent/20 text-accent flex items-center justify-center font-bold">
								@icons.Headphones(templ.Attributes{"class": "w-5 h-5"})
							</div>
							<span class="absolute -top-1 -right-1 w-3 h-3 bg-emerald-500 rounded-full border-2 border-surface"></span>
						</div>
						<div>
							<h3 class="font-bold text-sm text-content leading-tight">Онлайн-консультант</h3>
							<p class="text-[11px] text-content-muted flex items-center gap-1.5 mt-0.5">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
								<span>Отвечаем в Telegram за 1 мин</span>
							</p>
						</div>
					</div>

					<button
						type="button"
						x-on:click="isOpen = false"
						class="p-2 rounded-xl text-content-muted hover:text-content hover:bg-content/5 transition"
						title="Закрыть чат"
					>
						@icons.X(templ.Attributes{"class": "w-5 h-5"})
					</button>
				</div>

				<!-- Список сообщений с SSE подключением -->
				<div
					x-ref="scrollBox"
					hx-ext="sse"
					:sse-connect="'/api/chat/sse?session_id=' + sessionId"
					sse-swap="chat-message"
					hx-target="#chat-messages-list"
					hx-swap="beforeend"
					class="flex-1 overflow-y-auto p-4 space-y-2 text-xs"
				>
					<div
						id="chat-messages-list"
						:hx-get="'/api/chat/history?session_id=' + sessionId"
						hx-trigger="load"
						hx-swap="innerHTML"
						@htmx:after-settle="$refs.scrollBox.scrollTop = $refs.scrollBox.scrollHeight"
					>
						<div class="py-8 text-center text-xs text-content-muted">
							Загрузка истории переписки...
						</div>
					</div>
				</div>

				<!-- Поле ввода сообщения -->
				<div class="p-3 bg-surface-muted/60 border-t border-content/10">
					<form
						hx-post="/api/chat/send"
						hx-target="#chat-messages-list"
						hx-swap="beforeend"
						@htmx:after-request="if($event.detail.successful) { $refs.chatInput.value = ''; $nextTick(() => { $refs.scrollBox.scrollTop = $refs.scrollBox.scrollHeight; }); }"
						class="flex items-center gap-2"
					>
						<input type="hidden" name="session_id" :value="sessionId"/>
						<input
							x-ref="chatInput"
							type="text"
							name="message"
							required
							autocomplete="off"
							placeholder="Напишите сообщение..."
							class="flex-1 px-3.5 py-2.5 rounded-2xl bg-surface border border-content/15 text-content text-xs placeholder-content-muted focus:outline-none focus:border-accent transition shadow-inner"
						/>
						<button
							type="submit"
							class="p-2.5 rounded-2xl bg-accent text-primary-dark font-bold hover:brightness-105 active:scale-95 transition shadow-md flex items-center justify-center cursor-pointer"
							title="Отправить"
						>
							@icons.Send(templ.Attributes{"class": "w-4 h-4"})
						</button>
					</form>
				</div>
			</div>

			<!-- Кнопка вызова чата -->
			<button
				type="button"
				x-on:click="toggleChat()"
				:class="isOpen ? 'bg-content text-surface' : 'bg-accent text-primary-dark'"
				class="w-14 h-14 rounded-full flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95 transition-all duration-300 relative cursor-pointer focus:outline-none ring-4 ring-accent/20"
				aria-label="Открыть онлайн-чат"
			>
				<!-- Индикатор нового непрочитанного сообщения -->
				<span
					x-show="hasUnread && !isOpen"
					class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-rose-500 border-2 border-surface animate-bounce"
					style="display: none;"
				></span>

				<template x-if="!isOpen">
					@icons.MessageSquare(templ.Attributes{"class": "w-7 h-7 relative z-10 transition"})
				</template>
				<template x-if="isOpen">
					@icons.X(templ.Attributes{"class": "w-7 h-7 relative z-10 transition"})
				</template>
			</button>
		</div>
	}
}
