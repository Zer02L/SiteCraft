package components

import "sitecraft/internal/models"

templ RecentActivity(settings models.SiteSettings) {
	<!-- Модуль #9: Виджет недавней активности (Recent Activity Social Proof / FOMO) -->
	<div
		x-data="recentActivityWidget()"
		x-init="init()"
		x-cloak
		class="fixed bottom-5 left-5 z-40 max-w-sm pointer-events-none sm:max-w-xs"
		role="status"
		aria-live="polite"
	>
		<div
			x-show="show && !dismissed && currentItem"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 translate-y-4 scale-95"
			x-transition:enter-end="opacity-100 translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 translate-y-4 scale-95"
			class="pointer-events-auto flex items-start gap-3 p-3.5 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-xl shadow-slate-900/10 text-slate-800 dark:text-slate-100"
		>
			<!-- Иконка активности с пульсирующим маркером онлайна -->
			<div class="relative flex-shrink-0 mt-0.5">
				<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500/20 to-teal-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-500/30">
					<template x-if="currentItem.icon === 'order'">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
						</svg>
					</template>
					<template x-if="currentItem.icon === 'booking'">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
						</svg>
					</template>
					<template x-if="currentItem.icon === 'lead' || (!currentItem.icon || (currentItem.icon !== 'order' && currentItem.icon !== 'booking'))">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</template>
				</div>
				<span class="absolute -top-1 -right-1 flex h-3 w-3">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
				</span>
			</div>

			<!-- Детали события -->
			<div class="flex-1 min-w-0 pr-1">
				<p class="text-xs font-semibold leading-snug">
					<span class="text-slate-900 dark:text-white" x-text="currentItem.name"></span>
					<template x-if="currentItem.city">
						<span class="text-slate-400 dark:text-slate-500 font-normal" x-text="' (' + currentItem.city + ')'"></span>
					</template>
				</p>
				<p class="text-[11px] text-slate-600 dark:text-slate-300 leading-tight mt-0.5" x-text="currentItem.action"></p>
				<div class="flex items-center gap-2 mt-1">
					<span class="text-[10px] text-slate-400 dark:text-slate-500" x-text="currentItem.time_ago"></span>
					<span class="inline-flex items-center gap-0.5 text-[9px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-1.5 py-0.2 rounded-full border border-emerald-500/20">
						<svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
						</svg>
						Проверено
					</span>
				</div>
			</div>

			<!-- Кнопка закрытия (Respect user / Zero-annoyance) -->
			<button
				type="button"
				@click="dismiss()"
				aria-label="Закрыть уведомление"
				class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors p-1 -mr-1 -mt-1 rounded-lg focus:outline-none"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</div>

	<script>
		function recentActivityWidget() {
			return {
				items: [],
				currentIndex: 0,
				show: false,
				dismissed: false,
				timer: null,
				get currentItem() {
					if (!this.items || this.items.length === 0) return null;
					return this.items[this.currentIndex] || null;
				},
				init() {
					if (sessionStorage.getItem('sitecraft_fomo_dismissed') === '1') {
						this.dismissed = true;
						return;
					}

					fetch('/api/recent-activity')
						.then(r => r.ok ? r.json() : [])
						.then(data => {
							if (Array.isArray(data) && data.length > 0) {
								this.items = data;
								// Первый показ через 4 секунды после входа
								setTimeout(() => this.displayNext(), 4000);
							}
						})
						.catch(() => {});
				},
				displayNext() {
					if (this.dismissed || !this.items || this.items.length === 0) return;

					this.show = true;

					// Тост показывается 6 секунд
					setTimeout(() => {
						this.show = false;
						this.currentIndex = (this.currentIndex + 1) % this.items.length;

						// Следующий показ через 20 секунд
						this.timer = setTimeout(() => {
							this.displayNext();
						}, 20000);
					}, 6000);
				},
				dismiss() {
					this.show = false;
					this.dismissed = true;
					if (this.timer) clearTimeout(this.timer);
					sessionStorage.setItem('sitecraft_fomo_dismissed', '1');
				}
			};
		}
	</script>
}
