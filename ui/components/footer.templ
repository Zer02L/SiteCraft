package components

import (
	"sitecraft/internal/models"
)

templ Footer(content models.SiteContent) {
	<!-- Footer -->
	<footer class="bg-primary-dark text-stone-300 py-12 mt-auto text-sm border-t-2 border-accent">
		<div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
			<div>
				<div class="text-white font-serif-title font-bold text-lg mb-2">{ content.HeroTitle }</div>
				<p class="text-xs text-stone-400">{ content.OwnerName }</p>
				<p class="text-xs text-stone-400 mt-2">{ content.HeroSubtitle }</p>
			</div>
			<div>
				<div class="text-white font-semibold text-sm mb-3">Контакты для связи</div>
				if content.Phone1 != "" {
					<p class="text-xs text-stone-300">Основной: <a href={ templ.URL("tel:" + content.Phone1) } class="hover:text-accent">{ content.Phone1 }</a></p>
				}
				if content.Phone2 != "" {
					<p class="text-xs text-stone-300 mt-1">Дополнительный: <a href={ templ.URL("tel:" + content.Phone2) } class="hover:text-accent">{ content.Phone2 }</a></p>
				}
			</div>
			<div>
				<div class="text-white font-semibold text-sm mb-3">Режим работы</div>
				<p class="text-xs text-stone-300">{ content.WorkHours }</p>
				<p class="text-xs text-stone-400">Перерыв: { content.LunchBreak }</p>
				<p class="text-xs text-stone-500 mt-2">© 2026 { content.HeroTitle }. Все права защищены.</p>
			</div>
		</div>
	</footer>
}
