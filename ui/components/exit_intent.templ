package components

import (
	"sitecraft/internal/models"
	"sitecraft/ui/components/base"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ ExitIntent(settings models.SiteSettings) {
	<div
		x-data="{
			open: false,
			dismissed: false,
			init() {
				if (sessionStorage.getItem('sitecraft_exit_shown')) {
					return;
				}
				const onMouseLeave = (e) => {
					if (e.clientY <= 12 && !this.open && !this.dismissed) {
						this.open = true;
						sessionStorage.setItem('sitecraft_exit_shown', 'true');
					}
				};
				document.addEventListener('mouseleave', onMouseLeave);

				// Мобильный триггер при длительном нахождении на странице
				setTimeout(() => {
					if (!this.open && !this.dismissed && window.innerWidth < 768 && !sessionStorage.getItem('sitecraft_exit_shown')) {
						this.open = true;
						sessionStorage.setItem('sitecraft_exit_shown', 'true');
					}
				}, 45000);
			},
			close() {
				this.open = false;
				this.dismissed = true;
				sessionStorage.setItem('sitecraft_exit_shown', 'true');
			}
		}"
		x-show="open"
		x-cloak
		@keydown.escape.window="close()"
		class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6"
	>
		<!-- Backdrop -->
		<div
			x-show="open"
			x-transition:enter="transition-opacity ease-out duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="transition-opacity ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			@click="close()"
			class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"
		></div>

		<!-- Modal Box -->
		<div
			x-show="open"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 scale-95 translate-y-4"
			x-transition:enter-end="opacity-100 scale-100 translate-y-0"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 scale-100 translate-y-0"
			x-transition:leave-end="opacity-0 scale-95 translate-y-4"
			class="relative w-full max-w-lg bg-surface border border-accent/30 rounded-2xl p-6 sm:p-8 shadow-2xl overflow-hidden z-10"
		>
			<!-- Декоративное свечение вверху -->
			<div class="absolute -top-24 left-1/2 -translate-x-1/2 w-72 h-48 bg-accent/20 rounded-full blur-3xl pointer-events-none"></div>

			<!-- Кнопка закрытия -->
			<button
				type="button"
				@click="close()"
				class="absolute top-4 right-4 text-content-muted hover:text-content p-1.5 rounded-full hover:bg-content/5 transition-colors cursor-pointer"
				aria-label="Закрыть"
			>
				@icons.X(templ.Attributes{"class": "w-5 h-5"})
			</button>

			<div id="exit-intent-form-container">
				<div class="text-center mb-6">
					<div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-accent/15 border border-accent/25 text-accent mb-3 shadow-inner">
						@icons.Gift(templ.Attributes{"class": "w-6 h-6"})
					</div>
					<h3 class="text-xl sm:text-2xl font-bold text-content tracking-tight">
						Подождите! Не уходите с пустыми руками
					</h3>
					<p class="text-xs sm:text-sm text-content-muted mt-2 max-w-sm mx-auto leading-relaxed">
						Зафиксируйте за своим номером <strong class="text-accent font-bold">скидку 10%</strong> или получите бесплатную консультацию ведущего специалиста.
					</p>
				</div>

				<form
					hx-post="/api/leads"
					hx-target="#exit-intent-form-container"
					hx-swap="innerHTML transition:true"
					class="space-y-4"
				>
					<input type="hidden" name="source" value="exit_intent"/>
					<input type="hidden" name="action_type" value="Спецпредложение при выходе"/>
					<input type="hidden" name="comment" value="Зафиксирована скидка 10% (Exit-Intent Pop-up)"/>
					<input type="hidden" name="company_website_url" value=""/> <!-- Honeypot -->
					<input type="hidden" name="consent" value="on"/>

					<div>
						<label class="block text-xs font-semibold text-content-muted uppercase tracking-wider mb-1.5">Ваше имя</label>
						<input
							type="text"
							name="name"
							required
							placeholder="Иван"
							class="w-full px-4 py-2.5 rounded-xl bg-surface-raised border border-content/15 text-content placeholder-content-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm transition"
						/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-content-muted uppercase tracking-wider mb-1.5">Номер телефона</label>
						<input
							type="tel"
							name="phone"
							required
							x-mask="+7 (999) 999-99-99"
							placeholder="+7 (___) ___-__-__"
							class="w-full px-4 py-2.5 rounded-xl bg-surface-raised border border-content/15 text-content placeholder-content-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm font-mono transition"
						/>
					</div>

					<div class="pt-2">
						@base.Button(base.ButtonProps{
							Variant: base.BtnAccent,
							Size:    base.BtnSizeLg,
							Type:    "submit",
							Class:   "w-full text-primary-dark font-bold py-3 shadow-lg flex items-center justify-center gap-2 cursor-pointer",
						}) {
							@icons.Sparkles(templ.Attributes{"class": "w-4 h-4"})
							<span>Зафиксировать скидку 10%</span>
						}
					</div>

					<p class="text-[10px] text-content-muted/70 text-center mt-2">
						Нажимая кнопку, вы соглашаетесь на обработку персональных данных. Без спама.
					</p>
				</form>
			</div>
		</div>
	</div>
}
