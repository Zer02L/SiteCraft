package components

import (
	"sitecraft/internal/models"
)

templ Header(content models.SiteContent, settings models.SiteSettings) {
	<!-- Header -->
	<header class="bg-primary text-white sticky top-0 z-40 shadow-lg border-b border-primary-dark">
		<div class="max-w-6xl mx-auto px-4 py-3.5 flex justify-between items-center">
			<div class="flex items-center space-x-3">
				<div class="w-10 h-10 rounded-full bg-primary-dark border border-accent/40 flex items-center justify-center text-accent shadow-inner">
					<svg class="w-6 h-6 a11y-keep-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
					</svg>
				</div>
				<div>
					<div class="text-white font-serif-title font-bold text-lg tracking-wide leading-tight">{ content.HeroTitle }</div>
					<div class="text-xs text-accent font-medium">{ content.OwnerName }</div>
				</div>
			</div>

			<nav class="hidden md:flex items-center space-x-5 text-sm font-medium">
				<a href="#about" class="hover:text-accent transition">О нас</a>
				<a href="#schedule" class="hover:text-accent transition">Режим</a>
				<a href="#services" class="hover:text-accent transition">Услуги</a>
				<a href="#booking" class="hover:text-accent transition">Запись</a>
				<a href="#map" class="hover:text-accent transition">Контакты</a>

				<!-- Кнопка 'Версия для слабовидящих' (Vanilla JS) -->
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="flex items-center gap-1.5 px-2.5 py-1 rounded border border-white/30 text-xs font-semibold hover:border-accent hover:text-accent transition bg-white/5 cursor-pointer"
						title="Версия для слабовидящих"
					>
						<span>👓</span>
						<span>Для слабовидящих</span>
					</button>
				}

				<!-- Переключатель тем оформления (Vanilla JS) -->
				<div class="flex items-center bg-black/25 p-1 rounded-lg border border-white/10 text-xs">
					<button
						type="button"
						onclick="window.setSiteTheme('legal')"
						class="px-2 py-1 rounded hover:text-accent transition cursor-pointer"
						title="Бордовая / Юридическая тема"
					>
						🏛️
					</button>
					<button
						type="button"
						onclick="window.setSiteTheme('medical')"
						class="px-2 py-1 rounded hover:text-accent transition cursor-pointer"
						title="Медицинская / Бирюзовая тема"
					>
						🏥
					</button>
					<button
						type="button"
						onclick="window.setSiteTheme('auto')"
						class="px-2 py-1 rounded hover:text-accent transition cursor-pointer"
						title="Авто / Драйв тема"
					>
						🚗
					</button>
					<button
						type="button"
						onclick="window.setSiteTheme('tech')"
						class="px-2 py-1 rounded hover:text-accent transition cursor-pointer"
						title="IT / Корпоративная тема"
					>
						💻
					</button>
					<button
						type="button"
						onclick="window.setSiteTheme('dark')"
						class="px-2 py-1 rounded hover:text-accent transition cursor-pointer"
						title="Тёмная тема"
					>
						🌙
					</button>
				</div>

				<a href="/_/" target="_blank" class="text-accent border border-accent/50 px-2.5 py-1 rounded text-xs hover:bg-accent hover:text-primary-dark transition font-semibold">Админка</a>
			</nav>

			<div class="md:hidden flex items-center gap-2">
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="px-2 py-1 rounded border border-white/20 text-xs font-semibold bg-black/20 text-white cursor-pointer"
						title="Версия для слабовидящих"
					>
						<span>👓</span>
					</button>
				}
				<a href="#booking" class="bg-accent text-primary-dark text-xs font-semibold px-3 py-1.5 rounded">Запись</a>
			</div>
		</div>
	</header>
}
