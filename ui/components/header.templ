package components

import (
	"sitecraft/internal/i18n"
	"sitecraft/internal/models"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ LanguageSwitcher() {
	<div class="inline-flex items-center text-xs rounded-lg border border-white/20 bg-surface/5 p-0.5" role="group" aria-label="Language switcher">
		<a
			href="?lang=ru"
			class={ "px-2 py-0.5 rounded transition text-[11px]", templ.KV("bg-accent text-primary-dark font-bold shadow-sm", i18n.GetLocale(ctx) == "ru"), templ.KV("text-white/70 hover:text-white font-medium", i18n.GetLocale(ctx) != "ru") }
			title="Русский"
		>
			RU
		</a>
		<a
			href="?lang=en"
			class={ "px-2 py-0.5 rounded transition text-[11px]", templ.KV("bg-accent text-primary-dark font-bold shadow-sm", i18n.GetLocale(ctx) == "en"), templ.KV("text-white/70 hover:text-white font-medium", i18n.GetLocale(ctx) != "en") }
			title="English"
		>
			EN
		</a>
	</div>
}

templ Header(content models.SiteContent, settings models.SiteSettings) {
	switch settings.HeaderVariant {
		case "minimal":
			@HeaderMinimal(content, settings)
		case "centered":
			@HeaderCentered(content, settings)
		default:
			@HeaderClassic(content, settings)
	}
}

templ HeaderClassic(content models.SiteContent, settings models.SiteSettings) {
	<!-- Header Classic -->
	<header
		x-data="{ mobileMenuOpen: false }"
		class="bg-primary text-white sticky top-0 z-40 shadow-lg border-b border-primary-dark"
	>
		<!-- Zero-JS CSS Scroll Progress Indicator -->
		<div class="scroll-progress-bar absolute bottom-0 left-0 right-0 h-[2px] bg-accent z-50 pointer-events-none"></div>

		<div class="max-w-6xl mx-auto px-4 py-3.5 flex justify-between items-center">
			<div class="flex items-center space-x-3">
				<div class="w-10 h-10 rounded-full bg-primary-dark border border-accent/40 flex items-center justify-center text-accent shadow-inner animate-pulse-glow">
					@icons.Scale(templ.Attributes{"class": "w-5 h-5 a11y-keep-icon"})
				</div>
				<div>
					<div class="text-white font-serif-title font-bold text-lg tracking-wide leading-tight">{ content.HeroTitle }</div>
					<div class="text-xs text-accent font-medium">{ content.OwnerName }</div>
				</div>
			</div>


			<!-- Desktop Nav -->
			<nav class="hidden md:flex items-center space-x-5 text-sm font-medium">
				<a href="/#about" class="hover:text-accent transition">{ i18n.T(ctx, "nav.about") }</a>
				<a href="/#schedule" class="hover:text-accent transition">{ i18n.T(ctx, "nav.schedule") }</a>
				<a href="/#services" class="hover:text-accent transition">{ i18n.T(ctx, "nav.services") }</a>
				<a href="/#booking" class="hover:text-accent transition">{ i18n.T(ctx, "nav.booking") }</a>
				<a href="/track" class="hover:text-accent transition">{ i18n.T(ctx, "nav.tracker") }</a>
				<a href="/blog" class="hover:text-accent transition">{ i18n.T(ctx, "nav.blog") }</a>
				<a href="/#map" class="hover:text-accent transition">{ i18n.T(ctx, "nav.contacts") }</a>

				<!-- Языковой переключатель RU / EN -->
				@LanguageSwitcher()

				<!-- Переключатель сезонов и день/ночь -->
				<div
					x-data="{ 
						open: false, 
						season: 'main', 
						isNight: false,
						init() {
							const st = window.getThemeState ? window.getThemeState() : { base: 'main', isNight: false };
							this.season = st.base;
							this.isNight = st.isNight;
							window.addEventListener('themechanged', (e) => {
								this.season = e.detail.season;
								this.isNight = e.detail.isNight;
							});
						},
						changeSeason(s) {
							this.season = s;
							this.open = false;
							window.setSiteTheme(s);
						},
						toggleNight() {
							window.toggleNightMode();
						}
					}"
					class="flex items-center space-x-1 relative"
				>
					<button
						type="button"
						@click="open = !open"
						class="flex items-center gap-1 px-2.5 py-1 rounded border border-white/20 text-xs font-semibold hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
						title="Выбрать тему оформления"
					>
						<span x-show="season === 'legal' || season === 'legal-swiss'">⚖️</span>
						<span x-show="season === 'legal-british'">🌲</span>
						<span x-show="season === 'legal-corporate'">💼</span>
						<span x-show="season === 'legal-milano'">🏛️</span>
						<span x-show="season === 'legal-classic'">📜</span>
						<span x-show="season === 'main'">🏛️</span>
						<span x-show="season === 'harmonic'">🎨</span>
						<span x-show="season === 'spring'">🌱</span>
						<span x-show="season === 'summer'">☀️</span>
						<span x-show="season === 'autumn'">🍁</span>
						<span x-show="season === 'winter'">❄️</span>
						<span class="capitalize" x-text="season === 'legal' || season === 'legal-swiss' ? 'Швейцария' : (season === 'legal-british' ? 'Британия' : (season === 'legal-corporate' ? 'Корпорат' : (season === 'legal-milano' ? 'Милан' : (season === 'legal-classic' ? 'Оксфорд' : (season === 'main' ? 'Основная' : (season === 'harmonic' ? 'Гармония' : (season === 'spring' ? 'Весна' : (season === 'summer' ? 'Лето' : (season === 'autumn' ? 'Осень' : 'Зима')))))))))"></span>
						@icons.ChevronDown(templ.Attributes{"class": "w-3 h-3 ml-0.5"})
					</button>

					<!-- Выпадающий список сезонов и юридических тем -->
					<div
						x-show="open"
						x-cloak
						@click.outside="open = false"
						class="absolute top-full left-0 mt-1.5 w-52 bg-surface text-content rounded-xl shadow-xl border border-content/10 py-1.5 z-50 text-xs animate-fade-in max-h-80 overflow-y-auto"
					>
						<div class="px-3 py-1 text-[10px] font-bold text-accent uppercase tracking-wider border-b border-content/10">Темы Advokat-Pro</div>
						<button type="button" @click="changeSeason('legal-swiss')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>⚖️</span> Швейцарский Navy
						</button>
						<button type="button" @click="changeSeason('legal-british')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🌲</span> Британский Изумруд
						</button>
						<button type="button" @click="changeSeason('legal-corporate')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>💼</span> Корпоративный Сапфир
						</button>
						<button type="button" @click="changeSeason('legal-milano')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🏛️</span> Миланский Графит
						</button>
						<button type="button" @click="changeSeason('legal-classic')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium opacity-70">
							<span>📜</span> Оксфорд (Классик)
						</button>

						<div class="px-3 py-1 text-[10px] font-bold text-content-muted uppercase tracking-wider border-t border-b border-content/10 mt-1">Другие темы</div>
						<button type="button" @click="changeSeason('main')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🏛️</span> Основная
						</button>
						<button type="button" @click="changeSeason('harmonic')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center justify-between cursor-pointer font-medium text-accent">
							<span class="flex items-center gap-2"><span>🎨</span> Гармония (Авто)</span>
							<span class="text-[10px] opacity-70">HSL</span>
						</button>
						<button type="button" @click="changeSeason('spring')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🌱</span> Весна
						</button>
						<button type="button" @click="changeSeason('summer')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>☀️</span> Лето
						</button>
						<button type="button" @click="changeSeason('autumn')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🍁</span> Осень
						</button>
						<button type="button" @click="changeSeason('winter')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>❄️</span> Зима
						</button>
					</div>

					<!-- Переключатель День / Ночь -->
					<button
						type="button"
						@click="toggleNight()"
						class="p-1.5 rounded border border-white/20 text-xs hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
						:title="isNight ? 'Переключить на дневной режим' : 'Переключить на ночной режим'"
					>
						<span x-show="!isNight" title="Ночной режим">🌙</span>
						<span x-show="isNight" title="Дневной режим">☀️</span>
					</button>
				</div>

				<!-- Кнопка 'Версия для слабовидящих' (Vanilla JS) -->
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="flex items-center gap-1.5 px-2.5 py-1 rounded border border-white/30 text-xs font-semibold hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
						title={ i18n.T(ctx, "a11y.version") }
					>
						@icons.Eye(templ.Attributes{"class": "w-3.5 h-3.5"})
						<span>{ i18n.T(ctx, "a11y.toggle") }</span>
					</button>
				}

				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeXs,
					Href:    "/_/",
					Target:  "_blank",
					Class:   "text-accent border-accent/50 hover:bg-accent hover:text-primary-dark font-semibold transition",
				}) {
					{ i18n.T(ctx, "nav.admin") }
				}
			</nav>

			<!-- Mobile Controls -->
			<div class="md:hidden flex items-center gap-2">
				@LanguageSwitcher()
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="px-2.5 py-1.5 rounded border border-white/20 text-xs font-semibold bg-black/20 text-white cursor-pointer"
						title={ i18n.T(ctx, "a11y.version") }
					>
						@icons.Eye(templ.Attributes{"class": "w-4 h-4"})
					</button>
				}
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeSm,
					Href:    "#booking",
					Class:   "bg-accent text-primary-dark text-xs font-semibold px-3 py-1.5 rounded shadow",
				}) {
					{ i18n.T(ctx, "nav.booking") }
				}
				<!-- Alpine.js Hamburger Button -->
				<button
					type="button"
					@click="mobileMenuOpen = !mobileMenuOpen"
					class="p-1.5 rounded-lg border border-white/20 bg-surface/10 text-white hover:text-accent focus:outline-none cursor-pointer"
					aria-label="Меню навигации"
				>
					<span x-show="!mobileMenuOpen" class="flex items-center">
						@icons.Menu(templ.Attributes{"class": "w-6 h-6"})
					</span>
					<span x-show="mobileMenuOpen" x-cloak class="flex items-center">
						@icons.X(templ.Attributes{"class": "w-6 h-6"})
					</span>
				</button>
			</div>
		</div>


		<!-- Mobile Menu Drawer (Alpine.js) -->
		<div
			x-show="mobileMenuOpen"
			x-cloak
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 -translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 -translate-y-2"
			class="md:hidden bg-primary-dark/95 backdrop-blur-md border-b border-primary-light px-4 py-4 space-y-3"
		>
			<nav class="flex flex-col space-y-2 text-sm font-medium">
				<a href="/#about" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">{ i18n.T(ctx, "nav.about") }</a>
				<a href="/#schedule" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">{ i18n.T(ctx, "nav.schedule_full") }</a>
				<a href="/#services" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">{ i18n.T(ctx, "nav.services_full") }</a>
				<a href="/#booking" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">{ i18n.T(ctx, "nav.booking_full") }</a>
				<a href="/track" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">{ i18n.T(ctx, "nav.tracker_full") }</a>
				<a href="/blog" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">{ i18n.T(ctx, "nav.blog_full") }</a>
				<a href="/#map" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">{ i18n.T(ctx, "nav.contacts_full") }</a>
				<a href="/_/" target="_blank" class="py-2 px-3 rounded text-accent border border-accent/40 font-semibold text-center mt-2">{ i18n.T(ctx, "nav.admin_full") }</a>
			</nav>
		</div>
	</header>
}

templ HeaderMinimal(content models.SiteContent, settings models.SiteSettings) {
	<!-- Header Minimal: лаконичный компактный стиль с фокусом на конверсию -->
	<header
		class="bg-primary text-white sticky top-0 z-40 shadow-md border-b border-primary-dark/80 backdrop-blur-md bg-opacity-95"
	>
		<div class="scroll-progress-bar absolute bottom-0 left-0 right-0 h-[2px] bg-accent z-50 pointer-events-none"></div>

		<div class="max-w-6xl mx-auto px-4 py-2.5 flex justify-between items-center">
			<!-- Бренд / Название -->
			<a href="/" class="flex items-center space-x-2.5 group">
				<div class="w-8 h-8 rounded-lg bg-accent/20 border border-accent/40 flex items-center justify-center text-accent group-hover:scale-105 transition">
					@icons.Scale(templ.Attributes{"class": "w-4 h-4 a11y-keep-icon"})
				</div>
				<div>
					<div class="text-white font-serif-title font-bold text-base leading-tight tracking-wide group-hover:text-accent transition">{ content.HeroTitle }</div>
					<div class="text-[11px] text-accent/80 font-medium">{ content.OwnerName }</div>
				</div>
			</a>

			<!-- Правая часть: Телефон, CTA, Язык, День/Ночь -->
			<div class="flex items-center space-x-3">
				if content.Phone1 != "" {
					<a
						href={ templ.URL("tel:" + content.Phone1) }
						class="hidden sm:flex items-center gap-1.5 text-xs font-semibold text-white/90 hover:text-accent transition bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg"
					>
						@icons.Phone(templ.Attributes{"class": "w-3.5 h-3.5 text-accent"})
						<span>{ content.Phone1 }</span>
					</a>
				}

				@LanguageSwitcher()

				<!-- Переключатель День / Ночь -->
				<button
					type="button"
					onclick="window.toggleNightMode && window.toggleNightMode()"
					class="p-1.5 rounded border border-white/20 text-xs hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
					title="Переключить тему"
				>
					🌙
				</button>

				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="hidden md:flex items-center gap-1 px-2.5 py-1.5 rounded border border-white/30 text-xs font-semibold hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
						title={ i18n.T(ctx, "a11y.version") }
					>
						@icons.Eye(templ.Attributes{"class": "w-3.5 h-3.5"})
					</button>
				}

				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeSm,
					Href:    "/#booking",
					Class:   "bg-accent hover:bg-accent-hover text-primary-dark text-xs font-bold px-3.5 py-1.5 rounded-lg shadow transition",
				}) {
					@icons.Calendar(templ.Attributes{"class": "w-3.5 h-3.5 mr-1.5"})
					{ i18n.T(ctx, "btn.book") }
				}
			</div>
		</div>
	</header>
}

templ HeaderCentered(content models.SiteContent, settings models.SiteSettings) {
	<!-- Header Centered: элегантный центрированный стиль для респектабельных проектов -->
	<header
		x-data="{ mobileMenuOpen: false }"
		class="bg-primary text-white sticky top-0 z-40 shadow-lg border-b border-primary-dark"
	>
		<div class="scroll-progress-bar absolute bottom-0 left-0 right-0 h-[2px] bg-accent z-50 pointer-events-none"></div>

		<!-- Верхняя строка: Логотип и название по центру -->
		<div class="max-w-6xl mx-auto px-4 pt-3 pb-2 flex flex-col items-center justify-center border-b border-white/10">
			<a href="/" class="flex items-center space-x-2 text-center group">
				<div class="w-9 h-9 rounded-full bg-primary-dark border border-accent/40 flex items-center justify-center text-accent shadow-inner">
					@icons.Scale(templ.Attributes{"class": "w-4.5 h-4.5 a11y-keep-icon"})
				</div>
				<div class="text-left sm:text-center">
					<div class="text-white font-serif-title font-bold text-lg sm:text-xl tracking-wider leading-tight group-hover:text-accent transition">{ content.HeroTitle }</div>
					<div class="text-xs text-accent font-medium tracking-wide">{ content.OwnerName }</div>
				</div>
			</a>
		</div>

		<!-- Нижняя строка: Центрированная навигация -->
		<div class="max-w-6xl mx-auto px-4 py-2 flex justify-between md:justify-center items-center relative">
			<nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
				<a href="/#about" class="hover:text-accent transition">{ i18n.T(ctx, "nav.about") }</a>
				<a href="/#schedule" class="hover:text-accent transition">{ i18n.T(ctx, "nav.schedule") }</a>
				<a href="/#services" class="hover:text-accent transition">{ i18n.T(ctx, "nav.services") }</a>
				<a href="/#booking" class="hover:text-accent transition font-semibold text-accent">{ i18n.T(ctx, "nav.booking") }</a>
				<a href="/track" class="hover:text-accent transition">{ i18n.T(ctx, "nav.tracker") }</a>
				<a href="/blog" class="hover:text-accent transition">{ i18n.T(ctx, "nav.blog") }</a>
				<a href="/#map" class="hover:text-accent transition">{ i18n.T(ctx, "nav.contacts") }</a>
			</nav>

			<!-- Правые служебные кнопки (десктоп: абсолютно справа) -->
			<div class="hidden md:flex items-center space-x-2 absolute right-4 top-1/2 -translate-y-1/2">
				@LanguageSwitcher()
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="p-1 rounded border border-white/20 text-xs hover:border-accent hover:text-accent transition cursor-pointer"
						title={ i18n.T(ctx, "a11y.version") }
					>
						@icons.Eye(templ.Attributes{"class": "w-3.5 h-3.5"})
					</button>
				}
				<button
					type="button"
					onclick="window.toggleNightMode && window.toggleNightMode()"
					class="p-1 rounded border border-white/20 text-xs hover:border-accent transition cursor-pointer"
					title="Переключить день/ночь"
				>
					🌙
				</button>
			</div>

			<!-- Мобильная кнопка меню -->
			<div class="md:hidden flex items-center justify-between w-full">
				<div class="flex items-center gap-2">
					@LanguageSwitcher()
					<a href="#booking" class="text-xs text-accent font-semibold underline">{ i18n.T(ctx, "nav.booking") }</a>
				</div>
				<button
					type="button"
					@click="mobileMenuOpen = !mobileMenuOpen"
					class="p-1.5 rounded-lg border border-white/20 bg-surface/10 text-white hover:text-accent focus:outline-none cursor-pointer"
					aria-label="Меню навигации"
				>
					<span x-show="!mobileMenuOpen">@icons.Menu(templ.Attributes{"class": "w-5 h-5"})</span>
					<span x-show="mobileMenuOpen" x-cloak>@icons.X(templ.Attributes{"class": "w-5 h-5"})</span>
				</button>
			</div>
		</div>

		<!-- Mobile Menu Drawer (Alpine.js) -->
		<div
			x-show="mobileMenuOpen"
			x-cloak
			class="md:hidden bg-primary-dark/95 backdrop-blur-md border-b border-primary-light px-4 py-3 space-y-2 text-sm text-center"
		>
			<a href="/#about" @click="mobileMenuOpen = false" class="block py-1.5 hover:text-accent transition">{ i18n.T(ctx, "nav.about") }</a>
			<a href="/#schedule" @click="mobileMenuOpen = false" class="block py-1.5 hover:text-accent transition">{ i18n.T(ctx, "nav.schedule_full") }</a>
			<a href="/#services" @click="mobileMenuOpen = false" class="block py-1.5 hover:text-accent transition">{ i18n.T(ctx, "nav.services_full") }</a>
			<a href="/#booking" @click="mobileMenuOpen = false" class="block py-1.5 text-accent font-semibold">{ i18n.T(ctx, "nav.booking_full") }</a>
			<a href="/track" @click="mobileMenuOpen = false" class="block py-1.5 hover:text-accent transition">{ i18n.T(ctx, "nav.tracker_full") }</a>
			<a href="/blog" @click="mobileMenuOpen = false" class="block py-1.5 hover:text-accent transition">{ i18n.T(ctx, "nav.blog_full") }</a>
			<a href="/#map" @click="mobileMenuOpen = false" class="block py-1.5 hover:text-accent transition">{ i18n.T(ctx, "nav.contacts_full") }</a>
		</div>
	</header>
}

