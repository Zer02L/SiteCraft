package components

import (
	"sitecraft/internal/models"
)

templ Header(content models.SiteContent, settings models.SiteSettings) {
	<!-- Header -->
	<header
		x-data="{ mobileMenuOpen: false }"
		class="bg-primary text-white sticky top-0 z-40 shadow-lg border-b border-primary-dark"
	>
		<!-- Zero-JS CSS Scroll Progress Indicator -->
		<div class="scroll-progress-bar absolute bottom-0 left-0 right-0 h-[2px] bg-accent z-50 pointer-events-none"></div>

		<div class="max-w-6xl mx-auto px-4 py-3.5 flex justify-between items-center">
			<div class="flex items-center space-x-3">
				<div class="w-10 h-10 rounded-full bg-primary-dark border border-accent/40 flex items-center justify-center text-accent shadow-inner">
					<svg class="w-6 h-6 a11y-keep-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
					</svg>
				</div>
				<div>
					<div class="text-white font-serif-title font-bold text-lg tracking-wide leading-tight">{ content.HeroTitle }</div>
					<div class="text-xs text-accent font-medium">{ content.OwnerName }</div>
				</div>
			</div>

			<!-- Desktop Nav -->
			<nav class="hidden md:flex items-center space-x-5 text-sm font-medium">
				<a href="/#about" class="hover:text-accent transition">О нас</a>
				<a href="/#schedule" class="hover:text-accent transition">Режим</a>
				<a href="/#services" class="hover:text-accent transition">Услуги</a>
				<a href="/#booking" class="hover:text-accent transition">Запись</a>
				<a href="/track" class="hover:text-accent transition">Трекер</a>
				<a href="/blog" class="hover:text-accent transition">Блог</a>
				<a href="/#map" class="hover:text-accent transition">Контакты</a>

				<!-- Кнопка 'Версия для слабовидящих' (Vanilla JS) -->
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="flex items-center gap-1.5 px-2.5 py-1 rounded border border-white/30 text-xs font-semibold hover:border-accent hover:text-accent transition bg-white/5 cursor-pointer"
						title="Версия для слабовидящих"
					>
						<span>👓</span>
						<span>Для слабовидящих</span>
					</button>
				}

				<a href="/_/" target="_blank" class="text-accent border border-accent/50 px-2.5 py-1 rounded text-xs hover:bg-accent hover:text-primary-dark transition font-semibold">Админка</a>
			</nav>

			<!-- Mobile Controls -->
			<div class="md:hidden flex items-center gap-2">
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="px-2.5 py-1.5 rounded border border-white/20 text-xs font-semibold bg-black/20 text-white cursor-pointer"
						title="Версия для слабовидящих"
					>
						<span>👓</span>
					</button>
				}
				<a href="#booking" class="bg-accent text-primary-dark text-xs font-semibold px-3 py-1.5 rounded shadow">Запись</a>
				<!-- Alpine.js Hamburger Button -->
				<button
					type="button"
					@click="mobileMenuOpen = !mobileMenuOpen"
					class="p-1.5 rounded-lg border border-white/20 bg-white/10 text-white hover:text-accent focus:outline-none cursor-pointer"
					aria-label="Меню навигации"
				>
					<svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
					<svg x-show="mobileMenuOpen" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Mobile Menu Drawer (Alpine.js) -->
		<div
			x-show="mobileMenuOpen"
			x-cloak
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 -translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 -translate-y-2"
			class="md:hidden bg-primary-dark/95 backdrop-blur-md border-b border-primary-light px-4 py-4 space-y-3"
		>
			<nav class="flex flex-col space-y-2 text-sm font-medium">
				<a href="/#about" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-white/10 hover:text-accent transition">О нас</a>
				<a href="/#schedule" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-white/10 hover:text-accent transition">Режим работы</a>
				<a href="/#services" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-white/10 hover:text-accent transition">Услуги и цены</a>
				<a href="/#booking" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-white/10 hover:text-accent transition">Онлайн-запись</a>
				<a href="/track" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-white/10 hover:text-accent transition">Статус заказа</a>
				<a href="/blog" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-white/10 hover:text-accent transition">Блог и публикации</a>
				<a href="/#map" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-white/10 hover:text-accent transition">Контакты и адрес</a>
				<a href="/_/" target="_blank" class="py-2 px-3 rounded text-accent border border-accent/40 font-semibold text-center mt-2">Панель управления (PocketBase)</a>
			</nav>
		</div>
	</header>
}
