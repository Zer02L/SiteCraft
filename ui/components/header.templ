package components

import (
	"sitecraft/internal/models"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ Header(content models.SiteContent, settings models.SiteSettings) {
	<!-- Header -->
	<header
		x-data="{ mobileMenuOpen: false }"
		class="bg-primary text-white sticky top-0 z-40 shadow-lg border-b border-primary-dark"
	>
		<!-- Zero-JS CSS Scroll Progress Indicator -->
		<div class="scroll-progress-bar absolute bottom-0 left-0 right-0 h-[2px] bg-accent z-50 pointer-events-none"></div>

		<div class="max-w-6xl mx-auto px-4 py-3.5 flex justify-between items-center">
			<div class="flex items-center space-x-3">
				<div class="w-10 h-10 rounded-full bg-primary-dark border border-accent/40 flex items-center justify-center text-accent shadow-inner animate-pulse-glow">
					@icons.Scale(templ.Attributes{"class": "w-5 h-5 a11y-keep-icon"})
				</div>
				<div>
					<div class="text-white font-serif-title font-bold text-lg tracking-wide leading-tight">{ content.HeroTitle }</div>
					<div class="text-xs text-accent font-medium">{ content.OwnerName }</div>
				</div>
			</div>


			<!-- Desktop Nav -->
			<nav class="hidden md:flex items-center space-x-5 text-sm font-medium">
				<a href="/#about" class="hover:text-accent transition">О нас</a>
				<a href="/#schedule" class="hover:text-accent transition">Режим</a>
				<a href="/#services" class="hover:text-accent transition">Услуги</a>
				<a href="/#booking" class="hover:text-accent transition">Запись</a>
				<a href="/track" class="hover:text-accent transition">Трекер</a>
				<a href="/blog" class="hover:text-accent transition">Блог</a>
				<a href="/#map" class="hover:text-accent transition">Контакты</a>

				<!-- Переключатель сезонов и день/ночь -->
				<div
					x-data="{ 
						open: false, 
						season: 'main', 
						isNight: false,
						init() {
							const st = window.getThemeState ? window.getThemeState() : { base: 'main', isNight: false };
							this.season = st.base;
							this.isNight = st.isNight;
							window.addEventListener('themechanged', (e) => {
								this.season = e.detail.season;
								this.isNight = e.detail.isNight;
							});
						},
						changeSeason(s) {
							this.season = s;
							this.open = false;
							window.setSiteTheme(s);
						},
						toggleNight() {
							window.toggleNightMode();
						}
					}"
					class="flex items-center space-x-1 relative"
				>
					<button
						type="button"
						@click="open = !open"
						class="flex items-center gap-1 px-2.5 py-1 rounded border border-white/20 text-xs font-semibold hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
						title="Выбрать тему оформления"
					>
						<span x-show="season === 'main'">🏛️</span>
						<span x-show="season === 'harmonic'">🎨</span>
						<span x-show="season === 'spring'">🌱</span>
						<span x-show="season === 'summer'">☀️</span>
						<span x-show="season === 'autumn'">🍁</span>
						<span x-show="season === 'winter'">❄️</span>
						<span class="capitalize" x-text="season === 'main' ? 'Основная' : (season === 'harmonic' ? 'Гармония' : (season === 'spring' ? 'Весна' : (season === 'summer' ? 'Лето' : (season === 'autumn' ? 'Осень' : 'Зима'))))"></span>
						@icons.ChevronDown(templ.Attributes{"class": "w-3 h-3 ml-0.5"})
					</button>

					<!-- Выпадающий список сезонов -->
					<div
						x-show="open"
						x-cloak
						@click.outside="open = false"
						class="absolute top-full left-0 mt-1.5 w-44 bg-surface text-content rounded-xl shadow-xl border border-content/10 py-1.5 z-50 text-xs animate-fade-in"
					>
						<button type="button" @click="changeSeason('main')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🏛️</span> Основная
						</button>
						<button type="button" @click="changeSeason('harmonic')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center justify-between cursor-pointer font-medium text-accent">
							<span class="flex items-center gap-2"><span>🎨</span> Гармония (Авто)</span>
							<span class="text-[10px] opacity-70">HSL</span>
						</button>
						<button type="button" @click="changeSeason('spring')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🌱</span> Весна
						</button>
						<button type="button" @click="changeSeason('summer')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>☀️</span> Лето
						</button>
						<button type="button" @click="changeSeason('autumn')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>🍁</span> Осень
						</button>
						<button type="button" @click="changeSeason('winter')" class="w-full text-left px-3 py-1.5 hover:bg-accent/15 flex items-center gap-2 cursor-pointer font-medium">
							<span>❄️</span> Зима
						</button>
					</div>

					<!-- Переключатель День / Ночь -->
					<button
						type="button"
						@click="toggleNight()"
						class="p-1.5 rounded border border-white/20 text-xs hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
						:title="isNight ? 'Переключить на дневной режим' : 'Переключить на ночной режим'"
					>
						<span x-show="!isNight" title="Ночной режим">🌙</span>
						<span x-show="isNight" title="Дневной режим">☀️</span>
					</button>
				</div>

				<!-- Кнопка 'Версия для слабовидящих' (Vanilla JS) -->
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="flex items-center gap-1.5 px-2.5 py-1 rounded border border-white/30 text-xs font-semibold hover:border-accent hover:text-accent transition bg-surface/5 cursor-pointer"
						title="Версия для слабовидящих"
					>
						@icons.Eye(templ.Attributes{"class": "w-3.5 h-3.5"})
						<span>Для слабовидящих</span>
					</button>
				}

				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeXs,
					Href:    "/_/",
					Target:  "_blank",
					Class:   "text-accent border-accent/50 hover:bg-accent hover:text-primary-dark font-semibold transition",
				}) {
					Админка
				}
			</nav>

			<!-- Mobile Controls -->
			<div class="md:hidden flex items-center gap-2">
				if settings.EnableA11y {
					<button
						type="button"
						onclick="window.A11Y.toggle()"
						class="px-2.5 py-1.5 rounded border border-white/20 text-xs font-semibold bg-black/20 text-white cursor-pointer"
						title="Версия для слабовидящих"
					>
						@icons.Eye(templ.Attributes{"class": "w-4 h-4"})
					</button>
				}
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeSm,
					Href:    "#booking",
					Class:   "bg-accent text-primary-dark text-xs font-semibold px-3 py-1.5 rounded shadow",
				}) {
					Запись
				}
				<!-- Alpine.js Hamburger Button -->
				<button
					type="button"
					@click="mobileMenuOpen = !mobileMenuOpen"
					class="p-1.5 rounded-lg border border-white/20 bg-surface/10 text-white hover:text-accent focus:outline-none cursor-pointer"
					aria-label="Меню навигации"
				>
					<span x-show="!mobileMenuOpen" class="flex items-center">
						@icons.Menu(templ.Attributes{"class": "w-6 h-6"})
					</span>
					<span x-show="mobileMenuOpen" x-cloak class="flex items-center">
						@icons.X(templ.Attributes{"class": "w-6 h-6"})
					</span>
				</button>
			</div>
		</div>


		<!-- Mobile Menu Drawer (Alpine.js) -->
		<div
			x-show="mobileMenuOpen"
			x-cloak
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 -translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 -translate-y-2"
			class="md:hidden bg-primary-dark/95 backdrop-blur-md border-b border-primary-light px-4 py-4 space-y-3"
		>
			<nav class="flex flex-col space-y-2 text-sm font-medium">
				<a href="/#about" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">О нас</a>
				<a href="/#schedule" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">Режим работы</a>
				<a href="/#services" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">Услуги и цены</a>
				<a href="/#booking" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">Онлайн-запись</a>
				<a href="/track" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">Статус заказа</a>
				<a href="/blog" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">Блог и публикации</a>
				<a href="/#map" @click="mobileMenuOpen = false" class="py-2 px-3 rounded hover:bg-surface/10 hover:text-accent transition">Контакты и адрес</a>
				<a href="/_/" target="_blank" class="py-2 px-3 rounded text-accent border border-accent/40 font-semibold text-center mt-2">Панель управления (PocketBase)</a>
			</nav>
		</div>
	</header>
}
