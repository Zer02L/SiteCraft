# Конфигурация для фонового сторожа SiteCraft
# Скопируйте этот файл в .watchdog.env и укажите ваши параметры:
# cp .watchdog.env.example .watchdog.env

# Токен бота Telegram (получить у @BotFather)
TG_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Ваш Chat ID или ID группы/канала с ботом (узнать у @userinfobot)
TG_CHAT_ID="987654321"

# Пороги срабатывания
DISK_THRESHOLD=85       # Заполнение диска в процентах (%)
MEM_THRESHOLD=10        # Минимальный остаток свободной RAM в процентах (%)
LOAD_MULTIPLIER=2       # Множитель нагрузки Load Average к числу ядер процессора
SERVICE_NAME="sitecraft" # Имя systemd службы для контроля
